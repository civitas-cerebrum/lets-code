# Sessions: a local channel between the lets-code sessions on this machine
# (two terminals in one repo, an orchestrator and its subagents): a registry
# of live sessions and an inbox each, files only (see the module's header).
# Rewritten when its content changes.
pi_write_sessions_extension() {
