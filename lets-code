export function looksSecret(s: string): boolean { return SECRET_RES.some((re) => re.test(s)); }

// ------------------------------------------------------------------ keys
// The project is the nearest directory up from cwd with a .git, else cwd.
// A worktree's .git is a file, "gitdir: <main>/.git/worktrees/<name>": the
// project is the main checkout, so every worktree of a repository (a
// software factory run's among them) shares its memory, and paths under
// the worktree are read as the main checkout's (aliases, see normRef) so
// one entry's pointers fit both. Its store dir is the folder's name plus a
// hash of the full path, so two "app" folders do not share.
const aliases = new Map<string, string>();   // a worktree -> its main checkout
export function projectRoot(cwd: string): string {
	let d = resolve(cwd);
	for (;;) {
		const g = join(d, ".git");
		if (existsSync(g)) {
			try {
				const m = statSync(g).isFile() ? /^gitdir:\s*(.+?)[\\/]\.git[\\/]worktrees[\\/][^\\/\s]+[\\/]?\s*$/.exec(readFileSync(g, "utf8")) : null;
				if (m) { const main = resolve(d, m[1]); if (main !== d) aliases.set(d, main); return main; }
			} catch { /* unreadable: the folder stands on its own */ }
			return d;
		}
