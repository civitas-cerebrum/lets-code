	archive(days: number, now = Date.now()): number {
		const cut = now - days * 86_400_000;
		const gone = this.entries.filter((e) => (e.kind === "work" || e.kind === "pointer") && e.u < cut);
		if (!gone.length) return 0;
		mkdirSync(this.dir, { recursive: true, mode: 0o700 });
		appendFileSync(this.archiveFile, gone.map((e) => JSON.stringify(e)).join("\n") + "\n", { mode: 0o600 });
