}
// local > project > user on a name clash; project servers need trust and Claude's approval
export function claudeMcpServers(cwd: string, s: Settings, trusted: boolean, askedHere: boolean): { servers: McpEntry[]; skipped: string[] } {
	const cj = readJson(claudeJsonPath()) ?? {};
	const proj = cj.projects?.[real(cwd)] ?? cj.projects?.[resolve(cwd)] ?? {};
	const servers = new Map<string, McpEntry>(); const skipped: string[] = [];
	const add = (scope: McpEntry["scope"], all: any) => {
		for (const [name, raw] of Object.entries(all && typeof all === "object" ? all : {})) {
			if (servers.has(name)) continue;
			const c = toPiMcp(raw);
			if (typeof c === "string") { skipped.push(`${name} (${c})`); continue; }
			servers.set(name, { name, scope, config: c });
		}
	};
	add("local", proj.mcpServers);
	const mj = readJson(join(cwd, ".mcp.json"))?.mcpServers;
	if (mj && typeof mj === "object") {
		const disabled = new Set([...s.disabledMcpjsonServers, ...asList(proj.disabledMcpjsonServers)]);
		const enabled = new Set([...s.enabledMcpjsonServers, ...asList(proj.enabledMcpjsonServers)]);
		const approved: Record<string, unknown> = {};
		for (const [name, raw] of Object.entries(mj)) {
			if (disabled.has(name)) continue;
			if (!trusted) { skipped.push(`${name} (folder not trusted)`); continue; }
			if (!(s.enableAllProjectMcpServers || enabled.has(name) || askedHere)) { skipped.push(`${name} (not approved in Claude Code)`); continue; }
			approved[name] = raw;
		}
		add("project", approved);
	}
	if (userScope()) add("user", cj.mcpServers);
	return { servers: [...servers.values()], skipped };
}

