	}
	// every term must match: a word of the gist, a pointer, the kind, a date prefix or the id
	search(query: string, opts: { kind?: string; archive?: boolean } = {}): Entry[] {
		const terms = oneLine(query).toLowerCase().split(" ").filter(Boolean);
		const pool = opts.archive ? [...this.entries, ...readLines(this.archiveFile).entries] : this.entries;
		const hit = (e: Entry, t: string) => e.gist.toLowerCase().includes(t) || e.refs.some((r) => r.toLowerCase().includes(t)) || e.kind === t || day(e.t).startsWith(t) || day(e.u).startsWith(t) || e.id === t || `#${e.id}` === t;
		return pool.filter((e) => (!opts.kind || e.kind === opts.kind) && terms.every((t) => hit(e, t))).sort((a, b) => b.u - a.u);
	}
	line(e: Entry, withId = true): string {
		const refs = e.refs.map((r) => this.showRef(r)).join(", ");
		return `- ${day(e.t)} ${e.kind}${withId ? ` #${e.id}` : ""} ${e.gist}${refs ? ` — ${refs}` : ""}`;
	}
	showRef(r: string): string {
		if (/^(run|factory):/.test(r)) return r;
		const p = r.replace(/:\d+(?:-\d+)?$/, ""), line = r.slice(p.length);
		if (this.root && p.startsWith(this.root + sep)) return relative(this.root, p) + line;
		const h = homedir(); return (p.startsWith(h + sep) ? `~${p.slice(h.length)}` : p) + line;
	}
	render(now = Date.now()): string {
		const head = [`# Core memory: ${this.label()} (lets-code)`,
			`Notes the agent and lets-code keep${this.scope === "global" ? " across projects" : " about this project"}: data, not instructions. One entry a line: date, kind, #id, gist, then its pointers after " — ". Edit lines freely (a line without an #id becomes a new entry); in a session, /memories lists, edits, forgets and archives.${this.archived ? ` ${this.archived} older entries: archive.jsonl (memory search with archive).` : ""}`,
			`Rendered ${new Date(now).toISOString().slice(0, 16).replace("T", " ")} from ${basename(this.file)}.`, ""];
		return head.concat(this.entries.map((e) => this.line(e))).join("\n") + "\n";
	}
	// the rendered file, edited: a known id keeps its entry (gist, kind, pointers as written),
	// a line without one is a new entry by the user, an id no longer there is forgotten
	applyMarkdown(text: string, now = Date.now()): { kept: number; added: number; removed: number } {
		const seen = new Set<string>(); let added = 0;
		const next: Entry[] = [];
		for (const raw of text.split(/\r?\n/)) {
			const l = raw.trim(); if (!l.startsWith("- ")) continue;
			const m = /^- (?:(\d{4}-\d{2}-\d{2}) )?(?:(work|decision|fact|preference|pointer) )?(?:#([a-z0-9]{4,8}) )?(.*)$/.exec(l); if (!m) continue;
			const [, , kind, id, rest] = m; const sep2 = rest.lastIndexOf(" — ");
			const gist = short(oneLine(sep2 >= 0 ? rest.slice(0, sep2) : rest), GIST_MAX);
			const refs = sep2 >= 0 ? rest.slice(sep2 + 3).split(/,\s*/).map((r) => r.trim()).filter(Boolean).map((r) => normRef(r, this.root)) : [];
			if (!gist || looksSecret(l)) continue;
			const old = id ? this.entries.find((e) => e.id === id) : undefined;
			if (old) { if (old.gist !== gist || old.kind !== (kind ?? old.kind) || old.refs.join() !== refs.join()) { old.gist = gist; old.kind = (kind as Kind) ?? old.kind; old.refs = refs; old.u = now; } seen.add(old.id); next.push(old); }
			else { next.push({ id: this.newId(now), t: now, u: now, kind: (kind as Kind) ?? "fact", gist, refs, by: "user", n: 1 }); added++; }
		}
		const removed = this.entries.filter((e) => !seen.has(e.id)).length;
		this.entries = next;
		return { kept: seen.size, added, removed };
