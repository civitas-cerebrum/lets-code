            echo "# session. CORE_MEMORY_HEADLINES: how many of the newest entries (0..5)"
            echo "# a session starts with in its prompt."
            echo "CORE_MEMORY=\"${feat_core_memory}\""
            echo "CORE_MEMORY_HEADLINES=\"3\""
            echo ""
            echo "# Sessions: the message tool and /sessions, a local channel between the"
            echo "# lets-code sessions on this machine (another terminal in the same repo,"
            echo "# an orchestrator and its subagents). On by default; SESSIONS=false or"
            echo "# --no-sessions turns it off."
            echo "SESSIONS=\"true\""
            echo ""
            echo "# METRICS=true: start with the full footer (directory, model, cache, first"
            echo "# token, output) instead of the minimal one (--metrics; /metrics in pi)."
            echo "METRICS=\"${feat_metrics}\""
        } > "${CONFIG_FILE}"
        chmod 600 "${CONFIG_FILE}"
    }
    mkdir -p "${CONFIG_DIR}"
    setup_emit_config ""
    echo ""
    log "saved ${CONFIG_FILE}"

    # 7. register as a command: install + make executable + ensure PATH
    local self target
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    echo ""
    echo "Where should the 'lets-code' command be installed?"
    echo "  1) ${HOME}/.local/bin   (this user only — default)"
    echo "  2) /usr/local/bin       (system-wide, needs sudo)"
