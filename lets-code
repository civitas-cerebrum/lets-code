// Simple commands of a bash line, wrappers stripped: deny/ask rules match
// when any of them does, an allow rule only when all of them do.
export function bashParts(cmd: string): string[] {
	const out: string[] = []; let cur = ""; let q = "";
	for (let i = 0; i < cmd.length; i++) {
		const c = cmd[i];
		if (q) { cur += c; if (c === "\\" && q === '"') { cur += cmd[++i] ?? ""; continue; } if (c === q) q = ""; continue; }
		if (c === "'" || c === '"') { q = c; cur += c; continue; }
		if (c === "\\") { cur += c + (cmd[i + 1] ?? ""); i++; continue; }
		if (c === ";" || c === "\n" || c === "|" || (c === "&" && !/[<>]$/.test(cur) && cmd[i + 1] !== ">")) { out.push(cur); cur = ""; if ((c === "|" || c === "&") && cmd[i + 1] === c) i++; continue; }
		cur += c;
	}
	out.push(cur);
	return out.map((s) => s.trim().replace(/^[({]\s*/, "").replace(/\s*[)}]$/, "").replace(/\s+/g, " ")).map(stripWrappers).filter(Boolean);
}
