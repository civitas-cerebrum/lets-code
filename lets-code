# Claude backend: the claude module (index.ts) and the proxy it keeps running
# (server.mjs: an OpenAI-compatible server over `claude -p`; bridge.mjs: pi's
# tools for Claude over MCP), in <extension>/claude/. Written on every launch
# where `claude` is installed, so Claude models work from /model as well as
# with --claude; inert unless LETS_CODE_CLAUDE_PROVIDER is set. Each file is
# rewritten when its content changes (and the module then restarts an older
# running proxy).
pi_write_claude_extension() {
    local dir tmp
    lc_ext_module claude; dir="${LC_MOD_DIR}"
    tmp="$(mktemp "${dir}/.server.XXXXXX")"
    cat > "${tmp}" <<'MJS'
// Written by lets-code (claude proxy); regenerated on launch, edits are overwritten.
// OpenAI-compatible (vLLM-style) chat completions server backed by the Claude
// Code CLI, so pi can run Claude models on a Claude subscription. Started by
// index.ts next to it (one daemon per user and port).
//
// Every pi conversation gets one long-lived `claude -p` process. Claude's
// built-in tools are off; pi's tools reach it through bridge.mjs (MCP). When
// Claude calls a tool, the proxy returns it to pi as tool_calls and keeps the
// MCP call open; pi's next request carries the tool results, which complete
// the call, and Claude carries on in the same process. A request that matches
// no live process starts a fresh one with the history replayed as text.
import http from "node:http";
import net from "node:net";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import readline from "node:readline";
import { spawn } from "node:child_process";
import { createHash, randomUUID } from "node:crypto";

const env = process.env;
const PORT = +(env.PORT || 8795);
const HOST = env.HOST || "127.0.0.1";
const API_KEY = env.PROXY_API_KEY || "";
const CLAUDE_BIN = env.CLAUDE_BIN || "claude";
const MAX_SESSIONS = +(env.MAX_SESSIONS || 8);
const MAX_PER_TOKEN = +(env.MAX_SESSIONS_PER_TOKEN || 4); // a remote token cannot take every slot
const IDLE_MS = +(env.IDLE_TTL_S || 600) * 1000;
// a process waiting for pi to run tools (a long test suite, say) is not idle
const TOOL_WAIT_MS = Math.max(IDLE_MS, 3600 * 1000);
const STATE_DIR = env.STATE_DIR || path.join(os.homedir(), ".pi", "agent", "lets-code-claude");
const DEBUG = !!env.DEBUG;
// appended to the system prompt pi sends: Claude models explain at length by
// default; in a terminal the user wants the answer, not an essay
const STYLE = [
  "Output style (lets-code):",
  "- Be brief and direct. Lead with the answer or the result; use as few words as the task needs.",
  "- No preamble, no restating the request, no closing summaries or offers of further help.",
  "- Explain only what the user needs to know: the outcome, a decision they must make, a problem you hit. Skip narration of routine steps.",
  "- Prefer short sentences and plain prose over headers and long lists. Give more detail only when asked.",
  "- This is about your messages to the user; code, commands and tool calls stay as complete as the task requires.",
].join("\n");
// Claude Code adds its own environment (working directory, platform, OS
// version) to every conversation: the proxy's empty folder, and on another
// machine's proxy (the phone's) another machine. pi's tools run elsewhere.
const WHERE = "Environment (lets-code): the working directory, platform and OS version Claude Code adds to this conversation are the relaying proxy's, not where your tools run. Take the working directory and platform from the prompt above, or check with a tool; never work in the proxy's folder.";
const BRIDGE = new URL("./bridge.mjs", import.meta.url).pathname;
// index.ts compares this with its copy of the file and restarts an older daemon
const VERSION = createHash("sha256").update(fs.readFileSync(new URL(import.meta.url))).digest("hex").slice(0, 16);
// a unix socket path has room for about 107 bytes: a deep STATE_DIR gets its
// socket in the temp dir instead, named after it
const SOCK = path.join(STATE_DIR, "bridge.sock").length < 100
  ? path.join(STATE_DIR, "bridge.sock")
  : path.join(os.tmpdir(), `lets-code-claude-${createHash("sha256").update(STATE_DIR).digest("hex").slice(0, 12)}.sock`);
const WORK_DIR = path.join(STATE_DIR, "empty"); // cwd for claude: no CLAUDE.md to discover

// OpenAI model id -> claude --model: claude-<alias> for each CLI alias in
// LETS_CODE_CLAUDE_MODELS (an entry that already starts with claude- is a
// full model name and its own id). Unknown ids are passed through as well,
// so any model name the CLI takes works.
const MODELS = Object.fromEntries(
  (env.LETS_CODE_CLAUDE_MODELS || "haiku sonnet opus fable") // CLAUDE_DEFAULT_MODELS in lets-code
    .split(/[\s,]+/)
    .filter(Boolean)
    .map((m) => (m.startsWith("claude-") ? [m, m] : ["claude-" + m, m])),
);
const EFFORTS = new Set(["low", "medium", "high", "xhigh", "max"]);
// effortLevel, the setting Claude Code's /effort changes live, stops at xhigh;
// max only exists as a launch flag
const LIVE_EFFORTS = new Set(["low", "medium", "high", "xhigh"]);
const TOOL_PREFIX = "mcp__pi__";

const log = (...a) => console.error(new Date().toISOString(), ...a);
const dbg = (...a) => DEBUG && log(...a);
const sha = (s) => createHash("sha256").update(s).digest("hex").slice(0, 16);

// session dirs hold system prompts (remote users' too): this user only
fs.mkdirSync(STATE_DIR, { recursive: true, mode: 0o700 });
fs.chmodSync(STATE_DIR, 0o700);
fs.mkdirSync(WORK_DIR, { recursive: true });

// ---------- OpenAI <-> Anthropic content ----------

function textOf(content) {
  if (content == null) return "";
  if (typeof content === "string") return content;
  return content
    .filter((p) => p.type === "text")
    .map((p) => p.text)
    .join("\n");
}

function parseDataUrl(url) {
  const m = /^data:([^;,]+);base64,(.*)$/s.exec(url);
  return m ? { mime: m[1], data: m[2] } : null;
}

function toAnthropicBlocks(content) {
  if (typeof content === "string") return [{ type: "text", text: content }];
  const blocks = [];
  for (const p of content ?? []) {
    if (p.type === "text") blocks.push({ type: "text", text: p.text });
    else if (p.type === "image_url") {
      const url = p.image_url?.url ?? "";
      const d = parseDataUrl(url);
      blocks.push(
        d
          ? { type: "image", source: { type: "base64", media_type: d.mime, data: d.data } }
          : { type: "image", source: { type: "url", url } },
      );
    }
  }
  return blocks.length ? blocks : [{ type: "text", text: "(empty)" }];
}

function toMcpContent(content) {
  if (typeof content === "string") return [{ type: "text", text: content || "(no output)" }];
  const out = [];
  for (const p of content ?? []) {
    if (p.type === "text") out.push({ type: "text", text: p.text });
    else if (p.type === "image_url") {
      const d = parseDataUrl(p.image_url?.url ?? "");
      if (d) out.push({ type: "image", data: d.data, mimeType: d.mime });
    }
  }
  return out.length ? out : [{ type: "text", text: "(no output)" }];
}

// Fingerprint of a message list, stable across pi's re-serialisation: roles,
// user and tool text, tool call ids. Assistant text is left out: after a
// model switch pi sends earlier assistant turns again with their thinking
// folded into the text, and the conversation is still the same one.
function fingerprint(messages) {
  return sha(
    JSON.stringify(
      messages.map((m) => [
        m.role,
        m.role === "assistant" ? "" : textOf(m.content).trim(),
        (m.tool_calls ?? []).map((t) => t.id),
        m.tool_call_id ?? null,
      ]),
    ),
  );
}

// History for a fresh process, as one text block. Claude has no way to take
// earlier assistant turns as real turns over stream-json input.
function renderTranscript(messages) {
  const parts = [];
  for (const m of messages) {
    if (m.role === "user") parts.push(`<user>\n${textOf(m.content) || "(image)"}\n</user>`);
    else if (m.role === "assistant") {
      const t = textOf(m.content).trim();
      if (t) parts.push(`<assistant>\n${t}\n</assistant>`);
      for (const tc of m.tool_calls ?? [])
        parts.push(`<tool_call name="${tc.function?.name}" id="${tc.id}">\n${tc.function?.arguments ?? "{}"}\n</tool_call>`);
    } else if (m.role === "tool") parts.push(`<tool_result id="${m.tool_call_id}">\n${textOf(m.content)}\n</tool_result>`);
  }
  return parts.join("\n\n");
}

// pi thinking level -> how Claude Code runs it. Thinking "off" is Claude
// Code's: no thinking parameter (adaptive models may still think a little),
// at the lowest effort. No level means Claude Code's default effort.
function thinkingFor(level) {
  if (level === "none" || level === "off") return { off: true, effort: "low" };
  if (level === "minimal") return { off: false, effort: "low" };
  return { off: false, effort: EFFORTS.has(level) ? level : null };
}

// ---------- sessions ----------

const sessions = new Map();

// The environment claude runs in: the sidecar's (that of whichever session
// started it) without that session's lets-code settings and keys. A session
// on a token gets no other Anthropic credential either: an ANTHROPIC_API_KEY
// or ANTHROPIC_AUTH_TOKEN would outrank the token, and the conversation would
// run on this machine's account instead of the token owner's.
function childEnv(token, thinkingOff) {
  const e = { ...env };
  for (const k of Object.keys(e))
    if (k.startsWith("LETS_CODE_") || k === "PROXY_API_KEY" || (token && (k.startsWith("ANTHROPIC_") || k === "CLAUDE_CODE_OAUTH_TOKEN"))) delete e[k];
  return {
    ...e,
    MCP_TOOL_TIMEOUT: String(24 * 3600 * 1000),
    MCP_TIMEOUT: "30000",
    CLAUDE_CODE_DISABLE_AUTO_MEMORY: "1",
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1",
    ...(token && { CLAUDE_CODE_OAUTH_TOKEN: token }),
    ...(thinkingOff && { CLAUDE_CODE_DISABLE_THINKING: "1" }),
  };
}

class Session {
  constructor({ model, thinking, system, tools, compat, token = null }) {
    this.id = randomUUID();
    this.model = model; // switched live with setModel, like Claude Code's /model
    this.token = token;
    this.tokenKey = token ? sha(token) : null;
    this.claimed = false; // a request is about to continue it
    this.compat = compat;
    this.tools = tools;
    this.state = "starting"; // busy | awaiting_tools | finishing | idle | dead
    this.sink = null;
    this.pendingCalls = new Map(); // toolUseId -> reply fn (MCP call waiting)
    this.earlyResults = new Map(); // toolUseId -> result that arrived first
    this.outstanding = new Set(); // tool_call ids handed to pi, not answered yet
    this.convLen = 0; // conversation the last request carried
    this.convFp = "";
    this.lastToolCallIds = [];
    this.lastUsed = Date.now();
    this.idleWaiters = [];
    this.controlWaiters = new Map(); // request_id -> resolve
    this.thinkingOff = thinking.off;
    this.effort = thinking.effort;

    const dir = path.join(STATE_DIR, "sessions", this.id);
    fs.mkdirSync(dir, { recursive: true });
    this.dir = dir;
    const sysFile = path.join(dir, "system.md");
    fs.writeFileSync(sysFile, `${system || "You are a helpful assistant."}\n\n${STYLE}\n\n${WHERE}`);
    const mcpFile = path.join(dir, "mcp.json");
    fs.writeFileSync(
      mcpFile,
      JSON.stringify({ mcpServers: { pi: { command: process.execPath, args: [BRIDGE, SOCK, this.id] } } }),
    );

    const args = [
      "-p",
      "--model", model,
      "--input-format", "stream-json",
      "--output-format", "stream-json",
      "--verbose",
      "--include-partial-messages",
      "--tools", "",
      "--mcp-config", mcpFile,
      "--strict-mcp-config",
      "--disable-slash-commands",
      "--setting-sources", "",
      "--system-prompt-file", sysFile,
      "--allowedTools", "mcp__pi",
      "--permission-prompts", "none",
      "--no-session-persistence",
      // print mode defaults to omitted thinking; summarized streams the text
      "--thinking-display", "summarized",
    ];
    if (this.effort) args.push("--effort", this.effort);
    this.proc = spawn(CLAUDE_BIN, args, { cwd: WORK_DIR, stdio: ["pipe", "pipe", "pipe"], env: childEnv(token, this.thinkingOff) });
    this.stderr = "";
    this.proc.stderr.on("data", (d) => {
      this.stderr = (this.stderr + d).slice(-4000);
    });
    this.proc.stdin.on("error", () => {});
    readline.createInterface({ input: this.proc.stdout }).on("line", (l) => {
      let ev;
      try {
        ev = JSON.parse(l);
      } catch {
        return dbg(this.id, "non-json:", l);
      }
      this.onEvent(ev);
    });
    this.proc.on("exit", (code, sig) => {
      log(`session ${this.id.slice(0, 8)} exited code=${code} sig=${sig}`);
      if (this.state !== "dead" && code) log(this.stderr.trim());
      this.die(`claude exited (code ${code}${sig ? ", " + sig : ""}) ${this.stderr.trim().slice(-500)}`);
    });
    sessions.set(this.id, this);
    log(`session ${this.id.slice(0, 8)} started model=${model} ${this.describeThinking()} tools=${tools.length}`);
  }

  describeThinking() {
    return `effort=${this.effort ?? "default"}${this.thinkingOff ? " thinking=off" : ""}`;
  }

  // whether this process can switch to `t` without a restart
  canTake(t) {
    return t.off === this.thinkingOff && (t.effort === this.effort || t.effort === null || LIVE_EFFORTS.has(t.effort));
  }

  // what /effort does in Claude Code: applies from the next API request on.
  // Resolves to whether claude took it (an older Claude Code may not).
  async setEffort(effort) {
    if (effort === this.effort) return true;
    log(`session ${this.id.slice(0, 8)} effort ${this.effort ?? "default"} -> ${effort ?? "default"}`);
    const ok = await this.control({ subtype: "apply_flag_settings", settings: { effortLevel: effort } });
    if (ok) this.effort = effort;
    return ok;
  }

  // what /model does in Claude Code: the conversation carries on, the next
  // API request goes to the other model (effort and thinking stay)
  async setModel(model) {
    if (model === this.model) return true;
    log(`session ${this.id.slice(0, 8)} model ${this.model} -> ${model}`);
    const ok = await this.control({ subtype: "set_model", model });
    if (ok) this.model = model;
    return ok;
  }

  // a stream-json control request; resolves to true on success, false on an
  // error answer or none within 5 s
  control(request) {
    const id = "ctl-" + randomUUID();
    this.proc.stdin.write(JSON.stringify({ type: "control_request", request_id: id, request }) + "\n");
    return new Promise((resolve) => {
      this.controlWaiters.set(id, resolve);
      setTimeout(() => this.controlWaiters.delete(id) && resolve(false), 5000);
    });
  }

  send(blocks) {
    this.state = "busy";
    this.proc.stdin.write(JSON.stringify({ type: "user", message: { role: "user", content: blocks } }) + "\n");
  }

  onEvent(ev) {
    dbg(this.id.slice(0, 8), ev.type, ev.event?.type ?? ev.subtype ?? "");
    if (ev.type === "stream_event") return this.onStream(ev.event);
    if (ev.type === "control_response") {
      const id = ev.response?.request_id;
      const ok = ev.response?.subtype === "success";
      if (!ok) log(`session ${this.id.slice(0, 8)} control ${id} failed: ${ev.response?.error}`);
      this.controlWaiters.get(id)?.(ok);
      this.controlWaiters.delete(id);
      return;
    }
    if (ev.type === "result") {
      if (ev.is_error && this.sink) {
        let msg = ev.result || ev.subtype || "claude error";
        // a token Anthropic rejects is most often one cut off when copied
        if (this.token && /OAuth access token is invalid/i.test(msg))
          msg += ` (CLAUDE_TOKEN is ${this.token.length} characters long: check it was copied whole, as a narrow terminal wraps it over lines, or make a new one with 'claude setup-token')`;
        this.sink.error(msg);
      }
      this.sink = null;
      this.state = "idle";
      this.lastUsed = Date.now();
      this.idleWaiters.splice(0).forEach((f) => f());
    }
  }

  onStream(e) {
    const sink = this.sink;
    switch (e.type) {
      case "message_start":
        this.blocks = new Map();
        this.usage = { ...(e.message?.usage ?? {}) };
        this.stopReason = null;
        break;
      case "content_block_start":
        if (e.content_block?.type === "tool_use")
          this.blocks.set(e.index, { id: e.content_block.id, name: e.content_block.name, json: "" });
        break;
      case "content_block_delta": {
        const d = e.delta;
        if (d.type === "text_delta") sink?.text(d.text);
        else if (d.type === "thinking_delta" && d.thinking) sink?.reasoning(d.thinking);
        else if (d.type === "input_json_delta") {
          const b = this.blocks.get(e.index);
          if (b) b.json += d.partial_json;
        }
        break;
      }
      case "content_block_stop": {
        const b = this.blocks.get(e.index);
        if (!b) break;
        const name = b.name.startsWith(TOOL_PREFIX) ? b.name.slice(TOOL_PREFIX.length) : b.name;
        this.outstanding.add(b.id);
        this.lastToolCallIds.push(b.id);
        sink?.toolCall(b.id, name, b.json || "{}");
        break;
      }
      case "message_delta":
        this.stopReason = e.delta?.stop_reason ?? this.stopReason;
        Object.assign(this.usage, e.usage ?? {});
        break;
      case "message_stop": {
        const usage = this.usage;
        this.lastUsed = Date.now();
        if (this.stopReason === "tool_use") {
          this.state = "awaiting_tools";
          this.sink = null;
          sink?.finish("tool_calls", usage);
        } else {
          // claude still sends a result event; the session is reusable after it
          this.state = "finishing";
          sink?.finish(this.stopReason === "max_tokens" ? "length" : "stop", usage);
          this.sink = null;
        }
        break;
      }
    }
  }

  // tool call arrived from the bridge
  onToolCall(toolUseId, reply) {
    if (this.earlyResults.has(toolUseId)) {
      reply(this.earlyResults.get(toolUseId));
      this.earlyResults.delete(toolUseId);
    } else this.pendingCalls.set(toolUseId, reply);
  }

  deliver(toolUseId, result) {
    this.outstanding.delete(toolUseId);
    const reply = this.pendingCalls.get(toolUseId);
    if (reply) {
      this.pendingCalls.delete(toolUseId);
      reply(result);
    } else this.earlyResults.set(toolUseId, result);
  }

  waitIdle() {
    if (this.state === "idle") return Promise.resolve();
    return new Promise((r) => this.idleWaiters.push(r));
  }

  die(reason) {
    if (this.state === "dead") return;
    this.state = "dead";
    this.sink?.error(reason);
    this.sink = null;
    for (const reply of this.pendingCalls.values()) reply({ content: [{ type: "text", text: "session closed" }], isError: true });
    this.pendingCalls.clear();
    this.idleWaiters.splice(0).forEach((f) => f());
    sessions.delete(this.id);
    try {
      this.proc.kill("SIGTERM");
    } catch {}
    fs.rmSync(this.dir, { recursive: true, force: true }); // sync: shutdown exits right after
  }
}

// least worth keeping first: idle before waiting for tools, then oldest
const victims = (list) =>
  list.filter((s) => s.state !== "busy" && !s.claimed).sort((a, b) => (a.state === "awaiting_tools") - (b.state === "awaiting_tools") || a.lastUsed - b.lastUsed);

// Makes room for a new process (of `tokenKey`'s, null for this machine's
// login); false when there is none to make.
function evict(tokenKey = null) {
  const now = Date.now();
  for (const s of sessions.values())
    if (s.state !== "busy" && !s.claimed && now - s.lastUsed > (s.state === "awaiting_tools" ? TOOL_WAIT_MS : IDLE_MS)) {
      log(`session ${s.id.slice(0, 8)} idle, closing`);
      s.die("idle timeout");
    }
  if (tokenKey) {
    const own = [...sessions.values()].filter((s) => s.tokenKey === tokenKey);
    if (own.length >= MAX_PER_TOKEN) {
      const v = victims(own)[0];
      if (!v) return false;
      v.die("evicted");
    }
  }
  while (sessions.size >= MAX_SESSIONS) {
    const v = victims([...sessions.values()])[0];
    if (!v) break;
    v.die("evicted");
  }
  return true;
}
setInterval(evict, 60_000).unref();

// ---------- bridge socket ----------

const bridges = net.createServer((conn) => {
    readline.createInterface({ input: conn }).on("line", (line) => {
      let m;
      try {
        m = JSON.parse(line);
      } catch {
        return dbg("bridge: not json:", line);
      }
      const s = sessions.get(m.session);
      const reply = (o) => conn.writable && conn.write(JSON.stringify({ ...o, rid: m.rid }) + "\n");
      if (!s) return reply({ tools: [], content: [{ type: "text", text: "unknown session" }], isError: true });
      if (m.type === "list")
        reply({
          tools: s.tools.map((t) => ({
            name: t.name,
            description: t.description ?? "",
            inputSchema: t.parameters ?? { type: "object", properties: {} },
          })),
        });
      else if (m.type === "call") {
        dbg(`tool call ${m.name} ${m.toolUseId}`);
        s.onToolCall(m.toolUseId, reply);
      }
    });
    conn.on("error", () => {});
  });

// ---------- response sinks ----------

function sseSink(res, model, includeUsage) {
  const id = "chatcmpl-" + randomUUID().replace(/-/g, "").slice(0, 24);
  const created = Math.floor(Date.now() / 1000);
  let toolIndex = 0;
  let done = false;
  res.writeHead(200, { "content-type": "text/event-stream", "cache-control": "no-cache", connection: "keep-alive" });
  const write = (o) => res.write(`data: ${JSON.stringify(o)}\n\n`);
  const chunk = (delta, finish = null) =>
    write({ id, object: "chat.completion.chunk", created, model, choices: [{ index: 0, delta, finish_reason: finish }] });
  chunk({ role: "assistant", content: "" });
  return {
    get done() {
      return done;
    },
    text: (t) => chunk({ content: t }),
    reasoning: (t) => chunk({ reasoning_content: t }),
    toolCall: (tid, name, args) =>
      chunk({ tool_calls: [{ index: toolIndex++, id: tid, type: "function", function: { name, arguments: args } }] }),
    finish(reason, usage) {
      if (done) return;
      done = true;
      chunk({}, reason);
      if (includeUsage) write({ id, object: "chat.completion.chunk", created, model, choices: [], usage: openaiUsage(usage) });
      res.end("data: [DONE]\n\n");
    },
    error(msg) {
      if (done) return;
      done = true;
      write({ error: { message: msg, type: "server_error" } });
      res.end("data: [DONE]\n\n");
    },
  };
}

function jsonSink(res, model) {
  let content = "";
  let reasoning = "";
  const toolCalls = [];
  let done = false;
  return {
    get done() {
      return done;
    },
    text: (t) => (content += t),
    reasoning: (t) => (reasoning += t),
    toolCall: (tid, name, args) => toolCalls.push({ id: tid, type: "function", function: { name, arguments: args } }),
    finish(reason, usage) {
      if (done) return;
      done = true;
      const message = { role: "assistant", content: content || null };
      if (reasoning) message.reasoning_content = reasoning;
      if (toolCalls.length) message.tool_calls = toolCalls;
      sendJson(res, 200, {
        id: "chatcmpl-" + randomUUID().replace(/-/g, "").slice(0, 24),
        object: "chat.completion",
        created: Math.floor(Date.now() / 1000),
        model,
        choices: [{ index: 0, message, finish_reason: reason }],
        usage: openaiUsage(usage),
      });
    },
    error(msg) {
      if (done) return;
      done = true;
      sendJson(res, 502, { error: { message: msg, type: "server_error" } });
    },
  };
}

function openaiUsage(u = {}) {
  const cached = u.cache_read_input_tokens ?? 0;
  const prompt = (u.input_tokens ?? 0) + cached + (u.cache_creation_input_tokens ?? 0);
  const completion = u.output_tokens ?? 0;
  return {
    prompt_tokens: prompt,
    completion_tokens: completion,
    total_tokens: prompt + completion,
    // pi prices cache writes apart from fresh input (Claude Code writes 1-hour entries)
    prompt_tokens_details: { cached_tokens: cached, cache_write_tokens: u.cache_creation_input_tokens ?? 0 },
  };
}

// a Claude Code OAuth token, as `claude setup-token` prints it
const CLAUDE_TOKEN_RE = /^sk-ant-oat\d+-[A-Za-z0-9_-]{20,}$/;

function sendJson(res, status, body) {
  res.writeHead(status, { "content-type": "application/json" });
  res.end(JSON.stringify(body));
}

// ---------- chat completions ----------

async function chat(req, res, body, token = null) {
  // a client gone before its answer: noticed even while this waits below
  let gone = false;
  res.on("close", () => {
    gone = !sink?.done;
    if (gone && session?.sink === sink) {
      log(`client went away, closing session ${session.id.slice(0, 8)}`);
      session.die("client disconnected");
    }
  });
  let session = null;
  let sink = null;
  const modelId = body.model || "claude-haiku";
  const model = MODELS[modelId] ?? modelId;
  const thinking = thinkingFor(body.reasoning_effort);
  const all = body.messages ?? [];
  const system = all
    .filter((m) => m.role === "system" || m.role === "developer")
    .map((m) => textOf(m.content))
    .join("\n\n");
  const conv = all.filter((m) => m.role !== "system" && m.role !== "developer");
  const tools = (body.tools ?? []).filter((t) => t.type === "function").map((t) => t.function);
  // a conversation only continues in a process of the same token and the same
  // pi session (lets-code's session tag), so two sessions that happen to share
  // a prompt, tools and user turns never swap processes
  const compat = sha(JSON.stringify([system, tools, token ? sha(token) : null, req.headers["x-lets-code-session"] ?? null]));
  if (!conv.length) return sendJson(res, 400, { error: { message: "no messages" } });

  // tail = what is new since the previous request: tool results and/or user turns
  let tailStart = conv.length;
  while (tailStart > 0 && conv[tailStart - 1].role !== "assistant") tailStart--;
  const tail = conv.slice(tailStart);
  const toolMsgs = tail.filter((m) => m.role === "tool");
  const userMsgs = tail.filter((m) => m.role === "user");
  const prevAssistant = conv[tailStart - 1];

  // find the live process this request continues
  if (prevAssistant) {
    const prefixLen = tailStart - 1;
    const prefixFp = fingerprint(conv.slice(0, prefixLen));
    for (const s of sessions.values()) {
      if (s.claimed || s.compat !== compat || s.convLen !== prefixLen || s.convFp !== prefixFp || !s.canTake(thinking)) continue;
      const ids = (prevAssistant.tool_calls ?? []).map((t) => t.id);
      if (JSON.stringify(ids) !== JSON.stringify(s.lastToolCallIds)) continue;
      if (toolMsgs.length ? s.state === "awaiting_tools" : ["idle", "finishing"].includes(s.state)) {
        session = s;
        session.claimed = true; // before any await: no second request takes it
        break;
      }
    }
  }

  const stream = !!body.stream;
  sink = stream ? sseSink(res, modelId, body.stream_options?.include_usage !== false) : jsonSink(res, modelId);

  if (session) {
    if (session.state === "finishing") await session.waitIdle();
    // a switch claude does not take (an older Claude Code): a fresh process
    // with the new settings instead
    if (session.state !== "dead" && !((await session.setModel(model)) && (await session.setEffort(thinking.effort)))) session.die("switch not taken");
    session.claimed = false;
    if (session.state === "dead") session = null;
  }
  if (gone) {
    session?.die("client disconnected");
    return;
  }

  if (session) {
    dbg(`continue ${session.id.slice(0, 8)} tools=${toolMsgs.length} users=${userMsgs.length}`);
    session.sink = sink;
    session.lastUsed = Date.now();
    session.convLen = conv.length;
    session.convFp = fingerprint(conv);
    session.lastToolCallIds = [];
    if (toolMsgs.length) {
      session.state = "busy";
      // images pi attaches after tool results go with the last result
      const extra = userMsgs.flatMap((m) => toMcpContent(m.content));
      toolMsgs.forEach((m, i) => {
        const content = toMcpContent(m.content);
        if (i === toolMsgs.length - 1) content.push(...extra);
        session.deliver(m.tool_call_id, { content });
      });
      for (const tid of [...session.outstanding])
        session.deliver(tid, { content: [{ type: "text", text: "(no result returned)" }], isError: true });
    } else {
      session.send(userMsgs.flatMap((m) => toAnthropicBlocks(m.content)));
    }
  } else {
    if (!evict(token ? sha(token) : null))
      return sink.error(`this token already has ${MAX_PER_TOKEN} conversations working; try again when one is done`);
    session = new Session({ model, thinking, system, tools, compat, token });
    session.sink = sink;
    session.convLen = conv.length;
    session.convFp = fingerprint(conv);
    const history = conv.slice(0, tailStart);
    let blocks;
    if (!history.length && userMsgs.length && !toolMsgs.length) {
      blocks = userMsgs.flatMap((m) => toAnthropicBlocks(m.content));
    } else {
      log(`session ${session.id.slice(0, 8)} replaying ${conv.length} messages as text`);
      const lastUser = tail.length && tail[tail.length - 1].role === "user" && !toolMsgs.length;
      const past = lastUser ? history : conv;
      blocks = [
        {
          type: "text",
          text:
            "This conversation started elsewhere. Earlier turns, including your own tool calls and their results, are below. " +
            "Use your tools for any further actions; never write tool calls as text.\n\n<conversation>\n" +
            renderTranscript(past) +
            "\n</conversation>" +
            (lastUser ? "\n\nThe user's new message follows." : "\n\nContinue from where the conversation ends."),
        },
        ...(lastUser ? userMsgs.flatMap((m) => toAnthropicBlocks(m.content)) : []),
      ];
    }
    session.send(blocks);
  }
}

