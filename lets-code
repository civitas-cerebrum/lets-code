	const values = [cfg.command, ...((cfg.args as string[]) ?? []), ...Object.values((cfg.env as object) ?? {}), ...Object.values((cfg.headers as object) ?? {})];
	if (values.some((v) => typeof v === "string" && v.startsWith("!"))) return "a value starts with '!'";
