}
export function bashPatternMatches(spec: string, command: string): boolean {
	let p = spec.trim().replace(/:\*$/, " *");
	const trailing = / \*$/.test(p);
	if (trailing) p = p.slice(0, -2);
	const re = "^" + p.split("*").map((x) => x.replace(/[.+?^${}()|[\]\\]/g, "\\$&")).join(".*") + (trailing ? "(?: .*)?" : "") + "$";
	return new RegExp(re, "s").test(command);
}
function globRe(g: string): RegExp {
	let s = "";
