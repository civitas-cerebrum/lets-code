# re-added for pi below.
if [ "${BACKEND}" = claude ]; then
    BASE_URL="${ENDPOINTS}"
    MODELS_JSON="$(claude_models_json "${MODEL_OVERRIDE:-${MODEL}}")"
elif [ -n "${URL_OVERRIDE}" ]; then
