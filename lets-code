export const HEADLINE_BUDGET = 150;   // tokens, the headlines together
export const LINE_BUDGET = 100;       // tokens, the always-on line
export const ARCHIVE_DAYS = 120;
export const GIST_MAX = 200;
export const OPEN_CAP = 6000;
