const unalias = (p: string) => { for (const [from, to] of aliases) if (p === from || p.startsWith(from + sep)) return to + p.slice(from.length); return p; };
export function projectDir(root: string): string {
	const h = createHash("sha1").update(root).digest("hex").slice(0, 8);
	const slug = (basename(root) || "root").replace(/[^A-Za-z0-9._-]+/g, "-").slice(0, 40);
	return join(memoryRoot(), "projects", `${slug}-${h}`);
}
// pointers: run:<id>, factory:<id>, session:<file> stay; a path (absolute,
// or relative to the project root) becomes absolute, its :line kept. A
// path under the runs or factory dirs is also indexed as that run.
export function normRef(ref: string, root: string): string {
	let r = oneLine(ref);
	if (/^(run|factory):\S+$/.test(r)) return r;
	if (r.startsWith("session:")) r = r.slice(8);
	const m = /^(.*?)(:\d+(?:-\d+)?)?$/.exec(r)!; let p = m[1], line = m[2] ?? "";
	if (p.startsWith("~/")) p = join(homedir(), p.slice(2));
	if (!isAbsolute(p) && root) p = resolve(root, p);
