                echo ""
                echo "~/.local/bin is not on your PATH, so 'lets-code' won't be found yet."
                if [ -n "${profile}" ]; then
                    printf "Add 'export PATH=\"\$HOME/.local/bin:\$PATH\"' to %s? [Y/n] " "${profile}"
                    read -r reply
                    case "${reply}" in n|N)
                        echo "Add it manually, then restart your shell." ;;
                    *)
                        printf '\n# added by lets-code setup\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "${profile}"
                        log "PATH line appended to ${profile} — restart your shell (or: source ${profile})" ;;
                    esac
                else
                    echo "Add this line to your shell profile, then restart your shell:"
                    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
                fi ;;
        esac
    fi
    # verify registration
    if command -v lets-code >/dev/null 2>&1; then
        log "command registered: $(command -v lets-code)"
    else
        log "command will be available in a fresh shell."
    fi

    # 8. live test
    echo ""
    printf "Probe the server now? [Y/n] "
    read -r reply
    case "${reply}" in
        n|N)
            echo "Setup done. Run: lets-code"
            offer_fresh_shell
            exit 0
            ;;
    esac
    TOKEN="${token}"; CA_FOUND=""; [ -f "${ca}" ] && CA_FOUND="${ca}"
    # a Claude Code token at the Token prompt: the endpoint is a lets-code
    # Claude proxy (see CLAUDE_TOKEN), so Claude's models are registered
    # instead of probing a server
    if is_claude_token "${token}"; then
        local proxy; proxy="$(normalize_endpoint "${endpoints%% *}")"
        case "$(claude_proxy_status "${proxy}" "${token}")" in
            200) log "Claude proxy: ${proxy} (Claude runs on your token)" ;;
            *)   log_error "no lets-code Claude proxy answered at ${proxy} — config saved; check the address ('lets-code claude-remote' on that machine)." ;;
        esac
        PROVIDER_ID="Anthropic"; CLAUDE_URL="${proxy}"; CLAUDE_TOKEN="${token}"
        pi_write_configs "${proxy}/v1" "${DEFAULT_API}" "claude-haiku" "${CLAUDE_CONTEXT}" "${CLAUDE_OUTPUT_CAP}" true true "${DEFAULT_THINKING}" ""
        log "registered with pi: Claude Haiku, Sonnet, Opus and Fable; /model switches, Ctrl+S makes one the default"
        [ "${feat_subagents}" = "true" ] && write_default_agents
        [ "${feat_mcp}" = "yes" ] && mcp_import yes
        echo ""
        echo "All set. Run:  lets-code"
        offer_fresh_shell
        exit 0
    fi
    local found=""
    for cand in ${endpoints}; do
        if probe "${cand%/}" > "${PROBE_OUT}"; then found="${cand%/}"; MODELS_JSON="$(cat "${PROBE_OUT}")"; break; fi
        echo "  ${cand}: ${PROBE_ERR}"
    done
    if [ -z "${found}" ]; then
        log_error "no endpoint reachable right now — config saved; check the server and try 'lets-code --verbose'."
        offer_fresh_shell
        exit 1
    fi
    local info
    info="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print(d.get("id","?"), "| context:", d.get("max_model_len","?"))' 2>/dev/null || echo "?")"
    log "reachable: ${found}"
    log "resident model: ${info}"

    # 9. register the resident model with pi (so it is selectable in the fresh shell)
    local reg reg_id reg_len
    reg="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print("%s|%s" % (d.get("id", ""), d.get("max_model_len", "")))' 2>/dev/null || true)"
    reg_id="${reg%%|*}"
    reg_len="${reg##*|}"
    if [ -z "${reg_id}" ]; then
        log "could not parse a model id from /v1/models — skipping pi registration (launch re-registers anyway)."
    else
        case "${reg_len}" in
            *[!0-9]*|"") reg_len="${DEFAULT_CONTEXT}" ;;
        esac
        setup_detect "${found}" "${reg_id}" "${reg_len}"
        local thinking_level="${SD_THINKING}" reasoning_reg="${SD_REASONING}" reg_cap="${SD_CAP}"
        local vision_reg="${SD_VISION_REG}" vision_pin="${SD_VISION_PIN}"
        setup_emit_config "${thinking_level}" "${vision_pin}"
        log "updated ${CONFIG_FILE} (thinking level: ${thinking_level}, vision: ${vision_pin:-auto})"
        EFFORT_MAP=""
        if [ "${reasoning_reg}" = true ]; then
            probe_template_effort "${found}" "${reg_id}"
            log "${EFFORT_NOTE}"
        fi
        # auto[:<level>] starts off (the agent guard raises it). Computed
        # outside the call: bash 3.2 (macOS) cannot parse a case pattern's
        # ')' inside "$(...)" and prints a syntax error for it.
        local startup_level
        case "${thinking_level}" in auto*) startup_level="off" ;; adaptive*) startup_level="medium" ;; *) startup_level="${thinking_level}" ;; esac
        LC_THINKING_RESET=1 pi_write_configs "${found}" "${DEFAULT_API}" "${reg_id}" "${reg_len}" "${reg_cap}" "${vision_reg}" "${reasoning_reg}" "${startup_level}" "${EFFORT_MAP}"
        log "registered with pi: ${reg_id} (context ${reg_len}, output cap ${reg_cap}, vision: ${vision_reg}, thinking: ${reasoning_reg}, level: ${thinking_level})"
    fi

    # 10. optional features chosen above
    if [ "${feat_sandbox}" = "true" ]; then
        pi_write_sandbox_extension
        if [ -n "${SB_NOTE}" ]; then log "sandbox: ${SB_NOTE}"; else log "sandbox: runtime ready (${LC_MOD_DIR})"; fi
    fi
    [ "${feat_subagents}" = "true" ] && write_default_agents
    [ "${feat_mcp}" = "yes" ] && mcp_import yes
    if [ "${feat_mandate}" = "true" ]; then
        log "mandate: modes plan/auto/ask/yolo on (start mode: ${feat_mode:-auto}); /mode and alt+m switch, 'lets-code mandate init' writes a project manifest"
    fi

    echo ""
    echo "All set. Run:  lets-code          (interactive session)"
    echo "          or:  lets-code -p \"hi\"  (one-shot print mode)"
    offer_fresh_shell
    exit 0
}

# The parent shell caches its command/completion tables at startup, so a
# just-installed command isn't tab-completable there. A child process cannot
# refresh the parent — but we can hand the user a fresh login shell instead.
offer_fresh_shell() {
    if [ -t 0 ]; then
        printf "Open a refreshed shell now so 'lets-code' + tab-completion work immediately? [Y/n] "
        read -r reply
        case "${reply}" in
            n|N) echo "OK — run 'rehash' (zsh) / 'hash -r' (bash), or open a new terminal." ;;
            *)   exec "${SHELL:-/bin/sh}" -l ;;
        esac
    else
        echo "Note: run 'rehash' (zsh) / 'hash -r' (bash) or open a new terminal for tab-completion."
    fi
}

# The /v1/models entry for a model: the pinned one when the server lists it
# (a gateway like OpenRouter lists hundreds), else the first. Prints
# <id>|<context>|<listed: 1|0>; context is vLLM's max_model_len or the
# context_length gateways report, empty when neither is there.
model_entry() {  # model_entry <pinned-model-or-empty>  (models JSON on stdin)
    python3 -c '
import json, sys
want = sys.argv[1]
data = json.load(sys.stdin).get("data") or [{}]
d = next((m for m in data if m.get("id") == want), None) if want else None
listed = "0" if want and d is None else "1"
d = d or data[0]
print("%s|%s|%s" % (d.get("id", ""), d.get("max_model_len") or d.get("context_length") or "", listed))' "$1" 2>/dev/null
}

# ------------------------------------------------------------------ claude
# The Claude backend's models and facts (see pi_write_claude_extension).
# Haiku 5.5, Sonnet 5.5, Opus 5.5 and Fable 5.1 all run with a 1M-token
# window in Claude Code (its modelUsage reports contextWindow 1000000 for the
# bare aliases; no [1m] suffix needed)
CLAUDE_CONTEXT=1000000
CLAUDE_OUTPUT_CAP=32000
CLAUDE_DEFAULT_MODELS="haiku sonnet opus fable"   # CLAUDE_MODELS when not set (server.mjs lists the same)
CLAUDE_DEFAULT_PORT=8795                          # LETS_CODE_CLAUDE_PORT when not set (index.ts, server.mjs too)
# a whole Claude Code OAuth token, as `claude setup-token` prints it (the
# proxy checks the same pattern, CLAUDE_TOKEN_RE in server.mjs)
is_claude_token() {  # is_claude_token <string>
    [[ "$1" =~ ^sk-ant-oat[0-9]+-[A-Za-z0-9_-]{20,}$ ]]
}
# what a Claude proxy's /health says to <token>: 200 (here and takes it),
# 401 (token refused), 502-504 (nothing running behind a reverse proxy),
# 000 (not reachable, or a certificate not trusted)
claude_proxy_status() {  # claude_proxy_status <base-url> <token>
    curl -s -o /dev/null -w '%{http_code}' --max-time 8 -H "Authorization: Bearer $2" "$1/health" 2>/dev/null || true
}
# pi's startup default (Ctrl+S in /model) from its settings.json: the
# provider or the model id, empty when none is saved
pi_saved_default() {  # pi_saved_default provider|model
    LC_SETTINGS="${PI_AGENT_DIR}/settings.json" python3 -c 'import json, os, sys
try: d = json.load(open(os.environ["LC_SETTINGS"]))
except Exception: d = {}
v = d.get("defaultProvider" if sys.argv[1] == "provider" else "defaultModel") if isinstance(d, dict) else None
if v == "lets-code-claude": v = "Anthropic"   # the Claude provider before its rename
print(v if isinstance(v, str) else "")' "$1" 2>/dev/null
}
# what the proxy's /v1/models says, without asking it: the CLAUDE_MODELS
# entries as ids (claude-<alias>, or a full model name as is), plus <model>
claude_models_json() {  # claude_models_json [<model>]
    LC_MODELS="${CLAUDE_MODELS:-${CLAUDE_DEFAULT_MODELS}}" LC_CONTEXT="${CLAUDE_CONTEXT}" python3 -c 'import json, os, re, sys
ids = [m if m.startswith("claude-") else "claude-" + m for m in re.split(r"[\s,]+", os.environ["LC_MODELS"]) if m]
if sys.argv[1] and sys.argv[1] not in ids: ids.append(sys.argv[1])
print(json.dumps({"data": [{"id": i, "owned_by": "anthropic", "max_model_len": int(os.environ["LC_CONTEXT"])} for i in ids]}))' "${1:-}"
}

# lets-code claude-remote: lets other machines (a phone, say) use this
# machine's Claude proxy: starts it if it is not running and prints what the
# other machine needs. The proxy listens on 127.0.0.1 only; another machine
# reaches it through a reverse proxy that sets X-Forwarded-For, and such a
# request must carry its user's own Claude Code token (claude setup-token):
# its conversations run on that token, so they use that user's subscription
# and never this machine's login. Sessions here need no token.
claude_remote() {
    local state port="${LETS_CODE_CLAUDE_PORT:-${CLAUDE_DEFAULT_PORT}}" err
    command -v claude >/dev/null 2>&1 || { log_error "this machine needs Claude Code (the claude command) to serve Claude."; exit 1; }
    command -v node >/dev/null 2>&1 || { log_error "node not found."; exit 1; }
    state="${LETS_CODE_CLAUDE_STATE:-${PI_AGENT_DIR}/lets-code-claude}"
    pi_write_claude_extension
    if ! err="$(PI_CODING_AGENT_DIR="${PI_AGENT_DIR}" LETS_CODE_CLAUDE_PORT="${port}" LETS_CODE_CLAUDE_MODELS="${CLAUDE_MODELS:-${CLAUDE_DEFAULT_MODELS}}" node -e '
        import(process.argv[1]).then((m) => m.ensureProxy()).then((e) => { if (e) { console.log(e); process.exit(1); } })' \
        "${LC_EXT_ROOT}/claude/index.ts" 2>&1)"; then
        log_error "${err}"; exit 1
    fi
    log "the Claude proxy is running on 127.0.0.1:${port} (log: ${state}/proxy.log); it keeps running until this machine restarts"
    echo ""
    echo "Other machines reach it through a reverse proxy in front of 127.0.0.1:${port} that sets"
    echo "X-Forwarded-For (nginx: proxy_pass, proxy_set_header X-Forwarded-For, proxy_buffering off,"
    echo "proxy_read_timeout 3600s); keep it to your own network or VPN."
    echo ""
    echo "On the other machine, in ~/.config/lets-code/config (BACKEND=\"claude\" there makes it the"
    echo "default) or in ~/.config/lets-code/presets/claude (for --claude):"
    echo ""
    echo "  CLAUDE_URL=\"https://<the reverse proxy's address>\""
    echo "  CLAUDE_TOKEN=\"<your Claude Code token>\""
    echo ""
    echo "The token: run 'claude setup-token' on any machine signed in to Claude Code with your"
    echo "subscription. It opens a sign-in page (or prints its address) and then prints a long-lived"
    echo "token, sk-ant-oat01-...; treat it like a password. Requests with it use that subscription."
    exit 0
}

# ------------------------------------------------------------------ presets
# A preset is another backend saved under a name: a file in PRESET_DIR with
# the config's backend keys (ENDPOINTS, TOKEN, MODEL, ...), sourced on top of
# the config when the launch names it (--<name> or --preset <name>). Guards
# and features still come from the config. Each preset registers with pi as
# its own provider (lets-code-<name>), so two sessions on different presets
# never rewrite each other's backend.
# Names that would shadow a lets-code option; pi's own options are checked
# against `pi --help` at setup.
PRESET_RESERVED="harness url model context output-cap api vision no-vision thinking-level insecure no-mem-guard no-git-guard no-agent-guard grounding no-grounding no-session-tag metrics no-metrics metrics-log mandate no-mandate subagents no-subagents experts no-experts core-memory no-core-memory sessions no-sessions claude-code no-claude-code sandbox no-sandbox verbose debug help preset"
preset_name_ok() {  # preset_name_ok <name> -> 0 when usable as --<name>
    case "$1" in ""|[!a-z0-9]*|*[!a-z0-9_-]*) return 1 ;; esac
    case " ${PRESET_RESERVED} " in *" $1 "*) return 1 ;; esac
    return 0
}
preset_names() {  # space-separated names of the saved presets
    local f out=""
    for f in "${PRESET_DIR}"/*; do
        [ -f "${f}" ] || continue
        preset_name_ok "$(basename "${f}")" && out="${out:+${out} }$(basename "${f}")"
    done
    printf '%s' "${out}"
}

list_presets() {
    local n
    if [ -z "$(preset_names)" ]; then
        echo "No presets yet. Add one with:  lets-code setup preset <name>"
        exit 0
    fi
    echo "Presets (${PRESET_DIR}):"
    for n in $(preset_names); do
        # shellcheck disable=SC1090
        ( ENDPOINTS=""; MODEL=""; . "${PRESET_DIR}/${n}"
          printf '  lets-code --%-16s %s%s\n' "${n}" "${ENDPOINTS}" "${MODEL:+   model: ${MODEL}}" )
    done
    exit 0
}

# Interactive onboarding for a preset: its name (asked when not given), then
# endpoints, token, CA, model and the same live check as the main setup,
# saved to PRESET_DIR/<name> (mode 600). Terminal: always exits.
run_preset_setup() {  # run_preset_setup [<name>]
    local name="$1" file endpoints token ca="" model reply why
    command -v curl    >/dev/null || { log_error "curl not found."; exit 1; }
    command -v python3 >/dev/null || { log_error "python3 not found."; exit 1; }
    echo ""
    echo "lets-code setup preset — save another backend (server, token, model)"
    echo "under a name, launched with  lets-code --<name>. Guards and optional"
    echo "features still come from ${CONFIG_FILE}."
    # the name: from the command line, else asked (again until usable)
    while :; do
        if [ -z "${name}" ]; then
            [ -n "$(preset_names)" ] && echo "Saved presets: $(preset_names)"
            printf "Preset name (e.g. openrouter, qwen): "
            read -r name || { echo ""; log_error "no preset name given."; exit 1; }
        fi
        why=""
        if [ -z "${name}" ]; then why="a name is needed"
        elif ! preset_name_ok "${name}"; then
            case " ${PRESET_RESERVED} " in
                *" ${name} "*) why="--${name} is already a lets-code option" ;;
                *)             why="names start with a-z or 0-9 and use only a-z, 0-9, - and _" ;;
            esac
        elif command -v pi >/dev/null 2>&1 && pi --help 2>/dev/null | grep -qE -- "(^|[[:space:],])--${name}([[:space:],=]|\$)"; then
            why="--${name} is a pi option, so lets-code passes it on to pi"
        fi
        [ -n "${why}" ] || break
        log_error "can't use '${name}': ${why} — pick another name."
        [ -t 0 ] || exit 1
        name=""
    done
    file="${PRESET_DIR}/${name}"
    SETUP_FILE="${file}"
    echo "Saving to ${file}; launch it with:  lets-code --${name}"
    if [ -f "${file}" ]; then
        printf "A preset named '%s' exists. Replace it? [y/N] " "${name}"
        read -r reply
        case "${reply}" in y|Y|yes|YES) ;; *) echo "Kept the existing preset."; exit 0 ;; esac
    fi

    # pi harness, as in the main onboarding (no-op once installed)
    ensure_pi || exit 1
    ensure_pi_tools
    echo ""
    echo "Server base URL(s), most-preferred first (no /v1 suffix), e.g."
    echo "  http://localhost:8000    https://openrouter.ai/api"
    printf "Endpoints [http://localhost:8000]: "
    read -r endpoints
    endpoints="$(normalize_endpoints "${endpoints:-http://localhost:8000}")"
    echo "Using: ${endpoints}"
    echo ""
    printf "API token [dummy-key]: "
    read -r token
    token="${token:-dummy-key}"
    case " ${endpoints}" in *" https://"*)
        echo ""
        printf "Path to a private root CA .pem (empty for a public certificate): "
        read -r ca
        if [ -n "${ca}" ] && [ ! -f "${ca}" ]; then log_error "no file at ${ca} — saving anyway; fix it in ${file} later."; fi ;;
    esac
    echo ""
    echo "Model id. Empty = whatever the server lists first (fine for a vLLM box"
    echo "serving one model); a gateway like OpenRouter needs one, e.g. qwen/qwen3.8-27b."
    printf "Model []: "
    read -r model

    preset_emit() {  # preset_emit <thinking-level> <vision-pin> <reasoning-pin>
        mkdir -p "${PRESET_DIR}"
        local tmp; tmp="$(mktemp "${PRESET_DIR}/.${name}.XXXXXX")"
        {
            echo "# lets-code preset '${name}' (shell syntax): launch with  lets-code --${name}"
            echo "# Applied on top of ${CONFIG_FILE}; any config key may be set here."
            echo "# Re-run 'lets-code setup preset ${name}' to regenerate."
            echo "ENDPOINTS=\"${endpoints}\""
            echo "TOKEN=\"${token}\""
            echo "CA_PATH=\"${ca}\""
            echo "MODEL=\"${model}\""
            echo ""
            echo "# Pins (empty = discovered or probed at launch):"
            echo "CONTEXT=\"\""
            echo "OUTPUT_CAP=\"\""
            echo "API=\"\""
            echo "VISION=\"${2:-}\""
            echo "REASONING=\"${3:-}\""
            echo "THINKING=\"${1:-}\""
        } > "${tmp}"
        chmod 600 "${tmp}"
        mv "${tmp}" "${file}"
    }
    preset_emit "" "" ""
    echo ""
    log "saved ${file}"

    echo ""
    printf "Probe the server now? [Y/n] "
    read -r reply
    case "${reply}" in
        n|N) echo "Preset saved. Run:  lets-code --${name}"; exit 0 ;;
    esac
    TOKEN="${token}"; CA_FOUND=""; [ -f "${ca}" ] && CA_FOUND="${ca}"
    local found="" cand entry reg_id reg_len
    for cand in ${endpoints}; do
        if probe "${cand%/}" > "${PROBE_OUT}"; then found="${cand%/}"; MODELS_JSON="$(cat "${PROBE_OUT}")"; break; fi
        echo "  ${cand}: ${PROBE_ERR}"
    done
    if [ -z "${found}" ]; then
        log_error "no endpoint reachable right now — preset saved; check the server and try 'lets-code --${name} --verbose'."
        exit 1
    fi
    log "reachable: ${found}"
    entry="$(printf '%s' "${MODELS_JSON}" | model_entry "${model}")" || entry=""
    reg_id="${model:-${entry%%|*}}"
    reg_len="${entry#*|}"; reg_len="${reg_len%%|*}"
    case "${entry##*|}" in
        0) log "note: ${found} does not list ${model}; check the id (launch will fail if the server does not serve it)."; reg_len="" ;;
    esac
    case "${reg_len}" in *[!0-9]*|"") reg_len="${DEFAULT_CONTEXT}" ;; esac
    if [ -z "${reg_id}" ]; then
        log "could not find a model id in /v1/models — the preset is saved without a live check."
        exit 0
    fi
    log "model: ${reg_id} | context: ${reg_len}"
    setup_detect "${found}" "${reg_id}" "${reg_len}"
    # a detected thinking model is pinned, so launch skips the probe request
    local reasoning_pin=""
    [ "${SD_REASONING}" = true ] && reasoning_pin="true"
    preset_emit "${SD_THINKING}" "${SD_VISION_PIN}" "${reasoning_pin}"
    log "updated ${file} (thinking level: ${SD_THINKING}, vision: ${SD_VISION_PIN:-auto})"
    echo ""
    echo "All set. Run:  lets-code --${name}"
    exit 0
}

# ------------------------------------------------------------------ update
# `lets-code update` replaces this lets-code with the latest release on npm;
# `update --snapshot` with the script at the latest commit on main.
#   * installed by npm (the script resolves into node_modules): npm installs
#     the release, or main from GitHub, over itself
#   * a copied script (setup's ~/.local/bin or /usr/local/bin, or a symlink
#     to one): the new script is downloaded (the release tarball from the npm
#     registry, checked against its sha512; or main's file pinned to the
#     commit it was read at), syntax-checked, stamped with its version and
#     moved over the old one, so a lets-code that is running keeps reading
#     the file it started from
#   * a git checkout: refused, `git pull` is the update there
# Extensions and themes are rewritten by the next launch.
# Endpoints are overridable for tests.
UPDATE_PACKAGE="@civitas-cerebrum/lets-code"
UPDATE_REPO="civitas-cerebrum/lets-code"
UPDATE_REGISTRY="${LETS_CODE_UPDATE_REGISTRY:-https://registry.npmjs.org}"
UPDATE_GITHUB_API="${LETS_CODE_UPDATE_GITHUB_API:-https://api.github.com}"
UPDATE_GITHUB_RAW="${LETS_CODE_UPDATE_GITHUB_RAW:-https://raw.githubusercontent.com}"

run_update() {  # run_update [--snapshot]
    local mode="release" self dir tmp new_version="" json sha url integrity
    case "${1:-}" in
        "") ;;
        --snapshot) mode="snapshot" ;;
        *) log_error "usage: lets-code update [--snapshot]"; exit 1 ;;
    esac
    command -v curl    >/dev/null || { log_error "curl not found."; exit 1; }
    command -v python3 >/dev/null || { log_error "python3 not found."; exit 1; }
    self="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")"
    dir="$(dirname "${self}")"

    if [ -e "${dir}/.git" ] && [ -f "${dir}/package.json" ]; then
        log_error "${self} is a git checkout — update it with: git -C ${dir} pull"
        exit 1
    fi

    case "${self}" in
        */node_modules/*)
            command -v npm >/dev/null || { log_error "lets-code was installed by npm, but npm is not on PATH."; exit 1; }
            local spec="${UPDATE_PACKAGE}@latest"
            [ "${mode}" = snapshot ] && spec="github:${UPDATE_REPO}"
            log "installed by npm — running: npm install -g ${spec}"
            npm install -g "${spec}" || { log_error "npm install failed — see the npm output above."; exit 1; }
            log "updated: $("${self}" --version 2>/dev/null || echo lets-code)"
            exit 0 ;;
    esac

    tmp="$(mktemp -d "${TMPDIR:-/tmp}/lets-code-update.XXXXXX")"
    trap 'rm -rf "${tmp}"' EXIT
    if [ "${mode}" = release ]; then
        if ! json="$(curl -sfL --max-time 30 "${UPDATE_REGISTRY}/$(printf '%s' "${UPDATE_PACKAGE}" | sed 's|/|%2f|')/latest")"; then
            log_error "no release of ${UPDATE_PACKAGE} found on ${UPDATE_REGISTRY} — get the latest main instead with: lets-code update --snapshot"
            exit 1
        fi
        new_version="$(printf '%s' "${json}" | python3 -c 'import json, sys; print(json.load(sys.stdin)["version"])')" \
            || { log_error "unexpected answer from ${UPDATE_REGISTRY}."; exit 1; }
        if [ "${new_version}" = "${LETS_CODE_VERSION}" ]; then
            log "already up to date (${LETS_CODE_VERSION})."
            exit 0
        fi
        url="$(printf '%s' "${json}" | python3 -c 'import json, sys; print(json.load(sys.stdin)["dist"]["tarball"])')"
        integrity="$(printf '%s' "${json}" | python3 -c 'import json, sys; print(json.load(sys.stdin)["dist"].get("integrity", ""))')"
        log "downloading ${UPDATE_PACKAGE} ${new_version} ..."
        curl -sfL --max-time 120 -o "${tmp}/pkg.tgz" "${url}" || { log_error "download failed: ${url}"; exit 1; }
        if [ -n "${integrity}" ]; then
            python3 - "${tmp}/pkg.tgz" "${integrity}" <<'PY' || { log_error "the downloaded package does not match the registry's checksum — not installed."; exit 1; }
import base64, hashlib, sys
algo, _, want = sys.argv[2].partition("-")
h = hashlib.new(algo)
h.update(open(sys.argv[1], "rb").read())
sys.exit(0 if base64.b64encode(h.digest()).decode() == want else 1)
PY
        fi
        tar -xzf "${tmp}/pkg.tgz" -C "${tmp}" package/lets-code || { log_error "the package has no lets-code script."; exit 1; }
        mv "${tmp}/package/lets-code" "${tmp}/new"
    else
        if ! json="$(curl -sfL --max-time 30 -H "Accept: application/vnd.github+json" "${UPDATE_GITHUB_API}/repos/${UPDATE_REPO}/commits/main")"; then
            log_error "could not read the latest commit on main from ${UPDATE_GITHUB_API}."
            exit 1
        fi
        sha="$(printf '%s' "${json}" | python3 -c 'import json, sys; print(json.load(sys.stdin)["sha"])')" \
            || { log_error "unexpected answer from ${UPDATE_GITHUB_API}."; exit 1; }
        new_version="main-$(printf '%.7s' "${sha}")"
        if [ "${new_version}" = "${LETS_CODE_VERSION}" ]; then
            log "already up to date (${LETS_CODE_VERSION})."
            exit 0
        fi
        log "downloading lets-code at main ($(printf '%.7s' "${sha}")) ..."
        curl -sfL --max-time 120 -o "${tmp}/new" "${UPDATE_GITHUB_RAW}/${UPDATE_REPO}/${sha}/lets-code" \
            || { log_error "download failed: ${UPDATE_GITHUB_RAW}/${UPDATE_REPO}/${sha}/lets-code"; exit 1; }
    fi

    # sanity: a bash script that parses, then stamped with the version it is
    head -n 1 "${tmp}/new" | grep -q '^#!.*bash' && bash -n "${tmp}/new" 2>/dev/null \
        || { log_error "the downloaded lets-code is not a valid script — not installed."; exit 1; }
    python3 - "${tmp}/new" "${new_version}" <<'PY'
import re, sys
p, v = sys.argv[1], sys.argv[2]
s = open(p).read()
s, n = re.subn(r'(?m)^LETS_CODE_VERSION=.*$', 'LETS_CODE_VERSION="%s"' % v, s, count=1)
if n == 0:  # a version from before the stamp existed
    s = s.replace("\nset -eu\n", '\nset -eu\nLETS_CODE_VERSION="%s"\n' % v, 1)
open(p, "w").write(s)
PY
    if cmp -s "${tmp}/new" "${self}"; then
        log "already up to date (${new_version})."
        exit 0
    fi

    # replace by rename in the same directory (sudo when it is not ours)
    if [ -w "${dir}" ]; then
        cp "${tmp}/new" "${dir}/.lets-code.update.$$" && chmod 755 "${dir}/.lets-code.update.$$" \
            && mv -f "${dir}/.lets-code.update.$$" "${self}" \
            || { rm -f "${dir}/.lets-code.update.$$"; log_error "could not replace ${self}."; exit 1; }
    elif command -v sudo >/dev/null 2>&1; then
        log "${dir} is not writable — using sudo to replace ${self}"
        sudo install -m 755 "${tmp}/new" "${dir}/.lets-code.update.$$" && sudo mv -f "${dir}/.lets-code.update.$$" "${self}" \
            || { log_error "could not replace ${self}."; exit 1; }
    else
        log_error "${dir} is not writable — re-run as a user who can write ${self}."
        exit 1
    fi
    log "updated ${self}: ${LETS_CODE_VERSION} -> ${new_version}"
    exit 0
}

