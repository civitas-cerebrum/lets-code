def private_host(url):
    """A reason when the URL's host is on a private network (loopback, LAN, link-local), else ''."""
    if os.environ.get("LC_RESEARCH_ALLOW_LOCAL") == "1":
        return ""
    host = urllib.parse.urlsplit(url).hostname or ""
    if not host or host == "localhost" or host.endswith(".local") or host.endswith(".internal"):
        return f"private host {host or '?'}"
    try:
