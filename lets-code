const fenceFree = (s: string) => s.replace(/```[\s\S]*?(```|$)/g, (m) => " ".repeat(m.length)).replace(/`[^`\n]*`/g, (m) => " ".repeat(m.length));
// !`cmd` (at a line start or after whitespace) and ```! blocks: run, output in place
export async function runShellInjections(text: string, run: (cmd: string) => Promise<{ code: number; out: string }>): Promise<{ text: string; error?: string }> {
	const jobs: { start: number; end: number; cmd: string }[] = [];
	for (const m of text.matchAll(/```!\s*\n([\s\S]*?)\n```/g)) jobs.push({ start: m.index!, end: m.index! + m[0].length, cmd: m[1] });
	for (const m of text.matchAll(/(^|[ \t\n])!`([^`\n]+)`/g)) { const s = m.index! + m[1].length; if (!jobs.some((j) => s >= j.start && s < j.end)) jobs.push({ start: s, end: m.index! + m[0].length, cmd: m[2] }); }
	jobs.sort((a, b) => a.start - b.start);
	let out = ""; let at = 0;
	for (const j of jobs) {
		const r = await run(j.cmd);
		const searchMiss = r.code === 1 && /^\s*(grep|rg|egrep|fgrep|diff|cmp|test|\[)\b/.test(j.cmd);
		if (r.code !== 0 && !searchMiss) return { text, error: `!\`${short(j.cmd, 60)}\` failed (exit ${r.code}): ${short(r.out.trim().split("\n").pop() ?? "", 120)}` };
		out += text.slice(at, j.start) + r.out.trimEnd(); at = j.end;
	}
	return { text: out + text.slice(at) };
}
// @path references to files: the text stays, the files follow it
export function fileReferences(text: string, cwd: string): string {
	const files: string[] = [];
	for (const m of fenceFree(text).matchAll(/(?:^|\s)@((?:\\ |[^\s])+)/g)) {
		const raw = m[1].replace(/\\ /g, " ");
		for (const cand of [raw, raw.replace(/[.,;:!?)\]'"]+$/, "")]) {
			const p = abs(cand, cwd);
			if (!files.includes(p) && readText(p) !== undefined) { files.push(p); break; }
		}
	}
	if (!files.length) return text;
	return `${text.trimEnd()}\n\n${files.map((f) => `<file path="${f}">\n${readText(f)}\n</file>`).join("\n\n")}`;
}

// ----------------------------------------------------------------- memory
export interface ContextFile { path: string; content: string }
function importsOf(content: string, file: string): string[] {
	const out: string[] = [];
	for (const m of fenceFree(content).matchAll(/(?:^|\s)@((?:\\ |[^\s])+)/g)) {
		const raw = expandHome(m[1].replace(/\\ /g, " "));
		for (const cand of [raw, raw.replace(/[.,;:!?)\]'"]+$/, "")]) {
			const p = isAbsolute(cand) ? cand : resolve(dirname(file), cand);
			if (readText(p) !== undefined) { out.push(p); break; }
		}
	}
	return out;
}
// The context files of the session as Claude Code would have them: pi's own
// list (kept, in order) with Claude's additions placed by directory, root
// first, each followed by what it imports (up to 4 hops, each file once).
// Imports leave the project and ~/.claude only in a trusted folder or from a
// user-level file.
export function claudeContextFiles(cwd: string, existing: ContextFile[], trusted: boolean): ContextFile[] {
	const seen = new Set(existing.map((f) => real(f.path)));
	const root = gitRoot(cwd) ?? resolve(cwd);
	const dirs = ancestors(cwd).reverse();
	const depthOf = (d: string) => { const i = dirs.indexOf(d); return i < 0 ? -1 : i; };
	type E = ContextFile & { rank: number; claude: boolean; user: boolean };
	const list: E[] = existing.map((f, i) => {
		const d = dirname(resolve(f.path));
		const rank = resolve(d) === resolve(agentDir()) ? -3 : depthOf(d) >= 0 ? depthOf(d) * 10 : 1e6 + i;
		return { ...f, rank, claude: /^CLAUDE(\.local)?\.md$/i.test(basename(f.path)), user: rank === -3 };
	});
	const add = (path: string, rank: number, user: boolean) => {
		if (seen.has(real(path))) return;
		const text = readText(path); if (text === undefined) return;
		seen.add(real(path)); list.push({ path, content: text, rank, claude: true, user });
	};
	const rules = (dir: string, rank: number, user: boolean) => {
		for (const f of mdFiles(dir)) { const t = readText(f); if (t !== undefined && parseFrontmatter(t).fm.paths === undefined) add(f, rank, user); }
	};
	if (userScope()) {
		add(join(claudeDir(), "CLAUDE.md"), -2, true);
		rules(join(claudeDir(), "rules"), -1, true);
	}
	dirs.forEach((d, i) => {
		const own = existing.find((f) => dirname(resolve(f.path)) === d);
		const cm = join(d, "CLAUDE.md");
		// pi took AGENTS.md here; Claude reads CLAUDE.md (an identical one is not added twice)
		if (own && !/^CLAUDE\.md$/i.test(basename(own.path)) && readText(cm) !== undefined && readText(cm)!.trim() !== own.content.trim()) add(cm, i * 10 + 1, false);
		if (!isUserClaude(d)) add(join(d, ".claude", "CLAUDE.md"), i * 10 + 2, false);
		add(join(d, "CLAUDE.local.md"), i * 10 + 3, false);
		if ((under(d, root) || d === root) && !isUserClaude(d)) rules(join(d, ".claude", "rules"), i * 10 + 4, false);
	});
	list.sort((a, b) => a.rank - b.rank);
	const out: ContextFile[] = [];
	const expand = (f: E | ContextFile, user: boolean, hops: number) => {
		if (hops >= 4) return;
		for (const p of importsOf(f.content, f.path)) {
			if (seen.has(real(p))) continue;
			if (!user && !trusted && !under(real(p), real(root)) && !under(real(p), real(claudeDir()))) continue;
			const text = readText(p); if (text === undefined) continue;
			seen.add(real(p)); const e = { path: p, content: text }; out.push(e); expand(e, user, hops + 1);
		}
	};
	for (const f of list) { out.push({ path: f.path, content: f.content }); if (f.claude) expand(f, f.user, 0); }
	return out;
}

// -------------------------------------------------------------------- MCP
export function expandVars(s: string, env: Record<string, string | undefined> = process.env): string {
	return s.replace(/\$\{([A-Za-z_]\w*)(?::-([^}]*))?\}/g, (all, n, d) => (env[n] !== undefined && env[n] !== "" ? env[n]! : d !== undefined ? d : all));
}
export interface McpEntry { name: string; scope: "user" | "local" | "project"; config: Record<string, unknown> }
export function toPiMcp(raw: any): Record<string, unknown> | string {
	if (!raw || typeof raw !== "object") return "not an object";
	const type = String(raw.type ?? (raw.url ? "http" : "stdio"));
	const x = (v: unknown) => expandVars(String(v));
	const map = (o: any) => (o && typeof o === "object" ? Object.fromEntries(Object.entries(o).map(([k, v]) => [k, x(v)])) : undefined);
	let cfg: Record<string, unknown>;
	if (type === "stdio") { if (!raw.command) return "no command"; cfg = drop({ type: "stdio", command: x(raw.command), args: Array.isArray(raw.args) ? raw.args.map(x) : undefined, env: map(raw.env) }); }
	else if (type === "http" || type === "streamable-http") { if (!raw.url) return "no url"; cfg = drop({ type: "http", url: x(raw.url), headers: map(raw.headers) }); }
	else return `transport ${type} is not supported by pi`;
	if (typeof raw.timeout === "number") cfg.timeout = raw.timeout > 1000 ? Math.ceil(raw.timeout / 1000) : raw.timeout;
