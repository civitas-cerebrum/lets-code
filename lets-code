# Sandbox: bash confined with @anthropic-ai/sandbox-runtime. The runtime is
# an npm package installed next to the extension (a directory extension);
# lets-code installs or updates it when missing. Never fatal: without the
# runtime the extension warns and bash runs as before.
SANDBOX_RUNTIME_VERSION="0.0.79"
SB_NOTE=""
pi_write_sandbox_extension() {
    local dir="${PI_AGENT_DIR}/extensions/lets-code-sandbox" f tmp have=""
    mkdir -p "${dir}"
    f="${dir}/index.ts"
    tmp="$(mktemp "${dir}/.index.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (sandbox); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with the sandbox on
// (LETS_CODE_SANDBOX_ON=1). Runs the model's bash commands (and your own
// `!` commands) inside @anthropic-ai/sandbox-runtime: bubblewrap plus a
// filtering proxy on Linux, Seatbelt on macOS. Writes are confined to the
// project and a few scratch paths, secrets are unreadable, and the network
// is an allowlist of domains. The runtime lives next to this file
// (lets-code installs it into this directory); without it, bash runs as
// before and the launch line says so.
//
// Config, merged in this order: built-in defaults, ~/.pi/agent/extensions/
// sandbox.json, <project>/.pi/sandbox.json (the same files pi's own sandbox
// example reads), then the active mandate role (network on/off and its
// `sandbox` block). Keys: enabled, network.allowedDomains/deniedDomains,
// filesystem.denyRead/allowWrite/denyWrite, ignoreViolations,
// enableWeakerNestedSandbox.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const ACTIVE = process.env.LETS_CODE_SANDBOX_ON === "1";
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const HERE = dirname(fileURLToPath(import.meta.url));

export interface SandboxConfig {
	enabled?: boolean;
	network?: { allowedDomains?: string[]; deniedDomains?: string[] };
	filesystem?: { denyRead?: string[]; allowWrite?: string[]; denyWrite?: string[] };
	ignoreViolations?: Record<string, string[]>;
	enableWeakerNestedSandbox?: boolean;
}
export const DEFAULTS: SandboxConfig = {
	enabled: true,
	network: {
		allowedDomains: ["npmjs.org", "*.npmjs.org", "registry.yarnpkg.com", "pypi.org", "*.pypi.org", "files.pythonhosted.org", "github.com", "*.github.com", "raw.githubusercontent.com", "objects.githubusercontent.com", "crates.io", "*.crates.io", "proxy.golang.org", "deb.debian.org", "*.ubuntu.com"],
		deniedDomains: [],
	},
	filesystem: {
		denyRead: ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/lets-code", "~/.pi/agent/auth.json", "~/.pi/agent/mcp-auth.json", "~/.netrc", "~/.docker/config.json", "~/.kube"],
		allowWrite: [".", "/tmp", "~/.cache", "~/.npm", "~/.pi/agent/sessions"],
		denyWrite: [".env", ".env.*", "*.pem", "*.key", ".git/hooks"],
	},
};
function readJson(p: string, warn: (m: string) => void): Partial<SandboxConfig> {
	if (!existsSync(p)) return {};
	try { return JSON.parse(readFileSync(p, "utf8")); } catch (e) { warn(`sandbox: could not parse ${p}: ${(e as Error).message}`); return {}; }
}
export function merge(base: SandboxConfig, over: Partial<SandboxConfig>): SandboxConfig {
	const out: SandboxConfig = { ...base };
	if (over.enabled !== undefined) out.enabled = over.enabled;
	if (over.network) out.network = { ...base.network, ...over.network };
	if (over.filesystem) out.filesystem = { ...base.filesystem, ...over.filesystem };
	if (over.ignoreViolations) out.ignoreViolations = over.ignoreViolations;
	if (over.enableWeakerNestedSandbox !== undefined) out.enableWeakerNestedSandbox = over.enableWeakerNestedSandbox;
	return out;
}
export interface Mode { role?: string; network?: "on" | "off"; bypass?: boolean; sandbox?: Partial<SandboxConfig> & { allowWrite?: string[]; denyRead?: string[]; denyWrite?: string[]; allowedDomains?: string[] } }
export function loadConfig(cwd: string, mode: Mode | undefined, warn: (m: string) => void): SandboxConfig {
	let c = merge(DEFAULTS, readJson(join(AGENT_DIR, "extensions", "sandbox.json"), warn));
	c = merge(c, readJson(join(cwd, ".pi", "sandbox.json"), warn));
	if (mode) {
		if (mode.network === "off") c = merge(c, { network: { allowedDomains: [], deniedDomains: c.network?.deniedDomains } });
		const s = mode.sandbox ?? {};
		const flat: Partial<SandboxConfig> = {};
		if (s.allowWrite || s.denyRead || s.denyWrite) flat.filesystem = { ...(s.allowWrite ? { allowWrite: s.allowWrite } : {}), ...(s.denyRead ? { denyRead: s.denyRead } : {}), ...(s.denyWrite ? { denyWrite: s.denyWrite } : {}) };
		if (s.allowedDomains) flat.network = { allowedDomains: s.allowedDomains };
		c = merge(merge(c, s), flat);
		if (mode.bypass) c.enabled = false;
	}
	return c;
}

export default function (pi: ExtensionAPI) {
	if (!ACTIVE) return;
	let runtime: any = null;          // the @anthropic-ai/sandbox-runtime module, loaded lazily
	let piMod: any = null;            // @earendil-works/pi-coding-agent (createBashTool)
	let enabled = false;
	let mode: Mode | undefined;
	let cwd = process.cwd();
	let localBash: any = null;
	const warn = (ctx: ExtensionContext | undefined, m: string) => { if (ctx?.hasUI) ctx.ui.notify(m, "warning"); else console.error(`[lets-code] ${m}`); };

	// Sandboxed operations for createBashTool: wrap, then run through bash.
	function sandboxedOps() {
		return {
			async exec(command: string, dir: string, { onData, signal, timeout }: any) {
				if (!existsSync(dir)) throw new Error(`Working directory does not exist: ${dir}`);
				const wrapped: string = await runtime.SandboxManager.wrapWithSandbox(command);
				return new Promise<{ exitCode: number | null }>((resolve, reject) => {
					const child = spawn("bash", ["-c", wrapped], { cwd: dir, detached: true, stdio: ["ignore", "pipe", "pipe"] });
					let timedOut = false; let th: NodeJS.Timeout | undefined;
					const killGroup = () => { if (child.pid) { try { process.kill(-child.pid, "SIGKILL"); } catch { child.kill("SIGKILL"); } } };
					if (timeout && timeout > 0) th = setTimeout(() => { timedOut = true; killGroup(); }, timeout * 1000);
					child.stdout?.on("data", onData); child.stderr?.on("data", onData);
					child.on("error", (e) => { if (th) clearTimeout(th); reject(e); });
					signal?.addEventListener("abort", killGroup, { once: true });
					child.on("close", (code) => { if (th) clearTimeout(th); signal?.removeEventListener("abort", killGroup); if (signal?.aborted) reject(new Error("aborted")); else if (timedOut) reject(new Error(`timeout:${timeout}`)); else resolve({ exitCode: code }); });
				});
			},
		};
	}

	// Inits are serialised: a mode change can arrive while a previous init is
	// still awaiting the runtime, and two SandboxManager.initialize calls must
	// not interleave.
	let chain: Promise<void> = Promise.resolve();
	function init(ctx: ExtensionContext): Promise<void> { chain = chain.then(() => initNow(ctx)).catch(() => {}); return chain; }
	async function initNow(ctx: ExtensionContext) {
		const cfg = loadConfig(cwd, mode, (m) => warn(ctx, m));
		if (runtime) { try { await runtime.SandboxManager.reset(); } catch { /* ok */ } }
		if (!cfg.enabled) { enabled = false; if (ctx?.hasUI) ctx.ui.setStatus("sandbox", mode?.bypass ? "sandbox: off (yolo)" : "sandbox: off"); return; }
		if (process.platform !== "linux" && process.platform !== "darwin") { enabled = false; warn(ctx, `sandbox: not supported on ${process.platform}`); return; }
		try {
			if (!runtime) runtime = await import(join(HERE, "node_modules", "@anthropic-ai", "sandbox-runtime", "dist", "index.js"));
			if (!piMod) piMod = await import("@earendil-works/pi-coding-agent");
			// The runtime needs ripgrep; lets-code fetches pi's copy into <agent-dir>/bin, which is not on PATH
			const rg = join(AGENT_DIR, "bin", "rg");
			const ripgrep = existsSync(rg) ? { command: rg } : undefined;
			await runtime.SandboxManager.initialize({ network: cfg.network, filesystem: cfg.filesystem, ignoreViolations: cfg.ignoreViolations, enableWeakerNestedSandbox: cfg.enableWeakerNestedSandbox, ...(ripgrep ? { ripgrep } : {}) });
			enabled = true;
			if (ctx?.hasUI) ctx.ui.setStatus("sandbox", `sandbox: ${cfg.network?.allowedDomains?.length ? `${cfg.network.allowedDomains.length} domains` : "no network"}`);
		} catch (e) {
			enabled = false;
			warn(ctx, `sandbox: not active — ${(e as Error).message}. Install: cd ${HERE} && npm install; Linux also needs bubblewrap and socat.`);
		}
	}

	// The mandate announces its mode from its own session_start, which can run
	// before ours: before a session exists, only remember the mode, and let
	// session_start initialise with it.
	let lastCtx: ExtensionContext | undefined;
	pi.events.on("lets-code:mode", (data: unknown) => { mode = data as Mode; if (lastCtx) void init(lastCtx); });

	// The bash tool is replaced with one whose operations run sandboxed when
	// the sandbox is up, and plain otherwise. Registered at load so the tool
	// exists before the first turn; the wrapping decision is made per call.
	void (async () => {
		try { piMod = await import("@earendil-works/pi-coding-agent"); localBash = piMod.createBashTool(cwd); } catch { return; }
		pi.registerTool({
			...localBash,
			label: "bash",
			async execute(id: string, params: any, signal: AbortSignal, onUpdate: any) {
				if (!enabled) return localBash.execute(id, params, signal, onUpdate);
				return piMod.createBashTool(cwd, { operations: sandboxedOps() }).execute(id, params, signal, onUpdate);
			},
		});
	})();
	pi.on("user_bash", () => (enabled ? { operations: sandboxedOps() } : undefined));
	pi.on("session_start", async (_e, ctx) => { cwd = ctx.cwd; lastCtx = ctx; await init(ctx); });
	pi.on("session_shutdown", async () => { if (runtime) { try { await runtime.SandboxManager.reset(); } catch { /* ok */ } } });
	pi.registerCommand("sandbox", {
		description: "Show the sandbox configuration in effect",
		handler: async (_a, ctx) => {
			const c = loadConfig(ctx.cwd, mode, (m) => warn(ctx, m));
			ctx.ui.notify([`sandbox: ${enabled ? "on" : "off"}${mode?.role ? ` (mode ${mode.role})` : ""}`, `network: ${c.network?.allowedDomains?.join(", ") || "(none)"}`, `deny read: ${c.filesystem?.denyRead?.join(", ")}`, `allow write: ${c.filesystem?.allowWrite?.join(", ")}`, `deny write: ${c.filesystem?.denyWrite?.join(", ")}`].join("\n"), "info");
		},
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
    printf '{\n  "name": "lets-code-sandbox",\n  "private": true,\n  "type": "module",\n  "dependencies": { "@anthropic-ai/sandbox-runtime": "%s" }\n}\n' "${SANDBOX_RUNTIME_VERSION}" > "${dir}/package.json"
    [ -f "${dir}/node_modules/@anthropic-ai/sandbox-runtime/package.json" ] && \
        have="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "${dir}/node_modules/@anthropic-ai/sandbox-runtime/package.json" 2>/dev/null)"
    if [ "${have}" != "${SANDBOX_RUNTIME_VERSION}" ]; then
        if command -v npm >/dev/null 2>&1; then
            log "sandbox: installing @anthropic-ai/sandbox-runtime ${SANDBOX_RUNTIME_VERSION} into ${dir} (first run only) ..."
            if ! (cd "${dir}" && npm install --ignore-scripts --no-audit --no-fund --loglevel=error >/dev/null 2>&1); then
                SB_NOTE="runtime install failed; run: cd ${dir} && npm install"
            fi
        else
            SB_NOTE="npm not found; run: cd ${dir} && npm install"
        fi
    fi
    if [ "$(uname)" = "Linux" ]; then
        local miss=""
        command -v bwrap >/dev/null 2>&1 || miss="bubblewrap"
        command -v socat >/dev/null 2>&1 || miss="${miss:+${miss} }socat"
        [ -z "${miss}" ] || SB_NOTE="${SB_NOTE:+${SB_NOTE}; }needs ${miss} (apt install ${miss})"
    fi
}

# MCP: pi has MCP built in (~/.pi/agent/mcp.json, .pi/mcp.json, `pi mcp add`).
# Setup can import servers from the standard files other clients keep.
mcp_import() {  # mcp_import <ask: yes|no>
    local ask="$1" found
    found="$(python3 - "${PI_AGENT_DIR}" <<'PY'
import json, os, sys
home = os.path.expanduser("~")
cands = [os.path.join(os.getcwd(), ".mcp.json"), os.path.join(home, ".config", "mcp", "mcp.json"),
         os.path.join(home, ".claude.json"), os.path.join(home, ".cursor", "mcp.json"), os.path.join(home, ".codeium", "windsurf", "mcp_config.json")]
target = os.path.join(sys.argv[1], "mcp.json")
try:
    have = (json.load(open(target)).get("mcpServers") or {}) if os.path.exists(target) else {}
except Exception:
    have = {}
new = {}
for c in cands:
    if not os.path.isfile(c):
        continue
    try:
        d = json.load(open(c))
    except Exception:
        continue
    for name, cfg in (d.get("mcpServers") or {}).items():
        if name in have or name in new or not isinstance(cfg, dict):
            continue
        if not (cfg.get("command") or cfg.get("url")):
            continue
        new[name] = {k: v for k, v in cfg.items() if k in ("command", "args", "env", "cwd", "url", "headers", "type", "timeout")}
        new[name]["_from"] = c
for name, cfg in new.items():
    print("%s\t%s" % (name, cfg.pop("_from")))
json.dump(new, open(os.path.join(sys.argv[1], ".mcp-import.json"), "w"))
PY
)" || return 0
    if [ -z "${found}" ]; then
        log "mcp: no MCP servers found in .mcp.json, ~/.config/mcp/mcp.json, ~/.claude.json or ~/.cursor/mcp.json — add one later with: pi mcp add <name> -- <command>"
        rm -f "${PI_AGENT_DIR}/.mcp-import.json"; return 0
    fi
    echo ""
    echo "MCP servers found that pi does not have yet:"
    printf '%s\n' "${found}" | awk -F'\t' '{ printf "  %-24s from %s\n", $1, $2 }'
    local reply="y"
    if [ "${ask}" = "yes" ]; then printf "Import them into %s/mcp.json? [Y/n] " "${PI_AGENT_DIR}"; read -r reply; fi
    case "${reply}" in
        n|N) rm -f "${PI_AGENT_DIR}/.mcp-import.json"; log "mcp: skipped" ;;
        *)
            python3 - "${PI_AGENT_DIR}" <<'PY'
import json, os, sys
d = sys.argv[1]; target = os.path.join(d, "mcp.json")
doc = json.load(open(target)) if os.path.exists(target) else {}
if not isinstance(doc, dict): doc = {}
servers = doc.get("mcpServers") if isinstance(doc.get("mcpServers"), dict) else {}
servers.update(json.load(open(os.path.join(d, ".mcp-import.json"))))
doc["mcpServers"] = servers
tmp = target + ".tmp"
with open(tmp, "w") as f: json.dump(doc, f, indent=2); f.write("\n")
os.chmod(tmp, 0o600); os.replace(tmp, target)
os.unlink(os.path.join(d, ".mcp-import.json"))
PY
            log "mcp: imported into ${PI_AGENT_DIR}/mcp.json (manage with /mcp in pi, or pi mcp list)" ;;
    esac
}

# `lets-code mandate init [--global]`: a starter manifest to edit.
mandate_init() {
    local target
    if [ "${1:-}" = "--global" ]; then
        target="${PI_AGENT_DIR}/mandate.json"; mkdir -p "${PI_AGENT_DIR}"
    else
        target="$(pwd)/.pi/mandate.json"; mkdir -p "$(pwd)/.pi"
    fi
    if [ -f "${target}" ]; then log_error "${target} exists — edit it instead."; exit 1; fi
    if [ "${1:-}" = "--global" ]; then
        cat > "${target}" <<'JSON'
{
  "default": "auto",
  "cycle": ["auto", "ask", "plan", "yolo"],
  "roles": {
    "ask": { "bash": { "privileged": "deny" } },
    "ci":  { "tools": ["read", "grep", "find", "ls", "bash"],
             "bash": { "*": "deny", "readonly": "allow", "build": "allow" },
             "dispatch": [], "network": "off" }
  }
}
JSON
    else
        cat > "${target}" <<'JSON'
{
  "roles": {
    "auto": { "protected": ["secrets/", "*.sqlite"] },
    "ask":  { "bash": { "privileged": "deny" } }
  }
}
JSON
    fi
    log "wrote ${target}"
    echo "Roles: tools (allowlist), read/write (path scopes), external (allow|ask|deny),"
    echo "bash: {group: allow|ask|deny} with groups readonly, git-write, build,"
    echo "package-install, privileged, destructive, network-exec or your own under"
    echo "\"groups\"; mcp (decision or server list); dispatch (agent names); network on|off;"
    echo "sandbox overrides; prompt; protected; bypass. A project file may only tighten."
    exit 0
}

# ---------------------------------------------------------------- onboarding
run_setup() {  # run_setup [full|granular]
    local profile="${1:-}"
    case "${profile}" in
        ""|full|granular) ;;
        *) log_error "unknown setup profile '${profile}' — use: lets-code setup | setup full | setup granular"; exit 1 ;;
    esac
    echo ""
    echo "lets-code setup — point the pi harness at your own LLM server."
    echo "Answers are saved to ${CONFIG_FILE} (edit it any time, or re-run setup)."
    echo ""

    # 1. prerequisites
    local missing=""
    command -v curl    >/dev/null || missing="${missing} curl"
    command -v python3 >/dev/null || missing="${missing} python3"
    if [ -n "${missing}" ]; then
        log_error "missing prerequisites:${missing} — install them and re-run setup."
        exit 1
    fi

    # 2. pi harness (confirm, then install), plus its file-search helpers
    ensure_pi || exit 1
    ensure_pi_tools

    # 3. endpoints
    echo ""
    echo "Enter your server base URL(s), most-preferred first (no /v1 suffix)."
    echo "No scheme? IPs, localhost and *.local get http://, domains get https://."
    echo "Examples:  http://localhost:8000    https://llm.my-lan.example"
    echo "You can list several separated by spaces — the first reachable one wins"
    echo "(useful if the same server has a localhost, LAN, and VPN address)."
    printf "Endpoints [http://localhost:8000]: "
    local endpoints
    read -r endpoints
    endpoints="$(normalize_endpoints "${endpoints:-http://localhost:8000}")"
    echo "Using: ${endpoints}"

    # 4. token
    echo ""
    echo "API token. vLLM without --api-key accepts anything; a placeholder is fine."
    printf "Token [dummy-key]: "
    local token
    read -r token
    token="${token:-dummy-key}"

    # 5. CA for private TLS
    local ca=""
    case " ${endpoints}" in *" https://"*|" https://"*)
        echo ""
        echo "You listed an https endpoint. If it uses a private CA (e.g. mkcert),"
        echo "pi (Node) needs the root CA file — Node ignores the OS trust store."
        printf "Path to root CA .pem (empty to skip): "
        read -r ca
        if [ -n "${ca}" ] && [ ! -f "${ca}" ]; then
            log_error "no file at ${ca} — saving anyway; fix it in ${CONFIG_FILE} later."
        fi ;;
    esac

    # 5b. optional features: off in the default setup, all on with 'full',
    #     one question each with 'granular'
    local feat_mandate="false" feat_mode="" feat_subagents="false" feat_sandbox="false" feat_mcp="no"
    case "${profile}" in
        full) feat_mandate="true"; feat_subagents="true"; feat_sandbox="true"; feat_mcp="yes" ;;
        granular)
            echo ""
            echo "Optional features (each can be changed later in ${CONFIG_FILE}):"
            printf "  Mandate modes — plan / auto / ask / yolo per session, roles per subagent? [y/N] "
            read -r reply; case "${reply}" in y|Y) feat_mandate="true"
                printf "  Start mode [auto] (plan|auto|ask|yolo): "; read -r feat_mode
                case "${feat_mode}" in ""|auto) feat_mode="" ;; plan|ask|yolo) ;; *) log_error "mode must be plan|auto|ask|yolo"; exit 1 ;; esac ;; esac
            printf "  Subagents — a 'subagent' tool that delegates to agent files? [y/N] "
            read -r reply; case "${reply}" in y|Y) feat_subagents="true" ;; esac
            printf "  Sandbox — bash confined with bubblewrap/Seatbelt via sandbox-runtime? [y/N] "
            read -r reply; case "${reply}" in y|Y) feat_sandbox="true" ;; esac
            printf "  MCP — import servers from .mcp.json and other clients' configs into pi? [y/N] "
            read -r reply; case "${reply}" in y|Y) feat_mcp="yes" ;; esac ;;
    esac

    # 6. save config (re-emitted after the live probe with the thinking level)
    setup_emit_config() {  # setup_emit_config <thinking-level> [vision-pin]
        {
            echo "# lets-code configuration (shell syntax). Re-run 'lets-code setup' to regenerate."
            echo "ENDPOINTS=\"${endpoints}\""
            echo "TOKEN=\"${token}\""
            echo "CA_PATH=\"${ca}\""
            echo ""
            echo "# Optional pins (empty = auto-discovered at launch):"
            echo "MODEL=\"\""
            echo "CONTEXT=\"\""
            echo "OUTPUT_CAP=\"\""
            echo "API=\"\""
            echo ""
            echo "# Image input pin (empty = auto-detected at launch with a tiny test"
            echo "# image; setup asks when that probe is inconclusive): true|false"
            echo "VISION=\"${2:-}\""
            echo ""
            echo "# Thinking support pin (empty = auto-detected at launch): true|false"
            echo "REASONING=\"\""
            echo "# Thinking level for new sessions (default: medium; setup"
            echo "# suggests one based on the detected context window):"
            echo "THINKING=\"${1}\""
            echo ""
            echo "# Memory guard (Linux): when the machine runs low on RAM, stop the"
            echo "# largest process this session started. MEM_GUARD=false disables it."
            echo "MEM_GUARD=\"true\""
            echo ""
            echo "# Git guard: in a git repo, work on a pi/* branch (created at launch);"
            echo "# edits off such a branch are blocked. GIT_GUARD=false disables it."
            echo "GIT_GUARD=\"true\""
            echo ""
            echo "# Agent guard: bash timeouts, cut-off reply recovery, a wrap-up hint"
            echo "# once tests pass, and the auto thinking level. AGENT_GUARD=false disables it."
            echo "AGENT_GUARD=\"true\""
            echo "# Optional features (off by default; 'lets-code setup full' turns them on)."
            echo "# MANDATE=true: modes plan/auto/ask/yolo and roles for subagents (MODE sets"
            echo "# the start mode, empty = auto). SUBAGENTS=true: the subagent tool."
            echo "# SANDBOX=true: bash confined with sandbox-runtime."
            echo "MANDATE=\"${feat_mandate}\""
            echo "MODE=\"${feat_mode}\""
            echo "SUBAGENTS=\"${feat_subagents}\""
            echo "SANDBOX=\"${feat_sandbox}\""
        } > "${CONFIG_FILE}"
        chmod 600 "${CONFIG_FILE}"
    }
    mkdir -p "${CONFIG_DIR}"
    setup_emit_config ""
    echo ""
    log "saved ${CONFIG_FILE}"

    # 7. register as a command: install + make executable + ensure PATH
    local self target
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    echo ""
    echo "Where should the 'lets-code' command be installed?"
    echo "  1) ${HOME}/.local/bin   (this user only — default)"
    echo "  2) /usr/local/bin       (system-wide, needs sudo)"
    printf "Choice [1]: "
    local reply
    read -r reply
    if [ "${reply:-1}" = "2" ]; then
        target="/usr/local/bin/lets-code"
        sudo cp "${self}" "${target}" && sudo chmod 755 "${target}"
        log "installed ${target}"
    else
        target="${HOME}/.local/bin/lets-code"
        mkdir -p "${HOME}/.local/bin"
        [ "${self}" = "${target}" ] || cp "${self}" "${target}"
        chmod +x "${target}"
        log "installed ${target}"
        # ensure ~/.local/bin is on PATH — offer to persist it in the shell profile
        case ":${PATH}:" in
            *":${HOME}/.local/bin:"*) ;;
            *)
                local profile
                case "$(basename "${SHELL:-/bin/sh}")" in
                    zsh)  profile="${HOME}/.zshrc" ;;
                    bash) if [ "$(uname)" = "Darwin" ]; then profile="${HOME}/.bash_profile"; else profile="${HOME}/.bashrc"; fi ;;
                    *)    profile="" ;;
                esac
                echo ""
                echo "~/.local/bin is not on your PATH, so 'lets-code' won't be found yet."
                if [ -n "${profile}" ]; then
                    printf "Add 'export PATH=\"\$HOME/.local/bin:\$PATH\"' to %s? [Y/n] " "${profile}"
                    read -r reply
                    case "${reply}" in n|N)
                        echo "Add it manually, then restart your shell." ;;
                    *)
                        printf '\n# added by lets-code setup\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "${profile}"
                        log "PATH line appended to ${profile} — restart your shell (or: source ${profile})" ;;
                    esac
                else
                    echo "Add this line to your shell profile, then restart your shell:"
                    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
                fi ;;
        esac
    fi
    # verify registration
    if command -v lets-code >/dev/null 2>&1; then
        log "command registered: $(command -v lets-code)"
    else
        log "command will be available in a fresh shell."
    fi

    # 8. live test
    echo ""
    printf "Probe the server now? [Y/n] "
    read -r reply
    case "${reply}" in
        n|N)
            echo "Setup done. Run: lets-code"
            offer_fresh_shell
            exit 0
            ;;
    esac
    TOKEN="${token}"; CA_FOUND=""; [ -f "${ca}" ] && CA_FOUND="${ca}"
    local found=""
    for cand in ${endpoints}; do
        if probe "${cand%/}" > "${PROBE_OUT}"; then found="${cand%/}"; MODELS_JSON="$(cat "${PROBE_OUT}")"; break; fi
        echo "  ${cand}: ${PROBE_ERR}"
    done
    if [ -z "${found}" ]; then
        log_error "no endpoint reachable right now — config saved; check the server and try 'lets-code --verbose'."
        offer_fresh_shell
        exit 1
    fi
    local info
    info="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print(d.get("id","?"), "| context:", d.get("max_model_len","?"))' 2>/dev/null || echo "?")"
    log "reachable: ${found}"
    log "resident model: ${info}"

    # 9. register the resident model with pi (so it is selectable in the fresh shell)
    local reg reg_id reg_len
    reg="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print("%s|%s" % (d.get("id", ""), d.get("max_model_len", "")))' 2>/dev/null || true)"
    reg_id="${reg%%|*}"
    reg_len="${reg##*|}"
    if [ -z "${reg_id}" ]; then
        log "could not parse a model id from /v1/models — skipping pi registration (launch re-registers anyway)."
    else
        case "${reg_len}" in
            *[!0-9]*|"") reg_len="${DEFAULT_CONTEXT}" ;;
        esac
        # probe thinking support (launch re-detects; this informs onboarding)
        probe_thinking "${found}" "${reg_id}"
        local suggested thinking_level reasoning_reg
        reasoning_reg="false"
        local reg_cap; reg_cap="$(default_output_cap "${reg_len}")"
        suggested="$(suggested_thinking_level "${reg_len}" "${reg_cap}")"
        case "${THINKING_DETECTED}" in
            true)
                reasoning_reg="true"
                echo ""
                log "thinking: detected on ${reg_id} (probe: minimal request with thinking forced on)"
                echo "Thinking level for new sessions: off|minimal|low|medium|high (xhigh|max), or"
                echo "adaptive[:<ceiling>] (medium, low once tests pass, bursts up) or auto[:<ceiling>] (off, bursts up)."
                echo "Suggested for ${reg_len} context / ${reg_cap} output cap: ${suggested}"
                printf "Thinking level [%s]: " "${suggested}"
                read -r thinking_level
                thinking_level="${thinking_level:-${suggested}}"
                case "${thinking_level}" in
                    off|minimal|low|medium|high|xhigh|max|adaptive|adaptive:low|adaptive:medium|adaptive:high|adaptive:xhigh|adaptive:max|auto|auto:minimal|auto:low|auto:medium|auto:high|auto:xhigh|auto:max) ;;
                    *) log_error "thinking level must be one of off|minimal|low|medium|high|xhigh|max|auto[:<level>] (got: ${thinking_level})"; exit 1 ;;
                esac ;;
            *)
                thinking_level="${suggested}"
                case "${THINKING_DETECTED}" in
                    false) log "thinking: not detected on ${reg_id} — registering without thinking" ;;
                    *)     log "thinking: probe inconclusive for ${reg_id} — registering without thinking (pin REASONING=true in ${CONFIG_FILE} if it supports it)" ;;
                esac
                log "startup thinking level saved as ${thinking_level} in case the resident model changes" ;;
        esac
        # probe image support (launch re-detects unless pinned); ask when inconclusive
        local vision_reg vision_pin
        vision_reg="false"; vision_pin=""
        if [ -n "${LETS_CODE_VISION:-}" ]; then
            vision_pin="${LETS_CODE_VISION}"; vision_reg="${LETS_CODE_VISION}"
            log "vision: pinned to ${vision_pin} by LETS_CODE_VISION"
        else
            probe_vision "${found}" "${reg_id}"
            case "${VISION_DETECTED}" in
                true)  vision_reg="true"
                       log "vision: detected on ${reg_id} (probe: a tiny red image, asked for its color) — images will be sent to it" ;;
                false) log "vision: not detected on ${reg_id} (the server rejected image input or the model could not see it) — registering as text-only" ;;
                *)
                    echo ""
                    log "vision: probe inconclusive for ${reg_id} (no usable answer about a test image)."
                    echo "Does ${reg_id} accept images (screenshots, diagrams)? If unsure, say n —"
                    echo "pi only sends images to models declared with image input."
                    printf "Model accepts images? [y/N] "
                    read -r reply
                    case "${reply}" in
                        y|Y|yes|YES) vision_pin="true"; vision_reg="true" ;;
                        *)           vision_pin="false" ;;
                    esac
                    log "vision pinned as VISION=${vision_pin} in ${CONFIG_FILE} (clear it to re-probe at launch)" ;;
            esac
        fi
        setup_emit_config "${thinking_level}" "${vision_pin}"
        log "updated ${CONFIG_FILE} (thinking level: ${thinking_level}, vision: ${vision_pin:-auto})"
        EFFORT_MAP=""
        if [ "${reasoning_reg}" = true ]; then
            probe_template_effort "${found}" "${reg_id}"
            log "${EFFORT_NOTE}"
        fi
        # auto[:<level>] starts off (the agent guard raises it). Computed
        # outside the call: bash 3.2 (macOS) cannot parse a case pattern's
        # ')' inside "$(...)" and prints a syntax error for it.
        local startup_level
        case "${thinking_level}" in auto*) startup_level="off" ;; adaptive*) startup_level="medium" ;; *) startup_level="${thinking_level}" ;; esac
        pi_write_configs "${found}" "${DEFAULT_API}" "${reg_id}" "${reg_len}" "${reg_cap}" "${vision_reg}" "${reasoning_reg}" "${startup_level}" "${EFFORT_MAP}"
        log "registered with pi: ${reg_id} (context ${reg_len}, output cap ${reg_cap}, vision: ${vision_reg}, thinking: ${reasoning_reg}, level: ${thinking_level})"
    fi

    # 10. optional features chosen above
    if [ "${feat_sandbox}" = "true" ]; then
        pi_write_sandbox_extension
        if [ -n "${SB_NOTE}" ]; then log "sandbox: ${SB_NOTE}"; else log "sandbox: runtime ready (${PI_AGENT_DIR}/extensions/lets-code-sandbox)"; fi
    fi
    [ "${feat_subagents}" = "true" ] && write_default_agents
    [ "${feat_mcp}" = "yes" ] && mcp_import yes
    if [ "${feat_mandate}" = "true" ]; then
        log "mandate: modes plan/auto/ask/yolo on (start mode: ${feat_mode:-auto}); /mode and alt+m switch, 'lets-code mandate init' writes a project manifest"
    fi

    echo ""
    echo "All set. Run:  lets-code          (interactive session)"
    echo "          or:  lets-code -p \"hi\"  (one-shot print mode)"
    offer_fresh_shell
    exit 0
}

# The parent shell caches its command/completion tables at startup, so a
# just-installed command isn't tab-completable there. A child process cannot
# refresh the parent — but we can hand the user a fresh login shell instead.
offer_fresh_shell() {
    if [ -t 0 ]; then
        printf "Open a refreshed shell now so 'lets-code' + tab-completion work immediately? [Y/n] "
        read -r reply
        case "${reply}" in
            n|N) echo "OK — run 'rehash' (zsh) / 'hash -r' (bash), or open a new terminal." ;;
            *)   exec "${SHELL:-/bin/sh}" -l ;;
        esac
    else
        echo "Note: run 'rehash' (zsh) / 'hash -r' (bash) or open a new terminal for tab-completion."
    fi
}

