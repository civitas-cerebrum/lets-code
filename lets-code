```ts
// tests/e2e/login.spec.ts
import { test, expect } from '../fixtures/base';

test.describe('Login', () => {
  test('valid login reaches dashboard', async ({ steps }) => {
    await steps.navigateTo('/login');
    await steps.isVisible('cookieAccept', 'LoginPage').click();
    await steps.fill('emailInput', 'LoginPage', 'user@test.com');
    await steps.fill('passwordInput', 'LoginPage', 'Secret123!');
    await steps.click('submitButton', 'LoginPage');
    await steps.verifyUrlContains('/dashboard');
    await steps.verifyTextContains('welcome', 'DashboardPage', 'user@test.com');
  });

  test('empty submit shows error', async ({ steps }) => {
    await steps.navigateTo('/login');
    await steps.click('submitButton', 'LoginPage');
    await steps.verifyPresence('errorBox', 'LoginPage');
    await steps.expect('errorBox', 'LoginPage').text.toMatch(/required/i);
    const url = steps.getUrl();
    expect(url).toContain('/login');
  });
});
```
