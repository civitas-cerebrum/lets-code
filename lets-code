		if (c) { cur = null; if (c[2].toUpperCase() !== "PASS") { cur = { id: c[1].toUpperCase(), severity: "blocker", where: "criterion", title: `${c[2].toUpperCase()}${c[3].replace(/^[\s:|-]+/, " ").trimEnd()}`, detail: "" }; failing.push(cur); } continue; }
		if (/^#{1,6}\s/.test(lines[i].trim())) { cur = null; continue; }
		if (cur && lines[i].trim()) cur.detail = cur.detail ? `${cur.detail}\n${lines[i].trim()}` : lines[i].trim();
	}
