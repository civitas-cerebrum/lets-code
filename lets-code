        FEAT_DESC="${FEAT_DESC:+${FEAT_DESC}  }sandbox: on${SB_NOTE:+ (${SB_NOTE})}" ;;
esac

log "connecting: ${BASE_URL}  harness: ${HARNESS}  model: ${MODEL}  context: ${CONTEXT}  output cap: ${OUTPUT_CAP}  vision: ${VISION}  thinking: ${THINKING_DESC}  api: ${API}  ${MG_DESC}  ${GG_DESC}  ${AG_DESC}${FEAT_DESC:+  ${FEAT_DESC}}"
if [ ${#PASSTHROUGH[@]} -eq 0 ]; then
    mem_guard_exec pi --provider "${PROVIDER_ID}" --model "${MODEL}"
else
    mem_guard_exec pi --provider "${PROVIDER_ID}" --model "${MODEL}" "${PASSTHROUGH[@]}"
fi
