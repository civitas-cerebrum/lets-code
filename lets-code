# The first interactive launch asks for a theme while settings.json has
# none: auto (pi's "system", the default: it follows the terminal's colors),
# lets-code, dark or light. The answer is saved, so it is asked once; a
# launch without a terminal (scripts, -p in a pipe) never asks and leaves
# pi's default. LETS_CODE_THEME_PROMPT=force asks without a terminal (tests).
pick_theme_once() {
    local settings="${PI_AGENT_DIR}/settings.json" reply theme
    if [ "${LETS_CODE_THEME_PROMPT:-}" != force ]; then
        [ -t 0 ] && [ -t 1 ] || return 0
    fi
    python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: d = {}
sys.exit(0 if isinstance(d, dict) and "theme" in d else 1)' "${settings}" && return 0
    echo ""
    echo "Theme for pi (change it any time in /settings):"
    echo "  1) auto       follows your terminal's colors  (default)"
    echo "  2) lets-code  pastel, the same in every terminal and over ssh"
    echo "  3) dark"
    echo "  4) light"
    printf "Theme [1]: "
    read -r reply || reply=""
    case "${reply}" in
        2|lets-code) theme="lets-code" ;;
        3|dark)      theme="dark" ;;
        4|light)     theme="light" ;;
        *)           theme="system" ;;
    esac
    python3 - "${settings}" "${theme}" <<'PY'
import json, os, sys, tempfile
path, theme = sys.argv[1], sys.argv[2]
try:
    doc = json.load(open(path))
except Exception:
    doc = {}
if not isinstance(doc, dict):
    doc = {}
doc["theme"] = theme
