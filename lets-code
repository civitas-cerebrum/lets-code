# The starters (scout, worker, general, reviewer) are written once, to an
# agent dir with no file of the user's; from then on they are the user's.
# An earlier version's starters are upgraded on launch, each only while the
# file is exactly as that version wrote it: reviewer.md moves to the
# reviewer role, worker.md gets the description that tells it from general
# and the stop-after-three-fixes lines.
# general came later: it joins an install that has one of the earlier
# starters and no general.md. The dir's .lets-code-starters lists it once
# written, so a general.md the user deletes stays deleted (remove "general"
# from that file to get it back).
STARTER_WORKER_V1='General-purpose agent with full tools for a delegated change; isolated context'
# worker.md as versions before the stop-after-three-fixes lines wrote it
starter_worker_v2() { starter_worker | sed '/^If the same failure survives three different fixes/,/^with what you tried\.$/d'; }
write_default_agents() {
    local dir="${PI_AGENT_DIR}/agents" e mark
    mark="${dir}/.lets-code-starters"
    if [ -f "${dir}/reviewer.md" ] && [ "$(cat "${dir}/reviewer.md")" = "$(starter_reviewer | sed 's/^role: reviewer$/role: readonly/')" ]; then
        starter_reviewer > "${dir}/reviewer.md"
        log "subagents: ${dir}/reviewer.md moved to the reviewer role (it can run the tests now)"
    fi
    if [ -f "${dir}/worker.md" ] && [ "$(cat "${dir}/worker.md")" = "$(starter_worker_v2 | sed "s|^description: .*|description: ${STARTER_WORKER_V1}|")" ]; then
        starter_worker > "${dir}/worker.md"
        log "subagents: ${dir}/worker.md: new description (changes; general takes research)"
    elif [ -f "${dir}/worker.md" ] && [ "$(cat "${dir}/worker.md")" = "$(starter_worker_v2)" ]; then
        starter_worker > "${dir}/worker.md"
        log "subagents: ${dir}/worker.md: stops and reports a failure that survives three fixes"
    fi
    if [ ! -e "${dir}/general.md" ] && ! grep -qx general "${mark}" 2>/dev/null \
        && { [ -f "${dir}/scout.md" ] || [ -f "${dir}/worker.md" ] || [ -f "${dir}/reviewer.md" ]; }; then
        starter_general > "${dir}/general.md"
        starter_mark "${mark}"
        log "subagents: starter agent general added to ${dir} (research, multi-step tasks); delete it to opt out"
    fi
    if [ -d "${dir}" ]; then
        for e in "${dir}"/* "${dir}"/.[!.]*; do
            [ -e "${e}" ] || continue
            [ -f "${e}" ] && grep -q '^# Written by lets-code' "${e}" 2>/dev/null && continue
            return 0
        done
    fi
    mkdir -p "${dir}"
    cat > "${dir}/scout.md" <<'MD'
---
name: scout
description: Fast read-only recon of a codebase; returns the files, line ranges and key code another agent needs
tools: read, grep, find, ls, bash
role: readonly
---
Investigate quickly and report for an agent that has not seen the files.
Use grep and find to locate code, read only the sections that matter, note
how the pieces connect.

Output:
## Files
`path` (lines a-b) — what is there
## Key code
The types, functions or config that matter, quoted.
## Start here
The one file to open first, and why.
MD
    starter_worker > "${dir}/worker.md"
    starter_general > "${dir}/general.md"
    starter_reviewer > "${dir}/reviewer.md"
    starter_mark "${mark}"
    log "subagents: starter agents written to ${dir} (scout, worker, general, reviewer)"
}
# the starters added after the first set, by name, one per line (only general so far)
starter_mark() {
    [ -f "$1" ] || echo '# Written by lets-code: starter agents added after the first set; a name here is not added again.' > "$1"
    grep -qx general "$1" || echo general >> "$1"
}

