			const title = [head, "", e.gist, ...(e.refs.length ? ["", "pointers:", ...e.refs.map((x) => cut(`  ${s.showRef(x)}`, w))] : [])].join("\n");
			const opens = e.refs.map((x) => cut(`open ${s.showRef(x)}`, w));
			const options = [...opens, "edit", "forget", "back"];
			const choice = await ctx.ui.select(title, options);
			if (choice === undefined || choice === "back") return;
			const i = options.indexOf(choice);
			if (i >= 0 && i < opens.length) { say(short((await open(e.refs[i], st.root)).split("\n").slice(0, 40).join("\n"), OPEN_CAP)); continue; }
			if (choice === "edit") {
				const edited = await ctx.ui.editor(`Core memory #${e.id}: the gist`, e.gist);
				const gist = edited === undefined ? "" : oneLine(edited);
				if (!gist || gist === e.gist) { say("unchanged"); continue; }
				if (looksSecret(gist)) { say("not changed: that looks like a token, key or password", "warning"); continue; }
				s.upsert({ id: e.id, gist, kind: e.kind, refs: e.refs, by: e.by }); s.save();
				say(`core memory: updated ${s.line(e)}`);
				continue;
			}
			if (choice === "forget") {
				if (!(await ctx.ui.confirm(`Forget #${e.id}?`, e.gist))) continue;
				s.forget(e.id); s.save(); say(`forgot ${s.line(e)}`);
				return;
			}
		}
	}

	const USAGE = "Usage: /memories [words] | edit [global] | forget <id> | archive [days] | global [words]";
	const command = {
		description: "Core memory: /memories [words] | edit [global] | forget <id> | archive [days] | global [words]",
		getArgumentCompletions: (prefix: string) => (prefix.includes(" ") ? null : ["edit", "forget", "archive", "global"].filter((x) => x.startsWith(prefix) && x !== prefix).map((x) => ({ value: x, label: x }))),
		handler: async (args: string, ctx: any) => {
			const say = (m: string, type = "info") => (ctx.hasUI ? ctx.ui.notify(m, type) : console.log(m));
			const [verb = "", ...rest] = (args ?? "").trim().split(/\s+/).filter(Boolean);
			cwd = ctx.cwd || cwd; const st = current(); const p = st.project!;
			try {
				if (verb === "edit") {
					const s = rest[0] === "global" ? st.global : p;
					if (!ctx.hasUI) return say("the editor needs a UI; the file is " + s.md, "warning");
					const edited = await ctx.ui.editor(`Core memory: ${s.label()}`, s.render());
					if (edited === undefined) return say("unchanged");
					const r = s.applyMarkdown(edited); s.save();
					return say(`core memory: ${r.kept} kept, ${r.added} added, ${r.removed} removed`);
				}
				if (verb === "forget") {
					const id = (rest[0] ?? "").replace(/^#/, ""); if (!id) return say(USAGE, "warning");
					for (const s of [p, st.global]) { const e = s.forget(id); if (e) { s.save(); return say(`forgot ${s.line(e)}`); } }
					return say(`no entry #${id}`, "warning");
				}
				if (verb === "archive") {
					const days = rest[0] === undefined ? ARCHIVE_DAYS : Number(rest[0]);
					if (!Number.isFinite(days) || days < 0) return say(USAGE, "warning");
					const n = p.archive(days); if (n) p.save();
					return say(n ? `archived ${n} work/pointer ${n === 1 ? "entry" : "entries"} older than ${days} days to ${p.archiveFile}` : `nothing older than ${days} days to archive`);
				}
				// the list: every other word filters; "show" is the list's old name, "global" the global store alone
				const scope = verb === "global" ? "global" : "all";
				const q = (verb === "global" || verb === "show" ? rest : [verb, ...rest]).join(" ");
				if (!ctx.hasUI) return say(textList(st, scope === "global" ? st.global : p, q));
				return list(ctx, st, q, scope, say);
			} catch (e) { say(`memory: ${e instanceof Error ? e.message : String(e)}`, "error"); }
		},
	};
	pi.registerCommand("memories", command);
	pi.registerCommand("memory", { handler: command.handler });   // the old name, for one release
}
