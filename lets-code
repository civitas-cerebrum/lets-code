	toolCall(name: string, input: unknown): void {
		if (name === "bash") {
			this.lastCommand = String((input as any)?.command ?? "");
			this.pendingExec = EXEC_RE.test(this.lastCommand);
		}
		const sig = name + ":" + JSON.stringify(input);
		// identical call with no file change since: the model is going in circles
		if (this.recentCalls.some((c) => c.sig === sig && c.mutations === this.mutations)) this.repeats++;
		this.recentCalls = [...this.recentCalls, { sig, mutations: this.mutations }].slice(-4);
	}
