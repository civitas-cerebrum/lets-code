	get md(): string { return this.file.replace(/\.jsonl$/, ".md"); }
	get archiveFile(): string { return join(this.dir, "archive.jsonl"); }
	label(): string { return this.scope === "global" ? "global" : this.root; }
	load(now = Date.now()): this {
		this.entries = []; this.bad = 0;
		const read = readLines(this.file); this.entries = read.entries; this.bad = read.bad;
		try { this.archived = readLines(this.archiveFile).entries.length; } catch { this.archived = 0; }
