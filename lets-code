    lc_ext_module sessions; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.sessions.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (sessions); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with sessions on
// (LETS_CODE_SESSIONS_ON=1). A local channel between the lets-code sessions
// on this machine: two terminals in one repo, an orchestrator and its
// subagents. No network: files under LETS_CODE_SESSIONS_DIR (default
// <agent dir>/lets-code-sessions, mode 0700), which a subagent inherits even
// when it runs with an agent dir of its own.
//
// Registry: <dir>/<pid>.json for each live session (pid, pi session id,
// session tag, name, cwd, repo, mode, depth, parent pid, agent, busy),
// written at session start and at each run's start and end, removed when
// the session quits or its process exits. An entry whose process is gone is
// pruned by whoever lists. A subagent (LETS_CODE_SUBAGENT_DEPTH > 0) is a pi
// the subagent tool spawned directly, so the pi that
// started it is its parent: that pid is its parentPid (LETS_CODE_PARENT_PID, set by the
// subagent tool; the parent process without it). Print and json runs (-p) do not
// register; they can still send.
//
// The directory must be this user's and not group or world writable;
// otherwise the session runs unlisted (one warning). Trust model: every
// file is the same user's, the sender's name is its own claim, and a
// message is data: its text is cleaned of control characters and escapes,
// capped, and shown between per-message delimiters, never as the user.
//
// Inbox: <dir>/<pid>/inbox/<ts>-<rand>.json, written whole (tmp + rename,
// 0600). The session polls it every second (an unref'd timer) and shows
// each message in its conversation as a lets-code-message. No unattended
// turn by default: an idle main session shows it (and a notice) and the
// user decides; LETS_CODE_SESSIONS_AUTOTURN=1 lets it start a turn. A busy
// main session takes it as a follow-up after the current turn, a busy
// subagent as a steer inside its task (so the task's answer stays its last
// text), an idle subagent without a turn (its next task reads it). A
// message carries hops: one sent from a turn a message caused has hops + 1,
// and a message with hops >= 1 never causes a turn, so two sessions cannot
// answer each other forever. The exception is a main session's own
// subagent (its registry entry's parent is this pid), whose message to its
// orchestrator is like its report: it starts a turn when the main session is
// idle and is a follow-up when it is busy, up to CHILD_HOPS hops (the
// orchestrator asks, the subagent answers, it asks again: each answer is
// one hop further). Then <id>.ack {seenAt} is written for the
// sender and the message removed; an id once shown is never shown again.
// While the main session shows a subagent's own session (/subagents), its
// messages wait. An inbox left by an earlier process with the same pid is
// cleared at the first start.
//
// The message tool sends: to is a pid, a pi session id (or its first 6+
// characters), a session tag, a name (the session's /name, or a subagent's
// agent name), "parent", "children" or "repo" (every other session whose
// git repository is this one's, worktrees included). It waits up to `wait`
// seconds for the acks and reports each recipient: delivered, queued (not
// seen yet; it is shown when that session next polls) or undeliverable.
// action list and /sessions list the live sessions. The shell side is
// `lets-code sessions` and `lets-code message <to> -- <text>`.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { execFileSync } from "node:child_process";
import { randomBytes } from "node:crypto";
import { mkdirSync, readdirSync, readFileSync, realpathSync, renameSync, rmSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, join, resolve, sep } from "node:path";
import { Type } from "typebox";

export const ACTIVE = process.env.LETS_CODE_SESSIONS_ON === "1";
export const DEPTH = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
export const CUSTOM_TYPE = "lets-code-message";
export const POLL_MS = Math.max(50, Number(process.env.LETS_CODE_SESSIONS_POLL_MS ?? "") || 1000);
export const WAIT_DEFAULT = 10;
export const WAIT_MAX = 60;
export const TEXT_MAX = 8000;                 // characters of a message's text
export const FILE_MAX = TEXT_MAX * 4 + 4096;  // bytes of a message file read at all
export const STALE_MS = 10 * 60_000;          // an ack nobody collected, a tmp file left behind
export const agentDir = () => process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
export const sessionsDir = () => process.env.LETS_CODE_SESSIONS_DIR || join(agentDir(), "lets-code-sessions");
export const entryFile = (pid: number) => join(sessionsDir(), `${pid}.json`);
export const inboxDir = (pid: number) => join(sessionsDir(), String(pid), "inbox");
