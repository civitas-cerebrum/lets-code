		let dirty = false;
		try { if (existsSync(this.md) && statSync(this.md).mtimeMs > statSync(this.file).mtimeMs + 1000) { this.applyMarkdown(readFileSync(this.md, "utf8"), now); dirty = true; } } catch { /* unreadable: the store stands */ }
