const USAGE = "Usage: /factory start <ticket.md> [how-to-run] | resume <id> | list | status [id]";
export default function (pi: ExtensionAPI) {
	if (!active()) return;   // a command only: nothing in the model's context
	pi.registerCommand("factory", {
		description: "Software factory: /factory start <ticket.md> [how-to-run] | resume <id> | list | status [id]",
		getArgumentCompletions: (prefix: string) => {
			const w = prefix.split(/\s+/);
			if (w.length <= 1) return ["start", "resume", "list", "status"].filter((x) => x.startsWith(w[0] ?? "") && x !== w[0]).map((x) => ({ value: x, label: x }));
			if (w[0] === "resume" || w[0] === "status") return listRuns().filter((L) => w[0] === "status" || L.status === "waiting" || L.status === "running" || L.status === "stopped").map((L) => L.id).filter((id) => id.startsWith(w[1] ?? "") && id !== w[1]).slice(0, 20).map((id) => ({ value: `${w[0]} ${id}`, label: id }));
			return null;
		},
		handler: async (args: string, ctx: any) => {
			const say = (m: string, type = "info") => (ctx.hasUI ? ctx.ui.notify(m, type) : console.log(m));
			const [verb = "list", arg = "", ...rest] = (args ?? "").trim().split(/\s+/).filter(Boolean);
			const progress = (l: string) => { if (ctx.hasUI) ctx.ui.setStatus("factory", short(l, 80)); };
			try {
				if (verb === "list") {
					const runs = listRuns();
					return say(runs.length ? runs.slice(0, 20).map((L) => `${L.id}  ${summary(L).split("\n")[0].replace(/^factory run \S+: /, "")}`).join("\n") : "No factory runs. /factory start <ticket.md> [how-to-run] starts one.");
				}
				if (verb === "status") {
					const L = arg ? loadLedger(arg) : listRuns()[0];
					return say(L ? report(L) : arg ? `No factory run ${arg}.` : "No factory runs.", L ? "info" : "warning");
				}
				if (verb !== "start" && verb !== "run" && verb !== "resume") return say(USAGE, "warning");
				if (!arg) return say(USAGE, "warning");
				const file = resolve(ctx.cwd, arg);
				if (verb !== "resume" && !existsSync(file)) return say(`No ticket file ${arg}.`, "warning");
				const why = await ensureExperts(ctx); if (why) return say(why, "warning");
				orchestrate(ctx, verb === "resume" ? "factory run resumed" : "factory run");
				const deps = await sessionDeps(ctx, ctx.signal, progress);
				// the session counts as working while the run goes on, so switching
				// into a stage shows it in place instead of tearing this session down
				const vs = await busyView(); const was = vs?.mainBusy;
				if (vs) vs.mainBusy = true;
				let L: Ledger;
				try {
					L = verb === "resume" ? await resumeRun(arg, deps) : await startRun({ ticket: readFileSync(file, "utf8"), repo: ctx.cwd, howToRun: rest.join(" ") }, deps);
				} finally { if (vs && !was) vs.mainBusy = false; }
				if (ctx.hasUI) ctx.ui.setStatus("factory", undefined);
				say(report(L));
			} catch (e) { if (ctx.hasUI) ctx.ui.setStatus("factory", undefined); say(`factory: ${e instanceof Error ? e.message : String(e)}`, "error"); }
		},
	});
}
