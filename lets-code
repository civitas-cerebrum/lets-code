# intent, prepare (and, once the user confirms, send) a message, and where a
# shell-uid channel exists (Shizuku's rish, or adb to the phone itself) read
# the screen and tap and type. Its knowledge: the agent file, helpers in
# termux/bin (probe: which tiers this phone has, read-only; ui: the screen
# as text, tap, type; uitext.py: the uiautomator XML parser; setup: tier 1,
# below) and references in termux/ref, read on demand (tiers and setup
# steps, every Termux:API command, screen, messaging).
# Written on every launch on Termux with experts on, reached through the
# expert tool, dormant until the user enables it. A user's own agent of that
# name is left alone (and no helpers are written for it).
# Its setup (bin/setup, gated by termux/runtime/.installed) runs once the
# user enables it: pkg install termux-api when the commands are missing, and
# a read-only check for the Termux:API app, which pkg cannot install (the
# note says where to get it). Both already present at launch: marked done
# without a word, so the enable dialog names no setup.
write_termux_agent() {
    local af="${PI_AGENT_DIR}/agents/termux-device.md" t="${PI_AGENT_DIR}/termux" tmp
    if [ -e "${af}" ] && ! grep -q '^# Written by lets-code' "${af}" 2>/dev/null; then return 0; fi
    termux_write_knowledge "${t}" || return 0
