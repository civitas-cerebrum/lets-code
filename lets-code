	if (rel.startsWith("..") || isAbsolute(rel)) return false;
	const re = globRe(p.replace(/\/$/, ""));
	const dir = p.endsWith("/**") ? globRe(p.slice(0, -3)) : null;   // dir/** covers the directory itself too
	const parts = rel.split(sep);
	for (let i = parts.length; i >= 1; i--) { const q = parts.slice(0, i).join("/"); if (re.test(q) || dir?.test(q)) return true; }   // the path, or a directory above it
