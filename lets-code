export type Kind = (typeof KINDS)[number];
export type By = "model" | "user" | "harness";
export interface Entry { id: string; t: number; u: number; kind: Kind; gist: string; refs: string[]; by: By; n: number }
// English prose: about 3.6 characters a token (the experts module's estimate)
export const est = (s: string) => Math.ceil(s.length / 3.6);
export const day = (t: number) => new Date(t).toISOString().slice(0, 10);
const short = (s: string, n: number) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);
const oneLine = (s: string) => s.replace(/\s+/g, " ").trim();

// ------------------------------------------------------------------ safety
// What must never be remembered: a token, key or password, or a line that
// names one with its value. Commit hashes (plain hex) pass.
const SECRET_RES = [
