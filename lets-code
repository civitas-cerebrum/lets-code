		transcript_path: (() => { try { return ctx?.sessionManager.getSessionFile(); } catch { return undefined; } })() ?? "",
		cwd, hook_event_name: event, permission_mode: PERMISSION_MODE[liveMode ?? (process.env.LETS_CODE_ROLE || process.env.LETS_CODE_MODE || "")] ?? "default",
