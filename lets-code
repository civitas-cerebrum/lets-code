def http(url, headers, data=None):
    req = urllib.request.Request(url, data=data, headers={"Accept-Encoding": "gzip, deflate", **headers})
    try:
        r = urllib.request.urlopen(req, timeout=TIMEOUT)
        status, final, hdrs, body = r.status, r.geturl(), r.headers, r.read(MAX_BYTES)
    except urllib.error.HTTPError as e:
        status, final, hdrs, body = e.code, url, e.headers, e.read(MAX_BYTES) if e.fp else b""
    enc = (hdrs.get("Content-Encoding") or "").lower()
    try:
        if enc == "gzip":
            body = gzip.decompress(body)
        elif enc == "deflate":
            body = zlib.decompress(body)
    except Exception:
        pass
    ctype = hdrs.get("Content-Type") or ""
    m = re.search(r"charset=([\w-]+)", ctype)
    text = body.decode(m.group(1) if m else "utf-8", "replace")
    return status, final, ctype, text


