	let manifest: Manifest = BUILTIN;
	let roleName = process.env.LETS_CODE_ROLE || process.env.LETS_CODE_MODE || "auto";
	let role: Role = BUILTIN.roles.auto;
	let allowedForSession = new Set<string>();   // "bash:<group>" | "external" | "mcp:<server>"
	let cwd = process.cwd();
	let savedTools: string[] | null = null;   // the active tools before a role with an allowlist
	let lastSet: string[] | null = null;      // what that allowlist left active

	const log = (event: string, detail: Record<string, unknown>) => {
		try { mkdirSync(dirname(LOG), { recursive: true }); appendFileSync(LOG, JSON.stringify({ t: Date.now(), role: roleName, event, ...detail }) + "\n"); } catch { /* never fatal */ }
	};
	const warn = (ctx: ExtensionContext | undefined, m: string) => { if (ctx?.hasUI) ctx.ui.notify(m, "warning"); log("warn", { m }); };

	function apply(ctx: ExtensionContext | undefined, name: string, announce = true) {
		// the orchestrator is the main session's: a child that would inherit it
		// gets the default. A child in ask keeps ask's limits but never asks
		// (decide refuses instead): it is not loosened to auto
		if (name === "orchestrator" && subagentDepth > 0) name = manifest.default && manifest.default !== name ? manifest.default : "auto";
		if (!manifest.roles[name]) { warn(ctx, `mandate: unknown role '${name}', using '${manifest.default}'`); name = manifest.default ?? "auto"; }
		const prev = roleName; roleName = name; role = roleFor(manifest, name);
		// plan-like roles: drop tools outside the allowlist from the active set; restore on exit
		// (from the saved set, so role -> role keeps what the next allows; tools
		// that became active meanwhile, late MCP or expert tools, are kept too)
		const late = () => (lastSet ? pi.getActiveTools().filter((t) => !lastSet!.includes(t)) : []);
		if (role.tools) {
			savedTools = savedTools ? [...new Set([...savedTools, ...late()])] : pi.getActiveTools();
			const allowed = new Set(role.tools);
			lastSet = savedTools.filter((t) => allowed.has(t)); pi.setActiveTools(lastSet);
		} else if (savedTools) { pi.setActiveTools([...new Set([...savedTools, ...late()])]); savedTools = null; lastSet = null; }
		if (ctx?.hasUI) ctx.ui.setStatus("mandate", role.bypass ? "mode: yolo" : `mode: ${role.label ?? name}`);
		if (announce) { pi.events.emit("lets-code:mode", { role: name, network: role.network ?? "on", bypass: !!role.bypass, sandbox: role.sandbox ?? {}, ...(on ? {} : { off: true }) }); if (prev !== name) log("mode", { from: prev, to: name }); }
	}
