}
const IDENTITY = (ref: string) => /^(run|factory):/.test(ref) || /\.jsonl$/.test(ref);
const normGist = (g: string) => oneLine(g).toLowerCase().replace(/[.!…]+$/, "");

// ------------------------------------------------------------------ store
export class Store {
	entries: Entry[] = []; bad = 0; archived = 0; index = new Map<string, Set<string>>();
	dir: string; scope: "project" | "global"; root: string;   // root: the project's, "" for the global store
	constructor(dir: string, scope: "project" | "global", root: string) { this.dir = dir; this.scope = scope; this.root = root; }
