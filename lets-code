#!/usr/bin/env bash
# Written by lets-code (acceptance-judge); regenerated on launch, edits are overwritten.
# scratch-copy <dir> [<rev>]: a throwaway copy of <dir> for negative controls,
# under ${TMPDIR:-/tmp}/lets-code-judge; prints its path (the same subdir of
# the copy when <dir> is inside a git repo). In a git repo: the working tree
# (tracked and untracked files, not ignored ones), or commit <rev>; the copy
# is a git repo of its own with that content as one commit, and dependency
# dirs (node_modules, .venv, venv, vendor, target) link to the original's.
# Outside git: a plain copy. Never writes to <dir>.
# scratch-copy --clean: removes every copy.
set -eu
root="${TMPDIR:-/tmp}"; root="${root%/}/lets-code-judge"
if [ "${1:-}" = --clean ]; then rm -rf "${root}"; echo "removed ${root}"; exit 0; fi
[ $# -ge 1 ] && [ -d "$1" ] || { echo "usage: scratch-copy <dir> [<rev>] | --clean" >&2; exit 2; }
src="$(cd "$1" && pwd -P)"; rev="${2:-}"   # physical, as git reports the top level
mkdir -p "${root}"; dst="$(cd "$(mktemp -d "${root}/copy.XXXXXX")" && pwd -P)"
if top="$(git -C "${src}" rev-parse --show-toplevel 2>/dev/null)"; then
    rel="${src#"${top}"}"
    if [ -n "${rev}" ]; then
        git -C "${top}" archive "${rev}" | tar -x -C "${dst}"
    else
        (cd "${top}" && git ls-files -z -c -o --exclude-standard | while IFS= read -r -d '' f; do
            if [ -e "${f}" ] || [ -L "${f}" ]; then printf '%s\0' "${f}"; fi
        done | tar --null -T - -cf -) | tar -x -C "${dst}"
    fi
    (cd "${dst}" && git init -q && git add -A && git -c user.name=judge -c user.email=judge@localhost commit -qm "scratch copy" --no-verify) >/dev/null 2>&1 || true
    for d in node_modules .venv venv vendor target; do
        if [ -e "${top}/${d}" ] && [ ! -e "${dst}/${d}" ]; then
            ln -s "${top}/${d}" "${dst}/${d}"; echo "${d}" >> "${dst}/.git/info/exclude" 2>/dev/null || true
        fi
    done
    echo "${dst}${rel}"
else
    [ -z "${rev}" ] || { echo "scratch-copy: ${src} is not in a git repo, so it has no revision ${rev}" >&2; exit 2; }
    cp -a "${src}/." "${dst}/"
    echo "${dst}"
fi
