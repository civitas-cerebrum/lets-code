# claude is built in (the Claude backend, see CLAUDE_PROVIDER_ID); a saved
# preset of that name adds to it, e.g. MODEL=claude-sonnet.
PRESET=""
ARGS=()
while [ $# -gt 0 ]; do
    want=""
    case "$1" in
        --)         ARGS+=("$@"); break ;;
        --preset)   [ -n "${2:-}" ] || { log_error "--preset requires a name (saved: $(preset_names))."; exit 1; }
