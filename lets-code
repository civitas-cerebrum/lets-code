	"- Claims that code works must rest on commands you ran in this session.",
	"- Derive expected values for tests by executing the reference behaviour (for example real Python for Python semantics), not from memory.",
	"- Decide ambiguities once. When the task is silent on a detail, choose the simplest reading, state it in one line, and move on; do not revisit it unless a test or the task contradicts it.",
	"- Change files with the edit and write tools, not with scripts that rewrite source or test files.",
	"- After changing source, rerun the tests. Before finishing, run them once more and read the output: any failure it prints is unresolved.",
	...(BASH_TIMEOUT > 0 ? [`- bash calls without a timeout are stopped after ${BASH_TIMEOUT}s; pass \`timeout\` for long builds, test suites or installs.`] : []),
].join("\n");
const TIMEOUT_HINT = `[lets-code] Stopped by the ${BASH_TIMEOUT}s default timeout; rerun with a larger \`timeout\` if it needs longer.`;
const TEST_TEXT =
	"[lets-code] You have changed the source several times since your last test run. " +
	"Run your tests now, before making further changes.";
const LENGTH_TEXT =
	"[lets-code] Your last reply hit the output limit before making any tool call, so it was cut off. " +
	"Do not repeat that reasoning. Act now: make the next tool call (for example, write the file).";
const WRAP_TEXT =
	"[lets-code] Your tests have been passing for a while. If every requirement is covered by a test you ran, " +
	"finish with a short summary; otherwise test what is missing first. Do not refactor working code.";
const STOP_TEXT =
	"[lets-code] Stop now. Your tests pass, and since the wrap-up note you have changed no file: more " +
	"re-checking will not change the result. Reply with a short summary of what you built and make no further tool calls.";
const STOP_AFTER_TURNS = 6;
const STOP_AFTER_MS = 4 * 60_000;
const VERIFY_TEXT =
	"[lets-code] You are about to finish, but no code has been executed since your last source change. " +
	"Run the tests and any checks the task requires now, and base your summary on their actual output.";
const REVIEW_TEXT =
	"[lets-code] Final review before you finish. This is a verification step, not a refactor. Re-read the original task " +
	"statement and list every rule it states, one line each, with the executed test that covers it. For each rule without " +
	"such a test, write that test and run it. If a new test fails, first check its expected value against the task " +
	"statement (and real Python where semantics are involved): fix the test if the expectation was wrong, and change source " +
	"only for a rule the task clearly states. Then run the full test suite once more; you may finish only after a green run " +
	"that comes after this review.";
const AFTER_REVIEW_TEXT =
	"[lets-code] Run the full test suite once more now: finishing needs a green run after the final review.";
const FAILED_CHECK_TEXT =
	"[lets-code] You are about to finish, but the last command you executed reported a failure. " +
	"Fix it, or rerun to show it is resolved, before finishing.";

/** Failing-test count reported by a test-like tool output: 0 = all passed, null = not a test run.
 * Several summaries can appear in one output ("130 pass, 1 fail" then "error tests: 0 failures");
 * the largest failure count wins, so one green sub-summary never hides a failure. */
export function testStatus(txt: string): number | null {
	const counts: number[] = [];
	for (const m of txt.matchAll(/(\d+)[ \t]+(?:tests?[ \t]+)?(?:failed|failures?|fail|errors?)\b(?![ \t]*[=:])/gi)) counts.push(Number(m[1]));
	for (const m of txt.matchAll(/\b(?:fail(?:ures|ed|s)?|errors?)\s*[=:]\s*(\d+)/gi)) counts.push(Number(m[1]));
	const base = baseStatus(txt);
	if (base === null && !counts.length) return null;
	if (base === null && !/\bpass(?:ed|es)?\b|\bOK\b|\bok\b/.test(txt)) return null;
	return Math.max(base ?? 0, ...counts);
}

function baseStatus(txt: string): number | null {
	if (/Ran \d+ tests?/.test(txt)) {
		const f = /FAILED \((?:failures=(\d+))?(?:, )?(?:errors=(\d+))?/.exec(txt);
		if (f) return Number(f[1] ?? 0) + Number(f[2] ?? 0);
		if (/(^|\n)OK\b/.test(txt)) return 0;
	}
	let m = /(\d+) passed(?:, | and )(\d+) failed/.exec(txt);
	if (m) return Number(m[2]);
	m = /(\d+) failed, (\d+) passed/.exec(txt); // pytest summary
	if (m) return Number(m[1]);
	if (/=+ (\d+) passed\b[^\n]*=+/.test(txt) && !/failed|error/i.test(txt.slice(-300))) return 0;
	m = /\bfail(?:ures|ed|s)?\s*[=:]\s*(\d+)/i.exec(txt); // checked=20000 failures=51
	if (m) return Number(m[1]);
	m = /(\d+)\/\d+ cases failed|(\d+) differential failures|(\d+) failures?\b(?!\s*[=:])/.exec(txt);
	if (m) return Number(m[1] ?? m[2] ?? m[3]);
	const nfail = (txt.match(/(^|\n)(FAIL|MISMATCH)[:\s]/g) ?? []).length;
	if (nfail) return nfail;
	if (/ALL (TESTS )?PASS|all tests passed|ALL OK|all checks passed/i.test(txt)) return 0;
	// "all inline tests passed", "All 189 test assertions pass", "all 30 checks passed"
	if (/\ball\b[\w ,-]{0,40}?\b(tests?|checks?|assertions?|cases?)\b[\w ]{0,15}?\bpass(ed|es)?\b/i.test(txt) && !/\bfail(ed|ures?)?\b(?![ \t]*[=:][ \t]*0)/i.test(txt)) return 0;
	return null;
}

/** Total test count reported by a test-like output, or null when it cannot be read. */
export function testTotal(txt: string): number | null {
	let m = /Ran (\d+) tests?/.exec(txt);
	if (m) return Number(m[1]);
	m = /(\d+) passed(?:, | and )(\d+) failed/.exec(txt) ?? /(\d+)[ \t]+pass(?:ed)?,[ \t]*(\d+)[ \t]+fail/i.exec(txt);
	if (m) return Number(m[1]) + Number(m[2]);
	m = /(\d+) failed, (\d+) passed/.exec(txt);
	if (m) return Number(m[1]) + Number(m[2]);
	m = /(\d+)\/(\d+) (?:cases|tests|checks)? ?(?:passed|ok)/i.exec(txt);
	if (m) return Number(m[2]);
	return null;
}

/** A struggle signal: why thinking was raised, and the condition that ends the burst. */
export interface Trigger {
	why: string;
	goal: string;
	resolved: (d: Detector) => boolean;
}

/** Struggle signals, fed from tool calls, tool results and turn ends. */
export class Detector {
	turns = 0;
	editStreak = 0;
	errStreak = 0;
	syntax = 0;
	repeats = 0;
	best: number | null = null;
	noImprove = 0;
	regression = false;
	lastFailing: number | null = null;
	passing = false;
	passTurn: number | null = null;
	passAt: number | null = null;
	totalTurns = 0;
	mutations = 0;
	editsSinceTest = 0;
	seq = 0;
	lastSourceEdit = 0;
	lastExec = 0;
	lastExecFailed = false;
	lastOkEdit = 0;
	lastCleanExec = 0;
	lastOkResult = 0;
	lastTestEdit = 0;
	testRuns = 0;
	draftWrong = false;
	draftChecked = false;
	lastTotal: number | null = null;
	pendingExec = false;
	lastCommand = "";
	recentCalls: { sig: string; mutations: number }[] = [];
	now: () => number;
	constructor(now: () => number = () => Date.now()) {
		this.now = now;
	}
	/** Clears the struggle counters; test pass state and edit tracking are kept. */
	reset(): void {
		this.turns = this.editStreak = this.errStreak = this.syntax = this.repeats = this.noImprove = 0;
		this.regression = false;
		this.recentCalls = [];
		this.best = null;
	}
	toolCall(name: string, input: unknown): void {
		if (name === "bash") {
			this.lastCommand = String((input as any)?.command ?? "");
			this.pendingExec = EXEC_RE.test(this.lastCommand);
		}
		const sig = name + ":" + JSON.stringify(input);
		// identical call with no file change since: the model is going in circles
		if (this.recentCalls.some((c) => c.sig === sig && c.mutations === this.mutations)) this.repeats++;
		this.recentCalls = [...this.recentCalls, { sig, mutations: this.mutations }].slice(-4);
	}
	/** Returns the failing-test count when the result was a test run. */
	toolResult(name: string, isError: boolean, text: string, path = ""): number | null {
		// only a run of the tests counts: "fails: 16" from the model's own probe or fuzz script is
		// exploration, and counting it raised false struggle bursts (benchmark wave 13)
		const testRun = name === "bash" && TEST_RUN_RE.test(this.lastCommand);
		let failing = testRun ? testStatus(text) : null;
		// a run of a test file with no recognisable summary: its exit status and output decide
		// (seen in benchmark wave 10: "all inline tests passed", or a bare AssertionError traceback)
		if (failing === null && testRun) {
			if (!isError && /\bpass(ed|es)?\b|\bOK\b/i.test(text) && !/\bFAIL|\bError\b/.test(text)) failing = 0;
			else if (isError && /\bAssertionError\b/.test(text)) failing = 1;
		}
		this.seq++;
		// a failing test run or a failing assertion script exits non-zero; that is progress tracking, not a tool error
		const scriptSlip = name === "bash" && /File "<(stdin|string)>"/.test(text) && /\b(SyntaxError|IndentationError)\b/.test(text);
		const testFileEdit = (name === "edit" || name === "write") && TEST_PATH_RE.test(path);
		const realError = isError && failing === null && !scriptSlip && !testFileEdit && !text.trim().startsWith("(no output)") && !(name === "bash" && /\bAssertionError\b/.test(text));
		this.errStreak = realError ? this.errStreak + 1 : 0;
		if (!realError) this.lastOkResult = this.seq;
		if (name === "edit" && !TEST_PATH_RE.test(path)) this.editStreak = isError ? this.editStreak + 1 : 0;
		const hasSyntax = /\b(SyntaxError|IndentationError)\b/.test(text);
		// a broken throwaway script (heredoc or -c: File "<stdin>" / "<string>") is a quoting slip, not a
		// struggle with the code; only syntax errors in real files count toward the signal
		const syntaxFile = /File "([^"]+)", line \d+[^\n]*\n(?:[^\n]*\n){0,3}?\s*(?:SyntaxError|IndentationError)/.exec(text)?.[1] ?? "";
		if (hasSyntax && !/^<(stdin|string)>$/.test(syntaxFile) && !/File "<(stdin|string)>"/.test(text) && !TEST_PATH_RE.test(syntaxFile)) this.syntax++;
		const editedSource = (name === "edit" || name === "write") && !isError;
		if (editedSource) {
			this.mutations++;
			this.lastOkEdit = this.seq;
			if (TEST_PATH_RE.test(path)) {
				this.lastTestEdit = this.seq;
			} else if (!NONCODE_RE.test(path)) {
				this.editsSinceTest++;
				this.lastSourceEdit = this.seq;
			}
		}
		const executed = name === "bash" && this.pendingExec;
		if (executed) {
			this.lastExecFailed = failing !== 0 && (failing !== null || FAILURE_RE.test(text));
			if (!hasSyntax) this.lastCleanExec = this.seq;
			this.pendingExec = false;
		}
		if (failing !== null) {
			this.testRuns++;
			const total = testTotal(text);
			this.lastTotal = total;
			// the first test runs decide whether the draft is broadly right: half or more failing means a design
			// problem, which patching one failure at a time (thinking off) fixes slowly
			if (!this.draftChecked && this.testRuns <= 2 && total !== null && failing >= 5 && failing * 2 >= total) {
				this.draftWrong = true;
				this.draftChecked = true;
			} else if (this.testRuns >= 2) {
				this.draftChecked = true;
			}
			// more failures than the previous run after a source change, with the tests themselves untouched: a regression
			// (a test-file edit in between means the suite grew; new failures are then expected, not a signal)
			this.regression = this.lastFailing !== null && failing > this.lastFailing && this.lastSourceEdit > this.lastExec && this.lastTestEdit < this.lastExec;
			if (this.best === null || failing < this.best) {
				this.best = failing;
				this.noImprove = 0;
			} else if (failing > 0) {
				this.noImprove++;
			}
			this.lastFailing = failing;
			if (failing === 0 && !this.passing) {
				this.passTurn = this.totalTurns;
				this.passAt = this.now();
			}
			if (failing > 0) this.passTurn = this.passAt = null;
			this.passing = failing === 0;
			this.editsSinceTest = 0;
		}
		if (executed) this.lastExec = this.seq;
		return failing;
	}
	turnEnd(): void {
		this.turns++;
		this.totalTurns++;
	}
	/** The first strong struggle signal present, with its resolution condition, or null. */
	trigger(): Trigger | null {
		if (this.passing) return null;
		const seq = this.seq;
		const mutations = this.mutations;
		if (this.draftWrong) {
			this.draftWrong = false;
			const failing = this.lastFailing ?? 0, total = this.lastTotal ?? 0;
			return {
				why: `${failing} of ${total} tests fail on the first draft`,
				goal: "That many failures points at the design, not a detail. Re-read the task statement, find what the draft gets wrong at the root, and rewrite that part instead of patching failures one at a time.",
				resolved: (d) => d.lastFailing !== null && d.lastTotal !== null && d.lastFailing * 4 <= d.lastTotal,
			};
		}
		if (this.editStreak >= 2) {
			return { why: "2 failed edits in a row", goal: "Read the exact current text of the region before the next edit, then make one edit that matches it.", resolved: (d) => d.lastOkEdit > seq };
		}
		if (this.syntax >= 2) {
			return { why: "2 syntax errors", goal: "Re-read the broken region and fix the syntax in one edit, then run the file.", resolved: (d) => d.lastCleanExec > seq };
		}
		if (this.repeats >= 2) {
			return { why: "the same tool call repeated with no file change in between", goal: "Repeating that command gives the same result. Change the code or run a different check.", resolved: (d) => d.mutations > mutations };
		}
		if (this.regression) {
			const before = this.best ?? 0;
			return { why: "more tests fail after the last edit", goal: "Your last edit made more tests fail. Compare with the previous state and fix the regression first.", resolved: (d) => d.lastFailing !== null && d.lastFailing <= before };
		}
		if (this.noImprove >= 3) {
			// the count that keeps recurring is the latest one; best may be 0 from an earlier green run,
			// which would make "fewer than best" unreachable and pin the burst to its turn cap
			const stuck = this.lastFailing ?? this.best ?? 0;
			return { why: `${stuck} test(s) still failing after 3 runs`, goal: `Diagnose why ${stuck} test(s) keep failing before editing again; verify the diagnosis by running code.`, resolved: (d) => d.lastFailing !== null && d.lastFailing < stuck };
		}
		if (this.errStreak >= 3) {
			return { why: "3 tool errors in a row", goal: "Read the error text of the last three calls and change approach.", resolved: (d) => d.lastOkResult > seq };
		}
		if (this.turns >= 40 && this.testRuns > 0) {
			return { why: "40 turns without passing tests", goal: "Step back: list what is still failing and the simplest change that fixes it.", resolved: (d) => d.passing };
		}
		return null;
	}
	/** True once the model's own tests have passed for `turns` turns and `minMs`, or for `ms` on their own. */
	passedFor(turns: number, ms = Infinity, minMs = 0): boolean {
		if (!this.passing || this.passTurn === null || this.passAt === null) return false;
		const age = this.now() - this.passAt;
		return (this.totalTurns - this.passTurn >= turns && age >= minMs) || age >= ms;
	}
	/** Why finishing now would rest on speculation rather than execution, or null. */
	unverified(): "no-run" | "failed" | null {
		if (this.lastSourceEdit > this.lastExec) return "no-run";
		if (this.lastExec > 0 && this.lastExecFailed) return "failed";
		return null;
	}
}

/** Drops thinking from all but the last `keep` assistant messages. Returns null when nothing changes. */
export function stripOldThinking(messages: any[], keep: number): any[] | null {
	if (!Number.isFinite(keep)) return null;
	const idx = messages.map((m, i) => (m && m.role === "assistant" ? i : -1)).filter((i) => i >= 0);
	const kept = new Set(keep > 0 ? idx.slice(-keep) : []);
	let changed = false;
	const out = messages.map((m, i) => {
		if (!m || m.role !== "assistant" || kept.has(i) || !Array.isArray(m.content)) return m;
		const content = m.content.filter((c: any) => !(c && c.type === "thinking"));
		if (content.length === m.content.length) return m;
		changed = true;
		return { ...m, content };
	});
	return changed ? out : null;
}

function content0(event: any): any[] {
	const c = event?.message?.content;
	return Array.isArray(c) ? c : [];
}

function textOf(content: unknown): string {
	if (!Array.isArray(content)) return typeof content === "string" ? content : "";
	return content.map((c: any) => (c && c.type === "text" ? String(c.text ?? "") : "")).join("");
}

export default function (pi: ExtensionAPI) {
	if (!ACTIVE) return;
	const d = new Detector();
	let wrapNudged = false;
	let wrapTurn = -1;
	let wrapAt = 0;
	let wrapEdit = 0;
	// bash calls that got the guard's default timeout, so a timeout there is ours to explain
	const timedByUs = new Set<string>();
	let stopNudged = false;
	let lengthNudges = 0;
	let testReminders = 0;
	let verifyNudges = 0;
	let burst: { trigger: Trigger; turns: number; actNudges: number; goalPending: boolean } | null = null;
	let bursts = 0;
	let reviewed = false;
	let reviewing = false;
	let reviewSeq = -1;
	let afterReviewNudged = false;
	let planning = false;
	let planTurns = 0;
	const msg = (content: string) => ({ type: "custom_message" as const, customType: "lets-code-agent-guard", content, display: true });
	const log = (event: string, detail: Record<string, unknown> = {}) => {
		if (!LOG) return;
		try {
			appendFileSync(LOG, JSON.stringify({ t: Date.now(), turn: d.totalTurns, level: pi.getThinkingLevel(), event, ...detail }) + "\n");
		} catch {}
	};
	// the level outside bursts, plans and reviews: down once the model's own tests pass and a later turn
	// made no source edit (the work has settled), base otherwise. Dialing down on the first green run was
	// too early: hidden fixes often came after it, and at off the model missed a wrong order its own check printed.
	let greenSettled = false;
	let greenEdit = -1;
	// the levels this instance rests at: BASE and DOWN in the top session; in a subagent (depth > 0)
	// its start level throughout (its agent file's), so bursts come back to it and nothing dials it
	let base = BASE, down = DOWN;
	const restLevel = () => (d.passing && greenSettled ? down : base);
	const endBurst = (why: string) => {
		pi.setThinkingLevel(restLevel() as any);
		log("deescalate", { why, burstTurns: burst?.turns ?? 0 });
		burst = null;
		d.reset();
	};

	pi.on("session_start", async (_e: any, ctx: any) => {
		// a subagent's own session, opened from /subagents: read-only, and its
		// process may still be writing it, so nothing here may append to it
		if (/[\\/]lets-code-runs[\\/][^\\/]+[\\/][^\\/]+\.(pi|view)\.jsonl$/.test(String(ctx?.sessionManager?.getSessionFile?.() ?? ""))) return;
		// a subagent (depth > 0) keeps the level it started at (its agent file's) and rests there
		if (Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") > 0) { base = down = String(pi.getThinkingLevel() ?? BASE); }
		else if (AUTO && pi.getThinkingLevel() !== base) pi.setThinkingLevel(base as any);
		if (AUTO && PLAN) {
			planning = true;
			pi.setThinkingLevel(PLAN_LEVEL as any);
		}
		log("start", { auto: AUTO || null, base, down, bashTimeout: BASH_TIMEOUT, wrapTurns: WRAP_TURNS, wrapMinutes: WRAP_MS / 60_000, burstTurns: BURST_TURNS, maxBursts: MAX_BURSTS, replay: Number.isFinite(REPLAY) ? REPLAY : "all" });
	});

	pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (sections && typeof sections === "object") {
			sections.lets_code_verification = PROMPT_SECTION;
			if (PLAN) sections.lets_code_plan = PLAN_SECTION;
		}
		return undefined;
	});

	pi.on("context", async (event: any) => {
		const out = stripOldThinking(event?.messages ?? [], REPLAY);
		return out ? { messages: out } : undefined;
	});

	pi.on("agent_before_settle", async () => {
		const why = d.unverified();
		if (!why && !REVIEW_OFF && ((AUTO && bursts > 0) || REVIEW_ALWAYS) && !reviewed && d.passing) {
			// one review turn: the misses that remain are task rules the model never tested. In dynamic mode
			// it runs at the ceiling; at a fixed level it runs at that level.
			reviewed = true;
			reviewSeq = d.seq;
			if (AUTO) {
				reviewing = true;
				if (burst) endBurst("final review");
				pi.setThinkingLevel(AUTO as any);
			}
			log("review-burst", { to: AUTO || pi.getThinkingLevel() });
			return { entries: [msg(REVIEW_TEXT)], continue: true };
		}
		if (!why && reviewed && !afterReviewNudged && !(d.lastExec > reviewSeq && d.passing)) {
			// the review may have added tests; finishing needs a green run after it
			afterReviewNudged = true;
			log("after-review-nudge");
			return { entries: [msg(AFTER_REVIEW_TEXT)], continue: true };
		}
		if (!why || verifyNudges >= MAX_VERIFY_NUDGES) return undefined;
		verifyNudges++;
		log("verify-nudge", { why, n: verifyNudges });
		return { entries: [msg(why === "no-run" ? VERIFY_TEXT : FAILED_CHECK_TEXT)], continue: true };
	});

	pi.on("before_provider_request", async (event: any) => {
		if (!LOG) return undefined;
		const p = event?.payload ?? {};
		const msgs = Array.isArray(p?.messages) ? p.messages : [];
		const replayed = msgs.filter((m: any) => m && m.role === "assistant" && typeof (m.reasoning ?? m.reasoning_content) === "string" && (m.reasoning ?? m.reasoning_content).length > 0).length;
		log("request", { enable_thinking: p?.chat_template_kwargs?.enable_thinking ?? null, reasoning_effort: p?.chat_template_kwargs?.reasoning_effort ?? null, thinking_token_budget: p?.thinking_token_budget ?? null, max_tokens: p?.max_tokens ?? null, replayed_thinking: replayed, messages: msgs.length });
		return undefined;
	});

	pi.on("tool_call", async (event: any) => {
		if (event.parentToolCallId) return undefined;
		d.toolCall(event.toolName, event.input);
		if (BASH_TIMEOUT > 0 && event.toolName === "bash" && event.input && event.input.timeout == null) {
			event.input.timeout = BASH_TIMEOUT;
			timedByUs.add(String(event.toolCallId));
		}
		return undefined;
	});

	pi.on("tool_result", async (event: any) => {
		if (event.parentToolCallId) return undefined;
		const text = textOf(event.content);
		const ours = timedByUs.delete(String(event.toolCallId));
		const timedOut = event.toolName === "bash" && /timed out/i.test(text);
		if (timedOut) log("bash-timeout", { byDefault: ours });
		// pi's bash tool says "no default timeout", so the model would not know the stop was ours
		const hinted = ours && /Command timed out after \d+ seconds/.test(text)
			? { content: [...(Array.isArray(event.content) ? event.content : []), { type: "text", text: "\n" + TIMEOUT_HINT }] }
			: undefined;
		const failing = d.toolResult(event.toolName, !!event.isError, text, String(event.input?.path ?? ""));
		if (failing !== null) log("tests", { failing });
		// adaptive mode: a green run arms the dial-down (applied after a settled turn, see turn_end);
		// a red run cancels it and returns to base
		if (AUTO && failing !== null && base !== down) {
			if (failing === 0) {
				if (greenEdit < 0) greenEdit = d.lastSourceEdit;
			} else {
				greenSettled = false;
				greenEdit = -1;
				if (!burst && !planning && !reviewing && pi.getThinkingLevel() !== base) {
					pi.setThinkingLevel(base as any);
					log("dial", { to: base, why: `${failing} failing` });
				}
			}
		}
		// no bursts once the review has started: failures in tests the review adds are verification, not struggle
		if (AUTO && !burst && !planning && !reviewed && bursts < MAX_BURSTS) {
			const trigger = d.trigger();
			if (trigger) {
				pi.setThinkingLevel(AUTO as any);
				burst = { trigger, turns: 0, actNudges: 0, goalPending: true };
				bursts++;
				log("escalate", { why: trigger.why, to: AUTO, burst: bursts });
			}
		}
		return hinted;
	});

	pi.on("turn_end", async (event: any) => {
		d.turnEnd();
		if (planning) {
			planTurns++;
			const wroteSource = content0(event).some((c: any) => c && c.type === "toolCall" && (c.name === "write" || c.name === "edit") && !TEST_PATH_RE.test(String(c.arguments?.path ?? "")));
			if (wroteSource || planTurns >= PLAN_MAX_TURNS) {
				planning = false;
				if (!burst) pi.setThinkingLevel(restLevel() as any);
				log("plan-done", { planTurns });
			}
		}
		// adaptive dial-down: tests green and this turn changed no source since the green run
		if (AUTO && base !== down && d.passing && greenEdit >= 0 && !greenSettled) {
			if (d.lastSourceEdit === greenEdit) {
				greenSettled = true;
				if (!burst && !planning && !reviewing && pi.getThinkingLevel() !== down) {
					pi.setThinkingLevel(down as any);
					log("dial", { to: down, why: "tests pass, work settled" });
				}
			} else {
				greenEdit = d.lastSourceEdit; // still editing after green: wait for a turn without edits
			}
		}
		if (reviewing) {
			// the review turn has been taken; back to rest for whatever testing it triggers
			reviewing = false;
			pi.setThinkingLevel(restLevel() as any);
			log("review-done");
		}
		const m = event.message ?? {};
		const content = Array.isArray(m.content) ? m.content : [];
		const madeToolCall = content.some((c: any) => c && c.type === "toolCall");
		const entries: any[] = [];
		let cont: boolean | undefined;
		if (burst) {
			if (burst.goalPending) {
				burst.goalPending = false;
				entries.push(msg(`[lets-code] Thinking raised to ${AUTO} because: ${burst.trigger.why}. ${burst.trigger.goal} ` +
					"Use this thinking turn to reason it through: state your best hypothesis for the cause and what would confirm it, " +
					"then confirm it by running code before you edit. Act with a tool call."));
			} else {
				burst.turns++;
				if (d.passing) endBurst("tests pass");
				else if (burst.trigger.resolved(d)) endBurst("resolved: " + burst.trigger.why);
				else if (burst.turns >= BURST_TURNS) endBurst(`${BURST_TURNS} turns`);
				else if (!madeToolCall && m.role === "assistant" && m.stopReason === "stop" && burst.actNudges < MAX_ACT_NUDGES_PER_BURST) {
					burst.actNudges++;
					log("act-nudge");
					entries.push(msg(`[lets-code] You were given thinking time for: ${burst.trigger.why}. Act on your conclusion now with a tool call.`));
					cont = true;
				}
			}
		}
		if (FIRM_STOP && wrapNudged && !stopNudged && madeToolCall && d.passing && d.lastOkEdit === wrapEdit && !d.lastExecFailed &&
			(d.totalTurns - wrapTurn >= STOP_AFTER_TURNS || Date.now() - wrapAt >= STOP_AFTER_MS)) {
			// opt-in: the wrap-up was ignored, the tests still pass and no file has changed since: the rest is re-checking
			stopNudged = true;
			log("stop-nudge", { turnsSinceWrap: d.totalTurns - wrapTurn });
			entries.push(msg(STOP_TEXT));
		}
		if (m.role === "assistant" && m.stopReason === "length" && !madeToolCall && lengthNudges < MAX_LENGTH_NUDGES) {
			lengthNudges++;
			log("length-nudge", { n: lengthNudges });
			entries.push(msg(LENGTH_TEXT));
			cont = true;
		} else if (madeToolCall && d.editsSinceTest >= TEST_REMIND_EDITS && testReminders < MAX_TEST_REMINDERS) {
			testReminders++;
			d.editsSinceTest = 0;
			log("test-nudge", { n: testReminders });
			entries.push(msg(TEST_TEXT));
		} else if (WRAP_TURNS > 0 && !wrapNudged && madeToolCall && d.passedFor(WRAP_TURNS, WRAP_MS, WRAP_MIN_MS)) {
			wrapNudged = true;
			wrapTurn = d.totalTurns;
			wrapAt = Date.now();
			wrapEdit = d.lastOkEdit;
			log("wrap-nudge");
			entries.push(msg(WRAP_TEXT));
		}
		if (!entries.length) return undefined;
		return cont ? { entries, continue: true } : { entries };
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# ------------------------------------------------------------ harness gating
# v1 implements exactly one harness (pi). The others are roadmap items and
# must fail loudly rather than silently fall back or misconfigure.
harness_gate() {  # harness_gate <name>
    case "$1" in
        pi) return 0 ;;
        *)
            log_error "harness '$1' is a roadmap item — not yet available in v1."
            log_error "pi is the default (and only implemented) harness: run 'lets-code' without --harness, or with --harness pi."
            exit 1
            ;;
    esac
}

# thinking_check <level>: the forms a thinking level takes (off..max,
# adaptive[:<ceiling>], auto[:<level>]); says what is wrong with any other.
thinking_check() {
    case "$1" in
        off|minimal|low|medium|high|xhigh|max|adaptive|auto) return 0 ;;
        adaptive:*) case "${1#adaptive:}" in low|medium|high|xhigh|max) return 0 ;; esac
                    log_error "adaptive thinking needs a ceiling: adaptive:low|medium|high|xhigh|max (got: $1)"; return 1 ;;
        auto:*)     case "${1#auto:}" in minimal|low|medium|high|xhigh|max) return 0 ;; esac
                    log_error "auto thinking needs a level to raise to: auto:minimal|low|medium|high|xhigh|max (got: $1)"; return 1 ;;
    esac
    log_error "thinking level must be one of off|minimal|low|medium|high|xhigh|max|adaptive[:<ceiling>]|auto[:<level>] (got: $1) — set it via --thinking-level, LETS_CODE_THINKING, or THINKING= in ${CONFIG_FILE} (if present)."
    return 1
}

# flag_check <--flag>: a long flag lets-code does not know passes to pi,
# unless it is one edit away from a lets-code flag or a saved preset's:
# that is a typo, and the error names the flag meant rather than letting
# pi refuse it (or, for a --no-* flag, take it as a message). pi's own
# flags are never questioned, so --models (an edit from --model) passes.
LC_FLAGS="--url --model --context --output-cap --api --vision --no-vision --thinking-level --insecure --no-mem-guard --no-git-guard --no-agent-guard --grounding --no-grounding --no-session-tag --metrics --no-metrics --metrics-log --mandate --orchestrator --no-mandate --subagents --no-subagents --experts --no-experts --core-memory --no-core-memory --sessions --no-sessions --claude-code --no-claude-code --sandbox --no-sandbox --verbose --debug --help --version --preset --claude --harness"
PI_FLAGS="--provider --model --api-key --system-prompt --append-system-prompt --mode --print --continue --resume --session --session-id --fork --session-dir --no-session --name --models --no-tools --no-builtin-tools --tools --exclude-tools --thinking --extension --no-extensions --skill --no-skills --prompt-template --no-prompt-templates --theme --use-theme --no-themes --no-context-files --export --list-models --verbose --tui-mode --approve --no-approve --offline --help --version"
flag_check() {
    local f="${1%%=*}" near=""
    case " ${PI_FLAGS} " in *" ${f} "*) return 0 ;; esac
    # a value given to a flag that takes none (--orchestrator=1): the flag itself
    case " ${LC_FLAGS} " in *" ${f} "*) log_error "unknown flag $1: did you mean ${f}? (it takes no value)"; return 1 ;; esac
    command -v python3 >/dev/null 2>&1 || return 0
    # shellcheck disable=SC2046
    near="$(python3 -c '
import sys
f = sys.argv[1]
def near(a, b):   # one edit: a character changed, dropped, added, or two swapped
    if abs(len(a) - len(b)) > 1: return False
    if len(a) == len(b):
        d = [i for i in range(len(a)) if a[i] != b[i]]
        return len(d) == 1 or (len(d) == 2 and d[1] == d[0] + 1 and a[d[0]] == b[d[1]] and a[d[1]] == b[d[0]])
    s, l = (a, b) if len(a) < len(b) else (b, a)
    return any(l[:i] + l[i + 1:] == s for i in range(len(l)))
for k in sys.argv[2:]:
    if k != f and near(f, k): print(k); break
' "${f}" ${LC_FLAGS} $(preset_names | sed 's/\([^ ][^ ]*\)/--\1/g') 2>/dev/null)" || near=""
    [ -n "${near}" ] || return 0
    log_error "unknown flag $1: did you mean ${near}? (a flag lets-code does not know is passed to pi; see pi --help)"
    return 1
}

# ------------------------------------------------------ pi presence + install
# Detects a missing pi and offers to install it (confirm, then install).
# Never blocks a non-interactive session: it prints the command and returns 1
# so the caller can abort with a pointer.
ensure_pi() {
    command -v pi >/dev/null 2>&1 && return 0
    log "pi (the agentic coding CLI) is not installed."
    log "install command: npm install -g --ignore-scripts @earendil-works/pi-coding-agent"
    if [ ! -t 0 ]; then
        log_error "non-interactive session — refusing to auto-install."
        log_error "run the command above yourself, then re-run lets-code."
        return 1
    fi
    printf "Install now? [Y/n] "
    local answer; read -r answer
    case "$answer" in
        [Nn]*)
            log "skipped — install pi manually (command above) and re-run lets-code."
            return 1
            ;;
    esac
    if ! command -v npm >/dev/null 2>&1; then
        log_error "npm not found — cannot auto-install pi."
        log_error "install Node.js (>= 22.19.0) + npm, then re-run lets-code."
        return 1
    fi
    local nv major minor=""
    nv="$(node -v 2>/dev/null | sed 's/^v//')" || nv=""
    major="${nv%%.*}"
    case "${nv}" in *.*) minor="${nv#*.}"; minor="${minor%%.*}" ;; esac
    [ -n "${minor}" ] || minor=0
    if [ -z "${nv}" ] || [ "${major}" -lt 22 ] || { [ "${major}" -eq 22 ] && [ "${minor}" -lt 19 ]; }; then
        log_error "Node.js >= 22.19.0 required (found: ${nv:-none}) — pi 0.85+ needs it."
        log_error "upgrade Node, then re-run lets-code."
        return 1
    fi
    log "installing pi via npm (this may take a minute) ..."
    if ! npm install -g --ignore-scripts @earendil-works/pi-coding-agent; then
        log_error "npm install failed — check the npm output above and retry."
        return 1
    fi
    if ! command -v pi >/dev/null 2>&1; then
        log_error "npm reported success but 'pi' is not on PATH — check your npm global prefix, then re-run."
        return 1
    fi
    log "installed pi: $(pi --version 2>/dev/null | head -n1)"
    return 0
}

# pi's file-search helpers. pi looks for fd (or Debian's fdfind) and rg on
# PATH, else under <agent-dir>/bin, and downloads what is missing from
# GitHub the first time the TUI starts — printing "fd not found.
# Downloading..." / "ripgrep not found. Downloading..." into the session.
# Fetch them up front instead, through pi's own downloader (same releases,
# same bin dir), so the first session starts clean. No-op once present,
# skipped under PI_OFFLINE, and never fatal: pi still fetches on its own.
ensure_pi_tools() {
    [ -z "${PI_OFFLINE:-}" ] || return 0
    local missing="" bin="${PI_AGENT_DIR}/bin"
    { [ -x "${bin}/fd" ] || command -v fd >/dev/null 2>&1 || command -v fdfind >/dev/null 2>&1; } || missing="fd"
    { [ -x "${bin}/rg" ] || command -v rg >/dev/null 2>&1; } || missing="${missing:+${missing} }rg"
    [ -n "${missing}" ] || return 0
    command -v node >/dev/null 2>&1 || return 0
    local pi_bin pkg mod
    pi_bin="$(node -p 'require("fs").realpathSync(process.argv[1])' "$(command -v pi)" 2>/dev/null)" || pi_bin=""
    pkg="${pi_bin%/dist/*}"
    mod="${pkg}/dist/utils/tools-manager.js"
    if [ -z "${pi_bin}" ] || [ ! -f "${mod}" ]; then
        log "note: pi will download its file-search helpers (${missing}) on first start."
        return 0
    fi
    log "fetching pi's file-search helpers (${missing}) into ${bin} — first run only ..."
    # shellcheck disable=SC2016
    PI_CODING_AGENT_DIR="${PI_AGENT_DIR}" node --input-type=module -e '
        const [mod, ...tools] = process.argv.slice(1);
        const { ensureTool } = await import(mod);
        let ok = true;
        for (const t of tools) {
            const p = await ensureTool(t, (s) => { if (s.type === "warning") { console.log("[lets-code] " + s.message); ok = false; } });
            if (p) console.log("[lets-code] " + (t === "rg" ? "ripgrep" : t) + ": " + p); else ok = false;
        }
        process.exit(ok ? 0 : 1);' "${mod}" ${missing} \
        || log "note: could not fetch ${missing} now — pi retries on its next start (or install them with your package manager)."
    return 0
}

# ------------------------------------------------------------- features
# Optional, off unless setup full/granular or the config turns them on.
# Each is a pi extension written like the guards: regenerated on launch,
# inert in sessions not launched by lets-code with the feature on.

# Mandate: a role per session (mode) or per subagent that says which tools,
# paths, kinds of bash command, MCP servers and agents are allowed, asked
# about or denied. Built-in roles plan / auto / ask / yolo; more in
# ~/.pi/agent/mandate.json; a project's .pi/mandate.json may only tighten.
pi_write_mandate_extension() {
    local dir f tmp
    lc_ext_module mandate; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.mandate.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (mandate); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with the mandate on
// (LETS_CODE_MANDATE_ON=1), or dormant with the mandate off: plan mode
// (LETS_CODE_PLAN_ON=1) and the orchestrator (LETS_CODE_ORCHESTRATOR_ON=1)
// enforce nothing until entered. A mandate is a named role with a scope: which
// tools may run, which paths may be read or written, which kinds of bash
// commands are allowed, asked about or denied, which MCP servers and which
// subagents may be used. The main session runs under the mode role
// (LETS_CODE_MODE, default "auto"); a subagent runs under the role its agent
// file names (LETS_CODE_ROLE). Allowed calls cost nothing: the policy never
// enters the prompt, and a denied call gets one line under 200 characters.
//
// Manifest: ~/.pi/agent/mandate.json (global, full authority) and
// .pi/mandate.json (project, may only tighten; read when the project is
// trusted). Built-in roles: plan, auto, ask, yolo, and readonly and reviewer
// for subagents. A global role of a built-in's name is merged over it (the
// fields it sets win); a project's may only tighten it.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { existsSync, readFileSync, appendFileSync, mkdirSync, realpathSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { dirname, isAbsolute, join, resolve, sep } from "node:path";

type Decision = "allow" | "ask" | "deny";
interface Role {
	tools?: string[];                       // allowlist of tool names; unset = all
	read?: string[];                        // path scopes readable; unset = all
	write?: string[];                       // path scopes writable; default ["."]
	external?: Decision;                    // a path outside the write (or read) scope
	bash?: Record<string, Decision>;        // command group -> decision; "*" is the default
	groups?: Record<string, string[]>;      // extra command groups: name -> regexes
	mcp?: Decision | string[];              // MCP calls: decision, or allowed server names
	dispatch?: string[];                    // subagents this role may start; ["*"] all
	network?: "on" | "off";                 // for the sandbox
	sandbox?: Record<string, unknown>;      // sandbox overrides (allowWrite, denyRead, ...)
	prompt?: string;                        // short system prompt section
	protected?: string[];                   // never written, even when in scope
	bypass?: boolean;                       // the role does nothing (yolo)
	label?: string;
}
interface Manifest { default?: string; cycle?: string[]; roles: Record<string, Role> }

const ACTIVE = process.env.LETS_CODE_MANDATE_ON === "1";
// With the mandate off, the orchestrator role (LETS_CODE_ORCHESTRATOR_ON,
// set where the software factory is): dormant, enforcing nothing, until a
// factory run or /orchestrator engages it in the main session.
const ORCHESTRATOR = !ACTIVE && process.env.LETS_CODE_ORCHESTRATOR_ON === "1";
// With the mandate off, plan mode too (LETS_CODE_PLAN_ON, set unless
// --no-mandate): dormant until /plan or ctrl+alt+p enters it.
const PLAN = !ACTIVE && process.env.LETS_CODE_PLAN_ON === "1";
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const LOG = process.env.LETS_CODE_MANDATE_LOG || join(AGENT_DIR, "lets-code-mandate.log");
const PROTECTED = [".git/", ".env", ".env.*", "*.pem", "*.key", "id_rsa", "id_ed25519"];

// Built-in command groups. A simple command is matched against each group's
// patterns (first word plus arguments); the strictest decision over the
// groups it belongs to wins. "readonly" is only consulted by roles that deny
// "*" (plan): those run read-only commands and nothing else.
const GROUPS: Record<string, RegExp[]> = {
	readonly: [
		/^(cd|pushd|popd|cat|head|tail|less|more|wc|stat|file|du|df|echo|printf|true|pwd|ls|tree|grep|rg|egrep|fgrep|find|fd|which|type|env|printenv|uname|whoami|id|date|uptime|realpath|readlink|dirname|basename|sort|uniq|cut|tr|awk|sed|diff|cmp|md5sum|sha256sum|jq|yq|column|nl|xxd|hexdump|strings|test|\[)(\s|$)/,
		/^git\s+(status|log|diff|show|branch(\s+(-a|-r|-v|--list|--show-current))?|blame|ls-files|rev-parse|remote(\s+-v)?|stash\s+list|describe|tag(\s+-l)?|cat-file|shortlog|reflog)(\s|$)/,
		/^(npm|pnpm|yarn)\s+(ls|list|view|info|outdated|why|explain)(\s|$)/,
		/^(pip|pip3)\s+(list|show|freeze)(\s|$)/,
		/^(node|python3?|ruby|go|cargo|rustc|java|gcc|clang|make|cmake|tsc|deno|bun)\s+(--version|-v|-V|version)(\s|$)/,
	],
	"git-write": [/^git\s+(add|commit|push|pull|fetch|merge|rebase|cherry-pick|revert|reset|checkout|switch|restore|stash|tag|rm|mv|clean|am|apply)(\s|$)/],
	build: [/^(npm|pnpm|yarn|bun)\s+(run|test|t|start|build|exec|x)(\s|$)/, /^(npx|pnpx|bunx)\s/, /^(make|cmake|cargo|go|mvn|gradle|dotnet|tsc|pytest|python3?\s+-m\s+(pytest|unittest)|jest|vitest|mocha|node\s|deno\s|ruby\s|php\s|swift\s)/],
	"package-install": [/^(npm|pnpm|yarn|bun)\s+(i|install|add|ci|link|uninstall|remove|rm|update|up)(\s|$)/, /^(pip|pip3|pipx|uv|poetry|conda)\s+(install|add|uninstall|remove|sync)(\s|$)/,
