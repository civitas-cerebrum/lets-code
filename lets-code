// deny, then ask, then allow; first match wins
export function permissionCheck(s: Pick<Settings, "allow" | "ask" | "deny">, tool: string, input: any, cwd: string): { decision: "deny" | "ask" | "allow" | "none"; rule?: string } {
	for (const k of ["deny", "ask"] as const) { const r = s[k].find((x) => ruleMatches(x, tool, input, cwd, false)); if (r) return { decision: k, rule: r.raw }; }
	const r = s.allow.find((x) => ruleMatches(x, tool, input, cwd, true));
	return r ? { decision: "allow", rule: r.raw } : { decision: "none" };
}

// --------------------------------------------------------------- commands
export interface Template { name: string; kind: "command" | "skill"; scope: "user" | "project"; file: string; dir: string; description: string; argumentHint?: string; argNames: string[]; userInvocable: boolean; body: string }
function mdFiles(dir: string, depth = 0): string[] {
	if (depth > 5 || !isDir(dir)) return [];
	const out: string[] = [];
	for (const e of readdirSync(dir).sort()) {
		if (e.startsWith(".") || e === "node_modules") continue;
		const p = join(dir, e);
		if (isDir(p)) out.push(...mdFiles(p, depth + 1)); else if (e.endsWith(".md")) out.push(p);
	}
	return out;
}
function template(file: string, name: string, kind: Template["kind"], scope: Template["scope"]): Template | null {
	const text = readText(file); if (text === undefined) return null;
	const { fm, body } = parseFrontmatter(text);
	const first = body.split("\n").map((l) => l.trim()).find(Boolean) ?? "";
	const description = String(fm.description ?? "").trim() || first.replace(/^#+\s*/, "").slice(0, 80);
	return { name, kind, scope, file, dir: dirname(file), description, argumentHint: fm["argument-hint"] ? String(fm["argument-hint"]) : undefined,
		argNames: asList(fm.arguments), userInvocable: fm["user-invocable"] !== false, body };
}
// .claude/commands/<dir>/<name>.md is /<dir>:<name>; the nearest project wins, then the user's
export function discoverCommands(cwd: string): Template[] {
	const out = new Map<string, Template>();
	const scan = (dir: string, scope: Template["scope"]) => {
		for (const f of mdFiles(dir)) {
			const name = relative(dir, f).replace(/\.md$/, "").split(sep).join(":");
			if (out.has(name)) continue;
			const t = template(f, name, "command", scope); if (t) out.set(name, t);
		}
	};
	for (const d of projectDirs(cwd)) scan(join(d, ".claude", "commands"), "project");
	if (userScope()) scan(join(claudeDir(), "commands"), "user");
	return [...out.values()];
}
// ~/.claude/skills/synced holds the skills claude.ai syncs for its own apps
// (documents, browsers, computer use): about 15 KB of descriptions for tools
// that are not here, so they stay out unless LETS_CODE_CLAUDE_SYNCED_SKILLS=1
const synced = (d: string) => basename(d) === "synced" && dirname(d) === join(claudeDir(), "skills") && process.env.LETS_CODE_CLAUDE_SYNCED_SKILLS !== "1";
// the names of the skills pi finds on its own (its folders and .agents/skills)
export function piSkillNames(cwd: string): Set<string> {
	const names = new Set<string>();
	const walk = (dir: string, depth: number) => {
		if (depth > 4 || !isDir(dir)) return;
		const f = join(dir, "SKILL.md");
		if (existsSync(f)) { names.add(String(parseFrontmatter(readText(f) ?? "").fm.name || basename(dir))); return; }
		for (const e of readdirSync(dir).sort()) if (!e.startsWith(".") && e !== "node_modules") walk(join(dir, e), depth + 1);
	};
	walk(join(agentDir(), "skills"), 0);
	walk(join(home(), ".agents", "skills"), 0);
	walk(join(cwd, ".pi", "skills"), 0);
	for (const d of ancestors(cwd, gitRoot(cwd) ?? resolve(cwd))) walk(join(d, ".agents", "skills"), 0);
