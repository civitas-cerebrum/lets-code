	catch (e) { r = { text: `dispatch failed: ${e instanceof Error ? e.message : String(e)}`, exitCode: 1, input: 0, output: 0, seconds: 0 }; }
	const out = artifact(L, `${String(n).padStart(2, "0")}-${stage}.out.md`, r.text);
	const entry: Entry = { stage, round: L.rounds, expert, brief: briefFile, output: out, verdict: "", summary: "", input: r.input, output_tokens: r.output, seconds: r.seconds, started, ended: now() };
