		case "branch": return has(flags, "-D", "-f", "--force", "-M") ? "branch -D/-f/-M" : null;
		case "reset": return has(flags, "--hard", "--merge") ? "reset --hard" : null;
		case "checkout": {
			if (has(flags, "-f", "--force", "-B", "-p", "--patch")) return "checkout -f/-B/--patch";
			if (has(flags, "--ours", "--theirs")) return repo?.op ? null : "checkout --ours/--theirs";  // conflict resolution only during a merge/rebase
			if (g.args.includes("--")) return "checkout -- <path>";
			if (has(flags, "-b", "--orphan", "-t", "--track", "--detach", "-d")) return null;
			if (plain.length >= 2) return "checkout <ref> <path>";
			if (plain.length === 1 && plain[0] !== "-" && !branchExists(repo, plain[0]) && (/^\.{1,2}(\/|$)|\/$/.test(plain[0]) || exists(realPath(plain[0], g.dir)))) return `checkout ${plain[0]} (a path)`;
			return null;
		}
		case "switch": return has(flags, "-f", "--force", "--discard-changes", "-C", "--force-create") ? "switch -f/-C" : null;
		case "restore": return has(flags, "--staged", "-S") && !has(flags, "--worktree", "-W") ? null : "restore <path>";
		case "clean": return has(flags, "-f", "--force", "-d", "-x", "-X") && !has(flags, "-n", "--dry-run") ? "clean -f/-d/-x" : null;
		case "stash": return pos[0] === "drop" || pos[0] === "clear" ? `stash ${pos[0]}` : null;
		case "rm": return has(flags, "-f", "--force") && !has(flags, "--cached") ? "rm -f" : null;
		case "tag": return has(flags, "-d", "--delete") || (has(flags, "-f", "--force") && pos.length) ? "tag -d/-f" : null;
		case "update-ref": case "filter-branch": case "filter-repo": case "prune": case "replace": case "fast-import": return g.verb;
		case "reflog": return pos[0] === "expire" || pos[0] === "delete" ? `reflog ${pos[0]}` : null;
		case "gc": return has(flags, "--prune") ? "gc --prune" : null;
		case "worktree": return pos[0] === "remove" && has(flags, "-f", "--force") ? "worktree remove -f" : null;
		case "symbolic-ref": return plain.length >= 2 ? "symbolic-ref <write>" : null;
		case "config": return has(flags, "--unset-all", "--remove-section") ? "config --unset-all" : null;
		case "submodule": return pos[0] === "deinit" && has(flags, "-f", "--force") ? "submodule deinit -f" : null;
		default: return null;
	}
}

// Off a pi/* branch: inspection, finishing/aborting an operation in progress,
// and switching to (or creating) a pi/* branch.
const INSPECT = new Set(["status", "log", "diff", "show", "rev-parse", "symbolic-ref", "fetch", "ls-files", "ls-tree", "ls-remote", "blame", "describe", "reflog", "show-ref", "for-each-ref", "cat-file", "name-rev", "shortlog", "whatchanged", "count-objects", "var", "version", "help", "grep", "stash", "branch", "remote", "worktree", "config", "bisect", "merge", "rebase", "cherry-pick", "revert", "switch", "checkout", "am"]);
function allowedOffBranch(g: Git, repo: Repo): boolean {
	if (!INSPECT.has(g.verb)) return false;
	const { flags, pos } = flagsOf(g.args, g.verb);
	switch (g.verb) {
		case "stash": return pos[0] === "list" || pos[0] === "show";
		case "branch": return createdBranch(g) === null && !has(flags, "-d", "-D", "--delete", "-m", "-M", "--move", "-u", "--set-upstream-to", "--unset-upstream", "--edit-description");
		case "remote": return pos.length === 0 || pos[0] === "show" || pos[0] === "get-url" || has(flags, "-v", "--verbose");
		case "worktree": return pos[0] === "list";
		case "config": return pos.length === 0 || has(flags, "--get", "--get-all", "--get-regexp", "--list", "-l");
		case "bisect": return true;
		case "merge": case "rebase": case "cherry-pick": case "revert": case "am":
			return repo.op !== null && has(flags, "--abort", "--continue", "--skip", "--quit", "--show-current-patch", "--edit-todo");
		case "switch": case "checkout": { const to = movesHeadTo(g, repo); return to !== null && isPi(to); }
		default: return !flags.has("--output");
	}
}

// ================================================================ removal
// Would removing `p` (recursively or not) take a repo, .git, or the tree we work in?
function lethalPath(p: string, cwd: string, recursive: boolean): boolean {
	const glob = hasGlob(p);
	const target = realPath(glob ? dirname(p) : p, cwd);
	const repo = repoOf(target);
	if (glob) {
		if (!recursive) return false;
		if (target === homedir() || isRoot(target) || (repo && within(target, repo.gitdir))) return true;
		const pat = basename(p), re = globRe(pat);
		if (repo?.top === target) return re.test(".git") || pat === "*";             // at the repo top: .git, or everything
		return within(cwd, target) && re.test(cwd.slice(target.length + 1).split(sep)[0] ?? "");  // an ancestor: the dir that leads to us
	}
	if (basename(target) === ".git") return true;
	if (recursive && (target === homedir() || isRoot(target))) return true;
	if (!repo) return recursive && within(cwd, target);                              // an ancestor of where we are
	if (within(target, repo.gitdir)) return !/\.lock$/.test(target);                 // inside .git, except stale locks
	return recursive && (within(repo.top, target) || within(cwd, target));
}
// `find <paths> <expression>` that deletes: which paths are at risk? A test that
// cannot match .git (-name '*.pyc'), placed before the action and not negated,
// makes it safe; so does pruning .git (-name .git -prune -o ...).
function findDeletes(args: string[]): { paths: string[]; risky: boolean } | null {
	const i = args.findIndex((x) => x.startsWith("-") || x === "!" || x === "(");
	const paths = (i < 0 ? args : args.slice(0, i)).filter((x) => x !== "--"), expr = i < 0 ? [] : args.slice(i);
	const action = expr.findIndex((x, k) => x === "-delete" || (/^-exec(dir)?$/.test(x) && /^(rm|shred|unlink)$/.test(basename(expr[k + 1] ?? ""))));
	if (action < 0) return null;
	const before = expr.slice(0, action);
	const prunesGit = before.some((x, k) => /^-i?(name|path|wholename)$/.test(x) && /^(\.\/)?\.git$/.test(before[k + 1] ?? "") && before[k + 2] === "-prune");
	const filters = before.filter((x, k) => /^-i?(name|path|regex|wholename)$/.test(before[k - 1] ?? "") && before[k - 2] !== "!" && before[k - 2] !== "-not" && before[k + 1] !== "-prune");
	const risky = !prunesGit && (!filters.length || filters.some((f) => { const re = globRe(f); return re.test(".git") || re.test("./.git") || re.test("*/.git"); }));
	return { paths: paths.length ? paths : ["."], risky };
}

// ================================================================ reasons
// Block reasons are the only text the model ever sees from this guard, and
// only when a call is blocked, so they are kept to one short line.
const clip = (s: string, n = 60) => (s.length > n ? s.slice(0, n - 1) + "…" : s);
const offBranch = (r: Repo, via?: string) => {
	const where = r.branch === "" ? "detached HEAD" : `branch '${clip(r.branch)}'`;
	if (via) return `git guard: after \`${clip(via, 40)}\` the rest of this command would run on ${where}, not a ${PREFIX}* branch; stay on the ${PREFIX}* branch.`;
	if (r.op) return `git guard: a ${r.op} is in progress on ${where}, not a ${PREFIX}* branch; finish or abort it (git ${r.op} --continue|--abort) first.`;
	return `git guard: HEAD is on ${where}; work only on a ${PREFIX}* branch. Run \`git switch -c ${PREFIX}<topic>\` (changes come along), then retry.`;
};
const destructive = (what: string) => `git guard: '${clip(what)}' refused, it would discard work irreversibly. Reversible: git stash push -- <file>; git show HEAD:<file> > <file>; git revert.`;
const badName = (n: string) => `git guard: new branches must be named ${PREFIX}<topic>; use \`git switch -c ${PREFIX}${clip(n.replace(/^refs\/heads\//, ""), 40)}\`.`;
const gitDirWrite = () => `git guard: writing inside .git is refused; use git commands instead.`;
const unknownTarget = (what: string) => `git guard: cannot tell what '${clip(what, 40)}' refers to ($VAR, $(..) or stdin); use a literal path.`;
const stdinScript = (sh: string) => `git guard: a script piped into ${sh} cannot be checked; use ${sh} -c '...' or a heredoc.`;
const tooLong = () => `git guard: too many commands in one call (> ${MAX_CMDS}); split it up.`;

// ================================================================ judging a bash call
type Verdict = { block: true; reason: string } | undefined;
const READONLY = new Set(["cat", "ls", "less", "more", "head", "tail", "grep", "egrep", "fgrep", "rg", "ag", "wc", "diff", "file", "stat", "pwd", "echo", "printf", "true", "false", "test", "[", "which", "type", "du", "df", "tree", "sort", "uniq", "cut", "tr", "jq", "yq", "md5sum", "sha256sum", "basename", "dirname", "realpath", "readlink", "date", "env", "printenv", "id", "whoami", "hostname", "uname", "sleep", "exit", "return", "popd", "dirs", "shift", "export", "local", "declare", "set", "unset", "read", "wait", "seq", "xxd", "od", "strings", "column", "nl", "tac", "rev", "bat", "fd", "find"]);
// Commands that write files: which arguments they write to.
const WRITERS: Record<string, (f: Flags, plain: string[]) => string[]> = {
	cp: (_, p) => p.slice(-1), mv: (_, p) => p.slice(-1), ln: (_, p) => p.slice(-1), install: (_, p) => p.slice(-1), rsync: (_, p) => p.slice(-1),
	tee: (_, p) => p, touch: (_, p) => p, mkdir: (_, p) => p, truncate: (_, p) => p, chmod: (_, p) => p, chown: (_, p) => p,
	dd: (_, p) => p.filter((a) => a.startsWith("of=")).map((a) => a.slice(3)),
	tar: (f) => has(f.flags, "-x", "--extract") ? [f.val("-C") ?? "."] : [f.val("-f") ?? f.val("--file") ?? ""].filter(Boolean),
	unzip: (f) => [f.val("-d") ?? "."], patch: () => ["."],
	sed: (f, p) => has(f.flags, "-i") || [...f.flags].some((x) => x.startsWith("--in-place")) ? p : [],
	perl: (f, p) => has(f.flags, "-i") ? p : [],
};

function judgeBash(cmd: string, cwd0: string): Verdict {
	const cmds = lex(cmd);
	if (cmds.length > MAX_CMDS) return { block: true, reason: tooLong() };
	let cwd = realDir(cwd0, cwd0);
	const vars: Env = {}, stack: string[] = [], dirs: string[] = [], aliases = new Map<string, Env>();
	const moved = new Map<string, { branch: string; via: string }>();  // repo top (or new worktree path) -> where HEAD was moved in this call
	const repoAt = (dir: string): [Repo | null, string | undefined] => {
		for (const [top, m] of moved) if (within(dir, top)) return [{ top, gitdir: join(top, ".git"), ...repoOf(top), branch: m.branch, op: null }, m.via];  // a worktree being added may not exist yet
		return [repoOf(dir), undefined];
	};
	const judgeDir = (dir: string, real?: string): Verdict => {
		const [repo, via] = repoAt(dir);
		if (real !== undefined && inGitDir(real, repo)) return { block: true, reason: gitDirWrite() };
		return onPi(repo) ? undefined : { block: true, reason: offBranch(repo!, via) };
	};
	const writeTarget = (w: string): Verdict => {
		const p = expand(piPath(w), vars, cwd);
		if (unresolved(p) || unresolved(cwd)) return { block: true, reason: unknownTarget(w) };
		const real = realPath(p, cwd);
		return judgeDir(isDir(real) ? real : dirname(real), real);
	};
	const removal = (name: string, raw: string, recursive: boolean): Verdict => {
		const p = expand(raw.replace(/^--:/, ""), vars, cwd);
		if (unresolved(p) || unresolved(cwd) || /\{\}/.test(p)) return recursive ? { block: true, reason: unknownTarget(raw) } : undefined;  // $VAR, xargs {}
		return lethalPath(p, cwd, recursive) ? { block: true, reason: destructive(`${name} ${raw}`) } : undefined;
	};
	const splice = (script: string, n: number): Verdict => { const inner = lex(script); if (cmds.length + inner.length > MAX_CMDS) return { block: true, reason: tooLong() }; cmds.splice(n + 1, 0, ...inner); return undefined; };

	for (let n = 0; n < cmds.length; n++) {
		if (n >= MAX_CMDS) return { block: true, reason: tooLong() };
		const simple = cmds[n];
		let raw = simple.argv;
		if (raw[0] === "(") { stack.push(cwd); continue; }
		if (raw[0] === ")") { cwd = stack.pop() ?? cwd; continue; }
		if (raw[0] === "for" && raw[2] === "in" && raw.length === 4) vars[raw[1]] = expand(raw[3], vars, cwd);  // `for d in X`: one value, known
		while (raw.length && RESERVED.has(raw[0])) raw = raw.slice(1);  // `then rm ...`, `! git ...`
		if (/^(export|declare|local|typeset|readonly)$/.test(raw[0] ?? "")) raw = raw.slice(1).filter((a) => !a.startsWith("-"));
		const { argv, env, script } = unwrap({ ...simple, argv: raw });
		if (script !== undefined) {
			if (script === "|") return { block: true, reason: stdinScript(basename(raw.find((a) => SHELLS.test(basename(a))) ?? "sh")) };
			const v = splice(script, n); if (v) return v; continue;
		}
		for (const k in env) if (!argv.length) vars[k] = expand(env[k], vars, cwd);  // `D=../main` alone: remembered
		for (const w of simple.writes) { const v = writeTarget(w); if (v) return v; }
		if (!argv.length) continue;
		const name = basename(argv[0]);
		if (name === "cd" || name === "pushd") {
			const args = argv.slice(1).filter((a) => !/^-[LPe@]+$/.test(a) && a !== "--");
			if (name === "pushd") dirs.push(cwd);
			if (!args.length) cwd = homedir();
			else if (args[0] === "-") { /* previous dir: keep */ }
			else { const d = expand(args[0], vars, cwd); cwd = unresolved(d) || hasGlob(d) ? UNRESOLVED : realDir(d, cwd); }
			continue;
		}
		if (name === "popd") { cwd = dirs.pop() ?? cwd; continue; }
		if (unresolved(cwd) && (name === "git" || name in WRITERS || /^(rm|mv|find|shred|unlink|rmdir)$/.test(name))) return { block: true, reason: unknownTarget("cd target") };
		if (name === "git") {
			let g = parseGit(argv, cwd, env, vars);
			if (unresolved(g.dir)) return { block: true, reason: unknownTarget("git -C target") };
			const [repo, via] = (() => { const r = gitRepo(g); return r ? repoAt(r.top) : [null, undefined] as [Repo | null, string | undefined]; })();
			const alias = g.verb && !INSPECT.has(g.verb) && !(g.verb in LONG) ? aliasOf(g.verb, g.dir, g.cliAliases, aliases) : null;
			if (alias !== null) {
				if (alias.startsWith("!")) { const v = splice(alias.slice(1) + " " + g.args.join(" "), n); if (v) return v; continue; }
				const a = lex(alias)[0]?.argv ?? []; g = { ...g, verb: a[0] ?? "", args: [...a.slice(1), ...g.args] };
			}
			const bad = destructiveGit(g, repo);
			if (bad) return { block: true, reason: destructive(`git ${bad}`) };
			const created = createdBranch(g);
			if (created !== null && !isPi(created)) return { block: true, reason: badName(created) };
			if (!onPi(repo) && !allowedOffBranch(g, repo!)) return { block: true, reason: offBranch(repo!, via) };
			if (repo) {  // the rest of the call runs where this leaves HEAD
				const to = movesHeadTo(g, repo); if (to !== null) moved.set(repo.top, { branch: to, via: `git ${g.verb} ${to || "--detach"}` });
				const { pos } = flagsOf(g.args, g.verb);
				if (g.verb === "worktree" && pos[0] === "add" && pos[1]) moved.set(realPath(pos[1], g.dir), { branch: created ?? pos[2] ?? "", via: `git worktree add` });
			}
			continue;
		}
		if (/^(rm|shred|unlink|rmdir|mv)$/.test(name)) {
			const { flags, pos } = flagsOf(argv.slice(1));
			const recursive = name === "mv" || name === "rmdir" || has(flags, "-r", "-R", "--recursive");
			const targets = name === "mv" ? pos.slice(0, -1) : pos;
			if (!targets.length) {  // targets from stdin (`find … | xargs rm`): judged by the find's tests, as if it deleted
				const feed = cmds[n - 1], fd = feed?.argv[0] === "find" ? findDeletes([...feed.argv.slice(1), "-delete"]) : null;
				if (fd && !fd.risky) continue;
				if (recursive || fd) return { block: true, reason: unknownTarget(`${name} (targets from stdin)`) };
			}
			for (const p of targets) { const v = removal(name, p, recursive); if (v) return v; }
		}
		if (name === "find") {
			const k = argv.findIndex((x) => /^-exec(dir)?$/.test(x));
			if (k > 0 && SHELLS.test(basename(argv[k + 1] ?? ""))) {  // -exec sh -c '…': the script runs too
				const end = argv.findIndex((x, j) => j > k && (x === ";" || x === "+"));
				const sub = unwrap({ argv: argv.slice(k + 1, end < 0 ? undefined : end), writes: [] });
				if (sub.script) { const v = splice(sub.script, n); if (v) return v; }
			}
			const fd = findDeletes(argv.slice(1));
			if (fd) for (const p of fd.paths) { const v = fd.risky ? removal("find -delete", p, true) : writeTarget(p); if (v) return v; }
		}
		if (name in WRITERS) {
			const f = flagsOf(argv.slice(1)), plain = plainPos(f);
			for (const t of WRITERS[name](f, plain).filter((t) => !(name === "sed" || name === "perl") || exists(realPath(expand(t, vars, cwd), cwd)))) { const v = writeTarget(t); if (v) return v; }
			if (name === "rsync" && has(f.flags, "--delete") && plain.length && !f.flags.has("--exclude")) { const v = removal("rsync --delete", plain[plain.length - 1], true); if (v) return v; }
			continue;
		}
		// Anything else runs in the current directory: fine on pi/*, outside a repo, or read-only.
		if (!unresolved(cwd) && !READONLY.has(name)) { const v = judgeDir(cwd); if (v) return v; }
	}
	return undefined;
}

// ================================================================ checkpoints
// Uncommitted work on the pi/* branch is the one thing the rules above cannot
// protect: the model's own next edit overwrites it. So the working tree
// (tracked + untracked, .gitignore respected) is snapshotted as a commit under
// refs/pi-checkpoints/<branch>/<stamp>: synchronously BEFORE each edit/write/
// bash in a pi/* repo (so the state about to be changed is kept), and again
// shortly after (so the last state is kept). A private index file is used; the
// user's index, HEAD and branches are untouched; nothing is shown to the model.
//   recover:  git for-each-ref refs/pi-checkpoints/   git show <ref>:<path>
//   off: LETS_CODE_GIT_CHECKPOINTS=0  keep: LETS_CODE_GIT_CHECKPOINT_KEEP (200)
//   log of failures: .git/lets-code-checkpoint.log
const CHECKPOINTS = ACTIVE && process.env.LETS_CODE_GIT_CHECKPOINTS !== "0";
const CP_DEBOUNCE = Number(process.env.LETS_CODE_GIT_CHECKPOINT_DEBOUNCE_MS ?? 3000);
const CP_KEEP = Number(process.env.LETS_CODE_GIT_CHECKPOINT_KEEP ?? 200);
const CP_MAX_FILE = Number(process.env.LETS_CODE_GIT_CHECKPOINT_MAX_FILE_MB ?? 20) * 2 ** 20;    // bigger untracked files are left out
const CP_MAX_UNTRACKED = Number(process.env.LETS_CODE_GIT_CHECKPOINT_MAX_UNTRACKED_MB ?? 500) * 2 ** 20;  // above this, only tracked files
const CP_SYNC_BUDGET_MS = 2000;  // a repo whose warm snapshot takes longer is only snapshotted in the background

const gitEnv = (extra: Env) => ({ ...process.env, GIT_AUTHOR_NAME: "lets-code", GIT_AUTHOR_EMAIL: "lets-code@localhost", GIT_COMMITTER_NAME: "lets-code", GIT_COMMITTER_EMAIL: "lets-code@localhost", ...extra });
const gitSync = (args: string[], cwd: string, extra: Env = {}) => String(execFileSync("git", args, { cwd, env: gitEnv(extra), stdio: ["ignore", "pipe", "pipe"], maxBuffer: 64 * 2 ** 20, timeout: 60_000 }));
const gitAsync = (args: string[], cwd: string, extra: Env = {}) => new Promise<string>((res, rej) =>
	execFile("git", args, { cwd, env: gitEnv(extra), maxBuffer: 64 * 2 ** 20 }, (err, out) => (err ? rej(err) : res(String(out)))));
type Runner = (args: string[], cwd: string, extra?: Env) => string | Promise<string>;

const cpLastTree = new Map<string, string>(), cpWarm = new Set<string>(), cpSlow = new Set<string>();
const cpTimers = new Map<string, NodeJS.Timeout>(), cpRunning = new Map<string, Promise<void>>(), cpAgain = new Set<string>();
const cpLog = (repo: Repo, e: unknown) => { try { appendFileSync(join(repo.gitdir, "lets-code-checkpoint.log"), `${new Date().toISOString()} ${String((e as Error)?.message ?? e).split("\n")[0]}\n`); } catch { /* ignore */ } };

// One snapshot of `repo`. Works with the sync or the async git runner.
async function snapshot(repo: Repo, git: Runner): Promise<void> {
	const top = repo.top, idx = { GIT_INDEX_FILE: join(repo.gitdir, "lets-code-checkpoint.index") };
	const untracked = (await git(["ls-files", "-o", "--exclude-standard", "-z"], top)).split("\0").filter(Boolean)
		.map((f) => { try { return { f, size: statSync(join(top, f)).size }; } catch { return { f, size: 0 }; } });
	const total = untracked.reduce((s, u) => s + (u.size > CP_MAX_FILE ? 0 : u.size), 0);
	const exclude = total > CP_MAX_UNTRACKED ? untracked.map((u) => `:(exclude)${u.f}`) : untracked.filter((u) => u.size > CP_MAX_FILE).map((u) => `:(exclude)${u.f}`);
	if (total > CP_MAX_UNTRACKED) cpLog(repo, `untracked files total ${(total / 2 ** 20).toFixed(0)} MB > cap: only tracked files snapshotted`);
	try { await git(["add", "-A", "--ignore-errors", "--", ".", ...exclude], top, idx); } catch (e) { cpLog(repo, e); }  // unreadable files: what could be added was; exit status non-zero
	const tree = (await git(["write-tree"], top, idx)).trim();
	let head: string | null = null, headTree: string | null = null;
	try { head = (await git(["rev-parse", "-q", "--verify", "HEAD^{commit}"], top)).trim(); headTree = (await git(["rev-parse", "-q", "--verify", "HEAD^{tree}"], top)).trim(); } catch { /* unborn */ }
	if (tree === cpLastTree.get(top) || tree === headTree) { cpLastTree.set(top, tree); return; }
	const now = new Date(), pad = (x: number, w = 2) => String(x).padStart(w, "0");
	const stamp = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}.${pad(now.getMilliseconds(), 3)}`;
	const commit = (await git(["commit-tree", tree, ...(head ? ["-p", head] : []), "-m", `lets-code checkpoint ${now.toISOString()} on ${repo.branch}`], top)).trim();
	const ns = `refs/pi-checkpoints/${repo.branch}/`;
	await git(["update-ref", `${ns}${stamp}`, commit], top);
	cpLastTree.set(top, tree);
	const refs = (await git(["for-each-ref", "--format=%(refname)", "--sort=refname", ns], top)).split("\n").filter(Boolean);
	for (const r of refs.slice(0, Math.max(0, refs.length - CP_KEEP))) await git(["update-ref", "-d", r], top);
}

// Before a tool call: keep the state that is about to change. Waits for a
// background snapshot of the same repo, then snapshots synchronously, so no
// tool can run in between. A repo that proved slow (warm) is skipped.
async function checkpointNow(dir: string): Promise<void> {
	const repo = repoOf(dir);
	if (!repo || !isPi(repo.branch) || cpSlow.has(repo.top)) return;
	await cpRunning.get(repo.top);
	const t0 = Date.now();
	try { await snapshot(repo, gitSync); } catch (e) { cpLog(repo, e); }
	if (Date.now() - t0 > CP_SYNC_BUDGET_MS && cpWarm.has(repo.top)) { cpSlow.add(repo.top); cpLog(repo, `snapshot took ${Date.now() - t0} ms: pre-call snapshots off for this session, background ones continue`); }
	cpWarm.add(repo.top);
}
// After a tool call: keep the result, debounced, in the background.
function checkpointSoon(dir: string): void {
	const repo = repoOf(dir);
	if (!repo || !isPi(repo.branch)) return;
	clearTimeout(cpTimers.get(repo.top));
	const t = setTimeout(() => { cpTimers.delete(repo.top); run(repo.top); }, CP_DEBOUNCE);
	t.unref?.(); cpTimers.set(repo.top, t);
}
function run(top: string): void {
	if (cpRunning.has(top)) { cpAgain.add(top); return; }
	const repo = repoOf(top); if (!repo) return;
	cpRunning.set(top, snapshot(repo, gitAsync).catch((e) => cpLog(repo, e)).finally(() => { cpRunning.delete(top); if (cpAgain.delete(top)) run(top); }));
}
// Session end: run every pending snapshot and wait for all of them.
async function flushCheckpoints(): Promise<void> {
	for (const [top, t] of cpTimers) { clearTimeout(t); cpTimers.delete(top); run(top); }
	while (cpRunning.size) await Promise.all([...cpRunning.values()]);
}

// ================================================================ wiring
const targetDir = (toolName: string, input: Record<string, unknown>, cwd: string) =>
	toolName === "edit" || toolName === "write" ? dirname(realPath(piPath(String(input.path ?? "")), cwd)) : realDir(cwd, cwd);

export default function (pi: ExtensionAPI) {
	if (!ACTIVE) return;

	pi.on("tool_call", async (event, ctx) => {
		const input = event.input as Record<string, unknown>;
		let verdict: Verdict;
		switch (event.toolName) {
			case "edit": case "write": {
				const real = realPath(piPath(String(input.path ?? "")), ctx.cwd), repo = repoOf(dirname(real));
				verdict = inGitDir(real, repo) ? { block: true, reason: gitDirWrite() } : onPi(repo) ? undefined : { block: true, reason: offBranch(repo!) };
				break;
			}
			case "bash": case "powershell":
				try { verdict = judgeBash(String(input.command ?? ""), ctx.cwd); }
				catch { verdict = { block: true, reason: `git guard: this command is too complex to judge; simplify it.` }; }  // fail closed
				break;
			default: return undefined;  // read-only tools and custom tools are never blocked
		}
		if (!verdict && CHECKPOINTS) await checkpointNow(targetDir(event.toolName, input, ctx.cwd));
		return verdict;
	});

	if (CHECKPOINTS) {
		pi.on("tool_result", async (event, ctx) => {
			const name = (event as { toolName?: string }).toolName ?? "";
			if (!event.isError && /^(edit|write|bash|powershell)$/.test(name)) checkpointSoon(targetDir(name, event.input as Record<string, unknown>, ctx.cwd));
			return undefined;
		});
		pi.on("session_shutdown", async () => { await flushCheckpoints(); });
	}
}
