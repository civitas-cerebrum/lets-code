// Built-in command groups. A simple command is matched against each group's
// patterns (first word plus arguments); the strictest decision over the
// groups it belongs to wins. "readonly" is only consulted by roles that deny
// "*" (plan): those run read-only commands and nothing else.
const GROUPS: Record<string, RegExp[]> = {
	readonly: [
		/^(cat|head|tail|less|more|wc|stat|file|du|df|echo|printf|true|pwd|ls|tree|grep|rg|egrep|fgrep|find|fd|which|type|env|printenv|uname|whoami|id|date|uptime|realpath|readlink|dirname|basename|sort|uniq|cut|tr|awk|sed|diff|cmp|md5sum|sha256sum|jq|yq|column|nl|xxd|hexdump|strings|test|\[)(\s|$)/,
		/^git\s+(status|log|diff|show|branch(\s+(-a|-r|-v|--list|--show-current))?|blame|ls-files|rev-parse|remote(\s+-v)?|stash\s+list|describe|tag(\s+-l)?|cat-file|shortlog|reflog)(\s|$)/,
		/^(npm|pnpm|yarn)\s+(ls|list|view|info|outdated|why|explain)(\s|$)/,
		/^(pip|pip3)\s+(list|show|freeze)(\s|$)/,
		/^(node|python3?|ruby|go|cargo|rustc|java|gcc|clang|make|cmake|tsc|deno|bun)\s+(--version|-v|-V|version)(\s|$)/,
	],
	"git-write": [/^git\s+(add|commit|push|pull|fetch|merge|rebase|cherry-pick|revert|reset|checkout|switch|restore|stash|tag|rm|mv|clean|am|apply)(\s|$)/],
	build: [/^(npm|pnpm|yarn|bun)\s+(run|test|t|start|build|exec|x)(\s|$)/, /^(npx|pnpx|bunx)\s/, /^(make|cmake|cargo|go|mvn|gradle|dotnet|tsc|pytest|python3?\s+-m\s+(pytest|unittest)|jest|vitest|mocha|node\s|deno\s|ruby\s|php\s|swift\s)/],
	"package-install": [/^(npm|pnpm|yarn|bun)\s+(i|install|add|ci|link|uninstall|remove|rm|update|up)(\s|$)/, /^(pip|pip3|pipx|uv|poetry|conda)\s+(install|add|uninstall|remove|sync)(\s|$)/, /^(apt|apt-get|dnf|yum|pacman|apk|zypper|brew|port|snap|flatpak|gem|cargo\s+install|go\s+install|nix-env)(\s|$)/],
	privileged: [/^(sudo|doas|su|pkexec|runuser|setpriv|chroot)(\s|$)/, /^(systemctl|service|reboot|shutdown|halt|poweroff|mount|umount|modprobe|insmod|iptables|nft|ufw|useradd|usermod|passwd|chown|chgrp)(\s|$)/],
	destructive: [/^rm\s+(-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)(\s|$)/, /^(rm|rmdir|shred|unlink)\s+.*(\s|^)(\/|~|\.\.|\*|\.git)(\s|$)/, /^(dd|mkfs|fdisk|parted|wipefs)(\s|$)/, /^git\s+(push\s+.*(-f|--force|--delete|--mirror)|branch\s+-D|reset\s+--hard|clean\s+-[a-zA-Z]*[fxd]|stash\s+(drop|clear))(\s|$)/, /^(truncate|:>|>\s*\/dev\/sd)/, /^(find|fd)\s+.*(-delete|-exec\s+rm)/, /^(chmod|chown)\s+(-R\s+)?(777|000)\s/],
