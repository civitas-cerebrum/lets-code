    log "theme: ${theme/system/auto} (saved in ${settings}; /settings changes it)"
}

# ------------------------------------------------------------- memory guard
# A runaway command the agent runs (an unbounded search in a test, a leaking
# build) can eat the whole machine. When that machine also hosts the model
# server, the result is minutes of swap thrash and then a global OOM kill that
# can hit the server or the desktop (2026-09-25: a pi-run unittest reached
# 26 GB twice on the box serving the model).
#
# The guard watches the machine's REMAINING RAM (MemAvailable) and acts only on
# processes this lets-code session started -- never on anything else:
#   < 20 % free   pi is warned after each tool call
#   < 10 % free   pi's new non-cleanup bash commands are blocked
#   <  5 % free   (3 s) the largest session process is stopped gracefully:
#                 other big session processes paused, SIGINT -> SIGTERM -> SIGKILL
#   < 2.5 % free  the largest session process is SIGKILLed immediately
# No memory caps: nothing is limited until the machine as a whole runs low.
# It lives in a pi extension (memory-guard) that runs inside pi, so
# "this session" = descendants of that pi, plus anything in the session's
# systemd user scope (orphans re-parented to PID 1 keep their scope). The scope
# (lets-code-<pid>.scope, no root needed) also sets OOMPolicy=continue: if the
# kernel OOM-kills one process, systemd's default would stop the whole session.
# A machine-wide memguard daemon (github.com/civitas-cerebrum/memguard,
# /run/memguard present) already covers lets-code sessions: the extension then
# stays out of the way. Linux only; elsewhere the guard is off.
mem_limited_ancestor() {  # prints the nearest ancestor cgroup with a finite memory.max, if any
    local rel d
    rel="$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)" || return 0
    d="/sys/fs/cgroup${rel}"
    while [ "${d}" != "/sys/fs/cgroup" ] && [ -n "${d}" ]; do
        if [ -r "${d}/memory.max" ] && [ "$(cat "${d}/memory.max")" != "max" ]; then
            echo "${d#/sys/fs/cgroup}"; return 0
        fi
        d="${d%/*}"
    done
}

mem_guard_plan() {  # sets MG_MODE (scope|process|off) and MG_NOTE
    MG_MODE=off; MG_NOTE=""
    case "${MEM_GUARD}" in false|no|0|off) MG_NOTE="disabled"; return 0 ;; esac
    if [ "$(uname -s)" != Linux ]; then MG_NOTE="not available on $(uname -s)"; return 0; fi
    MG_MODE=process   # the extension alone: this pi's descendants
    local limited
    limited="$(mem_limited_ancestor)"
    if [ -n "${limited}" ]; then
        # a user scope would move pi OUT of a cgroup that has its own memory limits
        MG_NOTE="inside memory-limited cgroup ${limited}; no session scope"; return 0
    fi
    if ! command -v systemd-run >/dev/null 2>&1; then
        MG_NOTE="systemd-run not found; no session scope"; return 0
    fi
    # one cheap probe: user manager reachable and OOMPolicy accepted on scopes (systemd >= 253)
    if ! systemd-run --user --scope --quiet --collect -p OOMPolicy=continue true >/dev/null 2>&1; then
        MG_NOTE="systemd user scopes unavailable; no session scope"; return 0
    fi
    MG_MODE=scope
}

mem_guard_exec() {  # mem_guard_exec <cmd> [args...] -- replaces this process
    # exec replaces the shell, so the EXIT trap never runs: drop the probe file now
    rm -f "${PROBE_OUT:-}"
    if [ "${MG_MODE}" != off ]; then export LETS_CODE_SESSION=1; fi
    if [ "${MG_MODE}" = scope ]; then
        exec systemd-run --user --scope --quiet --collect --unit="lets-code-$$" \
            -p OOMPolicy=continue -- "$@"
    fi
    exec "$@"
}

# Footer and metrics: replaces pi's footer with lets-code's own, in one
# style and two sizes. Minimal (default): tokens sent and received, the
# session's tokens/s with a spinner while a response streams, context use.
# Full (/metrics): adds the directory and branch, model and thinking level,
# cache reads and hit rate, cost, time to first token and output tokens.
# Written on every launch; the size last picked with /metrics is where the
# next session starts (METRICS=true until one is picked). With
# LETS_CODE_METRICS_LOG (--metrics-log) it also appends the numbers to a JSON
# lines file, with or without a UI. Inert outside a lets-code launch; draws
# nothing without a UI. Rewritten when its content changes.
pi_write_metrics_extension() {
    local dir f tmp
    lc_ext_module footer; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.footer.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (footer and metrics); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code (LETS_CODE_METRICS_ON set); the
// footer needs a UI, the metrics log below does not. Replaces pi's footer with one in a single style (dim, " · " between
// parts), in two sizes switched with /metrics:
//   minimal (the default):
//     ↑222k ↓25k · 161.7 tok/s · 22.0%/262k (auto)
//   full (/metrics, METRICS=true or --metrics; the size picked with /metrics
//   is saved to LETS_CODE_METRICS_SAVE and the next launch starts in it):
//     ~/github/app (main)                              qwen3.8-27b • medium
//     ↑222k ↓25k · 22.0%/262k (auto) · cache 198k (86%) · $0.012
//     ⠸ 161.7 tok/s · TTFT 1.0s · 2.7k out · done in 1m 23s
// ↑ every prompt token sent, cached ones included; ↓ every token received,
// counting up while a response streams; tok/s the session's generation
// speed, from each response's first streamed token to its end (prompt
// processing is not in it; the response on its way counts too), with a
// small spinner while a response is on its way; context use is yellow over
// 70 % and red over 90 %, as in pi. The full size adds the directory and
// git branch, the model and thinking level, the latest request's cache
// hit rate, cost when there is one, and the latest response's
// time to first token and output tokens. Live token counts are estimated
// from the streamed text with a characters-per-token ratio learned from the
// provider's exact counts (4 until the first response); "~" marks an
// estimate the provider never replaced. Other extensions' statuses keep a
// line of their own. /metrics toggles the size; /metrics on|off picks one.
// The footer follows the session on screen: while a subagent's session is
// open (/subagents, in place or switched), the numbers, the model and the
// thinking level are that run's (its own session's totals, asked over RPC
// after each of its responses), the minimal size led by its name and level
// and the full one naming it after the directory; back in the main session
// they are the main session's again.
// Nothing reaches the model.
//
// Metrics log: with LETS_CODE_METRICS_LOG=<file> (--metrics-log <file>) the
// same numbers are appended to <file> as JSON lines, one object per event,
// written as it happens (append-only, parent directory created; a file that
// cannot be written is skipped silently). Works without a UI (-p, --mode
// json) and in subagents (child pi, LETS_CODE_SUBAGENT_DEPTH > 0), which
// inherit the variable and write the same file. Every record has type, ts
// (ISO time), depth (0 = the top session) and pid (to tell concurrent
// sessions apart); times are in ms, null where unknown:
//   {"type":"session", ts, model, provider, context_window, thinking_level, depth, pid}
//     once, at session start
//   {"type":"request", ts, ttft_ms, gen_ms, output_tokens, input_tokens, cached_tokens,
//    cache_hit_pct, tok_s, estimated, thinking_level, stop_reason, depth, pid}
//     per model response: ttft_ms request sent to first streamed token, gen_ms
//     first token to end; input_tokens every prompt token sent (cached included:
//     input + cacheRead + cacheWrite), cached_tokens the cache reads;
//     estimated = the provider gave no output count (estimated from the text);
//     thinking_level as of the request
//   {"type":"prompt", ts, duration_ms, requests, tool_calls, subagent_calls,
//    subagent_tasks, outcome, depth, pid}
//     per user prompt, agent_start to agent_settled; outcome completed |
//     interrupted | error (the last response's stop reason); subagent_tasks
//     counts each call's tasks or chain steps (1 for a single task)
//   {"type":"session_end", ts, reason, duration_ms, prompts, requests, tool_calls,
//    subagent_calls, subagent_tasks, input_tokens, output_tokens, cached_tokens, depth, pid}
//     at session shutdown (quit, /new, /resume, ...), totals for the session
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { appendFileSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve, isAbsolute, sep } from "node:path";
import { homedir } from "node:os";

const DELTAS = new Set(["text_delta", "thinking_delta", "toolcall_delta"]);
// pi's own working-spinner frames: braille is in nearly every terminal
// font, so every frame has the same width and shape (dingbats like ✢ ✶ ✻
// come from fallback fonts in many terminals and change size per frame)
export const FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
export const FRAME_MS = 200;
export const NUMBERS_MS = 1000;   // the numbers move once a second; the glyph every frame

// pi's footer format: 999, 1.2k, 45k, 1.2M
export function compact(n: number): string {
	if (n < 1000) return String(n);
	if (n < 10_000) return `${(n / 1000).toFixed(1)}k`;
	if (n < 1_000_000) return `${Math.round(n / 1000)}k`;
	if (n < 10_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
	return `${Math.round(n / 1_000_000)}M`;
}

export function rate(output: number, ms: number): number | undefined {
	return output > 0 && ms >= 50 ? output / (ms / 1000) : undefined;
}

export function tilde(cwd: string, home = homedir()): string {
	const r = relative(resolve(home), resolve(cwd));
	if (r === "") return "~";
	return r === ".." || r.startsWith(".." + sep) || isAbsolute(r) ? cwd : `~${sep}${r}`;
}

type Color = (c: string, s: string) => string;
const plain: Color = (_c, s) => s;

export interface Stats {
	sent: number; received: number; cached: number; written: number; hit?: number; cost: number;
	tps?: number; glyph?: string;
	firstMs?: number; waiting?: boolean; out?: number; estimated?: boolean;
	percent?: number | null; window: number; auto: boolean;
	runMs?: number; running?: boolean; stopped?: boolean;
	label?: string;   // whose numbers (a subagent's session on screen): its name and thinking level
	noContext?: boolean;   // context use not known (a run saved before its numbers were kept): left out
}

// how long a prompt took, from sending it until pi settled: 14s, 1m 23s, 1h 2m
export function duration(ms: number): string {
	const t = Math.max(0, Math.floor(ms / 1000));
	if (t < 60) return `${t}s`;
	if (t < 3600) return `${Math.floor(t / 60)}m ${t % 60}s`;
	return `${Math.floor(t / 3600)}h ${Math.floor((t % 3600) / 60)}m`;
}
export function runText(s: Stats): string {
	if (s.runMs === undefined) return "";
	return s.running ? `working ${duration(s.runMs)}` : s.stopped ? `stopped after ${duration(s.runMs)}` : `done in ${duration(s.runMs)}`;
}

// The stats. Minimal: one line (token counts, speed, context), wrapped
// between parts when the terminal is narrow. Full: always two lines, so the
// footer's height never changes mid-session: the session (token counts,
// context, cache, cost) and the speed (tok/s, TTFT, output). A line too
// wide for the terminal loses detail in order: the session line shortens
// the cache to its hit rate, then drops the cost, then the cache; the speed
// line drops the output, then TTFT. Token counts, context and speed stay.
// the full size on one line from this width on: its shortest form (tokens,
// context, speed, the prompt's clock) fits at their widest; the width alone
// decides, so the footer never changes height as the numbers grow
export const ONE_LINE_MIN = 78;
export function statsLines(s: Stats, full: boolean, color: Color = plain, w = Infinity, one = false): string[] {
	const pct = s.percent === null || s.percent === undefined ? "?" : `${s.percent.toFixed(1)}%`;
	const ctxText = `${pct}/${compact(s.window)}${s.auto ? " (auto)" : ""}`;
	const v = s.percent ?? 0;
	const ctx = s.noContext ? "" : v > 90 ? color("error", ctxText) : v > 70 ? color("warning", ctxText) : color("dim", ctxText);
	const io = [s.sent ? `↑${compact(s.sent)}` : "", s.received ? `↓${compact(s.received)}` : ""].filter(Boolean).join(" ");
	const speed = `${s.glyph ? s.glyph + " " : ""}${s.tps !== undefined ? s.tps.toFixed(1) + " tok/s" : full ? "– tok/s" : "…"}`;
	const sep = color("dim", " · ");
	const vis = (parts: string[]) => parts.reduce((n, p) => n + width(p), 0) + 3 * Math.max(0, parts.length - 1);
	// the first variant (most detail first) that fits; else the last
	const fit = (variants: string[][]) => (variants.find((p) => vis(p) <= w) ?? variants[variants.length - 1]).join(sep);
	const d = (t: string) => color("dim", t);
	if (!full) {
		const parts = [s.label ? color("accent", s.label) : "", io ? d(io) : "", s.tps !== undefined || s.glyph ? d(speed) : "", ctx].filter(Boolean);
		if (vis(parts) <= w || parts.length < 2) return [parts.join(sep)];
		// narrow: break between parts
		const rows: string[][] = [[]];
		for (const p of parts) { const r = rows[rows.length - 1]; if (r.length && vis([...r, p]) > w) rows.push([p]); else r.push(p); }
		return rows.map((r) => r.join(sep));
	}
	const head = [io ? d(io) : "", ctx].filter(Boolean);
	const hit = (s.cached || s.written) && s.hit !== undefined ? Math.round(s.hit) : undefined;
	const cacheLong = hit !== undefined && s.cached ? [d(`cache ${compact(s.cached)} (${hit}%)`)] : [];
	const cacheShort = hit !== undefined ? [d(`cache ${hit}%`)] : [];
	const cost = s.cost > 0 ? [d(`$${s.cost.toFixed(3)}`)] : [];
	const session = fit([[...head, ...(cacheLong.length ? cacheLong : cacheShort), ...cost], [...head, ...cacheShort, ...cost], [...head, ...cacheShort], head]);
	const ttft = s.firstMs !== undefined ? [d(`TTFT ${(s.firstMs / 1000).toFixed(1)}s${s.waiting ? "…" : ""}`)] : [];
	const out = s.out !== undefined ? [d(`${s.estimated ? "~" : ""}${compact(s.out)} out`)] : [];
	const run = runText(s) ? [d(runText(s))] : [];
	if (one) {   // session and moment on one line: detail drops first (cache size, output, cost, TTFT, cache)
		const cache = cacheLong.length ? cacheLong : cacheShort;
		return [fit([[...head, ...cache, ...cost, d(speed), ...ttft, ...out, ...run], [...head, ...cacheShort, ...cost, d(speed), ...ttft, ...out, ...run], [...head, ...cacheShort, ...cost, d(speed), ...ttft, ...run],
			[...head, ...cacheShort, d(speed), ...ttft, ...run], [...head, ...cacheShort, d(speed), ...run], [...head, d(speed), ...run]])];
	}
	const rate = fit([[d(speed), ...ttft, ...out, ...run], [d(speed), ...ttft, ...run], [d(speed), ...run], [d(speed)]]);
	return [session, rate];
}

// the stats on one line, however wide
export function statsLine(s: Stats, full: boolean, color: Color = plain): string { return statsLines(s, full, color)[0]; }

// visible width of a line with ANSI colors
export function width(s: string): number { return [...s.replace(/\x1b\[[0-9;]*m/g, "")].length; }

// cut a line with ANSI colors to a visible width
export function cut(s: string, w: number): string {
	let out = "", seen = 0, cutoff = false;
	for (let i = 0; i < s.length; ) {
		const esc = /^\x1b\[[0-9;]*m/.exec(s.slice(i));
		if (esc) { out += esc[0]; i += esc[0].length; continue; }
		const ch = String.fromCodePoint(s.codePointAt(i)!);
		if (seen >= w) { cutoff = true; break; }
		out += ch; seen++; i += ch.length;
	}
	return cutoff ? out + "\x1b[0m" : out;
}

// left and right on one line, right side dropped first when it does not fit
export function spread(left: string, right: string, w: number): string {
	const lw = width(left), rw = width(right);
	if (!right || lw + 2 + rw > w) return cut(left, w);
	return left + " ".repeat(w - lw - rw) + right;
}

type Theme = { fg(c: string, s: string): string };
type FooterData = { getExtensionStatuses(): ReadonlyMap<string, string>; getGitBranch?(): string | null; getAvailableProviderCount?(): number };
type Ctx = {
	hasUI: boolean; cwd?: string;
	ui: { setStatus(k: string, v: string | undefined): void; notify(m: string, t?: "info" | "warning" | "error"): void; theme?: Theme; setFooter?(f: unknown): void };
	sessionManager?: { getEntries(): any[]; getCwd?(): string; getSessionName?(): string | undefined };
	getContextUsage?(): { percent: number | null; contextWindow: number } | undefined;
	model?: { id?: string; provider?: string; reasoning?: boolean; contextWindow?: number };
};

// the run whose session is on screen (the subagents module's view state), if any
export const viewedRun = (): any => {
	const reg = (globalThis as any)[Symbol.for("lets-code.subagent-runs")];
	const id = reg?.view?.viewing;
	return id && Array.isArray(reg.runs) ? reg.runs.find((r: any) => r?.id === id) : undefined;
};
// a subagent's numbers as the footer's: its own session's (rec.stats), else the run's counts
export const runStats = (r: any, auto: boolean, now = Date.now()): Stats => {
	const x = r.stats ?? {}, n = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : 0);
	const sent = r.stats ? n(x.input) + n(x.cacheRead) + n(x.cacheWrite) : n(r.input);
	const received = (r.stats ? n(x.output) : n(r.output)) + n(r.live);
	const cu = x.contextUsage;
	// the level only for a model that reasons (known once the child's state has come)
	const level = x.reasoning === true && typeof x.thinkingLevel === "string" ? x.thinkingLevel : "";
	const s: Stats = { sent, received, cached: n(x.cacheRead), written: n(x.cacheWrite), hit: x.hit, cost: n(x.cost),
		tps: typeof x.tokPerSec === "number" ? x.tokPerSec : undefined, percent: cu ? cu.percent : null, window: n(cu?.contextWindow) || n(x.contextWindow), auto,
		noContext: !cu && !(n(x.contextWindow) > 0),
		label: `${r.agent}${level ? ` • ${level}` : ""}` };
	if (typeof x.ttftMs === "number") s.firstMs = x.ttftMs;
	if (typeof x.lastOut === "number") s.out = x.lastOut;
	if (typeof r.started === "number") {
		if (r.status === "running") { s.runMs = now - r.started; s.running = true; }
		else if (typeof r.ended === "number") { s.runMs = r.ended - r.started; s.stopped = r.status === "aborted" || r.status === "failed" || r.status === "timeout"; }
	}
	return s;
};

// one JSON line appended to the metrics log; never throws
// the footer size picked with /metrics, kept for the next launch (other keys in the file stay)
export function saveFull(file: string, full: boolean): void {
	let doc: any = {};
	try { doc = JSON.parse(readFileSync(file, "utf8")); } catch { /* missing or unreadable: start over */ }
	if (!doc || typeof doc !== "object" || Array.isArray(doc)) doc = {};
	if (doc.metrics === full) return;
	doc.metrics = full;
	const tmp = `${file}.${process.pid}.tmp`;
	writeFileSync(tmp, JSON.stringify(doc, null, 2) + "\n", { mode: 0o600 });
	renameSync(tmp, file);
}
export function appendRecord(file: string, rec: Record<string, unknown>): boolean {
	if (!file) return false;
	try {
		mkdirSync(dirname(file), { recursive: true });
		appendFileSync(file, JSON.stringify(rec) + "\n");
		return true;
	} catch { return false; }
}
const round1 = (n: number | undefined) => (n === undefined || !Number.isFinite(n) ? null : Math.round(n * 10) / 10);
export function outcome(stopReason: string): "completed" | "interrupted" | "error" {
	return stopReason === "aborted" ? "interrupted" : stopReason === "error" ? "error" : "completed";
}
// tool calls in an assistant message, and the subagent tool's calls and tasks
// (an expert run counts as one, with its runs as tasks)
export function toolCounts(content: unknown): { tools: number; subagents: number; tasks: number } {
	const c = { tools: 0, subagents: 0, tasks: 0 };
	if (!Array.isArray(content)) return c;
	for (const p of content) {
		if (p?.type !== "toolCall") continue;
		c.tools++;
		const a = p.arguments ?? {};
		if (p.name === "expert" && a.action === "run") { c.subagents++; c.tasks += (Array.isArray(a.runs) && a.runs.length) || 1; continue; }
		if (p.name !== "subagent") continue;
		c.subagents++;
		c.tasks += (Array.isArray(a.tasks) && a.tasks.length) || (Array.isArray(a.chain) && a.chain.length) || 1;
	}
	return c;
}

function autoCompaction(): boolean {
	try {
		const dir = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
		return JSON.parse(readFileSync(join(dir, "settings.json"), "utf8"))?.compaction?.enabled !== false;
	} catch { return true; }
}

export default function (pi: ExtensionAPI) {
	if (process.env.LETS_CODE_METRICS_ON === undefined) return;
	let full = process.env.LETS_CODE_METRICS_ON === "1";
	let sentAt: number | undefined, firstAt: number | undefined, chars = 0;
	let totalOut = 0, totalMs = 0, frame = 0, glyph = "";
	// the prompt's own clock: agent_start to agent_settled (pi continues on its own in between)
	let runStart: number | undefined, lastRunMs: number | undefined, lastStopped = false, stopReason = "";
	let runTimer: ReturnType<typeof setInterval> | undefined;
	let lastFirstMs: number | undefined, lastOut: number | undefined, lastEstimated = false;
	let calTokens = 0, calChars = 0;
	let ui: Ctx | undefined, timer: ReturnType<typeof setInterval> | undefined;
	let tuiRef: { requestRender(): void } | undefined;
	let usageCache: { n: number; sent: number; received: number; cached: number; written: number; cost: number; hit?: number } = { n: -1, sent: 0, received: 0, cached: 0, written: 0, cost: 0 };
	const AUTO = autoCompaction();
	// the metrics log (see the top): measured with or without a UI
	const LOG = process.env.LETS_CODE_METRICS_LOG ?? "";
	const DEPTH = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
	const record = (type: string, fields: Record<string, unknown>) => {
		if (LOG) appendRecord(LOG, { type, ts: new Date(Date.now()).toISOString(), ...fields, depth: DEPTH, pid: process.pid });
	};
	const level = () => { try { return pi.getThinkingLevel?.() ?? null; } catch { return null; } };
	let reqLevel: string | null = null, sessionAt: number | undefined, sessionLogged = false;
	let run = { requests: 0, tools: 0, subagents: 0, tasks: 0 };
	const tot = { prompts: 0, requests: 0, tools: 0, subagents: 0, tasks: 0, input: 0, output: 0, cached: 0 };
	const endPrompt = (reason: string) => {
		if (runStart === undefined) return;
		record("prompt", { duration_ms: Date.now() - runStart, requests: run.requests, tool_calls: run.tools,
			subagent_calls: run.subagents, subagent_tasks: run.tasks, outcome: reason ? outcome(reason) : "completed" });
		tot.prompts++;
	};

	const perChar = () => (calChars > 0 ? calTokens / calChars : 0.25);
	const liveOut = () => (sentAt !== undefined && firstAt !== undefined ? Math.round(chars * perChar()) : 0);
	const avgNow = () => (sentAt !== undefined && firstAt !== undefined
		? rate(totalOut + liveOut(), totalMs + (Date.now() - firstAt)) : rate(totalOut, totalMs));
	const usage = () => {
		const entries = ui?.sessionManager?.getEntries?.() ?? [];
		if (entries.length === usageCache.n) return usageCache;
		const u0 = { n: entries.length, sent: 0, received: 0, cached: 0, written: 0, cost: 0, hit: undefined as number | undefined };
		for (const e of entries) {
			const u = e?.type === "message" && e.message?.role === "assistant" ? e.message.usage : undefined;
			if (!u) continue;
			const prompt = (u.input ?? 0) + (u.cacheRead ?? 0) + (u.cacheWrite ?? 0);
			u0.sent += prompt; u0.received += u.output ?? 0;
			u0.cached += u.cacheRead ?? 0; u0.written += u.cacheWrite ?? 0;
			u0.cost += (typeof u.cost === "object" ? u.cost?.total : u.cost) ?? 0;
			u0.hit = prompt > 0 ? ((u.cacheRead ?? 0) / prompt) * 100 : undefined;
		}
		usageCache = u0;
		return u0;
	};
	// while a response streams, the numbers are held for NUMBERS_MS and only
	// the glyph moves; a new phase (sent, first token, done) shows at once
	let held: { at: number; s: Stats } | undefined;
	const stats = (): Stats => {
		const vr = viewedRun();
		if (vr) return runStats(vr, AUTO);   // a subagent's session on screen: its numbers
		if (sentAt !== undefined && held && Date.now() - held.at < NUMBERS_MS) return { ...held.s, glyph: glyph || undefined };
		const u = usage();
		const cu = ui?.getContextUsage?.();
		const s: Stats = { sent: u.sent, received: u.received + liveOut(), cached: u.cached, written: u.written, hit: u.hit, cost: u.cost,
			tps: avgNow(), glyph: glyph || undefined, percent: cu ? cu.percent : 0, window: cu?.contextWindow ?? ui?.model?.contextWindow ?? 0, auto: AUTO };
		if (sentAt !== undefined) {
			if (firstAt === undefined) { s.firstMs = Date.now() - sentAt; s.waiting = true; }
			else { s.firstMs = firstAt - sentAt; s.out = liveOut(); }
		} else if (lastFirstMs !== undefined || lastOut !== undefined) {
			s.firstMs = lastFirstMs; s.out = lastOut; s.estimated = lastEstimated;
		}
		if (runStart !== undefined) { s.runMs = Date.now() - runStart; s.running = true; }
		else if (lastRunMs !== undefined) { s.runMs = lastRunMs; s.stopped = lastStopped; }
		held = sentAt !== undefined ? { at: Date.now(), s } : undefined;
		return s;
	};
	// the directory left; the mode (when given) and the model right, the
	// directory shortened for them; placed: false when the mode did not fit
	const topLine = (data: FooterData, w: number, color: Color, mode = ""): { line: string; placed: boolean } => {
		let where = tilde(ui?.sessionManager?.getCwd?.() ?? ui?.cwd ?? process.cwd());
		const branch = data.getGitBranch?.();
		if (branch) where += ` (${branch})`;
		// a subagent's session on screen: its name, model and thinking level
		const vr = viewedRun(), vx = vr?.stats;
		const name = vr ? String(vr.agent ?? "subagent") : ui?.sessionManager?.getSessionName?.();
		if (name) where += ` • ${name}`;
		const m = vr ? (vx?.model ? { id: vx.model, provider: vx.provider, reasoning: vx.reasoning === true } : undefined) : ui?.model;
		// Claude through Claude Code (the claude module) reads as Anthropic's: (anthropic) haiku
		const claude = !!m?.provider && m.provider === (process.env.LETS_CODE_CLAUDE_PROVIDER || "Anthropic");
		// a run saved before its numbers were kept: no model to name, the right side stays empty
		let model = m?.id ? (claude ? m.id.replace(/^claude-/, "") : m.id) : vr ? "" : "no model";
		if (m?.reasoning) { const lvl = (vr ? vx?.thinkingLevel : pi.getThinkingLevel?.()) ?? "off"; model += lvl === "off" ? " • thinking off" : ` • ${lvl}`; }
		if ((data.getAvailableProviderCount?.() ?? 1) > 1 && m?.provider) model = `(${claude ? "anthropic" : m.provider}) ${model}`;
		const right = mode ? (model ? `${mode}${color("dim", " · ")}${color("dim", model)}` : mode) : model ? color("dim", model) : "";
		const room = w - width(right) - 2;
		if (mode && room >= 12) return { line: spread(color("dim", width(where) > room ? `${cut(where, room - 1)}…` : where), right, w), placed: true };
		return { line: spread(color("dim", where), model ? color("dim", model) : "", w), placed: false };
	};
	// lines other lets-code modules put in the footer, above the numbers (the
	// subagents list of /subagents toggle): globalThis, so a module loaded
	// again after a reload or a session switch replaces its own block
	const host = ((globalThis as any)[Symbol.for("lets-code.footer-blocks")] ??= { blocks: new Map() });
	const footer = (tui: { requestRender(): void }, theme: Theme, data: FooterData) => {
		tuiRef = tui;
		const color: Color = (c, s) => theme.fg(c, s);
		return {
			render(w: number): string[] {
				const lines: string[] = [];
				for (const block of (host.blocks as Map<string, (w: number, c: Color) => string[]>).values()) {
					try { for (const l of block(w, color)) lines.push(cut(l, w)); } catch { /* a block's problem, not the footer's */ }
				}
				// every status dim like the rest, unless it brings its own colors; the
				// mandate's mode at the right: of the top line (full size), else of the
				// last numbers line, else on its own line
				const tone = (v: string) => (/\x1b\[/.test(v) ? v : color("dim", v));
				const all = [...data.getExtensionStatuses()].sort(([a], [b]) => a.localeCompare(b)).map(([k, v]) => [k, v.replace(/\s+/g, " ").trim()] as const).filter(([, v]) => v);
				let mode = all.find(([k]) => k === "mandate")?.[1];
				const others = all.filter(([k]) => k !== "mandate").map(([, v]) => tone(v));
				// next to the model it is the mode's name alone, and the default (auto) is not shown
				if (full) { const name = (mode ?? "").replace(/^mode:\s*/, ""); const top = topLine(data, w, color, name && name !== "auto" ? tone(name) : ""); lines.push(top.line); if (top.placed || name === "auto") mode = undefined; }
				const numbers = statsLines(stats(), full, color, w, full && w >= ONE_LINE_MIN).map((l) => cut(l, w));
				if (mode) {
					const last = numbers.length ? numbers[numbers.length - 1] : "";
					const right = tone(mode);
					if (last && width(last) + 2 + width(right) <= w) numbers[numbers.length - 1] = spread(last, right, w);
					else numbers.push(width(right) < w ? " ".repeat(w - width(right)) + right : cut(right, w));
				}
				lines.push(...numbers);
				if (others.length) lines.push(cut(others.join(" "), w));
				return lines;
			},
			invalidate() {},
			dispose() { if (tuiRef === tui) tuiRef = undefined; },
		};
	};
	const repaint = () => tuiRef?.requestRender();
	host.repaint = repaint;
	const tick = () => { if (sentAt === undefined) return; glyph = FRAMES[frame++ % FRAMES.length]; repaint(); };
	const stop = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } glyph = ""; };
	const start = () => {
		stop();
		if (!ui || sentAt === undefined) return;
		frame = 0; tick();
		timer = setInterval(tick, FRAME_MS);
		(timer as { unref?: () => void }).unref?.();
	};
	// the UI context, kept for drawing; measuring never needs it
	const take = (ctx: unknown) => { const c = ctx as Ctx; if (!c?.hasUI) return false; ui = c; return true; };

	pi.on("session_start", (_e, ctx) => {
		const c = ctx as Ctx;
		if (!sessionLogged) {
			sessionLogged = true; sessionAt = Date.now();
			const m = c?.model;
			record("session", { model: m?.id ?? null, provider: m?.provider ?? null,
				context_window: c?.getContextUsage?.()?.contextWindow ?? m?.contextWindow ?? null, thinking_level: level() });
		}
		if (take(ctx)) ui!.ui.setFooter?.(footer);
	});
	pi.on("session_shutdown", (event) => {
		if (!sessionLogged || sessionAt === undefined) return;
		// a prompt still open: cut short, unless its last response had finished the turn
		endPrompt(sentAt !== undefined || stopReason === "" || stopReason === "toolUse" ? "aborted" : stopReason);
		runStart = undefined;
		if (runTimer !== undefined) { clearInterval(runTimer); runTimer = undefined; }
		record("session_end", { reason: (event as { reason?: string })?.reason ?? null, duration_ms: Date.now() - sessionAt,
			prompts: tot.prompts, requests: tot.requests, tool_calls: tot.tools, subagent_calls: tot.subagents, subagent_tasks: tot.tasks,
			input_tokens: tot.input, output_tokens: tot.output, cached_tokens: tot.cached });
		sessionAt = undefined;
	});
	pi.on("before_provider_request", (_e, ctx) => {
		sentAt = Date.now(); firstAt = undefined; chars = 0; held = undefined; reqLevel = level();
		if (take(ctx)) start();
	});
	pi.on("message_update", (event) => {
		const e = event.assistantMessageEvent as { type: string; delta?: string };
		if (!DELTAS.has(e.type)) return;
		if (firstAt === undefined) { firstAt = Date.now(); held = undefined; }
		chars += e.delta?.length ?? 0;
	});
	pi.on("message_end", (event, ctx) => {
		const m = event.message as { role?: string; usage?: { input?: number; cacheRead?: number; cacheWrite?: number; output?: number }; stopReason?: string; content?: unknown };
		if (m.role !== "assistant") return;
		stopReason = m.stopReason ?? "";
		take(ctx);
		const tc = toolCounts(m.content);
		run.requests++; run.tools += tc.tools; run.subagents += tc.subagents; run.tasks += tc.tasks;
		tot.requests++; tot.tools += tc.tools; tot.subagents += tc.subagents; tot.tasks += tc.tasks;
		if (sentAt === undefined) return;
		const endAt = Date.now();
		const reported = m.usage?.output ?? 0;
		const output = reported > 0 ? reported : Math.round(chars * perChar());
		if (reported > 0 && chars > 0) { calTokens += reported; calChars += chars; }
		if (firstAt !== undefined && rate(output, endAt - firstAt) !== undefined) { totalOut += output; totalMs += endAt - firstAt; }
		lastFirstMs = (firstAt ?? endAt) - sentAt; lastOut = output; lastEstimated = reported <= 0;
		if (LOG) {
			const u = m.usage ?? {};
			const input = (u.input ?? 0) + (u.cacheRead ?? 0) + (u.cacheWrite ?? 0), cached = u.cacheRead ?? 0;
			const gen = firstAt !== undefined ? endAt - firstAt : 0;
			tot.input += input; tot.output += output; tot.cached += cached;
			record("request", { ttft_ms: lastFirstMs, gen_ms: gen, output_tokens: output, input_tokens: input, cached_tokens: cached,
				cache_hit_pct: input > 0 ? round1((cached / input) * 100) : null, tok_s: round1(rate(output, gen)),
				estimated: lastEstimated, thinking_level: reqLevel, stop_reason: m.stopReason ?? null });
		}
		sentAt = undefined;
		stop(); repaint();
	});
	// an interrupted or failed run ends without message_end: stop the spinner
	pi.on("agent_end", () => { if (sentAt !== undefined) { sentAt = undefined; stop(); repaint(); } });
	// the prompt's clock; the footer counts it up once a second while pi works
	pi.on("agent_start", (_e, ctx) => {
		if (runStart !== undefined) return;
		runStart = Date.now(); stopReason = "";
		run = { requests: 0, tools: 0, subagents: 0, tasks: 0 };
		if (!take(ctx)) return;
		runTimer = setInterval(repaint, 1000);
		(runTimer as { unref?: () => void }).unref?.();
		repaint();
	});
	pi.on("agent_settled", () => {
		if (runStart === undefined) return;
		endPrompt(stopReason);
		lastRunMs = Date.now() - runStart; lastStopped = stopReason === "aborted" || stopReason === "error";
		runStart = undefined;
		if (runTimer !== undefined) { clearInterval(runTimer); runTimer = undefined; }
		held = undefined; repaint();
	});
	pi.registerCommand("metrics", {
		description: "Toggle the full footer (directory, model, cache, first token, output); on = full, off = minimal",
		getArgumentCompletions: (prefix) => ["on", "off"].filter((a) => a.startsWith(prefix.trim())).map((a) => ({ value: a, label: a })),
		handler: async (args, ctx) => {
			const a = args.trim().toLowerCase();
			if (a && a !== "on" && a !== "off") { ctx.ui.notify("usage: /metrics [on|off]", "warning"); return; }
			full = a ? a === "on" : !full;
			const save = process.env.LETS_CODE_METRICS_SAVE;
			if (save && !(Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") > 0)) { try { saveFull(save, full); } catch { /* best effort */ } }
			if (take(ctx) && !tuiRef) ui!.ui.setFooter?.(footer);
			repaint();
			ctx.ui.notify(full ? "Full footer" : "Minimal footer", "info");
		},
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# Grounding guard: a short system-prompt section that has pi look facts up
# with its tools instead of guessing them (file contents, paths, names,
# versions, config, command output), invent nothing, say what it could not
# verify, not take an empty grep for absence, back "the system accepted it"
# with a control that must fail, and report results as they are; and a
# block, once per file, on
# overwriting an existing file the session has not read. Inert unless
# LETS_CODE_GROUNDING_ON=1. Rewritten when its content changes.
pi_write_grounding_extension() {
    local dir f tmp
    lc_ext_module grounding; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.grounding.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (grounding guard); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with the grounding guard on
// (LETS_CODE_GROUNDING_ON=1). Two parts:
//   * a short system-prompt section: today's local date and time zone
//     (local models guess dates badly and write them into docs); facts
//     about the project and machine
//     (file contents, paths, names, versions, config, command output) are
//     looked up with tools, not guessed; nothing is invented; what could
//     not be checked is said; an empty grep is not absence (the phone
//     that "had no mail app": Gmail is com.google.android.gm); an accepted
//     action is shown against a control that must fail; results are
//     reported as they are;
//   * overwriting an existing file the session has not read (read tool,
//     or a bash command naming it) is blocked once, with a pointer to read
//     it first; writing it again goes through, so a deliberate overwrite is
//     one retry away. New files, and files read, edited or written before,
//     are never blocked.
// Nothing else is changed: no extra turns, nothing appended to results.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { existsSync, statSync } from "node:fs";
import { resolve } from "node:path";

export const SECTION = [
	"Ground truth (lets-code):",
	"- Look, don't guess. Before you state or rely on a fact about this project or machine (what a file contains, whether a path exists, a function, flag or option name, a version, a config value, what a command prints), check it with a tool: read the file, list the directory, search, or run the command or its --help. Memory and plausible-looking names are not evidence.",
	"- Never invent identifiers, paths, URLs, numbers or command output. If something you need does not exist, say so instead of making it up.",
	"- Read a file before you change or overwrite it, and look at what you are about to delete before you delete it.",
	"- When you cannot verify something, say plainly what you could not check and why. Do not present a guess as a fact.",
	"- An empty grep is not absence: before saying something is missing or not installed, check in a way that finds it under any name (grep \"mail\" misses Gmail, com.google.android.gm; ask the system who handles the role).",
	"- rc=0 is not success: to claim the system accepted an action, also run a control that must fail (a nonexistent target) and show that it answers differently.",
	"- Report results as they are: if a command failed or a test is red, say so with the relevant output; if you skipped a step, say that.",
].join("\n");

// the date line, built per prompt so a session that runs past midnight follows
export function dateLine(now = new Date()): string {
	return `- Today is ${now.toLocaleDateString("sv-SE")} (local time, ${Intl.DateTimeFormat().resolvedOptions().timeZone}). Use this date; do not guess one.`;
}

export function blockText(path: string): string {
	return `[lets-code] ${path} already exists and has not been read in this session. ` +
		"Read it first so you know what you are replacing (or use edit for a partial change). " +
		"If replacing it without reading is intended, write it again.";
}

const isFile = (p: string) => { try { return existsSync(p) && statSync(p).isFile(); } catch { return false; } };

// files a bash command names (cat a, sed -n 1,9p b, head c ...): any word
// that is an existing file counts as looked at
export function namedFiles(command: string, cwd: string): string[] {
	const out: string[] = [];
	for (const raw of command.split(/[\s;&|()<>]+/)) {
		const w = raw.replace(/^['"]|['"]$/g, "");
		if (!w || w.startsWith("-") || w.includes("$") || w.includes("*")) continue;
		const p = resolve(cwd, w);
		if (isFile(p)) out.push(p);
	}
	return out;
}

export default function (pi: ExtensionAPI) {
	if (process.env.LETS_CODE_GROUNDING_ON !== "1") return;
	const seen = new Set<string>();      // read, edited or written this session
	const warned = new Set<string>();    // blocked once already

	pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (sections && typeof sections === "object") sections.lets_code_grounding = `${SECTION}\n${dateLine()}`;
		return undefined;
	});

	pi.on("tool_call", async (event: any, ctx: any) => {
		const cwd = ctx?.cwd ?? process.cwd();
		const input = event?.input ?? {};
		const name = event?.toolName;
		if (name === "read" || name === "edit") {
			if (input.path) seen.add(resolve(cwd, String(input.path)));
			return undefined;
		}
		if (name === "bash") {
			for (const p of namedFiles(String(input.command ?? ""), cwd)) seen.add(p);
			return undefined;
		}
		if (name !== "write" || !input.path) return undefined;
		const p = resolve(cwd, String(input.path));
		if (seen.has(p) || warned.has(p) || !isFile(p)) { seen.add(p); return undefined; }
		warned.add(p);
		return { block: true, reason: blockText(String(input.path)) };
	});
}
