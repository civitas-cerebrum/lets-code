	}
	save(now = Date.now()): void {
		mkdirSync(this.dir, { recursive: true, mode: 0o700 });
		this.entries.sort((a, b) => a.t - b.t);
		atomic(this.file, this.entries.map((e) => JSON.stringify(e)).join("\n") + (this.entries.length ? "\n" : ""));
		atomic(this.md, this.render(now));
		this.reindex();
	}
	newId(now: number): string {
		for (;;) { const id = now.toString(36).slice(-4) + Math.random().toString(36).slice(2, 4); if (!this.entries.some((e) => e.id === id)) return id; }
	}
	// adds, or updates the entry it matches: the same run, factory or session
	// pointer (whatever the gist), or the same gist (pointers are merged)
	upsert(e: { kind?: string; gist: string; refs?: string[]; by?: By; id?: string }, now = Date.now()): { entry: Entry; updated: boolean } {
		const kind = (KINDS as readonly string[]).includes(e.kind ?? "") ? (e.kind as Kind) : "fact";
		const gist = short(oneLine(e.gist).replace(/ — /g, " - "), GIST_MAX);   // " — " separates the pointers in a rendered line
		const refs = [...new Set((e.refs ?? []).map((r) => normRef(r, this.root)).filter(Boolean))];
		const ids = refs.filter(IDENTITY);
		const old = (e.id && this.entries.find((x) => x.id === e.id)) || this.entries.find((x) => ids.length && x.refs.some((r) => ids.includes(r))) || this.entries.find((x) => normGist(x.gist) === normGist(gist));
