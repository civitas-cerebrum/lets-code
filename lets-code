# Backend facts: what lets-code knows about the backend (server, model,
# API, context, thinking, vision, preset) handed to the agent only when it
# needs it: a prompt about the backend adds a short system-prompt section,
# or the first command probing the backend gets the facts in its result.
# Inert unless LETS_CODE_BACKEND is set. Rewritten when its content changes.
pi_write_backend_extension() {
    local dir f tmp
    lc_ext_module backend; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.backend.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (backend facts); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code (LETS_CODE_BACKEND set). The
// agent learns what lets-code already knows about its backend (server,
// model, API, context, thinking, vision, preset) without discovering it,
// and only when it needs it, so nothing is in context by default:
//   * a prompt that asks about the backend (which model, the server, the
//     endpoint, context window, tok/s, GPU, KV cache...; judged on the
//     user's words with code removed; a bare "endpoint" or "backend" is app work, not
//     this) adds a short section to the system
//     prompt, kept for the session (a section that comes and goes costs a
//     change note each time it flips);
//   * otherwise the first command that probes the backend (curl to /v1 or
//     /metrics, LETS_CODE_* variables, nvidia-smi, vllm/sglang/ollama,
//     models.json) gets the facts appended to its result, once.
// The API key is never written out; the facts point at $LETS_CODE_TOKEN.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

export interface Backend {
	server?: string; url?: string; api_base?: string; api?: string; model?: string; model_source?: string;
	context?: number; output_cap?: number; thinking?: string; reasoning?: boolean; vision?: boolean; preset?: string; provider?: string;
}

const k = (n?: number) => (n === undefined ? "?" : n >= 1000 ? `${Math.round(n / 1000)}k` : String(n));

// about 120 tokens
export function facts(b: Backend): string {
	const lines = [
		`Backend, observed by lets-code at launch (GET ${b.api_base ?? "the server"}/models): checked facts; re-query only for live load or cache numbers.`,
		`- Model ${b.model ?? "?"}${b.model_source === "auto" ? " (discovered from the server)" : ""}, served by ${b.server ?? "an OpenAI-compatible server"} at ${b.url ?? "?"}${b.preset ? ` (preset ${b.preset})` : ""}.`,
		`- ${b.api ?? "openai-completions"} API at ${b.api_base ?? "?"}; auth header: Authorization: Bearer $LETS_CODE_TOKEN.`,
		`- Context ${k(b.context)} tokens, output cap ${k(b.output_cap)}, thinking ${b.reasoning ? b.thinking ?? "on" : "not supported"}, vision ${b.vision ? "yes" : "no"}.`,
		`- Useful: GET ${b.api_base ?? "<api>"}/models${b.server === "vllm" ? `; GET ${b.url}/metrics (queue, KV cache, prefix-cache hits)` : ""}.`,
	];
	return lines.join("\n");
}

const strip = (p: string) => String(p ?? "").replace(/```[\s\S]*?(```|$)/g, " ").replace(/`[^`\n]*`/g, " ");
export function asksAboutBackend(prompt: string): boolean {
	return /\b((llm|model|inference|your|the model.s|ai) (backend|endpoint|server)s?|backend (model|server)|inference|vllm|sglang|ollama|lm ?studio|llama\.cpp|openrouter|model server|llm server|(which|what) model|your model|served model|base ?url|api ?key|context (window|size|length)|output cap|tok\/s|tokens? (per|a) second|throughput|ttft|gpu|kv[- ]?cache|prefix[- ]cache)\b/i.test(strip(prompt));
}
export function probesBackend(command: string): boolean {
	return /\/v1\/(models|chat|completions)\b|\/metrics\b|\bLETS_CODE_\w*|\bnvidia-smi\b|\b(vllm|sglang|ollama)\b|models\.json\b|\.config\/lets-code\b/i.test(String(command ?? ""));
}

export default function (pi: ExtensionAPI) {
	let b: Backend;
	try { b = JSON.parse(process.env.LETS_CODE_BACKEND ?? ""); } catch { return; }
	if (!b || typeof b !== "object") return;
	const text = facts(b);
	// once in context, never twice: the section (asked for) or one appended result (probed)
	let section = false, told = false;

	pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (!sections || typeof sections !== "object") return undefined;
		if (!section && !told && asksAboutBackend(event.prompt)) section = true;
		if (section) sections.lets_code_backend = text;
		return undefined;
	});
	pi.on("tool_result", async (event: any) => {
		if (section || told || event?.toolName !== "bash" || !probesBackend(event?.input?.command)) return undefined;
		told = true;
		return { content: [...(event.content ?? []), { type: "text", text: `\n[lets-code] ${text}` }] };
	});
}
