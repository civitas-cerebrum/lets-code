// Active only in a pi launched by lets-code with the mandate on
// (LETS_CODE_MANDATE_ON=1). A mandate is a named role with a scope: which
// tools may run, which paths may be read or written, which kinds of bash
// commands are allowed, asked about or denied, which MCP servers and which
// subagents may be used. The main session runs under the mode role
// (LETS_CODE_MODE, default "auto"); a subagent runs under the role its agent
// file names (LETS_CODE_ROLE). Allowed calls cost nothing: the policy never
// enters the prompt, and a denied call gets one line under 200 characters.
//
// Manifest: ~/.pi/agent/mandate.json (global, full authority) and
// .pi/mandate.json (project, may only tighten; read when the project is
// trusted). Built-in roles: plan, auto, ask, yolo.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { existsSync, readFileSync, appendFileSync, mkdirSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, isAbsolute, join, resolve, sep } from "node:path";

type Decision = "allow" | "ask" | "deny";
interface Role {
	tools?: string[];                       // allowlist of tool names; unset = all
	read?: string[];                        // path scopes readable; unset = all
	write?: string[];                       // path scopes writable; default ["."]
	external?: Decision;                    // a path outside the write (or read) scope
	bash?: Record<string, Decision>;        // command group -> decision; "*" is the default
	groups?: Record<string, string[]>;      // extra command groups: name -> regexes
	mcp?: Decision | string[];              // MCP calls: decision, or allowed server names
	dispatch?: string[];                    // subagents this role may start; ["*"] all
	network?: "on" | "off";                 // for the sandbox
	sandbox?: Record<string, unknown>;      // sandbox overrides (allowWrite, denyRead, ...)
	prompt?: string;                        // short system prompt section
	protected?: string[];                   // never written, even when in scope
	bypass?: boolean;                       // the role does nothing (yolo)
	label?: string;
}
interface Manifest { default?: string; cycle?: string[]; roles: Record<string, Role> }

const ACTIVE = process.env.LETS_CODE_MANDATE_ON === "1";
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const LOG = process.env.LETS_CODE_MANDATE_LOG || join(AGENT_DIR, "lets-code-mandate.log");
