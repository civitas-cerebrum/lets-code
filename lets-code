}
export function discoverAgents(cwd: string, trusted: boolean): AgentDef[] {
	const out = new Map<string, AgentDef>();
	// the user's expert files belong to the expert tool (their names stay taken)
	const taken = new Set<string>(discoverExperts().map((a) => a.name));
	const scan = (dir: string, source: "user" | "project", claude = false) => {
		if (!existsSync(dir)) return;
		for (const f of readdirSync(dir).sort()) { if (!f.endsWith(".md")) continue; try { const a = parseAgentFile(readFileSync(join(dir, f), "utf8"), join(dir, f), source, cwd, claude); if (a && !out.has(a.name) && !taken.has(a.name) && !(source === "user" && a.expert)) out.set(a.name, a); } catch { /* skip bad file */ } }
	};
	if (trusted) { scan(join(cwd, ".pi", "agents"), "project"); scan(join(cwd, ".agents", "agents"), "project"); }
	scan(join(AGENT_DIR, "agents"), "user");
	if (CLAUDE) {   // after pi's: the nearest .claude/agents up to the git root, then the user's
		if (process.env.LETS_CODE_CLAUDE_TRUST === "1") {
			let d = resolve(cwd);
			while (true) { if (resolve(d, ".claude") !== resolve(claudeDir())) scan(join(d, ".claude", "agents"), "project", true); if (existsSync(join(d, ".git")) || dirname(d) === d) break; d = dirname(d); }
		}
		if (process.env.LETS_CODE_CLAUDE_SCOPE === "all") scan(join(claudeDir(), "agents"), "user", true);
	}
	return [...out.values()];
}

interface RunResult { agent: string; task: string; text: string; exitCode: number; stderr: string; turns: number; input: number; output: number; step?: number; timedOut?: number; stopped?: boolean; lastSteps?: string }

// ------------------------------------------------------------ run transcripts
// Each child's JSON event stream is also kept as a transcript: the live part
// of a running child's session and the lists (subagent sessions, below).
// UI only: none of it reaches the model.
// Kept in memory for the session (on globalThis, so the copies of this module
// the experts and Claude Code modules import share it, and a /reload keeps
// it), and on disk as <agent dir>/lets-code-runs/<session id>/<run>.json
// (0600, written at most every RUN_SAVE_MS while it runs and once at the
// end), so a finished run is listed after a reload or a restart. Next to it
// is the child's own pi session file, <run>.pi.jsonl, which the TUI
// switches into. Capped: a
// tool's output keeps its head and tail (TOOL_OUT_CAP characters), a long
// argument (ARG_CAP) or text block (TEXT_CAP) is cut, a run keeps its newest
// MAX_EVENTS events, and the newest KEEP_RUNS runs of a session (and
// RUNS_SESSIONS sessions) stay on disk. Nothing is stored that the child
// did not print.
export type RunStatus = "running" | "done" | "failed" | "aborted" | "timeout";
export interface Block { type: "text" | "thinking" | "toolCall"; text: string; id?: string; name?: string; args?: unknown }
export type RunEvent = { v: number; at: number } & (
	| { t: "user"; text: string }
	| { t: "assistant"; blocks: Block[]; done: boolean; stop?: string; error?: string }
	| { t: "tool"; id: string; name: string; args: unknown; done: boolean; isError?: boolean; output: string; cut: number; details?: unknown; end?: number }
	| { t: "note"; text: string; error?: boolean });
// the parent tool call a run belongs to
export interface RunMeta { tool?: string; callId?: string; mode?: "single" | "parallel" | "chain"; index?: number; of?: number }
export interface RunRecord {
	v: 1; id: string; agent: string; kind: "subagent" | "expert"; task: string; cwd: string; session: string;
	started: number; ended?: number; status: RunStatus; exitCode?: number; turns: number; input: number; output: number; live?: number;
	parent?: RunMeta; events: RunEvent[]; dropped: number; final?: string; ver: number; seenTask?: boolean;
	sessionFile?: string;   // the child's own pi session file
	spawn?: Spawn;          // how its process starts (again): args, environment, folder
	home?: string;          // the session file of the main session it belongs to
	stats?: RunStats;       // the child's own session numbers, for the footer while its session is on screen
}
// A run's session as the footer shows it while the run's session is open
// (in place or switched): token totals, cost and context use from the child's
// get_session_stats, model and thinking level from its get_state (both asked
// after each of its responses; a pi without them leaves the numbers counted
// from the stream), the speed and time to first token from its own stream.
export type RunStats = {
	input: number; output: number; cacheRead: number; cacheWrite: number; cost: number;
	hit?: number;                 // the latest response's cache hit rate, %
	contextUsage?: { tokens: number | null; contextWindow: number; percent: number | null };
	model?: string; provider?: string; reasoning?: boolean; contextWindow?: number;
	thinkingLevel?: string;
	tokPerSec?: number; ttftMs?: number; lastOut?: number;
	genOut?: number; genMs?: number;   // the speed's sums: output tokens and ms from first token to end
};
export const STATS_MS = 2000;
export const emptyStats = (): RunStats => ({ input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0 });
const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : 0);
// a flag's value in the run's spawn args (a restart of its process starts with it); only a flag it has
const spawnArg = (rec: RunRecord, flag: string, value: string | undefined): void => {
	const a = rec.spawn?.args, i = a ? a.indexOf(flag) : -1;
	if (a && value && i >= 0 && i + 1 < a.length) a[i + 1] = value;
};
// a thinking level the child took (its RPC answer), recorded for the footer and its next start
export const noteLevel = (rec: RunRecord, level: unknown): void => {
	if (typeof level !== "string" || !level) return;
	(rec.stats ??= emptyStats()).thinkingLevel = level;
	spawnArg(rec, "--thinking", level);
	saveRun(rec, true); notifyRuns(rec);
};
// one response's usage, counted until the child's own totals come
export const noteUsage = (rec: RunRecord, u: any): void => {
	if (!u || typeof u !== "object") return;
	const x = (rec.stats ??= emptyStats());
	x.input += num(u.input); x.output += num(u.output); x.cacheRead += num(u.cacheRead); x.cacheWrite += num(u.cacheWrite);
	x.cost += num(typeof u.cost === "object" ? u.cost?.total : u.cost);
	const prompt = num(u.input) + num(u.cacheRead) + num(u.cacheWrite);
	x.hit = prompt > 0 ? (num(u.cacheRead) / prompt) * 100 : undefined;
};
// the child's session totals and state over RPC; an answer that is not there (an older pi) changes nothing
export const applyStats = (rec: RunRecord, st: any, state: any): boolean => {
	const x = (rec.stats ??= emptyStats());
	let changed = false;
	const k = st?.success ? st.data?.tokens : undefined;
	if (k && typeof k === "object") {
		x.input = num(k.input); x.output = num(k.output); x.cacheRead = num(k.cacheRead); x.cacheWrite = num(k.cacheWrite); x.cost = num(st.data.cost);
		const cu = st.data.contextUsage;
		if (cu && typeof cu === "object") x.contextUsage = { tokens: typeof cu.tokens === "number" ? cu.tokens : null, contextWindow: num(cu.contextWindow), percent: typeof cu.percent === "number" ? cu.percent : null };
		changed = true;
	}
	const s = state?.success ? state.data : undefined;
	if (s && typeof s === "object") {
		if (typeof s.thinkingLevel === "string" && s.thinkingLevel) { x.thinkingLevel = s.thinkingLevel; spawnArg(rec, "--thinking", s.thinkingLevel); }
		const m = s.model;
		if (m && typeof m === "object" && m.id) {
			x.model = String(m.id); x.provider = m.provider ? String(m.provider) : undefined; x.reasoning = !!m.reasoning; if (num(m.contextWindow)) x.contextWindow = num(m.contextWindow);
			if (x.provider && rec.spawn?.args.includes("--model")) { spawnArg(rec, "--provider", x.provider); spawnArg(rec, "--model", x.model); }
		}
		changed = true;
	}
	return changed;
};
export const refreshStats = async (c: { rec: RunRecord; alive: boolean; send(cmd: Record<string, unknown>): Promise<any> }): Promise<void> => {
	if (!c.alive) return;
	const rec = c.rec;
	const [st, state] = await Promise.all([c.send({ type: "get_session_stats" }), c.send({ type: "get_state" })]);
	if (applyStats(rec, st, state)) { saveRun(rec); notifyRuns(rec); }
};
export const TOOL_OUT_CAP = 6000;
export const TEXT_CAP = 32000;
export const ARG_CAP = 2000;
export const DETAILS_CAP = 8000;
export const MAX_EVENTS = 800;
export const KEEP_RUNS = Math.max(1, Number(process.env.LETS_CODE_SUBAGENT_KEEP_RUNS ?? "30") || 30);
export const RUNS_SESSIONS = 20;
export const RUN_SAVE_MS = 2000;
export const runsRoot = () => join(AGENT_DIR, "lets-code-runs");

export function clipText(s: string, cap = TEXT_CAP): string { return s.length <= cap ? s : `${s.slice(0, cap)}\n… [${s.length - cap} more characters not kept]`; }
export function clipOutput(s: string, cap = TOOL_OUT_CAP): { text: string; cut: number } {
	if (s.length <= cap) return { text: s, cut: 0 };
	const head = Math.floor(cap * 0.7), tail = cap - head;
	return { text: `${s.slice(0, head)}\n… [${s.length - cap} characters cut] …\n${s.slice(-tail)}`, cut: s.length - cap };
}
export function clipArgs(a: unknown, depth = 0): unknown {
	if (typeof a === "string") return a.length > ARG_CAP ? `${a.slice(0, ARG_CAP)}… [${a.length - ARG_CAP} more characters]` : a;
	if (a === null || typeof a !== "object") return a;
	if (depth > 4) return "[…]";
	if (Array.isArray(a)) return a.slice(0, 50).map((x) => clipArgs(x, depth + 1));
	const o: Record<string, unknown> = {};
	for (const [k, v] of Object.entries(a as Record<string, unknown>).slice(0, 50)) o[k] = clipArgs(v, depth + 1);
	return o;
}
function resultText(r: any): string {
	const c = r?.content;
	if (typeof c === "string") return c;
	if (!Array.isArray(c)) return typeof r === "string" ? r : "";
	return c.map((x: any) => (x?.type === "text" ? String(x.text ?? "") : x?.type === "image" ? "[image]" : "")).filter(Boolean).join("\n");
}
function smallDetails(d: unknown): unknown {
	if (d === undefined || d === null) return undefined;
	try { const s = JSON.stringify(d); return s && s.length <= DETAILS_CAP ? JSON.parse(s) : undefined; } catch { return undefined; }
}
function blocksOf(content: unknown): Block[] {
	if (typeof content === "string") return content ? [{ type: "text", text: clipText(content) }] : [];
	if (!Array.isArray(content)) return [];
	const out: Block[] = [];
	for (const c of content as any[]) {
		if (c?.type === "text") out.push({ type: "text", text: clipText(String(c.text ?? "")) });
		else if (c?.type === "thinking") out.push({ type: "thinking", text: clipText(String(c.thinking ?? "")) });
		else if (c?.type === "toolCall") out.push({ type: "toolCall", text: "", id: c.id, name: c.name, args: clipArgs(c.arguments) });
	}
	return out;
}

interface Registry { runs: RunRecord[]; listeners: Set<(r?: RunRecord) => void>; stops: Map<string, () => void>; session: string; seq: number; saved: Map<string, number> }
const REG = Symbol.for("lets-code.subagent-runs");
export function registry(): Registry {
	const g = globalThis as any;
	return (g[REG] ??= { runs: [], listeners: new Set(), stops: new Map(), session: "", seq: 0, saved: new Map() });
}
export function notifyRuns(r?: RunRecord): void { for (const l of [...registry().listeners]) { try { l(r); } catch { /* a view's problem, not the run's */ } } }

export function newRun(agent: { name: string; expert?: unknown }, task: string, cwd: string, meta?: RunMeta, now = Date.now()): RunRecord {
	const reg = registry();
	const id = `${now.toString(36)}-${process.pid.toString(36)}-${(reg.seq++).toString(36)}`;
	return { v: 1, id, agent: agent.name, kind: agent.expert ? "expert" : "subagent", task, cwd, session: reg.session, started: now, status: "running",
		turns: 0, input: 0, output: 0, parent: meta, events: [{ t: "user", text: clipText(task), v: 0, at: now }], dropped: 0, ver: 0 };
}
// the run joins the session's list; finished ones beyond KEEP_RUNS leave memory
export function addRun(rec: RunRecord): void {
	const reg = registry();
	reg.runs.push(rec);
	const done = reg.runs.filter((r) => r.status !== "running").sort((a, b) => (b.ended ?? b.started) - (a.ended ?? a.started));
	const drop = new Set(done.slice(KEEP_RUNS).map((r) => r.id));
	if (drop.size) { reg.runs = reg.runs.filter((r) => !drop.has(r.id)); for (const id of drop) killChild(id); }
}
const openAssistant = (rec: RunRecord) => { for (let i = rec.events.length - 1; i >= 0; i--) { const e = rec.events[i]; if (e.t === "assistant") return e.done ? undefined : e; } return undefined; };
const toolEv = (rec: RunRecord, id: string | undefined, name?: string) => {
	for (let i = rec.events.length - 1; i >= 0; i--) { const e = rec.events[i]; if (e.t === "tool" && !e.done && (id ? e.id === id : e.name === name)) return e; }
	return undefined;
};
// one event of the child's JSON stream into the transcript; true when it changed
export function recordEvent(rec: RunRecord, ev: any, now = Date.now()): boolean {
	const push = (e: RunEvent) => {
		rec.events.push(e);
		if (rec.events.length > MAX_EVENTS) { const n = rec.events.length - MAX_EVENTS; rec.events.splice(1, n); rec.dropped += n; }   // the task stays first
	};
	let changed = true;
	switch (ev?.type) {
		case "message_start":
			if (ev.message?.role === "assistant") push({ t: "assistant", blocks: [], done: false, v: 0, at: now }); else changed = false;
			break;
		case "message_update": {
			const a = openAssistant(rec); const e = ev.assistantMessageEvent;
			if (typeof ev.usage?.output === "number") rec.live = ev.usage.output;
			if (!a || !e || typeof e.type !== "string") { changed = typeof ev.usage?.output === "number"; break; }
			const kind = e.type.startsWith("text") ? "text" : e.type.startsWith("thinking") ? "thinking" : e.type.startsWith("toolcall") ? "toolCall" : "";
			if (!kind) { changed = false; break; }
			const i = Math.max(0, Math.min(Number(e.contentIndex ?? a.blocks.length) || 0, 200));
			const b = (a.blocks[i] ??= { type: kind, text: "" });
			if (e.type.endsWith("_start")) { if (kind === "toolCall") { b.id = e.id; b.name = e.toolName; } }
			else if (e.type.endsWith("_delta")) { if (kind !== "toolCall" && b.text.length < TEXT_CAP) b.text += String(e.delta ?? ""); }
			else if (e.type.endsWith("_end")) {
				if (kind === "toolCall") { b.id = e.toolCall?.id ?? b.id; b.name = e.toolCall?.name ?? b.name; b.args = clipArgs(e.toolCall?.arguments); }
				else b.text = clipText(String(e.content ?? b.text));
			}
			for (let j = 0; j < a.blocks.length; j++) a.blocks[j] ??= { type: "text", text: "" };
			a.v++;
			break;
		}
		case "message_end": {
			const m = ev.message ?? {};
			if (m.role === "assistant") {
				let a = openAssistant(rec);
				if (!a) { a = { t: "assistant", blocks: [], done: false, v: 0, at: now }; push(a); }
				a.blocks = blocksOf(m.content); a.done = true; a.stop = m.stopReason;
				if (m.errorMessage && (m.stopReason === "error" || m.stopReason === "aborted")) a.error = clipText(String(m.errorMessage), 2000);
				a.v++;
				rec.turns++; rec.live = 0;
				const u = m.usage; if (u) { rec.input += u.input || 0; rec.output += u.output || 0; }
			} else if (m.role === "user") {
				// the first user message is the task (already the first event)
				const text = blocksOf(m.content).filter((b) => b.type === "text").map((b) => b.text).join("\n");
				if (rec.seenTask && text.trim()) push({ t: "user", text: clipText(text), v: 0, at: now }); else changed = false;
				rec.seenTask = true;
			} else changed = false;   // tool results come from the tool events
			break;
		}
		case "tool_execution_start":
			push({ t: "tool", id: String(ev.toolCallId ?? ""), name: String(ev.toolName ?? "tool"), args: clipArgs(ev.args), done: false, output: "", cut: 0, v: 0, at: now });
			break;
		case "tool_execution_update":
		case "tool_execution_end": {
			let x = toolEv(rec, ev.toolCallId, ev.toolName);
			if (!x) { x = { t: "tool", id: String(ev.toolCallId ?? ""), name: String(ev.toolName ?? "tool"), args: clipArgs(ev.args), done: false, output: "", cut: 0, v: 0, at: now }; push(x); }
			const o = clipOutput(resultText(ev.type === "tool_execution_end" ? ev.result : ev.partialResult));
			x.output = o.text; x.cut = o.cut;
			if (ev.type === "tool_execution_end") { x.done = true; x.isError = !!ev.isError; x.details = smallDetails(ev.result?.details); x.end = now; }
			x.v++;
			break;
		}
		case "auto_retry_start":
			push({ t: "note", text: `retrying (attempt ${ev.attempt ?? "?"}/${ev.maxAttempts ?? "?"}): ${clipText(String(ev.errorMessage ?? ""), 300)}`, error: true, v: 0, at: now });
			break;
		case "compaction_start":
			push({ t: "note", text: `compacting the context (${ev.reason ?? "threshold"})`, v: 0, at: now });
			break;
		default:
			changed = false;
	}
	if (changed) rec.ver++;
	return changed;
}
// how the run ended; open blocks close, stderr of a failed run is kept as a note
export function finishRun(rec: RunRecord, r: { exitCode: number; text: string; stderr: string; timedOut?: number }, stopped: boolean, now = Date.now()): void {
	rec.ended = now; rec.exitCode = r.exitCode; rec.live = 0;
	rec.status = stopped ? "aborted" : r.timedOut ? "timeout" : r.exitCode === 0 ? "done" : "failed";
	for (const e of rec.events) if ((e.t === "assistant" || e.t === "tool") && !e.done) { e.done = true; e.v++; }
	if (r.text.trim()) rec.final = clipText(r.text);
	if (rec.status === "failed" && r.stderr.trim()) rec.events.push({ t: "note", text: `stderr: ${r.stderr.trim().slice(-800)}`, error: true, v: 0, at: now });
	if (rec.status === "timeout") rec.events.push({ t: "note", text: `stopped after its timeout of ${r.timedOut}s`, error: true, v: 0, at: now });
	rec.ver++;
}
// never throws; while running at most every RUN_SAVE_MS
export function saveRun(rec: RunRecord, force = false, now = Date.now()): boolean {
	const reg = registry();
	if (!force && now - (reg.saved.get(rec.id) ?? 0) < RUN_SAVE_MS) return false;
	reg.saved.set(rec.id, now);
	try {
		const dir = join(runsRoot(), rec.session || "no-session");
		mkdirSync(dir, { recursive: true, mode: 0o700 });
		const f = join(dir, `${rec.id}.json`), tmp = `${f}.${process.pid}.tmp`;
		writeFileSync(tmp, JSON.stringify(rec), { mode: 0o600 });
		renameSync(tmp, f);
		if (rec.status !== "running") reg.saved.delete(rec.id);
		return true;
	} catch { return false; }
}
// the newest KEEP_RUNS runs of the session, and RUNS_SESSIONS sessions, stay
export function pruneRuns(session: string): void {
	const byTime = (dir: string, names: string[]) => names.map((n) => { try { return { n, t: statSync(join(dir, n)).mtimeMs }; } catch { return { n, t: 0 }; } }).sort((a, b) => b.t - a.t);
	try {
		const root = runsRoot(), dir = join(root, session || "no-session");
		// a run is its transcript and its session file: pruned together
		for (const { n } of byTime(dir, readdirSync(dir).filter((f) => f.endsWith(".json"))).slice(KEEP_RUNS)) {
			rmSync(join(dir, n), { force: true });
			for (const ext of [".pi.jsonl", ".view.jsonl", ".prompt.md"]) rmSync(join(dir, n.replace(/\.json$/, ext)), { force: true });
			killChild(n.replace(/\.json$/, ""));
		}
		for (const { n } of byTime(root, readdirSync(root)).slice(RUNS_SESSIONS)) rmSync(join(root, n), { recursive: true, force: true });
	} catch { /* nothing to prune */ }
}
// a session's runs from disk; one saved while running whose process is gone
// (pi quit or crashed) shows as stopped
export function loadRuns(session: string): RunRecord[] {
	const out: RunRecord[] = [];
	try {
		const dir = join(runsRoot(), session || "no-session");
		for (const f of readdirSync(dir)) {
			if (!f.endsWith(".json")) continue;
			try {
				const r = JSON.parse(readFileSync(join(dir, f), "utf8"));
				if (r?.v !== 1 || typeof r.id !== "string" || !Array.isArray(r.events)) continue;
				if (r.status === "running") { r.status = "aborted"; r.ended ??= r.events[r.events.length - 1]?.at ?? r.started; r.events.push({ t: "note", text: "interrupted: pi stopped while it ran", error: true, v: 0, at: r.ended }); }
				out.push(r);
			} catch { /* a broken file */ }
		}
	} catch { /* none yet */ }
	return out.sort((a, b) => a.started - b.started).slice(-KEEP_RUNS);
}
// the session changed (start, /new, /resume, /reload): its saved runs, plus
// whatever still runs in this process
export function useSession(session: string): void {
	const reg = registry();
	reg.session = session;
	const live = reg.runs.filter((r) => r.status === "running");
	const mem = reg.runs.filter((r) => r.status !== "running" && r.session === session);
	const ids = new Set([...live, ...mem].map((r) => r.id));
	reg.runs = [...loadRuns(session).filter((r) => !ids.has(r.id)), ...mem, ...live];
	notifyRuns();
}


// ------------------------------------------------------------ the child process
// Each run is one pi in RPC mode (--mode rpc) on its own session file, with
// the agent's tools, thinking level, skills, role and instructions. The
