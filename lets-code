// /subagents' argument completions: none until a letter is typed, so Enter on
// "/subagents" or "/subagents " opens the navigator and never takes a suggestion
export const SUBCOMMANDS = ["toggle", "back", "stop"];
export function subcommandCompletions(prefix: string): { value: string; label: string }[] | null {
	const p = String(prefix ?? "").trimStart();
	if (!p.trim() || /\s/.test(p.trim())) return null;
	const out = SUBCOMMANDS.filter((a) => a.startsWith(p.trim()) && a !== p.trim()).map((a) => ({ value: a, label: a }));
	return out.length ? out : null;
}
// The copy of a child's session file the TUI opens: up to (not including) an
// assistant message whose tool calls have no results yet, so pi never draws a
// pending call it will not hear the end of; the live part has the rest.
export function viewLines(text: string): string[] {
	const lines = text.split("\n").filter((l) => l.trim());
	const parsed = lines.map((l) => { try { return JSON.parse(l); } catch { return undefined; } });
	const results = new Set<string>();
	let cut = lines.length;
	for (let i = parsed.length - 1; i >= 0; i--) {
		const m = parsed[i]?.type === "message" ? parsed[i].message : undefined;
		if (m?.role === "toolResult" && m.toolCallId) results.add(String(m.toolCallId));
		if (m?.role === "assistant" && Array.isArray(m.content) && m.content.some((c: any) => c?.type === "toolCall" && !results.has(String(c.id)))) cut = i;
	}
	return lines.slice(0, cut);
}
// /subagents <arg>: a number (its row in the picker, the main session is 0) or an agent name
export function pickRun(runs: RunRecord[], arg: string, ordered: (r: RunRecord[]) => RunRecord[]): RunRecord | undefined {
	const rs = ordered(runs); const a = arg.trim();
	if (!a) return undefined;
	if (/^\d+$/.test(a)) return rs[Number(a) - 1];
	return rs.find((r) => r.agent === a) ?? rs.find((r) => r.agent.startsWith(a));
}
// a child's own session file, or the copy the TUI opens of it (under the runs dir)
export function isChildSession(p: string): boolean {
	return !!p && p.startsWith(`${runsRoot()}${sep}`) && /\.(pi|view)\.jsonl$/.test(p);
}
// commands that read the session itself (see the key hook in a child's session)
export const READS_SESSION = /^\/(copy|export|share|session)(\s|$)/;
// shown in place (the main session working): these would act on the main session, so they run in the child's own session once the main one is idle
export const IN_PLACE_DEFER = /^\/(copy|export|share|session|model|scoped-models|thinking|tree|fork|clone)(\s|$)/;
export const viewFile = (sessionFile: string) => sessionFile.replace(/\.pi\.jsonl$/, ".view.jsonl");
export function detachNote(names: string[]): string {
	return `Still running in the background (the user opened a subagent's session, which ended this turn): ${names.join(", ") || "the runs of this call"}. Their reports follow in a message when they finish; do not start them again.`;
}
export const DELIVER_HEAD = "Reports of the subagent call that went on in the background:";
// In the interactive main session a call does not hold the session up: it
// returns after LETS_CODE_SUBAGENT_WAIT seconds (default 0, at once) or its
// own wait, its runs go on, and their report arrives as a message (a
// follow-up when the session is busy, else it starts a turn), so the user
// and the orchestrator keep talking meanwhile. Print and RPC mode, and
// subagents' own calls, still wait for the report (nothing would take it).
export const BG_WAIT_S = Math.max(0, Number(process.env.LETS_CODE_SUBAGENT_WAIT ?? "0") || 0);
export function backgroundAfter(ctx: any, wait?: unknown): number | undefined {
	if (DEPTH > 0 || !isTui(ctx)) return undefined;
	const w = Number(wait);
	return Math.round(Math.min(3600, Math.max(0, wait === undefined || wait === null || !Number.isFinite(w) ? BG_WAIT_S : w)) * 1000);
}
// the calls gone on in the background, by call id: what stops them all
// (their queued tasks too) and whether their report still has somewhere to go
// (name: a workflow call's workflow, whose agents start as its script goes)
export interface BgCall { abort: () => void; home: string; planned: number; name?: string; drop?: boolean }
export const bgCalls = (): Map<string, BgCall> => ((registry() as any).bgCalls ??= new Map());
const queuedOf = (id: string, c: BgCall) => Math.max(0, c.planned - registry().runs.filter((r) => r.parent?.callId === id).length);
export function backgroundNote(runs: RunRecord[], queued = 0, name?: string): string {
	const named = runs.map((r) => `${r.agent} (run ${r.id}${childPid(r) ? `, pid ${childPid(r)}` : ""})`).join(", ");
	const who = name ? `workflow ${name}${named ? `, now running ${named}` : ""} (its agents start as its script goes; stop it with run "${name}")`
		: (named || "the runs of this call") + (queued ? `, and ${queued} more queued` : "");
	return `Running in the background; this session stays free: ${who}. Their report arrives as a message when they finish (it starts your next turn if you are idle). Meanwhile go on with other work or end your turn; do not wait, poll or start them again. subagent({action: "status"}) shows how each is doing; message({to: <pid>, text}) reaches one without stopping it (its reply comes back as a message); subagent({action: "stop", run}) stops one; run "all" stops every background call, its queued tasks too.`;
}
const childPid = (r: RunRecord): number | undefined => (registry() as any).children?.get?.(r.id)?.proc?.pid;
// subagent({action: "status"}): the runs going on, with what each last said and did
export function statusText(runs: RunRecord[], now = Date.now()): string {
	const live = runs.filter((r) => r.status === "running");
	const queued = [...bgCalls()].reduce((n, [id, c]) => n + queuedOf(id, c), 0);
	const idle = [...bgCalls()].filter(([id, c]) => c.name && !live.some((r) => r.parent?.callId === id)).map(([, c]) => `- workflow ${c.name}: running, between agents.`);
	const more = (idle.length ? `\n${idle.join("\n")}` : "") + (queued ? `\n${queued} more task${queued === 1 ? "" : "s"} queued in background calls.` : "");
	if (!live.length) return more.trim() || "No subagent or expert is running.";
	return live.map((r) => {
		const wf = r.parent?.callId ? bgCalls().get(r.parent.callId)?.name : undefined;
		const said = [...r.events].reverse().find((e: any) => e.t === "assistant" && e.blocks?.some((b: any) => b.type === "text" && b.text?.trim())) as any;
		const text = said ? said.blocks.filter((b: any) => b.type === "text").map((b: any) => b.text).join(" ").replace(/\s+/g, " ").trim() : "";
		const steps = lastSteps(r);
		const min = Math.floor((now - r.started) / 60000), sec = Math.floor((now - r.started) / 1000) % 60;
		return `- ${r.agent} (run ${r.id}${childPid(r) ? `, pid ${childPid(r)}` : ""}${wf ? `, workflow ${wf}` : ""}): running ${min}m${String(sec).padStart(2, "0")}s, ${r.turns} turns. Task: ${r.task.replace(/\s+/g, " ").slice(0, 120)}${text ? `\n  last said: ${text.length > 300 ? `${text.slice(0, 299)}…` : text}` : ""}${steps ? `\n  last steps: ${steps}` : ""}`;
	}).join("\n") + more;
}

// quiet: a reply to a turn the user started in a child; it informs, it starts no turn
interface Pending { home: string; text: string; isError: boolean; quiet?: boolean }
interface ViewState {
	home: string; homeId: string;        // the main session (its file and id)
	current: string;                     // the session file open now
	viewing?: string;                    // the run whose session is open
	loaded?: any;                        // what that session held when it opened (view.loadedOf)
	added?: WeakSet<object>; addedCount?: number;   // the run's events added to the chat since
	resubmit?: string; resubmitKey?: string; passOnce?: boolean;   // a command (or key) to run again once the copy is caught up
	nav?: boolean; sel?: number; confirm?: boolean;   // the footer navigator has the keys; its selected row
	expanded?: boolean;                               // the navigator shows the whole list (from the short list's "more" row)
	followUpNext?: boolean;               // the follow-up key was pressed: the next prompt is a follow-up
	typed?: string;                       // in place: a slash text typed for the child, taken by the input hook
	inplace?: { run: string; chat: any; pending: any; status: any };   // a child shown in place while the main session works
	mainBusy?: boolean;                   // the main session's turn is running (agent_start .. agent_settled)
	mainLevel?: string;                   // the main session's thinking level when a child's copy opened; put back on return to it
	mainHome?: string;                    // that main session's file (another session opened from the copy does not get the level)
	echo?: string[];                      // levels this view set on the copy itself: their thinking_level_select is not passed on
	picker: boolean;
	footer: boolean;
}
type Reg = Registry & { status?: (r?: RunRecord) => void; view?: ViewState; pending?: Pending[]; switching?: boolean; pi?: any; ui?: any };
export function viewState(reg = registry()): ViewState {
	const r = reg as Reg;
	return (r.view ??= { home: "", homeId: "", current: "", picker: false, footer: readFooterOn() });
}
// /subagents toggle: remembered in lets-code-state.json (key subagentsFooter), as /metrics is
export const stateFile = () => process.env.LETS_CODE_METRICS_SAVE || process.env.LETS_CODE_STATE_FILE || join(AGENT_DIR, "lets-code-state.json");
export function readFooterOn(file = stateFile()): boolean {
	try { return JSON.parse(readFileSync(file, "utf8"))?.subagentsFooter === true; } catch { return false; }
}
export function saveFooterOn(on: boolean, file = stateFile()): void {
	let doc: any = {};
	try { doc = JSON.parse(readFileSync(file, "utf8")); } catch { /* missing or unreadable: start over */ }
	if (!doc || typeof doc !== "object" || Array.isArray(doc)) doc = {};
	if (doc.subagentsFooter === on) return;
	doc.subagentsFooter = on;
	const tmp = `${file}.${process.pid}.tmp`;
	writeFileSync(tmp, JSON.stringify(doc, null, 2) + "\n", { mode: 0o600 });
