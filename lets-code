}
const READ_TOOLS = new Set(["Read", "Grep", "Glob", "LS"]);
const EDIT_TOOLS = new Set(["Edit", "Write", "MultiEdit", "NotebookEdit"]);
const norm = (s: string) => s.replace(/-/g, "_");
function toolMatches(rule: Rule, tool: string): boolean {
	const t = rule.tool;
	if (t.startsWith("mcp__")) {
		if (!tool.startsWith("mcp__")) return false;
		const r = norm(t); const n = norm(tool);
		if (r.includes("*")) return globRe(r.replace(/\*/g, "**")).test(n) || n.startsWith(r.replace(/\*+$/, ""));
		return n === r || n.startsWith(`${r}__`);
	}
	if (t.includes("*")) return globRe(t).test(tool);
	if (t === "Edit" || t === "Write") return EDIT_TOOLS.has(tool);
	if (t === "Read") return READ_TOOLS.has(tool);
	return toolNames(t).includes(tool) || toolNames(tool).includes(t);
}
export function ruleMatches(rule: Rule, tool: string, input: any, cwd: string, all: boolean): boolean {
	if (!toolMatches(rule, tool)) return false;
	if (rule.spec === undefined) return true;
	const spec = rule.spec;
	if (tool === "Bash") { const parts = bashParts(String(input?.command ?? "")); return parts.length > 0 && (all ? parts.every((c) => bashPatternMatches(spec, c)) : parts.some((c) => bashPatternMatches(spec, c))); }
	if (READ_TOOLS.has(tool) || EDIT_TOOLS.has(tool)) return pathPatternMatches(spec, rule.base, cwd, abs(input?.file_path ?? input?.path ?? cwd, cwd));
	if (tool === "Agent") { const names = [input?.subagent_type, ...(input?.tasks ?? []).map((x: any) => x?.agent), ...(input?.chain ?? []).map((x: any) => x?.agent)].filter(Boolean); return names.some((n) => n === spec); }
