# TERMUX=true / REA=true (the switches of earlier versions) in the config or
# a preset: remembered once as the expert enabled, unless the state already
# has a decision for it; after that the key is not read. false, empty and
# REA=manual mean nothing now (a dormant expert costs only its list entry).
# The tester became the test lead (2026-10); its browser half is ui-tester.
# Once: an installed runtime moves over (no second download), and a yes
# remembered for the tester is remembered for ui-tester too.
lc_migrate_ui_tester() {
    local old="${PI_AGENT_DIR}/tester" new="${PI_AGENT_DIR}/ui-tester" x
    for x in runtime work; do
        if [ -d "${old}/${x}" ] && [ ! -e "${new}/${x}" ]; then mkdir -p "${new}" && mv "${old}/${x}" "${new}/${x}"; fi
    done
    [ "$(lc_expert_remembered tester)" = true ] && [ -z "$(lc_expert_remembered ui-tester)" ] || return 0
    LC_STATE="${PI_AGENT_DIR}/lets-code-state.json" python3 - <<'PY' 2>/dev/null || true
import json, os
p = os.environ["LC_STATE"]
try: s = json.load(open(p))
except Exception: s = {}
e = s.get("experts") if isinstance(s.get("experts"), dict) else {}
e["ui-tester"] = True; s["experts"] = e
tmp = p + ".tmp"
with open(tmp, "w") as f: json.dump(s, f, indent=2); f.write("\n")
os.chmod(tmp, 0o600); os.replace(tmp, p)
PY
}
lc_migrate_expert_switches() {
    local pair var name
    for pair in TERMUX:termux-device REA:reverse-engineer; do
        var="${pair%%:*}"; name="${pair#*:}"
        case "$(lc "${!var:-}")" in true|yes|1|on) ;; *) continue ;; esac
        if LC_STATE="${PI_AGENT_DIR}/lets-code-state.json" python3 - "${name}" <<'PY' 2>/dev/null
import json, os, sys
p = os.environ["LC_STATE"]
try: s = json.load(open(p))
except Exception: s = {}
if not isinstance(s, dict): s = {}
e = s.get("experts") if isinstance(s.get("experts"), dict) else {}
if sys.argv[1] in e: sys.exit(1)
e[sys.argv[1]] = True; s["experts"] = e
tmp = p + ".tmp"
with open(tmp, "w") as f: json.dump(s, f, indent=2); f.write("\n")
os.chmod(tmp, 0o600); os.replace(tmp, p)
PY
        then log "note: ${var}=true in ${CONFIG_FILE} is now remembered as the ${name} expert enabled (/experts disable makes it dormant); ${var} is no longer read, remove it."
        fi
    done
}
