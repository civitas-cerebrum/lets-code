    { "elementName": "heading",     "selector": { "xpath": "//h1" } },
    { "elementName": "welcome",     "selector": { "text": { "regex": "Welcome,? .+", "flags": "i" } } },
    { "elementName": "authBtn",     "selector": { "role": "button", "name": { "regex": "Log in|Sign in", "flags": "i" } } }
