await steps.verifyPresence('welcome', 'HomePage');           // attached + visible
await steps.verifyAbsence('errorBox', 'LoginPage');
await steps.verifyState('submitButton', 'LoginPage', 'disabled'); // enabled|checked|visible|hidden|focused...
await steps.verifyInputValue('emailInput', 'LoginPage', 'a@b.com');
await steps.verifyPageTitle(/Login/);
// expect chain (retries, first failure throws)
await steps.expect('errorBox', 'LoginPage').text.toContain('required');
await steps.expect('rows', 'ListPage').count.toBeGreaterThan(0);
await steps.expect('submitButton', 'LoginPage').visible.toBeTrue().enabled.toBeTrue();
await steps.expect('errorBox', 'LoginPage').not.text.toContain('Crash');
// visibility probe / gate
const shown = await steps.isVisible('cookieBanner', 'HomePage', { timeout: 1000 }); // boolean, never throws
await steps.isVisible('cookieBanner', 'HomePage').click();   // skips silently if hidden
// waits
await steps.waitForState('modal', 'HomePage', 'visible');    // throws on timeout; { optional: true } -> false
await steps.waitForUrl(/dashboard/);
// data
const t = await steps.getText('welcome', 'HomePage');
// screenshots / visual
await steps.screenshot({ fullPage: true, path: 'shot.png' });
await steps.screenshot('loginForm', 'LoginPage');
await steps.verifyVisualMatch('login.png', { mask: [{ elementName: 'clock', pageName: 'LoginPage' }] });
