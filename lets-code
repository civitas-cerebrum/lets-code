                exit 1
            fi
        fi ;;
esac

MODEL="${MODEL_OVERRIDE:-${MODEL}}"
# was the model pinned (config, preset, env, --model) or discovered: the
# banner marks a discovered one "(auto)"; a pinned one the server does not
# list gets a warning
if [ -n "${MODEL}" ]; then MODEL_SOURCE="pinned"; else MODEL_SOURCE="auto"; fi
