    local ctx="${CONTEXT}" think host guards=0 exts=0 e extras="" b="" d="" r="" a="" line1 line2
    # the window the way pi's footer writes it (262144 -> 262k, 1000000 -> 1.0M)
    ctx="$(awk -v n="${CONTEXT}" 'BEGIN {
        if (n < 1000) printf "%d", n; else if (n < 10000) printf "%.1fk", n / 1000;
        else if (n < 1000000) printf "%dk", int(n / 1000 + 0.5); else if (n < 10000000) printf "%.1fM", n / 1000000;
        else printf "%dM", int(n / 1000000 + 0.5) }')"
    think="thinking ${THINKING}"
    [ "${REASONING_SUPPORTED}" = true ] || think="no thinking"
    case "${THINKING_DESC}" in adaptive*) think="thinking adaptive" ;; auto*) think="thinking auto" ;; esac
    host="${BASE_URL#*://}"
    [ "${BACKEND}" = claude ] && host="Claude Code${CLAUDE_URL:+ via ${CLAUDE_URL#*://}}"
    # counts only; --verbose names them
    [ "${MG_MODE}" = off ] || guards=$((guards + 1))
    case "${AG_DESC}" in *" on"*) guards=$((guards + 1)) ;; esac
    [ "${LETS_CODE_GROUNDING_ON:-}" = 1 ] && guards=$((guards + 1))
    [ "${GG_MODE}" = off ] || guards=$((guards + 1))
    # extensions: lets-code's features on this launch (pi lists them as one,
    # "lets-code") plus the user's own (a .ts/.js file, or a directory with
    # an index or a package.json)
    for e in ${LC_ACTIVE}; do exts=$((exts + 1)); done
    for e in "${PI_AGENT_DIR}"/extensions/*; do
        [ "${e}" = "${LC_EXT_ROOT}" ] && continue
        case "${e}" in *.ts|*.js) [ -f "${e}" ] && exts=$((exts + 1)) ;; *) [ -f "${e}/index.ts" ] || [ -f "${e}/index.js" ] || [ -f "${e}/package.json" ] && exts=$((exts + 1)) ;; esac
    done
    [ "${VISION}" = true ] && extras=" · vision"
    extras="${extras} · ${guards} guard$([ "${guards}" = 1 ] || echo s) · ${exts} extension$([ "${exts}" = 1 ] || echo s)"
    # a model discovered from the server, not pinned, is marked (auto)
    local auto=""
    [ "${MODEL_SOURCE}" = auto ] && auto=" (auto)"
    # a saved preset is named; the built-in claude one is the host already
    local preset=""
    [ -z "${PRESET}" ] || [ ! -f "${PRESET_DIR}/${PRESET}" ] || preset="  (preset ${PRESET})"
    line1="${MODEL}${auto} @ ${host}${preset}"
    line2="${ctx} context · ${think}${extras}"
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
        b=$'\033[1m'; d=$'\033[2m'; r=$'\033[0m'
        # the lets-code theme's magenta: the color of the high thinking level
        local hex="#d39fd3" i256=182
        case "${COLORTERM:-}" in
            truecolor|24bit) a=$'\033[38;2;'"$((16#${hex:1:2}));$((16#${hex:3:2}));$((16#${hex:5:2}))m" ;;
            *)               a=$'\033[38;5;'"${i256}m" ;;
        esac
        local signoffs=("let's code." "happy hacking." "go build something." "may your tests be green.")
        # one color after the mark: model, (auto), host
        printf '%s✦ lets-code%s %s%s%s\n' "${a}${b}" "${r}" "${b}" "${line1}" "${r}"
        printf '  %s%s%s\n' "${d}" "${line2}" "${r}"
        [ -z "${CC_SUMMARY}" ] || printf '  %s%s%s\n' "${d}" "${CC_SUMMARY}" "${r}"
        printf '  %s%s%s\n' "${d}" "${signoffs[$(( RANDOM % ${#signoffs[@]} ))]}" "${r}"
    else
        log "${line1} · ${line2}${CC_SUMMARY:+ · ${CC_SUMMARY}}"
    fi
}
if [ "${VERBOSE}" = true ]; then
    log "connecting: ${PRESET:+preset ${PRESET}  }${BASE_URL}  harness: ${HARNESS}  model: ${MODEL}  context: ${CONTEXT}  output cap: ${OUTPUT_CAP}  vision: ${VISION}  thinking: ${THINKING_DESC}  api: ${API}  ${MG_DESC}  ${GG_DESC}  ${AG_DESC}  grounding guard is $( [ "${LETS_CODE_GROUNDING_ON:-}" = 1 ] && echo on || echo off )${FEAT_DESC:+  ${FEAT_DESC}}${SESSION_DESC:+  ${SESSION_DESC}}"
fi
banner
if [ ${#PASSTHROUGH[@]} -eq 0 ]; then
    mem_guard_exec pi --provider "${PROVIDER_ID}" --model "${MODEL}"
else
    mem_guard_exec pi --provider "${PROVIDER_ID}" --model "${MODEL}" "${PASSTHROUGH[@]}"
fi
