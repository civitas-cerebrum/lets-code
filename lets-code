// A call (subagent, expert, workflow) whose children should outlive a
// session switch: work gets its own signal, aborted by the call's abort
// unless that abort comes from a switch (reg.switching); then the call
// returns detachNote at once and its result is delivered later.
// With after (ms; see backgroundAfter) the call also detaches once that
// long has passed, and from then on the call's abort no longer stops it.
export function detachable(signal: AbortSignal | undefined, callId: string, work: (signal: AbortSignal, job: { detached: boolean }) => Promise<{ text: string; isError: boolean }>, after?: number, planned = 0, name?: string): Promise<{ text: string; isError: boolean }> {
	const reg = registry() as Reg, vs = viewState(reg);
	const home = vs.current;   // the session this call runs in
	const inner = new AbortController(), job = { detached: false };
	return new Promise((resolve) => {
		let settled = false, timer: ReturnType<typeof setTimeout> | undefined;
		const onAbort = () => {
			if (job.detached) return;   // in the background: stopped by its own run's stop only
			if (reg.switching && home && !settled) {
				settled = true; job.detached = true;
				const names = reg.runs.filter((r) => r.status === "running" && r.parent?.callId === callId).map((r) => r.agent);
				resolve({ text: detachNote(names), isError: false });
				return;
			}
			inner.abort();
		};
		if (signal?.aborted) inner.abort(); else signal?.addEventListener("abort", onAbort, { once: true });
		if (after !== undefined && home && !signal?.aborted) timer = setTimeout(() => {
			if (settled) return;
			settled = true; job.detached = true;
			signal?.removeEventListener("abort", onAbort);
			const call: BgCall = { abort: () => inner.abort(), home, planned, name };
			bgCalls().set(callId, call);
			resolve({ text: backgroundNote(reg.runs.filter((r) => r.status === "running" && r.parent?.callId === callId), queuedOf(callId, call), name), isError: false });
		}, after);
		const end = (r: { text: string; isError: boolean }) => {
			if (timer) clearTimeout(timer);
			signal?.removeEventListener("abort", onAbort);
			if (!job.detached) { settled = true; resolve(r); return; }
			const call = bgCalls().get(callId); bgCalls().delete(callId);
			if (call?.drop) { notifyRuns(); return; }   // its session ended (/new, /resume elsewhere) and took the runs with it
			(reg.pending ??= []).push({ home, text: `${DELIVER_HEAD}\n\n${r.text}`, isError: r.isError });
			notifyRuns(); flushPending();   // the status says a report waits; the main session gets it now if it is open
		};
		work(inner.signal, job).then(end, (e) => end({ text: `The call failed: ${e instanceof Error ? e.message : String(e)}`, isError: true }));
	});
}
// reports for the session that is open now: a detached call's continues it
// (a follow-up when it is busy); a continued child's reply only informs it
export function flushPending(): void {
	const reg = registry() as Reg, vs = viewState(reg);
	if (!reg.pending?.length || !reg.pi || !vs.current || isChildSession(vs.current)) return;
	const mine = reg.pending.filter((p) => p.home === vs.current);
	if (!mine.length) return;
	reg.pending = reg.pending.filter((p) => p.home !== vs.current);
	for (const p of mine) {
		try { reg.pi.sendMessage({ customType: CUSTOM_TYPE, content: p.text, display: true }, p.quiet ? { triggerTurn: false } : { triggerTurn: true, deliverAs: "followUp" }); }
		catch { (reg.pending ??= []).push(p); }   // a stale pi (mid-switch): the next session_start sends it
	}
}

const isTui = (ctx: any) => !!ctx?.hasUI && (!ctx.mode || ctx.mode === "tui");
// subagent-view.ts and pi's parts, loaded once per process (on globalThis):
// a session switch loads this module again, and the footer list and the
// chat messages must draw from the first frame, not after an import
const VG = Symbol.for("lets-code.subagent-view");
const vg = () => ((globalThis as any)[VG] ??= {} as { view?: any; deps?: any });
let view: any = vg().view, deps: any = vg().deps;
const loadView = async () => (view ??= vg().view ??= await import(pathToFileURL(join(HERE, "subagent-view.ts")).href));
const loadDeps = async () => { const v = await loadView(); return (deps ??= vg().deps ??= await v.piDeps()); };

function setupSessions(pi: ExtensionAPI) {
	const api = pi as any;
	const reg = registry() as Reg;
	const vs = viewState(reg);
	const viewed = () => (vs.viewing ? reg.runs.find((r) => r.id === vs.viewing) : undefined);
	// a child's session is open: its copy (switchSession), or shown in place while the main session works
	const inChild = () => isChildSession(vs.current) || !!vs.inplace;
	// the thinking level is the viewed session's: a change made in a child's
	// copy goes to the child, and the main session's own level is kept aside
	// when the copy opens and put back when that main session opens again (pi
	// may have moved it: the copy's change becomes pi's default). In place the
	// TUI holds the main session, whose level (the agent guard's too) is left
	// alone; there the thinking keys are passed on to the child directly.
	const levelNow = (): string | undefined => { try { const v = (reg.pi ?? pi as any).getThinkingLevel?.(); return typeof v === "string" ? v : undefined; } catch { return undefined; } };
	const keepMainLevel = () => { if (!inChild()) { vs.mainLevel = levelNow(); vs.mainHome = vs.home; } };
	const restoreMainLevel = (file: string) => {
		const want = vs.mainLevel, home = vs.mainHome; vs.mainLevel = undefined; vs.mainHome = undefined;
		if (!want || file !== home || levelNow() === want) return;   // another session (/resume, /new): its own level
		try { (reg.pi ?? pi as any).setThinkingLevel?.(want); } catch { /* a stale pi: the level stays as it is */ }
	};
	const FOOTER = Symbol.for("lets-code.footer-blocks");
	const viaFooter = process.env.LETS_CODE_METRICS_ON !== undefined;   // lets-code's footer draws the list
	let liveTui: any, footTui: any, lastStatus: string | undefined, transcript: any, clock: ReturnType<typeof setInterval> | undefined;
