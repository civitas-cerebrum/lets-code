	if (tool === "WebFetch" && spec.startsWith("domain:")) { try { const h = new URL(String(input?.url)).hostname; const d = spec.slice(7); return d === "*" || h === d || (d.startsWith("*.") && h.endsWith(d.slice(1))); } catch { return false; } }
