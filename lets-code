// each skill's own folder, so pi loads exactly these (no name twice, none of pi's own)
export function skillDirs(cwd: string): string[] {
	return discoverSkills(cwd).map((t) => dirname(t.file));
}
export function discoverSkills(cwd: string): Template[] {
	const out = new Map<string, Template>();
	const walk = (dir: string, scope: Template["scope"], depth: number) => {
		if (depth > 4 || !isDir(dir) || synced(dir)) return;
		const f = join(dir, "SKILL.md");
		if (existsSync(f)) {
			const t = template(f, "", "skill", scope);
			if (t) { const { fm } = parseFrontmatter(readText(f) ?? ""); t.name = String(fm.name || basename(dir)); if (!out.has(t.name)) out.set(t.name, t); }
			return;
		}
		for (const e of readdirSync(dir).sort()) if (!e.startsWith(".") && e !== "node_modules") walk(join(dir, e), scope, depth + 1);
	};
	for (const d of projectDirs(cwd)) walk(join(d, ".claude", "skills"), "project", 0);
	if (userScope()) walk(join(claudeDir(), "skills"), "user", 0);
	const pis = piSkillNames(cwd);
	return [...out.values()].filter((t) => !pis.has(t.name));
}
export function parseArgs(s: string): string[] {
	const out: string[] = []; let cur = ""; let q = ""; let has = false;
	for (const c of s) {
		if (q) { if (c === q) q = ""; else cur += c; continue; }
		if (c === '"' || c === "'") { q = c; has = true; continue; }
		if (/\s/.test(c)) { if (cur || has) out.push(cur); cur = ""; has = false; continue; }
		cur += c;
	}
	if (cur || has) out.push(cur);
	return out;
}
// $ARGUMENTS, $ARGUMENTS[N] and $N (0-based), $name (frontmatter arguments),
// ${CLAUDE_*} variables; arguments no placeholder took are appended
export function substitute(body: string, rawArgs: string, t: Pick<Template, "argNames" | "dir">, vars: Record<string, string> = {}): string {
	const args = parseArgs(rawArgs); let used = false;
	let out = body.replace(/\\\$/g, "\u0000");
	out = out.replace(/\$\{(CLAUDE_[A-Z_]+)\}/g, (all, n) => (n === "CLAUDE_SKILL_DIR" ? t.dir : vars[n] ?? all));
	out = out.replace(/\$ARGUMENTS\[(\d+)\]/g, (_a, n) => { used = true; return args[Number(n)] ?? ""; });
	out = out.replace(/\$ARGUMENTS\b/g, () => { used = true; return rawArgs.trim(); });
	out = out.replace(/\$(\d+)\b/g, (_a, n) => { used = true; return args[Number(n)] ?? ""; });
	if (t.argNames.length) out = out.replace(/\$([A-Za-z_][\w-]*)/g, (all, n) => { const i = t.argNames.indexOf(n); if (i < 0) return all; used = true; return args[i] ?? ""; });
