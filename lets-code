	L.entries.push(entry);
	if (stage === "plan" || stage === "build") {
		// no STATUS line: a plan with its "## Plan" heading is a plan, a report with "## Changes" a build
		const said = lineValue(text, "STATUS");
		const st = said ?? (ok && stage === "plan" && /^#{1,3}\s*Plan\b/im.test(text) ? "PLAN" : ok && stage === "build" && /^#{1,3}\s*Changes\b/im.test(text) ? "DONE" : null);
		entry.verdict = st ? (said ? st : `${st} (no STATUS line)`) : ok ? "NO STATUS" : "FAILED";
		if (stage === "plan" && st === "PLAN") { L.plan = bodyOf(text, "STATUS"); entry.summary = short(L.plan.split("\n").find((l) => /^\s*1[.)]/.test(l)) ?? L.plan); L.stage = "build"; L.waiting = "plan"; return true; }
		if (stage === "build" && st === "DONE") {
			L.claim = bodyOf(text, "STATUS"); const stat = await snapshot(L, deps); entry.summary = stat || "no change in the work tree";
			if (!stat) { blocked(L, "the developer reported DONE but the work tree has no change"); return true; }
			if (L.fixing) { L.stage = L.fixing.stage; L.fixing = null; L.fixNote = ""; } else L.stage = next(stage);
			return true;
		}
		entry.summary = short(bodyOf(text, "STATUS") || text);
		blocked(L, `${stage}: ${st === "BLOCKED" ? "the developer is blocked" : ok ? "no STATUS line in the developer's reply" : "the developer's run failed"}: ${short(bodyOf(text, "STATUS") || text, 200)}`);
		return true;
	}
	let verdict: string | null; let found: Finding[];
	if (stage === "judge") { const j = parseJudge(text); verdict = j.verdict === "ACCEPT" ? "APPROVE" : j.verdict === "REJECT" ? "REVISE" : null; found = j.failing; entry.verdict = j.verdict ?? (ok ? "NO VERDICT" : "FAILED"); }
	else { verdict = lineValue(text, "VERDICT"); found = parseFindings(text, PREFIX[stage]!); entry.verdict = verdict ?? (ok ? "NO VERDICT" : "FAILED"); }
	const open = found.filter((f) => stage === "judge" || f.severity === "blocker" || f.severity === "major");
	entry.findings = found.map((f) => `${f.id}:${f.severity}`);
	entry.summary = found.length ? `${found.length} finding${found.length === 1 ? "" : "s"} (${open.length} to fix)` : "no findings";
	if (verdict === "APPROVE") { L.findings[stage] = found; L.stage = next(stage); return true; }
	if (verdict === "REVISE") {
		L.findings[stage] = found;
		if (!open.length) { L.stage = next(stage); entry.summary += "; REVISE without a blocker or major: going on"; return true; }
		fixRound(L, stage, open); return true;
	}
	blocked(L, `${stage}: ${ok ? `no verdict line in ${EXPERT[stage]}'s reply` : `${EXPERT[stage]}'s run failed: ${short(text, 200)}`}`);
	return true;
}

async function applyDecision(L: Ledger, d: Decision, deps: Deps): Promise<void> {
	const kind = L.waiting!; L.waiting = null; L.note = "";
	if (d.action === "stop") { L.status = "stopped"; L.stoppedAt = kind; L.note = `${d.by ?? "the user"} stopped it at the ${kind} checkpoint`; return; }
	if (kind === "criteria") { if (d.text !== undefined) L.criteria = criteriaFromText(d.text); if (!L.criteria.length) { L.waiting = "criteria"; L.note = "no criteria: write at least one"; } return; }
	if (kind === "plan") { if (d.text !== undefined && d.text.trim()) L.plan = d.text.trim(); return; }
	if (kind === "blocked") return;   // retry: the stage runs again
	if (kind === "stuck") {
		const p = L.pending; L.pending = null;
		if (d.action === "final") { L.stage = "done"; return; }
		if (p && L.rounds < MAX_FIX_ROUNDS) { L.fixNote = (d.text ?? "").trim(); fixRound(L, p.stage, p.findings, true); return; }
		// no round left: the checkpoint stays (the result as it is, or a stop), the run is not lost
		L.pending = p; L.waiting = "stuck"; L.note = `${MAX_FIX_ROUNDS} fix rounds used${p ? `; ${p.stage} still fails` : ""}: the final approval as it is, or stop`;
		return;
	}
	if (kind === "result") {
		if (d.action === "commit") {
			await stageChange(L, deps);
			const msg = `${(L.ticket.split("\n").find((l) => l.trim()) ?? "factory run").replace(/^#+\s*/, "").slice(0, 72)}\n\nsoftware factory run ${L.id}`;
			artifact(L, "commit-message.txt", msg);
			// one commit on the run's branch from the base, whatever the children's checkpoints did to HEAD
			const tree = (await deps.exec(`git write-tree`, L.work)).out.trim();
			const c = await deps.exec(`git${await ident(L.work, deps)} commit-tree ${tree} -p ${L.base} -F ${join(L.dir, "artifacts", "commit-message.txt")}`, L.work);
			const sha = c.out.trim();
			if (c.code === 0 && /^[0-9a-f]{40,64}$/.test(sha)) { await deps.exec(`git update-ref refs/heads/${L.branch} ${sha}`, L.work); await deps.exec(`git symbolic-ref HEAD refs/heads/${L.branch}`, L.work); L.commit = sha; }
			else { L.waiting = "result"; L.note = `commit failed: ${short(c.out, 200)}`; return; }
		}
		L.status = "done";
	}
}

// Runs the pipeline from where the ledger stands until it is done, stopped
// or waiting for a user who cannot be asked. Saves the ledger after each step.
export async function advance(L: Ledger, deps: Deps): Promise<Ledger> {
	L.status = L.status === "waiting" ? "running" : L.status;
	for (let guard = 0; guard < 200 && L.status === "running"; guard++) {
		if (L.waiting) {
			const d = await deps.checkpoint(L.waiting, L);
			if (!d) { L.status = "waiting"; saveLedger(L, (deps.now ?? Date.now)()); return L; }
			await applyDecision(L, d, deps); saveLedger(L, (deps.now ?? Date.now)()); continue;
		}
		await step(L, deps); saveLedger(L, (deps.now ?? Date.now)());
		deps.progress?.(summary(L).split("\n").pop() ?? "");
	}
	if (L.status === "done" || L.status === "stopped") { try { const cm = await import(pathToFileURL(join(HERE, "core-memory.ts")).href); cm.noteFactoryRun?.(L); } catch { /* no core memory here */ } }
	return L;
}

// git's -c flags for an identity where git has none (a fresh phone, a CI box):
// the factory's own commits then need no setup and change no config
export const FACTORY_IDENT = ` -c user.name="lets-code factory" -c user.email=factory@lets-code.invalid`;
export async function ident(repo: string, deps: Deps): Promise<string> {
	const a = await deps.exec(`git var GIT_AUTHOR_IDENT`, repo); const c = await deps.exec(`git var GIT_COMMITTER_IDENT`, repo);
	return a.code === 0 && c.code === 0 ? "" : FACTORY_IDENT;
}
// A new project: a folder that does not exist yet, or is empty, becomes a git
// repo; a repo without a commit gets an empty first one (on its own, from the
// empty tree: the index and the files are not touched) for the run to branch
// from. Returns what it did, for the run's log; a folder with files that is
// not a repo is left alone (startRun then says so).
export async function prepareRepo(target: string, deps: Deps): Promise<string[]> {
	const did: string[] = [];
	let empty = false;
	if (!existsSync(target)) {
		if (/[()\n]/.test(target)) throw new Error(`${target} does not exist, and is not a folder name to create (a remark in the path?)`);
		mkdirSync(target, { recursive: true }); did.push(`created ${target}`); empty = true;
	}
	else { try { empty = statSync(target).isDirectory() && readdirSync(target).length === 0; } catch { /* not ours to judge */ } }
	if (empty) {
		const i = await deps.exec(`git init -q`, target);
		if (i.code !== 0) throw new Error(`git init in ${target} failed: ${short(i.out, 300)}`);
		did.push("made it a git repo");
	}
	const top = await deps.exec(`git rev-parse --show-toplevel`, target);
	if (top.code !== 0) return did;
	const repo = top.out.trim();
	if ((await deps.exec(`git rev-parse -q --verify HEAD`, repo)).code !== 0) {
		const tree = (await deps.exec(`git hash-object -t tree /dev/null`, repo)).out.trim();
		const c = await deps.exec(`git${await ident(repo, deps)} commit-tree ${tree} -m "start: an empty first commit for the software factory"`, repo);
		const sha = c.out.trim();
		if (c.code !== 0 || !/^[0-9a-f]{40,64}$/.test(sha)) throw new Error(`the first commit in ${repo} failed: ${short(c.out, 300)}`);
		const u = await deps.exec(`git update-ref HEAD ${sha}`, repo);
		if (u.code !== 0) throw new Error(`the first commit in ${repo} failed: ${short(u.out, 300)}`);
		did.push("added an empty first commit");
	}
	return did;
}
// A command with a remark after it ("make test (the unit tests)") does not
// parse, and a suite that cannot run fails before and after alike: the
// remark is dropped; a command that still does not parse stops the start.
const sq = (s: string) => `'${s.replace(/'/g, `'\\''`)}'`;
export async function shellCommand(cmd: string, what: string, deps: Deps, cwd: string): Promise<string> {
	const parses = async (c: string) => (await deps.exec(`bash -n -c ${sq(c)}`, cwd)).code === 0;
	if (!cmd.trim() || (await parses(cmd))) return cmd.trim();
	const bare = cmd.replace(/\s+\([^()]*\)\s*$/, "").trim();
	if (bare !== cmd.trim() && (await parses(bare))) return bare;
	throw new Error(`the ${what} is not a shell command that parses: ${short(cmd, 200)}`);
}
export interface StartOpts { ticket: string; repo: string; howToRun?: string; start?: string; constraints?: string; conventions?: string; tester?: "auto" | "on" | "off"; criteria?: string[]; root?: string; id?: string }
// a new run: its dir, its worktree and branch from the repo's HEAD, its ledger
export async function startRun(o: StartOpts, deps: Deps): Promise<Ledger> {
	const now = (deps.now ?? Date.now)(); const root = o.root ?? factoryRoot();
	const prepared = await prepareRepo(resolve(o.repo), deps);
	const top = await deps.exec(`git rev-parse --show-toplevel`, resolve(o.repo));
	if (top.code !== 0) throw new Error(`${o.repo} is not a git repository, and has files: make it one first (git init and a first commit of its files: a setup chore for a subagent), or give a new or empty folder for a new project`);
	const repo = top.out.trim(); const base = (await deps.exec(`git rev-parse HEAD`, repo)).out.trim();
	const howToRun = await shellCommand(o.howToRun ?? "", "test command (how_to_run)", deps, repo);
	const startCmd = await shellCommand(o.start ?? "", "start command", deps, repo);
	// an id no run dir and no branch of this repo has yet (runs started in the same second)
	let id = o.id ?? newId(now);
	for (let i = 0; !o.id && i < 20 && (existsSync(join(root, id)) || (await deps.exec(`git rev-parse -q --verify refs/heads/pi/factory-${id}`, repo)).code === 0); i++) id = newId(now);
	const dir = join(root, id); const branch = `pi/factory-${id}`; const work = join(dir, "work");
	mkdirSync(dir, { recursive: true });
	const add = await deps.exec(`git worktree add -q -b ${branch} ${JSON.stringify(work)} ${base}`, repo);
	if (add.code !== 0) throw new Error(`git worktree add failed: ${short(add.out, 300)}`);
	const L: Ledger = { v: 1, id, created: now, updated: now, repo, base, branch, work, dir, ticket: o.ticket.trim(), howToRun, start: startCmd, constraints: o.constraints ?? "", conventions: o.conventions ?? "",
		tester: o.tester ?? "auto", status: "running", waiting: null, note: "", stage: "intake", rounds: 0, criteria: o.criteria ?? [], plan: "", claim: "", findings: {}, sent: {}, fixing: null, pending: null, baseline: null, commit: "", entries: [] };
	writeFileSync(join(dir, "ticket.md"), L.ticket + "\n", { mode: 0o600 });
	if (prepared.length) L.entries.push({ stage: "intake", round: 0, verdict: "new project", summary: `${repo}: ${prepared.join(", ")}`, input: 0, output_tokens: 0, seconds: 0, started: now, ended: now });
	saveLedger(L, now);
	return advance(L, deps);
}
// the checkpoint a stopped run stopped at; a ledger from before stoppedAt
// says it in its note (a stop at a checkpoint, or the fix rounds used up)
export function stopKind(L: Ledger): Waiting | null {
	if (L.status !== "stopped") return null;
	if (L.stoppedAt) return L.stoppedAt;
	const m = /stopped it at the (criteria|plan|result|stuck|blocked) checkpoint/.exec(L.note);
	return m ? (m[1] as Waiting) : /fix rounds used/.test(L.note) ? "stuck" : null;
}
export async function resumeRun(id: string, deps: Deps, root = factoryRoot()): Promise<Ledger> {
	const L = loadLedger(id, root); if (!L) throw new Error(`no factory run ${id}`);
	// stopped at a checkpoint: that checkpoint is asked again
	if (L.status === "stopped" && !L.stoppedAt) L.stoppedAt = stopKind(L);
	if (L.status === "stopped" && L.stoppedAt) { L.status = "waiting"; L.waiting = L.stoppedAt; L.stoppedAt = null; L.note = ""; }
	if (L.status === "done" || L.status === "stopped") return L;
	if (L.status !== "waiting") L.status = "running";   // interrupted mid-stage: that stage runs again
	return advance(L, deps);
}

// ------------------------------------------------------------------ in a session
export function shellExec(cmd: string, cwd: string, timeoutMs = 120000): Promise<{ code: number; out: string }> {
	return new Promise((res) => {
		let out = ""; const child = spawn("bash", ["-c", cmd], { cwd, stdio: ["ignore", "pipe", "pipe"], detached: true });
		const timer = setTimeout(() => { try { process.kill(-child.pid!, "SIGKILL"); } catch { /* gone */ } }, timeoutMs); timer.unref?.();
		const add = (d: Buffer) => { out += d.toString(); if (out.length > 200000) out = out.slice(-100000); };
		child.stdout.on("data", add); child.stderr.on("data", add);
		child.on("error", (e) => { clearTimeout(timer); res({ code: 127, out: e.message }); });
		child.on("close", (code) => { clearTimeout(timer); res({ code: code ?? 1, out }); });
	});
}
// the checkpoints as dialogs; no UI: null (the run pauses)
export function dialogs(ui: any | undefined): Deps["checkpoint"] {
	return async (kind, L) => {
		if (!ui) return null;
		if (kind === "criteria") {
			for (;;) {
				const c = await ui.select(`Factory ${L.id}: acceptance criteria\n\n${L.criteria.length ? numbered(L.criteria) : "(none found in the ticket)"}`, ["Confirm", "Edit", "Stop"]);
				if (c === "Confirm" && L.criteria.length) return { action: "approve" };
				if (c === "Edit" || (c === "Confirm" && !L.criteria.length)) { const t = await ui.editor("Acceptance criteria, one per line", L.criteria.join("\n")); if (t === undefined) continue; return { action: "edit", text: t }; }
				return { action: "stop" };
			}
		}
		if (kind === "plan") {
			const c = await ui.select(`Factory ${L.id}: the developer's plan\n\n${L.plan}`, ["Approve", "Edit", "Stop"]);
			if (c === "Approve") return { action: "approve" };
			if (c === "Edit") { const t = await ui.editor("The plan to follow", L.plan); return t === undefined ? { action: "approve" } : { action: "edit", text: t }; }
			return { action: "stop" };
		}
		if (kind === "result") {
			const c = await ui.select(`Factory ${L.id}: the result\n\n${summary(L)}\n\nDiff: ${diffPath(L)}`, ["Commit on the run branch", "Keep uncommitted", "Stop"]);
			return { action: c === "Commit on the run branch" ? "commit" : c === "Keep uncommitted" ? "keep" : "stop" };
		}
		if (kind === "stuck") {
			const opts = [...(L.rounds < MAX_FIX_ROUNDS ? ["One more fix round"] : []), "Go to the final approval as it is", "Stop"];
			const c = await ui.select(`Factory ${L.id}: ${L.note}\n\n${formatFindings(L.pending?.findings ?? [])}`, opts);
			return { action: c === "One more fix round" ? "more" : c === "Go to the final approval as it is" ? "final" : "stop" };
		}
		const c = await ui.select(`Factory ${L.id}: ${L.note}`, ["Retry the stage", "Stop"]);
		return { action: c === "Retry the stage" ? "retry" : "stop" };
	};
}
// A run the orchestrator started: each checkpoint pauses the run and goes
// back to it (the main session's model) with what to decide; it goes on with a
// resume and its decision, and asks the user only what needs the user. The
// criteria it wrote into the ticket are confirmed for it.
export const DECISIONS: Record<Waiting, Decision["action"][]> = { criteria: ["approve", "edit", "stop"], plan: ["approve", "edit", "stop"], result: ["commit", "keep", "stop"], stuck: ["more", "final", "stop"], blocked: ["retry", "stop"] };
// "approve" reads as the checkpoint's go-ahead wherever it has another name
const GO: Partial<Record<Waiting, Decision["action"]>> = { result: "commit", stuck: "more", blocked: "retry" };
// what a checkpoint takes now: no further fix round once the rounds are used
export const decisionsAt = (kind: Waiting, L?: Ledger): Decision["action"][] => (kind === "stuck" && L && L.rounds >= MAX_FIX_ROUNDS ? ["final", "stop"] : DECISIONS[kind]);
export function decisionFor(kind: Waiting, said: string, text?: string, L?: Ledger): Decision | string {
	const a = said.trim().toLowerCase(); const ok = decisionsAt(kind, L);
	const action = (a === "approve" && GO[kind] && ok.includes(GO[kind]!) ? GO[kind] : a) as Decision["action"];
	if (!ok.includes(action)) return `the run waits at its ${kind} checkpoint${ok !== DECISIONS[kind] ? ` with its ${MAX_FIX_ROUNDS} fix rounds used` : ""}: decision is one of ${ok.join(", ")}`;
	if (action === "edit" && !(text ?? "").trim()) return `decision edit needs text: the ${kind === "plan" ? "plan" : "criteria"} to use`;
	return { action, text: action === "edit" || action === "more" ? text : undefined, by: "the orchestrator" };
}
export function orchestrated(decision?: Decision): Deps["checkpoint"] {
	let given = decision;
	return async (kind, L) => {
		if (given) { const d = given; given = undefined; return d; }
		if (kind === "criteria" && L.criteria.length) return { action: "approve", by: "the orchestrator" };
		return null;
	};
}
// the real stages: the experts module's brief rendering, the subagents runner
export async function sessionDeps(ctx: any, signal?: AbortSignal, progress?: (l: string) => void, callId?: string): Promise<Deps> {
	const sub = await import(pathToFileURL(join(HERE, "subagents.ts")).href);
	const exp = await import(pathToFileURL(join(HERE, "experts.ts")).href);
	const find = (n: string) => sub.discoverExperts().find((s: any) => s.name === n);
	return {
		available: (n) => { const s = find(n); return !!s && s.expert.ready && exp.remembered()[n] === true; },
		async dispatch(expert, brief, cwd, meta) {
			const s = find(expert); if (!s) return { text: `The ${expert} expert is not usable here.`, exitCode: 127, input: 0, output: 0, seconds: 0 };
			const t0 = Date.now(); const i = PIPELINE.indexOf(meta.stage);
			const r = await sub.runAgent(s, exp.renderBrief(s, brief), cwd, signal, progress, { tool: "factory", callId: callId ?? meta.runId, mode: "chain", index: i, of: PIPELINE.length });
			return { text: r.text ?? "", exitCode: r.exitCode ?? 1, input: r.input ?? 0, output: r.output ?? 0, seconds: (Date.now() - t0) / 1000 };
		},
		exec: shellExec,
		checkpoint: dialogs(ctx?.hasUI ? ctx.ui : undefined),
		progress,
	};
}
// the stage experts must be enabled: the user's yes (one dialog for all) is remembered
export async function ensureExperts(ctx: any, names = ["developer", "expert-reviewer", "design-reviewer", "tester", "acceptance-judge"]): Promise<string | null> {
	const exp = await import(pathToFileURL(join(HERE, "experts.ts")).href);
	const off = names.filter((n) => exp.remembered()[n] !== true);
	if (!off.length) return null;
	if (!ctx?.hasUI) return `The factory needs these experts enabled: ${off.join(", ")} (/experts enable <name>).`;
	if (!(await ctx.ui.confirm("Enable the factory's experts?", `${off.join(", ")}\nlets-code remembers the answer yes.`))) return "The user did not enable the factory's experts.";
	for (const n of off) exp.remember(n, true);
	return null;
}

// the main session orchestrates from a run's start on (the mandate's
// orchestrator role: it reads and dispatches experts, changes no file), until
// the user leaves it with /orchestrator or /mode; nothing without the mandate
export const ORCHESTRATING = "This session is now in orchestrator mode: you plan and dispatch experts, and change no file yourself.";
export function orchestrate(ctx: any, why: string): boolean {
	try { return (globalThis as any).__letsCodeOrchestrate?.(ctx, why) === true; } catch { return false; }
}
// what the caller is told: the stage lines and what happens next
// for the orchestrator (forModel): a waiting run's checkpoint, with what to
// decide and the call that decides it; for the user: the /factory command
export function report(L: Ledger, forModel = false): string {
	const call = (kind: Waiting) => { const ok = decisionsAt(kind, L); return `expert({action: "run", name: "software-factory", brief: {resume: "${L.id}", decision: "${ok.join(" | ")}"${ok.includes("edit") ? `, text: "the edited ${kind === "plan" ? "plan" : "criteria"}, with edit"` : ok.includes("more") ? `, text: "optional: your note to the developer for that round"` : ""}}})`; };
	const what = (kind: Waiting) => kind === "criteria" ? `Acceptance criteria:\n${L.criteria.length ? numbered(L.criteria) : "(none found in the ticket)"}`
		: kind === "plan" ? `The developer's plan:\n${L.plan}`
		: kind === "result" ? `The result: the change is in ${L.work}; diff: ${diffPath(L)}. commit makes one commit on ${L.branch} (nothing is pushed or merged); keep leaves it uncommitted.`
		: kind === "stuck" ? `${L.note}\n${formatFindings(L.pending?.findings ?? [])}` : L.note;
	let next = "";
	if (L.status === "waiting" && L.waiting) next = forModel
		? `The run waits at its ${L.waiting} checkpoint, for you to decide.\n\n${what(L.waiting)}\n\nDecide it yourself and go on with ${call(L.waiting)}. Ask the user first only for a significant design decision.`
		: `The run waits for the user (${L.waiting}): /factory resume ${L.id} asks it.`;
	else if (L.status === "done") next = L.commit ? `The change is committed on ${L.branch} (worktree ${L.work}); pushing, merging or a PR is up to the user.` : `The change is left uncommitted in ${L.work} on ${L.branch}.`;
	else if (L.status === "stopped") { const at = stopKind(L); next = !at ? "Stopped; the worktree stays." : forModel ? `Stopped. To go on, ${call(at)}; the worktree stays.` : `Stopped. /factory resume ${L.id} asks the ${at} checkpoint again; the worktree stays.`; }
	return [summary(L), next].filter(Boolean).join("\n");
}
// the software-factory expert's run, in the main session: the brief's ticket
// (its text, or a file holding it), criteria, repo, how_to_run, start,
// constraints. Models name fields their own way (acceptance_criteria,
// test_command, goal) and send lists: those are read too, and any other
// field goes into the ticket, so nothing the caller agreed with the user is lost.
const FIELDS: Record<string, string[]> = { criteria: ["criteria", "acceptance_criteria", "acceptance"], how_to_run: ["how_to_run", "test_command", "tests", "test"], goal: ["goal", "summary"] };
const SEEN = new Set(["ticket", "repo", "start", "constraints", "resume", "decision", "text", ...Object.values(FIELDS).flat()]);
const asText = (x: unknown): string => (Array.isArray(x) ? x.map(asText).filter(Boolean).join("\n") : typeof x === "string" ? x : x === undefined || x === null ? "" : typeof x === "object" ? JSON.stringify(x) : String(x)).trim();
export function ticketFrom(brief: Record<string, unknown>, cwd: string): { ticket: string; howToRun: string; constraints: string } {
	const v = (k: string) => asText(brief?.[k]);
	const pick = (name: string) => FIELDS[name].map(v).find(Boolean) ?? "";
	let ticket = v("ticket");
	if (ticket && !ticket.includes("\n") && ticket.length < 500) { const f = resolve(cwd, ticket); try { if (statSync(f).isFile()) ticket = readFileSync(f, "utf8"); } catch { /* the text itself */ } }
	const goal = pick("goal"); const criteria = pick("criteria");
