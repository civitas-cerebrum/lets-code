#!/usr/bin/env bash
#
# lets-code — run an agentic coding CLI against your own self-hosted LLM server
# (vLLM, SGLang, Ollama, LM Studio, OpenRouter, or any OpenAI-compatible
# server exposing /v1/models).
#
#   lets-code setup              interactive onboarding (start here)
#   lets-code [args...]          launch pi (args pass to `pi`, e.g.
#                                `lets-code -p "hello"` for one-shot print mode)
#   lets-code --url <base> ...   one-off endpoint override
#   lets-code --model <id> ...   one-off model override
#   lets-code --context <tok>    context window (default: auto-discovered)
#   lets-code --output-cap <tok> max output tokens (default 32768)
#   lets-code --api <dialect>    openai-completions (default) | openai-responses |
#                                anthropic-messages | google-generative-ai
#   lets-code --vision ...       model accepts images (default: auto-detected)
#   lets-code --no-vision ...    force image input off (skips the probe)
#   lets-code --thinking-level <l> thinking level, default: adaptive (medium until
#                                pi's own tests pass, then off; bursts to high
#                                when the output shows struggle)
#                                (auto-detected when the resident model thinks);
#                                auto[:<l>] is dynamic thinking: off, raised to
#                                the ceiling <l> (default high) in short bursts
#                                when the output shows pi struggling
#   lets-code --harness <name>   pi (default; only v1 harness) |
#                                deepseek | codex (roadmap)
#   lets-code --insecure ...     skip TLS verification (self-signed certs)
#   lets-code --no-mem-guard     launch without the memory guard
#   lets-code --no-git-guard     launch without the git guard
#   lets-code --no-agent-guard   launch without the agent guard
#   lets-code --verbose ...      show endpoint probing
#
# What it does at launch:
#   1. probes your configured endpoints in order, first reachable wins
#   2. discovers the resident model, its context window, whether it
#      thinks (a minimal test request with thinking forced on) and whether
#      it sees images (a tiny solid-red PNG and "what color is this?"); for a
#      thinking model on vLLM, also whether its chat template has its own
#      effort control (rendered via /tokenize, no generation), which then
#      follows pi's thinking level
#   3. registers the endpoint with pi (~/.pi/agent/models.json) and reserves
#      the output budget in pi's compaction settings (settings.json), so
#      compaction fires before a response can overflow the server's window;
#      pi's install telemetry is off unless you turned it on yourself, and
#      pi's file-search helpers (fd, ripgrep) are fetched before the first
#      start instead of by the TUI mid-session
#   4. exports LETS_CODE_TOKEN (pi resolves it via $ENV interpolation) and
#      execs:  pi --provider lets-code --model <id>
#   5. memory guard (Linux): when the machine runs low on RAM, stops the
#      largest process this session started (never anything else) instead
#      of letting it freeze the machine; pi is warned first and told why
#   6. git guard: in a git repo, work happens on a pi/* branch. lets-code
#      creates pi/<timestamp> at launch if needed (uncommitted changes come
#      along); a pi hook parses each bash command like a shell and blocks
#      edits/writes/commands aimed at a repo whose HEAD is on any other
#      branch, refuses irreversible commands (force push, branch -D, reset
#      --hard, checkout <path>, clean -f, stash drop, rm .git) on every
#      branch, and refuses writes into .git. After each successful tool
#      call it snapshots uncommitted work under refs/pi-checkpoints/ (own
#      index file; HEAD, index and branches untouched). Zero tokens unless
#      a call is blocked.
#   7. agent guard: gives bash calls a default timeout, continues a reply
#      the output limit cut off before any tool call, reminds pi to run its
#      tests after several untested edits, requires executed checks (not
#      reasoning) as verification, tells pi once to finish after its own
#      tests have passed for a while, and runs the auto thinking level. Zero tokens unless a rule acts.
#
# Harness: pi is the default (and only v1) harness; --harness deepseek|codex
# are roadmap items, not yet available.
#
# Config: ~/.config/lets-code/config   (created by `lets-code setup`)
# Env overrides: LETS_CODE_ENDPOINTS (space-separated), LETS_CODE_TOKEN,
#                LETS_CODE_CA, LETS_CODE_MODEL, LETS_CODE_CONTEXT,
#                LETS_CODE_OUTPUT_CAP, LETS_CODE_API, LETS_CODE_VISION,
#                LETS_CODE_THINKING, LETS_CODE_REASONING,
#                LETS_CODE_MEM_GUARD (true|false), LETS_CODE_GIT_GUARD (true|false),
#                LETS_CODE_GIT_CHECKPOINTS (1|0), LETS_CODE_AGENT_GUARD (true|false),
#                LETS_CODE_BASH_TIMEOUT (s, default 300), LETS_CODE_WRAP_TURNS (6),
#                LETS_CODE_WRAP_MINUTES (5), LETS_CODE_TEMPLATE_EFFORT (auto|neutral|off),
#                LETS_CODE_BURST_TURNS (3), LETS_CODE_MAX_BURSTS (8), LETS_CODE_THINKING_REPLAY (all|<n>)
#                LETS_CODE_FINAL_REVIEW (auto|on|0), LETS_CODE_PLAN_BURST (0|1), LETS_CODE_PLAN_LEVEL (low)
#                LETS_CODE_OPENROUTER_PROVIDER (pin upstream providers, comma-separated, no fallbacks)
# Needs: bash >= 3.2 (stock macOS is fine), curl, python3, pi CLI
# (auto-installed on request).

set -eu
(set -o pipefail) 2>/dev/null && set -o pipefail   # pipefail is bash 4+; keep 3.2 alive

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lets-code"
CONFIG_FILE="${CONFIG_DIR}/config"
PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"   # pi's config home (overridable)
PROVIDER_ID="lets-code"          # fixed provider id we upsert into pi's files
DEFAULT_CONTEXT=128000
DEFAULT_OUTPUT_CAP=32768
DEFAULT_API="openai-completions"
DEFAULT_THINKING="adaptive"

VERBOSE=false
LOG_PREFIX="[lets-code]"
log()         { echo "${LOG_PREFIX} ${1}"; }
log_verbose() { if [ "${VERBOSE}" = "true" ]; then echo "${LOG_PREFIX} ${1}"; fi; }
log_error()   { echo "${LOG_PREFIX} ERROR: ${1}" >&2; }

# ------------------------------------------------------------------ probing
# The probe is PERMISSIVE over TLS on purpose: it runs against every
# configured endpoint (first reachable wins), so a strict check here would
# wrongly kill LAN/VPN fallbacks. Certificate trust is enforced separately,
# before launch, for the endpoint that won (see the https block in main).

tls_args_for() {
    case "$1" in
        https://*)
            if   [ -n "${CA_FOUND:-}" ];        then echo "--cacert|${CA_FOUND}"
            elif [ "${INSECURE:-false}" = true ]; then echo "-k"
            else echo "-k"   # permissive probe; trust is enforced before launch
            fi ;;
        *) echo "" ;;
    esac
}

# Endpoint normalization. Accepts "192.168.0.114/vllm", "llm.example.com",
# "http://host:8000/v1", ... A missing scheme is filled in: IP addresses,
# localhost, bare hostnames and *.local (mDNS) get http:// (no public cert
# can exist for them); other domain names get https://. A trailing / or /v1
# is dropped — the probe always hits <base>/v1/models.
normalize_endpoint() {  # normalize_endpoint <url> -> prints the normalized base URL
    local u="${1%/}" host
    u="${u%/v1}"
    case "${u}" in
        *://*) ;;
        *)
            host="${u%%/*}"
            case "${host}" in
                \[*) ;;                               # [::1]:8000 — IPv6 literal
                *) host="${host%%:*}" ;;              # strip :port
            esac
            case "${host}" in
                \[*|localhost|*.local) u="http://${u}" ;;
                *[!0-9.]*)                            # not an IPv4 address
                    case "${host}" in
                        *.*) u="https://${u}" ;;      # domain name
                        *)   u="http://${u}" ;;       # bare hostname (no dots)
                    esac ;;
                *) u="http://${u}" ;;                 # IPv4 address
            esac ;;
    esac
    printf '%s\n' "${u}"
}

normalize_endpoints() {  # normalize_endpoints "<url> <url> ..." -> space-separated
    local out="" e
    for e in $1; do out="${out:+${out} }$(normalize_endpoint "${e}")"; done
    printf '%s\n' "${out}"
}

PROBE_ERR=""
PROBE_OUT="${TMPDIR:-/tmp}/.lets-code-probe.$$"
trap 'rm -f "${PROBE_OUT}"' EXIT
probe() {  # probe <base-url> -> prints /v1/models JSON on success; PROBE_ERR explains failure
    local base="$1" tls rc; tls="$(tls_args_for "$base")"
    local IFS='|'; # shellcheck disable=SC2086
    if curl -sf --max-time 4 ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" "${base}/v1/models" 2>/dev/null; then
        PROBE_ERR=""; return 0
    else
        rc=$?
    fi
    case "${rc}" in
        6)  PROBE_ERR="DNS: cannot resolve host" ;;
        7)  PROBE_ERR="connection refused (host up, port closed?)" ;;
        28) PROBE_ERR="timed out (host unreachable / wrong IP?)" ;;
        35) PROBE_ERR="TLS handshake failed" ;;
        60) PROBE_ERR="TLS certificate not trusted" ;;
        22) local code; code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 ${tls:+$tls} \
                -H "Authorization: Bearer ${TOKEN:-dummy-key}" "${base}/v1/models" 2>/dev/null)"
            case "${code}" in
                401)         PROBE_ERR="HTTP 401: token rejected" ;;
                403)         PROBE_ERR="HTTP 403: forbidden (proxy doesn't allow this network, or bad token)" ;;
                404)         PROBE_ERR="HTTP 404: no /v1/models here (wrong base URL/path?)" ;;
                502|503|504) PROBE_ERR="HTTP ${code}: proxy is up but the model server behind it is down" ;;
                *)           PROBE_ERR="HTTP error ${code:-4xx/5xx} from server" ;;
            esac ;;
        *)  PROBE_ERR="curl exit ${rc}" ;;
    esac
    return "${rc}"
}

# Thinking probe: one minimal chat completion with thinking forced on.
# A server that reports reasoning tokens (or streams reasoning content)
# has a thinking model resident. Cost: one tiny request per launch.
# Sets THINKING_DETECTED: true | false | unknown (inconclusive).
probe_thinking() {  # probe_thinking <base-url-without-/v1> <model>
    local base="$1" model="$2" payload tls out
    payload="$(python3 -c '
import json, sys
print(json.dumps({
    "model": sys.argv[1],
    "max_tokens": 16,
    "temperature": 0,
    "chat_template_kwargs": {"enable_thinking": True},
    "messages": [{"role": "user", "content": "Reply with exactly: OK"}],
}))' "${model}" 2>/dev/null)" || { THINKING_DETECTED="unknown"; return 0; }
    tls="$(tls_args_for "${base}")"
    local IFS='|'; # shellcheck disable=SC2086
    if out="$(curl -sf --max-time 30 ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" \
        -H "Content-Type: application/json" -d "${payload}" \
        "${base}/v1/chat/completions" 2>/dev/null)"; then
        THINKING_DETECTED="$(printf '%s' "${out}" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("unknown"); sys.exit()
ch = (d.get("choices") or [{}])[0]
m = ch.get("message") or {}
usage = d.get("usage") or {}
details = usage.get("completion_tokens_details") or {}
rt = details.get("reasoning_tokens") or 0
rc = m.get("reasoning_content") or m.get("reasoning") or ""
content = m.get("content") or ""
if isinstance(rt, (int, float)) and rt > 0:
    print("true")
elif isinstance(rc, str) and rc.strip():
    print("true")
elif "think" in content.lower():
    print("true")
else:
    print("false")' 2>/dev/null)"
    else
        THINKING_DETECTED="unknown"
    fi
    case "${THINKING_DETECTED}" in
        true|false) ;;
        *) THINKING_DETECTED="unknown" ;;
    esac
}

# Vision probe: one minimal chat completion carrying a 64x64 solid-red PNG
# (built inline; no PIL) and the question "what color is this?". A model
# that answers "red" saw the image. An error whose message talks about
# images / multimodal input (vLLM 400, llama.cpp 500 without an mmproj) is
# a text-only model. A 200 whose answer says it cannot see images (servers
# like Ollama silently drop images for text-only models) is text-only too.
# Anything else is inconclusive: onboarding then asks, launch defaults to
# text-only. Cost: one tiny request per launch (only when VISION is unset).
# Sets VISION_DETECTED: true | false | unknown (inconclusive).
probe_vision() {  # probe_vision <base-url-without-/v1> <model>
    local base="$1" model="$2" payload tls out code body
    payload="$(python3 -c '
import base64, json, struct, sys, zlib
w = h = 64
raw = b"".join(b"\x00" + b"\xff\x00\x00" * w for _ in range(h))
def chunk(t, d):
    return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
       + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
print(json.dumps({
    "model": sys.argv[1],
    "max_tokens": 200,
    "temperature": 0,
    "chat_template_kwargs": {"enable_thinking": False},
    "messages": [{"role": "user", "content": [
        {"type": "text", "text": "What color is this image? Reply with one word."},
        {"type": "image_url", "image_url": {"url": "data:image/png;base64," + base64.b64encode(png).decode()}},
    ]}],
}))' "${model}" 2>/dev/null)" || { VISION_DETECTED="unknown"; return 0; }
    tls="$(tls_args_for "${base}")"
    local IFS='|'; # shellcheck disable=SC2086
    if out="$(curl -s --max-time 60 -w '
%{http_code}' ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" \
        -H "Content-Type: application/json" -d "${payload}" \
        "${base}/v1/chat/completions" 2>/dev/null)"; then
        code="${out##*
}"; body="${out%
*}"
        VISION_DETECTED="$(printf '%s' "${body}" | python3 -c '
import json, re, sys
code = sys.argv[1]
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    d = {}
if code == "200" and isinstance(d, dict) and d.get("choices"):
    m = (d["choices"] or [{}])[0].get("message") or {}
    content = m.get("content") or ""
    if not isinstance(content, str):  # list-of-parts replies
        content = " ".join(p.get("text", "") for p in content if isinstance(p, dict))
    seen = (content + " " + (m.get("reasoning_content") or m.get("reasoning") or "")).lower()
    if re.search(r"\bred\b", seen):
        print("true")
    elif re.search(r"(can.?t|cannot|unable to|not able to|don.?t have the ability to) (see|view|process|interpret|analy[sz]e|access)|no image|text-only|text-based|only (process|handle|understand) text", seen):
        print("false")
    else:
        print("unknown")
elif code[:1] in ("4", "5"):
    # a JSON error that names images/multimodal input: the server refused
    # the image for this model (vLLM 400, llama.cpp 500 without mmproj)
    err = d.get("error") if isinstance(d, dict) else None
    msg = err.get("message", "") if isinstance(err, dict) else (err if isinstance(err, str) else "")
    if re.search(r"image|vision|multi-?modal|mm_|mmproj", str(msg), re.I):
        print("false")
    else:
        print("unknown")
else:
    print("unknown")' "${code}" 2>/dev/null)"
    else
        VISION_DETECTED="unknown"
    fi
    case "${VISION_DETECTED}" in
        true|false) ;;
        *) VISION_DETECTED="unknown" ;;
    esac
}

# Template effort probe. Some chat templates carry their own effort control
# besides enable_thinking: Qwen3.8's takes reasoning_effort low|medium|xhigh,
# defaults to xhigh, and puts an instruction in the system prompt ("think
# carefully, validate key assumptions, consider plausible alternatives"),
# rejecting any other value with HTTP 400. pi never sets it unless told to, so
# every thinking level ran under the xhigh instruction and the levels differed
# only in where the token budget cut the thinking off (2026-10-08).
# Renders the prompt through vLLM's /tokenize (no generation, milliseconds)
# without the kwarg and with each candidate value. If some accepted value
# changes the rendered prompt, the template uses it: each pi level from minimal
# to high gets the accepted value nearest to it. xhigh/max stay unmapped so pi
# keeps clamping them to high. Servers without /tokenize: nothing is sent.
# Sets EFFORT_MAP ("" or JSON like {"low": "low", ...}) and EFFORT_NOTE.
probe_template_effort() {  # probe_template_effort <base-url-without-/v1> <model> [1 = neutral: map every level to the least-instruction value]
    EFFORT_MAP=""; EFFORT_NOTE=""
    local out
    out="$(LC_BASE="$1" LC_MODEL="$2" LC_TOKEN="${TOKEN:-}" LC_CA="${CA_FOUND:-}" LC_NEUTRAL="${3:-0}" python3 -c '
import json, os, ssl, urllib.request, urllib.error
base, model, token, ca = (os.environ[k] for k in ("LC_BASE", "LC_MODEL", "LC_TOKEN", "LC_CA"))
ctx = None
if base.startswith("https://"):
    ctx = ssl.create_default_context(cafile=ca) if ca else ssl._create_unverified_context()
RANK = {"minimal": 0, "low": 1, "medium": 2, "high": 3, "xhigh": 4, "max": 5}
class NoTokenize(Exception):
    pass
def render(extra):
    kwargs = {"enable_thinking": True}
    kwargs.update(extra)
    body = {"model": model, "add_generation_prompt": True, "chat_template_kwargs": kwargs,
            "messages": [{"role": "system", "content": "s"}, {"role": "user", "content": "u"}]}
    req = urllib.request.Request(base + "/tokenize", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json", "Authorization": "Bearer " + token})
    try:
        with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
            return json.load(r).get("tokens")
    except urllib.error.HTTPError as e:
        if e.code == 400:
            return None
        raise NoTokenize("HTTP %d" % e.code)
    except Exception as e:
        raise NoTokenize(type(e).__name__)
try:
    baseline = render({})
    if baseline is None:
        raise NoTokenize("baseline rejected")
    accepted = {}
    for v in RANK:
        t = render({"reasoning_effort": v})
        if t is not None:
            accepted[v] = t
except NoTokenize as e:
    print("|no /tokenize endpoint (%s): template effort not probed" % e)
    raise SystemExit
renders = {json.dumps(t) for t in accepted.values()} | {json.dumps(baseline)}
if not accepted or len(renders) < 2:
    print("|template has no effort control")
    raise SystemExit
mapping = {}
neutral = min(accepted, key=lambda v: (len(accepted[v]), RANK[v]))  # the value whose instruction is shortest
for level in ("minimal", "low", "medium", "high"):
    mapping[level] = neutral if os.environ.get("LC_NEUTRAL") == "1" else min(accepted, key=lambda v: (abs(RANK[v] - RANK[level]), RANK[v]))
default = [v for v, t in accepted.items() if t == baseline]
note = "template effort control: accepts %s%s; pi levels map %s" % (
    "|".join(accepted), " (default %s)" % "|".join(default) if default else "",
    ", ".join("%s->%s" % kv for kv in mapping.items()))
print(json.dumps(mapping) + "|" + note)
' 2>/dev/null)" || out="|template effort probe failed"
    EFFORT_MAP="${out%%|*}"
    EFFORT_NOTE="${out#*|}"
}

# Suggested thinking level from context window + output cap. Level costs
# are pi's published budgets (minimal ~1k / low ~2k / medium ~8k /
# high ~16k). A level is suggested only when 4x its cost fits the window
# (pi's own model catalog follows this: 64k deployments top out at high,
# 131k just misses xhigh's 32k, 256k gets xhigh) and half the output cap
# (thinking must not eat the response budget). xhigh/max are never
# suggested: on the chat-template path pi clamps their budget to high's
# 16k, so they behave identically to high.
suggested_thinking_level() {  # suggested_thinking_level <context> <output-cap>
    local ctx="$1" cap="$2" room
    room=$(( ctx / 4 ))
    if [ $(( cap / 2 )) -lt "${room}" ]; then room=$(( cap / 2 )); fi
    if   [ "${room}" -ge 16384 ]; then echo "high"
    elif [ "${room}" -ge 8192  ]; then echo "medium"
    elif [ "${room}" -ge 2048  ]; then echo "low"
    elif [ "${room}" -ge 1024  ]; then echo "minimal"
    else echo "off"; fi
}

# ---------------------------------------------------------- pi config writes
# pi keeps its state under ~/.pi/agent (override: $PI_CODING_AGENT_DIR).
# lets-code owns exactly two slices, both keyed by the fixed provider id
# 'lets-code', so it never clobbers the user's own providers or defaults:
#   models.json   -> providers["lets-code"]
#                    (endpoint, api dialect, model, contextWindow, maxTokens,
#                     input types: ["text","image"] when vision is enabled,
#                     reasoning + chat-template thinking kwargs when thinking,
#                     + hard thinking_token_budget ceiling when thinking)
#   settings.json -> compaction.enabled = true +
#                    compaction.modelOverrides["lets-code/<model>"]
#                    .reserveTokens = output cap
#                    + modelThinkingLevels["lets-code/<model>"] = startup
#                    thinking level (when thinking is registered)
#                    + enableInstallTelemetry = false when the key is absent
#                    (pi defaults it to true and pings pi.dev on first start;
#                    an explicit true/false already in the file is kept)
# The token is never written to disk: apiKey points at $LETS_CODE_TOKEN (pi's
# $ENV interpolation), exported at launch — the secret stays in
# ~/.config/lets-code/config (mode 600). Writes are atomic (tmp + rename),
# every other key in the files is preserved, and a corrupt file fails loudly.
pi_write_configs() {  # pi_write_configs <base> <api> <model> <context> <output-cap> <vision> <reasoning> <thinking> [<effort-map-json>]
    PI_AGENT_DIR="${PI_AGENT_DIR}" python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "${9:-}" <<'PY'
import json, os, sys, tempfile

base, api, model, context, cap, vision, reasoning, thinking, effort_map = sys.argv[1:10]
agent_dir = os.environ["PI_AGENT_DIR"]
ctx = int(context)
cap = int(cap)

def upsert(path, mutate):
    doc = {}
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                doc = json.load(f)
        except Exception as exc:
            sys.exit("[lets-code] cannot parse %s: %s\n"
                     "  fix or move the file aside, then re-run lets-code." % (path, exc))
    if not isinstance(doc, dict):
        sys.exit("[lets-code] %s must contain a JSON object." % path)
    mutate(doc)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    existed = os.path.exists(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".lets-code-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, indent=2)
            f.write("\n")
        os.chmod(tmp, os.stat(path).st_mode & 0o777 if existed else 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

def to_models(doc):
    providers = doc.get("providers")
    if not isinstance(providers, dict):
        providers = {}
    compat = {"supportsDeveloperRole": False, "supportsReasoningEffort": False}
    model_doc = {
        "id": model,
        "contextWindow": ctx,
        "maxTokens": cap,
        # pi defaults a model's input to ["text"] unless declared otherwise,
        # so image support must be declared explicitly for images to pass
        "input": ["text", "image"] if vision == "true" else ["text"],
    }
    openrouter = "openrouter.ai" in base
    if reasoning == "true" and openrouter:
        # OpenRouter normalises thinking across providers with its own request
        # field, reasoning: {effort}; pi sends it per request (effort "none" when
        # thinking is off) in its openrouter mode. Chat-template kwargs and
        # thinking_token_budget are vLLM/SGLang features and are not set here.
        model_doc["reasoning"] = True
        compat["thinkingFormat"] = "openrouter"
    elif reasoning == "true":
        # pi only offers thinking levels for models that declare reasoning.
        # The chat-template kwargs map pi's level onto the server's chat
        # template variables (vLLM/SGLang pass chat_template_kwargs through;
        # Qwen3 & friends take enable_thinking + thinking_budget).
        model_doc["reasoning"] = True
        compat["thinkingFormat"] = "chat-template"
        compat["chatTemplateKwargs"] = {
            "enable_thinking": {"$var": "thinking.enabled"},
            "thinking_budget": {"$var": "thinking.budget", "omitWhenOff": True},
        }
        # Hard per-level ceiling on thinking tokens. The template budget above
        # is only a hint, and Qwen3's template ignores it entirely (checked
        # 2026-10-06: identical prompt with and without it). vLLM enforces
        # thinking_token_budget engine-side (with a reasoning parser): the
        # thinking section is force-terminated at the budget. pi sends its
        # budget for the current level in that field when the compat flag is
        # set (defaults: minimal 1024, low 2048, medium 8192, high 16384;
        # override with thinkingBudgets in settings.json), clamped to leave
        # 1024 tokens of answer room. A fixed samplingParams ceiling used to
        # be here; it gave every level the same 16K budget, so low, medium
        # and high behaved alike. Servers that don't know the field ignore it.
        compat["supportsThinkingTokenBudget"] = True
        # The template's own effort control (see probe_template_effort): pi
        # substitutes its current level through thinkingLevelMap, so the
        # model gets the matching instruction instead of the template's
        # default. Omitted when thinking is off (no thinking section at all).
        if effort_map:
            compat["chatTemplateKwargs"]["reasoning_effort"] = {"$var": "thinking.level", "omitWhenOff": True}
            model_doc["thinkingLevelMap"] = json.loads(effort_map)
    if openrouter and os.environ.get("LETS_CODE_OPENROUTER_PROVIDER"):
        # Pin one upstream provider (no fallbacks): providers serving the same
        # model differ in quantization and in how they honour reasoning effort
        # (2026-10-09: for qwen3.8-27b, effort "none" was clean on one provider
        # and still reasoned at length in the answer on another).
        compat["openRouterRouting"] = {"order": [p.strip() for p in os.environ["LETS_CODE_OPENROUTER_PROVIDER"].split(",") if p.strip()], "allow_fallbacks": False}
    providers["lets-code"] = {
        "baseUrl": base,
        "api": api,
        "apiKey": "$LETS_CODE_TOKEN",
        "compat": compat,
        "models": [model_doc],
    }
    doc["providers"] = providers

def to_settings(doc):
    compaction = doc.get("compaction")
    if not isinstance(compaction, dict):
        compaction = {}
    overrides = compaction.get("modelOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    overrides["lets-code/" + model] = {"reserveTokens": cap}
    compaction["modelOverrides"] = overrides
    compaction["enabled"] = True  # auto-compaction explicit, not pi's implicit default
    doc["compaction"] = compaction
    # install telemetry off by default; a value the user set stays as is
    doc.setdefault("enableInstallTelemetry", False)
    if reasoning == "true":
        # pi's per-model startup thinking level (global default is "medium")
        levels = doc.get("modelThinkingLevels")
        if not isinstance(levels, dict):
            levels = {}
        levels["lets-code/" + model] = thinking
        doc["modelThinkingLevels"] = levels
    elif "lets-code/" + model in (doc.get("modelThinkingLevels") or {}):
        # thinking unregistered — drop our stale level so it cannot surprise
        # a later /model rebind; other providers' entries are untouched
        levels = dict(doc["modelThinkingLevels"])
        del levels["lets-code/" + model]
        if levels:
            doc["modelThinkingLevels"] = levels
        else:
            doc.pop("modelThinkingLevels", None)

upsert(os.path.join(agent_dir, "models.json"), to_models)
upsert(os.path.join(agent_dir, "settings.json"), to_settings)
PY
}

# ------------------------------------------------------------- memory guard
# A runaway command the agent runs (an unbounded search in a test, a leaking
# build) can eat the whole machine. When that machine also hosts the model
# server, the result is minutes of swap thrash and then a global OOM kill that
# can hit the server or the desktop (2026-09-25: a pi-run unittest reached
# 26 GB twice on the box serving the model).
#
# The guard watches the machine's REMAINING RAM (MemAvailable) and acts only on
# processes this lets-code session started -- never on anything else:
#   < 20 % free   pi is warned after each tool call
#   < 10 % free   pi's new non-cleanup bash commands are blocked
#   <  5 % free   (3 s) the largest session process is stopped gracefully:
#                 other big session processes paused, SIGINT -> SIGTERM -> SIGKILL
#   < 2.5 % free  the largest session process is SIGKILLed immediately
# No memory caps: nothing is limited until the machine as a whole runs low.
# It lives in a pi extension (lets-code-memguard.ts) that runs inside pi, so
# "this session" = descendants of that pi, plus anything in the session's
# systemd user scope (orphans re-parented to PID 1 keep their scope). The scope
# (lets-code-<pid>.scope, no root needed) also sets OOMPolicy=continue: if the
# kernel OOM-kills one process, systemd's default would stop the whole session.
# A machine-wide memguard daemon (github.com/civitas-cerebrum/memguard,
# /run/memguard present) already covers lets-code sessions: the extension then
# stays out of the way. Linux only; elsewhere the guard is off.
mem_limited_ancestor() {  # prints the nearest ancestor cgroup with a finite memory.max, if any
    local rel d
    rel="$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)" || return 0
    d="/sys/fs/cgroup${rel}"
    while [ "${d}" != "/sys/fs/cgroup" ] && [ -n "${d}" ]; do
        if [ -r "${d}/memory.max" ] && [ "$(cat "${d}/memory.max")" != "max" ]; then
            echo "${d#/sys/fs/cgroup}"; return 0
        fi
        d="${d%/*}"
    done
}

mem_guard_plan() {  # sets MG_MODE (scope|process|off) and MG_NOTE
    MG_MODE=off; MG_NOTE=""
    case "${MEM_GUARD}" in false|no|0|off) MG_NOTE="disabled"; return 0 ;; esac
    if [ "$(uname -s)" != Linux ]; then MG_NOTE="not available on $(uname -s)"; return 0; fi
    MG_MODE=process   # the extension alone: this pi's descendants
    local limited
    limited="$(mem_limited_ancestor)"
    if [ -n "${limited}" ]; then
        # a user scope would move pi OUT of a cgroup that has its own memory limits
        MG_NOTE="inside memory-limited cgroup ${limited}; no session scope"; return 0
    fi
    if ! command -v systemd-run >/dev/null 2>&1; then
        MG_NOTE="systemd-run not found; no session scope"; return 0
    fi
    # one cheap probe: user manager reachable and OOMPolicy accepted on scopes (systemd >= 253)
    if ! systemd-run --user --scope --quiet --collect -p OOMPolicy=continue true >/dev/null 2>&1; then
        MG_NOTE="systemd user scopes unavailable; no session scope"; return 0
    fi
    MG_MODE=scope
}

mem_guard_exec() {  # mem_guard_exec <cmd> [args...] -- replaces this process
    if [ "${MG_MODE}" != off ]; then export LETS_CODE_SESSION=1; fi
    if [ "${MG_MODE}" = scope ]; then
        exec systemd-run --user --scope --quiet --collect --unit="lets-code-$$" \
            -p OOMPolicy=continue -- "$@"
    fi
    exec "$@"
}

# The pi extension that IS the guard. Inert unless LETS_CODE_SESSION=1 (set by
# lets-code at launch) and silent while the machine has RAM to spare.
# Rewritten when its content changes.
pi_write_memguard_extension() {
    local dir="${PI_AGENT_DIR}/extensions" f tmp
    f="${dir}/lets-code-memguard.ts"
    mkdir -p "${dir}"
    tmp="$(mktemp "${dir}/.lets-code-memguard.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (memory guard); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code (LETS_CODE_SESSION=1). Watches the
// machine's free RAM and acts only on processes this session started.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { existsSync, readFileSync, readdirSync } from "node:fs";

const ACTIVE = process.env.LETS_CODE_SESSION === "1";
// A machine-wide memguard daemon already covers lets-code sessions: defer to it.
const DEFER = existsSync("/run/memguard") && process.env.LETS_CODE_MEM_IGNORE_SYSTEM_GUARD !== "1";
const GRACE_MS = 10_000, NEED = 3, PAUSE_MIN = 512 * 2 ** 20;
const CLEANUP_OK = /^\s*(sudo\s+)?(kill|pkill|killall|ps|pgrep|top|htop|free|vmstat|cat\s+\/proc|cat\s+\/sys\/fs\/cgroup|systemctl\s+(--user\s+)?(status|show)|docker\s+(ps|stop|rm|kill)|tmux\s+kill|echo|true|sleep\s+\d)\b/;

const read = (p: string): string | null => { try { return readFileSync(p, "utf8"); } catch { return null; } };
const gib = (b: number) => `${(b / 2 ** 30).toFixed(1)} GiB`;

function meminfo(): { total: number; avail: number } {
	const t = read("/proc/meminfo") ?? "";
	const kb = (k: string) => Number(new RegExp(`^${k}:\\s+(\\d+)`, "m").exec(t)?.[1] ?? 0) * 1024;
	return { total: kb("MemTotal"), avail: kb("MemAvailable") || kb("MemFree") };
}

// Levels: % of MemTotal or sizes like 3G; env overrides are for tests.
function level(spec: string, total: number): number {
	const m = /^\s*(\d+(?:\.\d+)?)\s*([%KMGT]?)/i.exec(spec);
	if (!m) return 0;
	const n = Number(m[1]), u = m[2].toUpperCase();
	return u === "%" ? (total * n) / 100 : n * 1024 ** "BKMGT".indexOf(u || "B");
}
function levels(total: number) {
	const e = process.env;
	return {
		warn: level(e.LETS_CODE_MEM_WARN ?? "20%", total),
		critical: level(e.LETS_CODE_MEM_CRITICAL ?? "10%", total),
		stop: level(e.LETS_CODE_MEM_STOP ?? "5%", total),
		emergency: level(e.LETS_CODE_MEM_EMERGENCY ?? "2.5%", total),
	};
}
type Level = "ok" | "warn" | "critical" | "stop" | "emergency";
function levelOf(avail: number, th: ReturnType<typeof levels>): Level {
	return avail < th.emergency ? "emergency" : avail < th.stop ? "stop" : avail < th.critical ? "critical" : avail < th.warn ? "warn" : "ok";
}

type Proc = { pid: number; ppid: number; bytes: number; start: number; cmd: string; argv: string[]; cgroup: string };
function procTable(): Map<number, Proc> {
	const out = new Map<number, Proc>();
	for (const d of readdirSync("/proc")) {
		if (!/^\d+$/.test(d)) continue;
		const stat = read(`/proc/${d}/stat`), st = read(`/proc/${d}/status`), cl = read(`/proc/${d}/cmdline`);
		if (!stat || !st || !cl) continue;
		const rest = stat.slice(stat.lastIndexOf(")") + 2).split(" ");
		const kb = (k: string) => Number(new RegExp(`${k}:\\s+(\\d+)`).exec(st)?.[1] ?? 0);
		const argv = cl.split("\0").filter(Boolean);
		if (!argv.length) continue;
		out.set(Number(d), {
			pid: Number(d), ppid: Number(rest[1]), start: Number(rest[19]),
			bytes: (kb("VmRSS") + kb("VmSwap")) * 1024, argv, cmd: argv.join(" ").slice(0, 60),
			cgroup: (read(`/proc/${d}/cgroup`) ?? "").trim().split("::").pop() ?? "",
		});
	}
	return out;
}

// The agents themselves (pi, its node entry, tmux) are never stopped.
function isAgent(argv: string[]): boolean {
	const base = (argv[0] ?? "").split("/").pop() ?? "";
	if (/^(pi|tmux)$/.test(base)) return true;
	return /^(node|nodejs)$/.test(base) && /pi-coding-agent\//.test(argv[1] ?? "");
}

const SCOPE = /\/(lets-code-\d+\.scope)(\/|$)/.exec(read("/proc/self/cgroup") ?? "")?.[1] ?? null;

// Processes this session started: descendants of this pi, or in this session's scope.
function sessionProcs(t: Map<number, Proc>): Proc[] {
	const memo = new Map<number, boolean>();
	const under = (pid: number, depth = 0): boolean => {
		if (memo.has(pid)) return memo.get(pid)!;
		const p = t.get(pid);
		const r = !!p && depth < 200 && p.ppid !== 0 && (p.ppid === process.pid || under(p.ppid, depth + 1));
		memo.set(pid, r);
		return r;
	};
	return [...t.values()].filter((p) => p.pid !== process.pid && !isAgent(p.argv) &&
		(under(p.pid) || (SCOPE !== null && p.cgroup.includes(`/${SCOPE}`))));
}

const alive = (pid: number) => { const s = read(`/proc/${pid}/stat`); return !!s && !/^[ZX]$/.test(s.slice(s.lastIndexOf(")") + 2, s.lastIndexOf(")") + 3)); };
const ignoresInt = (pid: number) => { const m = /SigIgn:\s+([0-9a-f]+)/.exec(read(`/proc/${pid}/status`) ?? ""); return !!m && (BigInt(`0x${m[1]}`) & 2n) !== 0n; };
const signal = (pid: number, sig: NodeJS.Signals) => { try { process.kill(pid, sig); return true; } catch { return false; } };

export default function (pi: ExtensionAPI) {
	if (!ACTIVE || DEFER) return;

	type Stop = { pid: number; cmd: string; bytes: number; avail: number; signals: string[]; step: number; sentAt: number; paused: number[]; done: boolean };
	let stop: Stop | null = null;
	const unreported: Stop[] = [];
	let below = 0, timer: NodeJS.Timeout | undefined;
	const LADDER: NodeJS.Signals[] = ["SIGINT", "SIGTERM", "SIGKILL"];

	const send = (s: Stop) => {
		let sig = LADDER[s.step];
		if (sig === "SIGINT" && ignoresInt(s.pid)) sig = LADDER[++s.step];
		signal(s.pid, sig);
		s.signals.push(sig);
		s.sentAt = Date.now();
	};
	const release = (s: Stop) => {
		for (const p of s.paused) signal(p, "SIGCONT");
		s.paused = [];
		s.done = true;
		stop = null;
		below = 0;
	};

	const tick = () => {
		const m = meminfo(), lv = levelOf(m.avail, levels(m.total));
		if (stop) {
			if (!alive(stop.pid)) return release(stop);
			if (lv === "emergency" && stop.step < 2) { stop.step = 2; send(stop); }
			else if (Date.now() - stop.sentAt >= GRACE_MS) {
				if (stop.step < 2) { stop.step++; send(stop); } else release(stop);  // unkillable: never leave others paused
			}
			return;
		}
		below = lv === "stop" || lv === "emergency" ? below + 1 : 0;
		if (lv !== "emergency" && below < NEED) return;
		const mine = sessionProcs(procTable());
		const target = mine.sort((a, b) => b.bytes - a.bytes || b.start - a.start)[0];
		if (!target) { below = 0; return; }
		const s: Stop = { pid: target.pid, cmd: target.cmd, bytes: target.bytes, avail: m.avail, signals: [],
			step: lv === "emergency" ? 2 : 0, sentAt: 0, paused: [], done: false };
		if (lv !== "emergency") {
			for (const p of mine) if (p.pid !== s.pid && p.bytes >= PAUSE_MIN && signal(p.pid, "SIGSTOP")) s.paused.push(p.pid);
		}
		send(s);
		stop = s;
		unreported.push(s);
	};

	pi.on("session_start", async () => {
		timer = setInterval(() => { try { tick(); } catch { /* never break pi */ } }, 1000);
		timer.unref?.();
	});
	pi.on("session_shutdown", async () => {
		if (timer) clearInterval(timer);
		if (stop) release(stop);  // never leave processes paused
	});

	function status() {
		if (stop && !alive(stop.pid)) release(stop);  // don't report "stopping" once the target is gone
		const m = meminfo(), th = levels(m.total), lv = levelOf(m.avail, th);
		return { m, th, level: (stop ? "critical" : lv === "stop" || lv === "emergency" ? "critical" : lv) as "ok" | "warn" | "critical" };
	}
	function message(st: ReturnType<typeof status>): string {
		const top = sessionProcs(procTable()).filter((p) => p.bytes >= PAUSE_MIN).sort((a, b) => b.bytes - a.bytes).slice(0, 3);
		const lines = [`[lets-code] MEMORY ${st.level.toUpperCase()}: the machine has ${gib(st.m.avail)} of RAM left (of ${gib(st.m.total)}). Below ${gib(st.th.stop)} lets-code stops the largest process this session started.`];
		if (top.length) lines.push("Largest processes this session started: " + top.map((p) => `pid ${p.pid} ${gib(p.bytes)} \`${p.cmd}\``).join("; "));
		lines.push(st.level === "critical"
			? "New commands are blocked except cleanup (kill/pkill/ps/free/...). Kill processes you started and no longer need, then retry with smaller inputs, bounded depth/caches, or streaming."
			: "Before starting anything memory-heavy: stop background jobs you no longer need, and keep inputs, recursion depth and caches bounded.");
		return lines.join("\n");
	}

	pi.on("tool_call", async (event) => {
		if (event.toolName !== "bash") return undefined;
		const st = status();
		if (st.level !== "critical") return undefined;
		const cmd = String((event.input as { command?: string }).command ?? "");
		return CLEANUP_OK.test(cmd) ? undefined : { block: true, reason: message(st) };
	});

	pi.on("tool_result", async (event) => {
		const notes: string[] = [];
		while (unreported.length) {
			const s = unreported.shift()!;
			notes.push(`[lets-code] Stopped pid ${s.pid} (\`${s.cmd}\`, ${gib(s.bytes)}) with ${s.signals.join(" -> ")} because the machine was down to ${gib(s.avail)} of free RAM. If a command above ended abruptly (KeyboardInterrupt, Terminated, Killed, exit 130/137/143, or output cut short behind a pipe such as | tail), that is why: it used too much memory; it is not a bug where it stopped. Reduce input size or recursion depth, bound caches, or stream data.`);
		}
		const st = status();
		if (st.level !== "ok") notes.push(message(st));
		if (!notes.length) return undefined;
		return { content: [...event.content, { type: "text", text: `\n${notes.join("\n")}` }] };
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# ------------------------------------------------------------------ git guard
# Safety net for small self-hosted models: all work happens on a pi/* branch,
# so a broken edit or a bad `git` command never lands on main. Two parts:
#   * here, at launch (zero tokens): if the cwd is a git work tree and HEAD is
#     not on a pi/* branch, `git switch -c pi/<timestamp>` — uncommitted
#     changes travel with the switch, nothing is lost.
#   * a pi extension (lets-code-gitguard.ts) that blocks edit/write/bash
#     while HEAD is off a pi/* branch (only plain git inspection and a
#     switch to a pi/* branch may run), and on any branch refuses commands
#     that destroy work irreversibly. It reads .git/HEAD from disk; nothing
#     is added to the system prompt or to tool results while the rules hold.
#   * the same extension checkpoints uncommitted work: after each
#     successful edit/write/bash in a pi/* repo (debounced 3 s) the working
#     tree is committed under refs/pi-checkpoints/<branch>/<stamp> through
#     a private index file. HEAD, the index and all branches stay as they
#     are; the model sees nothing. Last 200 kept per branch.
git_guard_plan() {  # sets GG_MODE (on|off) and GG_NOTE
    GG_MODE=off; GG_NOTE=""
    case "$(printf '%s' "${GIT_GUARD}" | tr '[:upper:]' '[:lower:]')" in false|no|0|off) GG_NOTE="disabled"; return 0 ;; esac
    command -v git >/dev/null 2>&1 || { GG_NOTE="git not found"; return 0; }
    if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
        GG_NOTE="not a git repo"; return 0
    fi
    local head
    head="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
    case "${head}" in
        pi/*) ;;
        *)
            # A merge/rebase/cherry-pick in progress would be silently dropped
            # by a branch switch: leave it, pi can only inspect until it's done.
            local g op
            g="$(git rev-parse --git-path . 2>/dev/null)"
            for op in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
                if [ -e "${g}/${op}" ]; then
                    log_error "git guard: ${op%%_*} in progress on '${head:-detached HEAD}'; finish or abort it first. pi can only run git inspection commands until a pi/* branch is checked out."
                    GG_MODE=on; GG_BRANCH=""; export LETS_CODE_GIT_GUARD_ON=1; return 0
                fi
            done
            # Always a fresh branch: switching to an existing one can fail on a
            # conflicting dirty file; creating never does.
            local name base n=1
            base="pi/$(date +%Y%m%d-%H%M)"; name="${base}"
            while git show-ref --verify -q "refs/heads/${name}"; do n=$((n + 1)); name="${base}-${n}"; done
            git switch -q -c "${name}" 2>/dev/null || git checkout -q -b "${name}" 2>/dev/null || true
            head="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
            case "${head}" in
                pi/*) ;;
                *) log_error "git guard: could not create ${name} (from '${head:-detached HEAD}'); pi will have to create a pi/* branch before it can write." ;;
            esac ;;
    esac
    GG_MODE=on; GG_BRANCH="${head}"
    export LETS_CODE_GIT_GUARD_ON=1
}

# The pi extension that enforces the rule. Inert unless LETS_CODE_GIT_GUARD_ON=1.
# Rewritten when its content changes.
pi_write_gitguard_extension() {
    local dir="${PI_AGENT_DIR}/extensions" f tmp
    f="${dir}/lets-code-gitguard.ts"
    mkdir -p "${dir}"
    tmp="$(mktemp "${dir}/.lets-code-gitguard.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (git guard); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with the git guard on
// (LETS_CODE_GIT_GUARD_ON=1). Checked before edit/write/bash:
//   1. the target repo's HEAD must be on a pi/* branch (a rebase/bisect/merge in
//      progress on one counts), else only git inspection, finishing/aborting the
//      operation, or a switch to a pi/* branch may run;
//   2. on any branch, commands that destroy work irreversibly are refused
//      (force push, branch -D, reset --hard, checkout/restore discarding changes,
//      clean -f, stash drop, rm of .git or the tree), writes into .git are refused,
//      and new branches must be named pi/*;
//   3. before each edit/write/bash in a pi/* repo the working tree is snapshotted
//      under refs/pi-checkpoints/ (private index; HEAD/index/branches untouched),
//      and again shortly after, so no state is lost to the model's next edit.
// Bash commands are lexed like a shell and judged per simple command, in the
// directory (and on the branch) each one would run in. Nothing is added to the
// system prompt or to tool results; a blocked call gets one short line.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { execFile, execFileSync } from "node:child_process";
import { appendFileSync, readFileSync, realpathSync, statSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, isAbsolute, join, relative, resolve, sep } from "node:path";

const ACTIVE = process.env.LETS_CODE_GIT_GUARD_ON === "1";
const PREFIX = "pi/";
const MAX_CMDS = 500;

const read = (p: string): string | null => { try { return readFileSync(p, "utf8"); } catch { return null; } };
const isDir = (p: string): boolean => { try { return statSync(p).isDirectory(); } catch { return false; } };
const isFile = (p: string): boolean => { try { return statSync(p).isFile(); } catch { return false; } };
const exists = (p: string): boolean => { try { statSync(p); return true; } catch { return false; } };

// ================================================================ paths
// pi's own tool path rules: a leading `@`, then a file:// URL, then ~.
function piPath(p: string): string {
	if (p.startsWith("@")) p = p.slice(1);
	if (p.startsWith("file://")) { try { p = decodeURIComponent(p.slice(7)); } catch { p = p.slice(7); } }
	return expandTilde(p);
}
const expandTilde = (p: string) => (p === "~" || p.startsWith("~/") ? join(homedir(), p.slice(1)) : p);
// Absolute path with symlinks resolved on the deepest existing ancestor.
function realPath(p: string, cwd: string): string {
	const abs = isAbsolute(p) ? p : resolve(cwd, p);
	let d = abs, tail = "";
	for (let i = 0; i < 64 && !exists(d); i++) { const up = dirname(d); if (up === d) break; tail = join(basename(d), tail); d = up; }
	try { d = realpathSync(d); } catch { /* keep */ }
	return tail ? join(d, tail) : d;
}
const realDir = (p: string, cwd: string): string => { const r = realPath(p, cwd); return isDir(r) ? r : dirname(r); };
const within = (p: string, dir: string): boolean => { const r = relative(dir, p); return r === "" || (!r.startsWith("..") && !isAbsolute(r)); };
const isRoot = (p: string) => dirname(p) === p;
// Shell glob -> RegExp (*, ?, [..], [!..]).
const globRe = (pat: string) => new RegExp("^" + pat.replace(/[.+^${}()|\\]/g, "\\$&").replace(/\*/g, ".*").replace(/\?/g, ".").replace(/\[!/g, "[^") + "$");
const hasGlob = (s: string) => /[*?[]/.test(s);

// ================================================================ repo state
type Repo = { top: string; gitdir: string; branch: string; op: string | null };  // branch "" = detached
