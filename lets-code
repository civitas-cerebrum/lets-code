    esac
fi
# xhigh in-session: with an unpinned cap too small for xhigh, its requests
# alone get the raised cap, so xhigh can be picked at any startup level.
XHIGH_LEVEL_CAP=""
[ "${OUTPUT_CAP_PINNED}" = false ] && XHIGH_LEVEL_CAP="$(xhigh_output_cap "${CONTEXT}")"
pi_write_configs "${PROVIDER_BASE}" "${API}" "${MODEL}" "${CONTEXT}" "${OUTPUT_CAP}" "${VISION}" "${REASONING_SUPPORTED}" "${THINKING}" "${EFFORT_MAP}"
