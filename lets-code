const server = http.createServer(async (req, res) => {
  try {
    if (API_KEY && req.headers.authorization !== `Bearer ${API_KEY}`)
      return sendJson(res, 401, { error: { message: "bad api key" } });
    // A Claude Code token sent as the API key (CLAUDE_TOKEN in lets-code,
    // from `claude setup-token`) is what the conversation runs on, so it uses
    // that token's subscription. Without one a session runs on this
    // machine's own Claude Code sign-in, which only sessions on this machine
    // get: a request through a reverse proxy (nginx sets X-Forwarded-For)
    // comes from another machine and must bring its token.
    const bearer = (req.headers.authorization ?? "").replace(/^Bearer\s+/i, "").trim();
    const token = CLAUDE_TOKEN_RE.test(bearer) ? bearer : null;
    const forwarded = !!(req.headers["x-forwarded-for"] || req.headers["x-real-ip"] || req.headers.forwarded);
    if (!token && bearer.startsWith("sk-ant-oat"))
      return sendJson(res, 401, { error: { message: `that Claude Code token is not whole (${bearer.length} characters); copy it again or make a new one with 'claude setup-token'` } });
    if (!token && forwarded)
      return sendJson(res, 401, { error: { message: "send your Claude Code token (from `claude setup-token`) as the API key (CLAUDE_TOKEN in lets-code)" } });
    const url = new URL(req.url, "http://x");
    if (req.method === "GET" && url.pathname === "/v1/models")
      return sendJson(res, 200, {
        object: "list",
        data: Object.keys(MODELS).map((id) => ({ id, object: "model", owned_by: "anthropic", max_model_len: 1000000 })),
      });
    if (req.method === "GET" && (url.pathname === "/health" || url.pathname === "/status"))
      return sendJson(res, 200, {
        ok: true,
        name: "lets-code-claude",
        version: VERSION,
        pid: process.pid,
        // the conversations are this machine's business, not a remote caller's
        sessions: forwarded ? undefined : [...sessions.values()].map((s) => ({
          id: s.id,
          model: s.model,
          effort: s.effort ?? "default",
          thinking: !s.thinkingOff,
          state: s.state,
          messages: s.convLen,
          idle_s: Math.round((Date.now() - s.lastUsed) / 1000),
