    for pair in whatsapp:com.whatsapp whatsapp-business:com.whatsapp.w4b telegram:org.telegram.messenger signal:org.thoughtcrime.securesms messages:com.google.android.apps.messaging gmail:com.google.android.gm messenger:com.facebook.orca; do
        has "${pair#*:}" && apps="${apps:+${apps}, }${pair%%:*}"
    done
    echo "apps: ${apps:-none of these messaging apps (others by role: see Which app is it)}"
fi

