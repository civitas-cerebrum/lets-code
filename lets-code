}
export function refKeys(ref: string): string[] {
	if (/^(run|factory):/.test(ref)) return [ref];
	const p = ref.replace(/:\d+(?:-\d+)?$/, ""); const keys = [p];
	const run = /[\\/]lets-code-runs[\\/][^\\/]+[\\/]([^\\/]+?)\.(?:json|pi\.jsonl|view\.jsonl|prompt\.md)$/.exec(p);
	if (run) keys.push(`run:${run[1]}`);
	const fac = /[\\/]lets-code-factory[\\/]([^\\/]+)(?:[\\/]|$)/.exec(p);
	if (fac) keys.push(`factory:${fac[1]}`);
