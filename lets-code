#!/usr/bin/env bash
# Written by lets-code (termux); regenerated on launch, edits are overwritten.
# probe: which channels this phone gives the termux-device expert, read-only
# (it starts nothing but adb's local server when adb is installed):
#   tier 0 intents       am as com.termux: apps, files, pre-filled messages
#   tier 1 termux-api    the Termux:API app + pkg termux-api: contacts, clipboard, SMS, dialogs
#   tier 2 shell         Shizuku's rish or adb to the phone itself: screen, taps, typing
# One "key: value" line each, then tiers: (those present) and, without tier 2, next:.
set -u
to() { if command -v timeout >/dev/null 2>&1; then timeout "$@"; else shift; "$@"; fi; }   # no timeout on macOS
here="$(cd "$(dirname "$0")" && pwd)"
syscmd="${TERMUX_PROBE_SYSCMD:-/system/bin/cmd}"
ref="$(cd "${here}/.." && pwd)/ref/tiers.md"

ver="$(getprop ro.build.version.release 2>/dev/null)"; sdk="$(getprop ro.build.version.sdk 2>/dev/null)"
uid="$(id -u)"
