# `lets-code sessions` and `lets-code message <to> [--wait <s>] -- <text>`:
# the shell side of the sessions module (pi_write_sessions_extension), on the
# same registry and inboxes, without pi. sessions lists the live sessions;
# message writes the text to each inbox `to` names (a pid, a pi session id or
# its first 6+ characters, a session tag, a name or agent name, or "repo":
# every session in the git repository of the current directory) and waits up
# to --wait seconds (default 10, max 60) for each to be seen. Exit status: 0
# every recipient saw it, 2 one has not yet (it is shown when that session
# next polls), 1 no session matched (or the directory is not this user's
# alone). Terminal: exits on every path.
sessions_cli() {
    local rc=0
    LETS_CODE_SESSIONS_DIR="${LETS_CODE_SESSIONS_DIR:-${PI_AGENT_DIR}/lets-code-sessions}" \
        python3 - "$@" <<'PY' || rc=$?
import json, os, re, secrets, subprocess, sys, time

d = os.environ["LETS_CODE_SESSIONS_DIR"]
USAGE = "usage: lets-code sessions | lets-code message <to> [--wait <s>] -- <text>"
TEXT_MAX = 8000   # the module's TEXT_MAX

def alive(pid):   # alive and this user's: EPERM is another user's process
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False

def dir_safe():   # missing, or this user's and writable by nobody else
    try:
        st = os.stat(d)
    except OSError:
        return True
    import stat
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and not (st.st_mode & 0o022)

def unregister(pid):
    import shutil
    try:
        os.remove(os.path.join(d, "%d.json" % pid))
    except OSError:
        pass
    shutil.rmtree(os.path.join(d, str(pid)), ignore_errors=True)

def live():
    try:
        names = os.listdir(d)
    except OSError:
        return []
    out = []
    for n in names:
        m = re.match(r"^(\d+)\.json$", n)
        if not m:
            continue
        pid = int(m.group(1))
        if not alive(pid):
            unregister(pid)
            continue
        try:
            with open(os.path.join(d, n)) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(e, dict) and e.get("pid") == pid:
            out.append(e)
    return sorted(out, key=lambda e: e.get("startedAt") or 0)

def label(e):
    base = os.path.basename(e.get("repoRoot") or e.get("cwd") or "")
    return e.get("name") or e.get("agent") or base or "pid %s" % e.get("pid")

def home(p):
    h = os.path.expanduser("~")
    return "~" + p[len(h):] if p and p.startswith(h + os.sep) else p

def repo_key(cwd):
    try:
        out = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel", "--git-common-dir"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=3).stdout.decode().strip().split("\n")
    except (OSError, subprocess.SubprocessError):
        return "", ""
    if len(out) < 2 or not out[1]:
        return "", ""
    return os.path.realpath(out[0]), os.path.realpath(os.path.join(cwd, out[1]))

def write_atomic(path, doc):
    tmp = "%s.%d.%s.tmp" % (path, os.getpid(), secrets.token_hex(3))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(doc) + "\n")
    os.rename(tmp, path)

def mkdir(p):
    os.makedirs(p, mode=0o700, exist_ok=True)

args = sys.argv[1:]
cmd = args.pop(0) if args else ""
if not dir_safe():
    sys.exit("lets-code: %s is not yours alone (another owner, or writable by others); sessions are off." % d)
if cmd == "sessions":
    if args:
        sys.exit(USAGE)
    es = live()
    if not es:
        print("No live lets-code session on this machine.")
        sys.exit(0)
    print("%d live %s:" % (len(es), "session" if len(es) == 1 else "sessions"))
    for e in es:
        parts = ["pid %s" % e.get("pid"), label(e), home(e.get("repoRoot") or e.get("cwd") or ""), e.get("mode") or "-",
                 "busy" if e.get("busy") else "idle", "subagent of pid %s" % e["parentPid"] if e.get("parentPid") else ""]
        print("  ".join(p for p in parts if p))
    sys.exit(0)

# message <to> [--wait <s>] [--] <text...>
to, wait, words = "", 10.0, []
while args:
    a = args.pop(0)
    if a == "--":
        words += args
        break
    if a == "--wait":
        if not args:
            sys.exit(USAGE)
        try:
            wait = float(args.pop(0))
        except ValueError:
            sys.exit(USAGE)
    elif a.startswith("--wait="):
        try:
            wait = float(a[7:])
        except ValueError:
            sys.exit(USAGE)
    elif not to:
        to = a
    else:
        words.append(a)
text = " ".join(words).strip()
if not to or not text:
    sys.exit(USAGE)
if len(text) > TEXT_MAX:
    sys.exit("lets-code message: the text is over %d characters; write it to a file and send its path." % TEXT_MAX)
wait = min(60.0, max(0.0, wait))
es = live()
root, key = repo_key(os.getcwd())
if to == "repo":
    targets = [e for e in es if key and (e.get("repoKey") or e.get("repoRoot")) == key]
elif to in ("parent", "children"):
    sys.exit("lets-code message: %s only means something inside a session (the message tool)" % to)
elif re.match(r"^\d+$", to):
    targets = [e for e in es if e.get("pid") == int(to)]
else:
    targets = [e for e in es if e.get("piSessionId") == to or (e.get("tag") and e.get("tag") == to)]
    if not targets and len(to) >= 6:
        targets = [e for e in es if (e.get("piSessionId") or "").startswith(to)]
    if not targets:
        targets = [e for e in es if to.lower() in ((e.get("name") or "").lower(), (e.get("agent") or "").lower())]
if not targets:
    print("undeliverable: %s: %s" % (to, "no session in this repository" if to == "repo" else "no live session matches (lets-code sessions lists them)"))
    sys.exit(1)
sender = {"pid": 0, "name": "a shell, via lets-code message", "repo": root or os.getcwd()}
sent = []
for e in targets:
    inbox = os.path.join(d, str(e["pid"]), "inbox")
    now = int(time.time() * 1000)
    mid = "%d-%s" % (now, secrets.token_hex(4))
    try:
        mkdir(os.path.join(d, str(e["pid"])))
        mkdir(inbox)
        write_atomic(os.path.join(inbox, mid + ".json"), {"id": mid, "from": sender, "text": text, "hops": 0, "sentAt": now})
        sent.append((e, os.path.join(inbox, mid + ".ack")))
    except OSError as err:
        print("undeliverable: %s (pid %s): %s" % (label(e), e["pid"], err))
deadline = time.time() + wait
seen = set()
while True:
    for e, ack in sent:
        if ack not in seen and os.path.exists(ack):
            seen.add(ack)
            try:
                os.remove(ack)
            except OSError:
                pass
    if len(seen) == len(sent) or time.time() >= deadline:
        break
    time.sleep(0.15)
for e, ack in sent:
    if ack in seen:
        print("delivered: %s (pid %s) has it" % (label(e), e["pid"]))
    else:
        print("queued: %s (pid %s) has not taken it within %gs; it is shown there when that session next polls" % (label(e), e["pid"], wait))
sys.exit(0 if sent and len(seen) == len(sent) else 2 if sent else 1)
PY
    exit "${rc}"
}

# `lets-code mandate init [--global]`: a starter manifest to edit.
