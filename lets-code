			const body = typeof result === "string" ? result : result === undefined ? "(no result)" : JSON.stringify(result, null, 2);
			return { text: `## workflow ${name} — ${signal?.aborted ? "stopped" : "done"}, ${agents} agent${agents === 1 ? "" : "s"}\n${body.length > 50_000 ? `${body.slice(0, 50_000)}\n[truncated at 50 KB]` : body}`, error: false };
		} catch (e) { return { text: `Workflow "${name}" failed: ${(e as Error).message}`, error: true }; }
	}
	const workflowsOn = process.env.LETS_CODE_SUBAGENTS_ON === "1" && DEPTH < MAX_DEPTH && workflows.length > 0;
	if (workflowsOn) {
		pi.registerTool({
			name: "workflow", label: "workflow",
			description: "Run a project workflow script by name; without a name, lists them.",
			parameters: Type.Object({ name: Type.Optional(Type.String()), args: Type.Optional(Type.String({ description: "input (JSON or text)" })) }),
			async execute(_id: string, params: any, signal: AbortSignal | undefined, onUpdate: any, ctx?: any) {
				if (!params?.name) {
					const list = discoverWorkflows(cwd, trusted);
					return { content: [{ type: "text" as const, text: list.map((w) => `- ${w.name}: ${w.description}`).join("\n") || "No workflows." }] };
				}
				// the call goes on when the user switches sessions mid-call (the subagents module's detachable)
				const sub = await import(pathToFileURL(join(HERE, "subagents.ts")).href);
				let job = { detached: false };
				const out = await sub.detachable(signal, _id, async (sig: AbortSignal, j: { detached: boolean }) => {
					job = j;
					const r = await startWorkflow(params.name, params.args ?? "", sig, (line) => { if (!job.detached) onUpdate?.({ content: [{ type: "text", text: line }] }); }, _id);
					return { text: r.text, isError: r.error };
				}, sub.backgroundAfter(ctx), 0, params.name);
				return { content: [{ type: "text" as const, text: out.text }], isError: out.isError };
			},
		} as any);
		const runCommand = async (name: string, args: string, ctx: any) => {
			const r = await startWorkflow(name, args, ctx.signal, (line) => { if (ctx.hasUI) ctx.ui.setStatus("claude-code", `workflow ${name}: ${short(line, 60)}`); });
			if (ctx.hasUI) ctx.ui.setStatus("claude-code", undefined);
			if (!ctx.hasUI) { process.stdout.write(`${r.text}\n`); return; }
			pi.sendMessage({ customType: "claude-code-workflow", content: r.text, display: true }, { triggerTurn: false });
		};
		pi.registerCommand("workflow", {
			description: "Run a Claude Code workflow: /workflow <name> [args]",
			handler: async (args: string, ctx: any) => {
				const [name, ...rest] = (args ?? "").trim().split(/\s+/);
				if (!name) { const l = discoverWorkflows(cwd, trusted); const text = l.map((w) => `${w.name}: ${w.description}`).join("\n") || "No workflows."; if (ctx.hasUI) ctx.ui.notify(text, "info"); else process.stdout.write(`${text}\n`); return; }
				await runCommand(name, rest.join(" "), ctx);
			},
		});
		for (const w of workflows) register(w.name, `workflow: ${w.description}`, (args, ctx) => runCommand(w.name, args ?? "", ctx));
	}

	// ----------------------------------------------------------- lifecycle
	// a subagent's own session file, opened from /subagents (see the subagents module)
	const childView = (f: unknown) => /[\\/]lets-code-runs[\\/][^\\/]+[\\/][^\\/]+\.(pi|view)\.jsonl$/.test(String(f ?? ""));
	pi.on("session_start", async (event: any, ctx: ExtensionContext) => {
		cwd = ctx.cwd; currentCtx = ctx;
		if (event?.reason !== "reload") await settleTrust(ctx);
		process.env.LETS_CODE_CLAUDE_TRUST = trusted ? "1" : "0";   // for the subagents module and child processes
		settings = loadSettings(cwd, trusted);                          // the session's snapshot
		if (trusted && process.env.LETS_CODE_CLAUDE_ENV !== "all") {
			for (const [k, v] of Object.entries(settings.env)) if (/^[A-Za-z_]\w*$/.test(k) && !/^(LETS_CODE_|PI_)/.test(k)) process.env[k] = v;
			process.env.LETS_CODE_CLAUDE_ENV = "all";
		}
		// a bare tool name in deny takes the tool away, as in Claude Code
		const gone = settings.deny.filter((r) => r.spec === undefined && !r.tool.includes("*")).map((r) => r.tool);
		if (gone.length) { try { pi.setActiveTools(pi.getActiveTools().filter((t) => !gone.some((g) => toolNames(g).includes(claudeToolName(t)) || (g === "Edit" && t === "write")))); } catch { /* keep */ } }
		contextSnapshot = null;
		const mcp = claudeMcpServers(cwd, settings, trusted, askedHere);
		registerMcp(ctx, mcp.servers.filter((e) => e.scope === "project"));
		if (mcp.skipped.length && trusted) notify(ctx, `MCP servers skipped: ${mcp.skipped.join(", ")}`);
		if (DEPTH > 0) {
			const o = await fire("SubagentStart", agentName, { agent_id: String(process.pid), agent_type: agentName }, ctx);
			if (o?.context.length) pendingContext.push(...o.context);
			return;
		}
		if (event?.reason === "reload") return;
		// into or out of a subagent's session (/subagents): not a session start for Claude's hooks
		if (childView(ctx.sessionManager?.getSessionFile?.()) || childView(event?.previousSessionFile)) return;
		const source = ({ startup: "startup", new: "clear", resume: "resume", fork: "fork" } as Record<string, string>)[event?.reason] ?? "startup";
		const o = await fire("SessionStart", source, { source, model: process.env.LETS_CODE_MODEL ?? "" }, ctx);
		if (o?.context.length) pendingContext.push(...o.context);
	});
	pi.on("session_compact", async (_e: any, ctx: ExtensionContext) => {
		if (DEPTH > 0) return;
		const o = await fire("SessionStart", "compact", { source: "compact" }, ctx);
		if (o?.context.length) pendingContext.push(...o.context);
	});
	pi.on("resources_discover", () => ({ skillPaths: skillDirs(cwd) }));
	pi.on("session_before_compact", async (event: any, ctx: ExtensionContext) => {
		if (!has("PreCompact")) return undefined;
		const trigger = event?.reason === "manual" ? "manual" : "auto";
		const o = await fire("PreCompact", trigger, { trigger, custom_instructions: event?.customInstructions ?? null }, ctx);
		if (o?.block) { notify(ctx, `compaction blocked by a PreCompact hook: ${short(o.block)}`); return { cancel: true }; }
		return undefined;
	});
	pi.on("session_shutdown", async (event: any, ctx: ExtensionContext) => {
		if (DEPTH > 0 || event?.reason === "reload" || !has("SessionEnd")) return;
		if (childView(ctx?.sessionManager?.getSessionFile?.()) || childView(event?.targetSessionFile)) return;
		const reason = ({ quit: "prompt_input_exit", new: "clear", resume: "resume" } as Record<string, string>)[event?.reason] ?? "other";
		await fire("SessionEnd", reason, { reason }, ctx, 1500);   // Claude's budget for these
	});
	pi.on("ui_prompt_start", (event: any) => {
		if (!has("Notification")) return;
		void fire("Notification", "permission_prompt", { notification_type: "permission_prompt", message: String(event?.title ?? "lets-code needs your input").split("\n")[0], title: "lets-code" }, currentCtx);
	});

	// ------------------------------------------------------------- prompts
	pi.on("input", async (event: any, ctx: ExtensionContext) => {
		currentCtx = ctx; stopContinuations = 0;
		if (DEPTH > 0 || !has("UserPromptSubmit")) return undefined;
		const o = await fire("UserPromptSubmit", undefined, { prompt: String(event?.text ?? "") }, ctx);
		if (!o) return undefined;
		if (o.block || o.stop) { notify(ctx, `prompt blocked by a UserPromptSubmit hook: ${short(o.block ?? o.stop ?? "")}`); waiting.blocked = true; return { action: "handled" }; }
		pendingContext.push(...o.context);
		return undefined;
	});
	pi.on("before_agent_start", async (event: any, ctx: ExtensionContext) => {
		const opts = event?.systemPromptOptions;
		const noContext = process.argv.includes("--no-context-files") || process.argv.includes("-nc");
		if (opts && Array.isArray(opts.contextFiles) && !noContext) {
			contextSnapshot ??= claudeContextFiles(ctx.cwd, opts.contextFiles, trusted);
			opts.contextFiles = contextSnapshot.map((f) => ({ ...f }));
		}
		// a prompt that asks for a workflow adds its line, kept for the session (a section
		// that comes and goes costs a change note each time it flips)
		if (workflowsOn && opts?.sections && typeof opts.sections === "object") {
			const list = discoverWorkflows(ctx.cwd, trusted);
			for (const n of workflowMatches(event?.prompt ?? "", list)) matched.add(n);
			const hit = list.filter((w) => matched.has(w.name));
			if (hit.length) opts.sections.lets_code_workflows = workflowSection(hit);
		}
		if (!pendingContext.length) return undefined;
		const text = pendingContext.join("\n\n"); pendingContext = [];
		return { message: { customType: "claude-code-hook", content: hookContext(text), display: false } };
	});

	// --------------------------------------------------------------- tools
	pi.on("tool_call", async (event: any, ctx: ExtensionContext) => {
		currentCtx = ctx;
		const tool = String(event.toolName); const name = claudeToolName(tool);
		let ci = toClaudeInput(tool, event.input, ctx.cwd);
		let hookAllow = false; let hookAsk: string | undefined;
		const o = await fire("PreToolUse", toolNames(name), { tool_name: name, tool_input: ci, tool_use_id: event.toolCallId }, ctx);
		if (o) {
			if (o.stop) { notify(ctx, `stopped by a PreToolUse hook: ${short(o.stop)}`); ctx.abort(); return { block: true, reason: short(`PreToolUse hook stopped the session: ${o.stop}`) }; }
			if (o.decision === "deny") return { block: true, reason: short(`PreToolUse hook: ${o.reason || "denied"}`) };
			if (o.updatedInput) {
				const next = fromClaudeInput(tool, { ...ci, ...o.updatedInput }, event.input);
				for (const k of Object.keys(event.input ?? {})) if (!(k in next)) delete event.input[k];
				Object.assign(event.input, next);
				ci = toClaudeInput(tool, event.input, ctx.cwd);
			}
			if (o.context.length) preContext.set(event.toolCallId, o.context);
			if (o.decision === "allow") hookAllow = true;
			if (o.decision === "ask") hookAsk = o.reason || "a PreToolUse hook asks";
		}
		const p = permissionCheck(settings, name, ci, ctx.cwd);
		if (p.decision === "deny") return { block: true, reason: short(`Claude Code permission rule ${p.rule} denies this call.`) };
		if (p.decision === "ask" || hookAsk) {
			const key = p.rule ?? `hook:${name}`;
			if (!sessionAllowed.has(key)) {
				const what = short(name === "Bash" ? String(ci.command ?? "") : String(ci.file_path ?? ci.path ?? JSON.stringify(ci)), 160);
				if (!ctx.hasUI) return { block: true, reason: short(`${p.rule ? `Claude Code rule ${p.rule}` : hookAsk} needs approval and no one can be asked here.`) };
				// a subagent does not ask the user (its dialog would reach them past the orchestrator)
				if (DEPTH > 0) return { block: true, reason: short(`${p.rule ? `Claude Code rule ${p.rule}` : hookAsk} needs the user's approval, and a subagent does not ask the user: do without it, or name it in your report.`) };
				const choice = await ctx.ui.select(`claude code: ${p.rule ? `rule ${p.rule}` : hookAsk} asks before\n${name}: ${what}\n\nAllow?`, ["Allow once", "Allow for this session", "Deny"]);
				if (choice === "Allow for this session") sessionAllowed.add(key);
				else if (choice !== "Allow once") return { block: true, reason: short(`The user did not approve ${name}: ${what}`) };
			}
			approved.add(event.toolCallId);
		} else if (p.decision === "allow" || hookAllow) approved.add(event.toolCallId);
		return undefined;
	});
	pi.on("tool_result", async (event: any, ctx: ExtensionContext) => {
		approved.delete(event.toolCallId);
		const extra = preContext.get(event.toolCallId) ?? []; preContext.delete(event.toolCallId);
		const tool = String(event.toolName); const name = claudeToolName(tool);
		const failed = event.isError === true;
		const ev = failed ? "PostToolUseFailure" : "PostToolUse";
		let replace: unknown;
		if (has(ev)) {
			const ci = toClaudeInput(tool, event.input, ctx.cwd);
			const text = (event.content ?? []).filter((c: any) => c?.type === "text").map((c: any) => c.text).join("\n");
			const o = await fire(ev, toolNames(name), { tool_name: name, tool_input: ci, tool_use_id: event.toolCallId, ...(failed ? { error: text.slice(0, CAP) } : { tool_response: toolResponse(tool, event.input, event.content, failed) }) }, ctx);
			if (o) {
				if (o.block) extra.push(o.block);
				extra.push(...o.context);
				replace = o.updatedOutput;
				if (o.stop) { notify(ctx, `stopped by a ${ev} hook: ${short(o.stop)}`); ctx.abort(); }
			}
		}
		if (!extra.length && replace === undefined) return undefined;
		const base = replace !== undefined ? [{ type: "text", text: typeof replace === "string" ? replace : JSON.stringify(replace) }] : event.content ?? [];
		return { content: [...base, ...(extra.length ? [{ type: "text", text: `\n[lets-code] ${ev} hook (configured by the user in .claude/settings.json):\n${extra.join("\n\n")}` }] : [])] };
	});

	// ---------------------------------------------------------------- stop
	pi.on("agent_before_settle", async (event: any, ctx: ExtensionContext) => {
		const ev = DEPTH > 0 ? "SubagentStop" : "Stop";
		if (event?.continue || event?.outcome !== "completed" || !has(ev)) return undefined;
		const msgs: any[] = event?.context?.llmMessages ?? event?.context?.contextMessages ?? [];
		const last = [...msgs].reverse().find((m) => m?.role === "assistant");
		const lastText = typeof last?.content === "string" ? last.content : (last?.content ?? []).filter((c: any) => c?.type === "text").map((c: any) => c.text).join("\n");
		const o = await fire(ev, DEPTH > 0 ? agentName : undefined, { stop_hook_active: stopContinuations > 0, last_assistant_message: lastText, ...(DEPTH > 0 ? { agent_id: String(process.pid), agent_type: agentName } : {}) }, ctx);
		if (!o || o.stop || !o.block || stopContinuations >= 8) return undefined;
		stopContinuations++;
		return { entries: [...(event.entries ?? []), { type: "custom_message", customType: "claude-code-hook", content: `${ev} hook: ${o.block}`, display: true }], continue: true };
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# What the Claude Code adapter finds from here, for the launch line, and the
# settings `env` it exports into pi's environment: the user's always, the
# project's (.claude/settings.json, settings.local.json) when the folder is
# trusted the way the extension decides it (Claude Code's record for the
# folder or a parent in ~/.claude.json, pi's trust.json, lets-code's own
# remembered answer). Sets CC_SUMMARY, empty when there is nothing.
CC_SUMMARY=""; CC_NEED=0
claude_code_scan() {
    local out
    # shellcheck disable=SC2016
    out="$(PI_AGENT_DIR="${PI_AGENT_DIR}" LC_SCOPE="${LETS_CODE_CLAUDE_SCOPE:-}" python3 -c '
import json, os, re, shlex, sys
cwd = os.path.realpath(sys.argv[1]); home = os.path.expanduser("~")
cfg = os.environ.get("CLAUDE_CONFIG_DIR") or ""
cdir = cfg or os.path.join(home, ".claude")
cj_path = os.path.join(cfg, ".claude.json") if cfg else os.path.join(home, ".claude.json")
agent = os.environ["PI_AGENT_DIR"]
alls = os.environ.get("LC_SCOPE") == "all"   # CLAUDE_CODE=all: ~/.claude of the user too
def rj(p):
    try:
        with open(p) as f: return json.load(f)
    except Exception: return None
def ups(d):
    out = []
    while True:
        out.append(d); p = os.path.dirname(d)
        if p == d: return out
        d = p
def nearest(m, pick):
    if not isinstance(m, dict): return None
    for d in ups(cwd):
        if d in m:
            v = pick(m[d])
            if v is True or v is False: return v
    return None
cj = rj(cj_path) or {}
trusted = (nearest(cj.get("projects"), lambda p: True if isinstance(p, dict) and p.get("hasTrustDialogAccepted") is True else None) is True
    or nearest(rj(os.path.join(agent, "trust.json")), lambda v: v) is True
    or nearest((rj(os.path.join(agent, "lets-code-state.json")) or {}).get("claudeCodeTrust"), lambda v: v) is True)
git = next((d for d in ups(cwd) if os.path.exists(os.path.join(d, ".git"))), cwd)
proj = []
for d in ups(cwd):
    if os.path.realpath(os.path.join(d, ".claude")) != os.path.realpath(cdir): proj.append(os.path.join(d, ".claude"))
    if d == git: break
users = [cdir] if alls else []
local = os.path.realpath(os.path.join(cwd, ".claude")) != os.path.realpath(cdir)
def walk(d, depth=0):
    if depth > 5 or not os.path.isdir(d): return []
    out = []
    for e in sorted(os.listdir(d)):
        if e.startswith(".") or e == "node_modules": continue
        p = os.path.join(d, e)
        out += walk(p, depth + 1) if os.path.isdir(p) else [p]
    return out
commands = set()
for d in proj + users:
    base = os.path.join(d, "commands")
    commands |= {os.path.relpath(f, base)[:-3] for f in walk(base) if f.endswith(".md")}
skills = set()
for d in proj + users:
    skills |= {os.path.dirname(f) for f in walk(os.path.join(d, "skills")) if os.path.basename(f) == "SKILL.md"
               and not (d == cdir and os.path.relpath(f, os.path.join(d, "skills")).startswith("synced" + os.sep) and os.environ.get("LETS_CODE_CLAUDE_SYNCED_SKILLS") != "1")}
agents = set()
for d in (proj if trusted else []) + users:
    a = os.path.join(d, "agents")
    if os.path.isdir(a): agents |= {f[:-3] for f in os.listdir(a) if f.endswith(".md")}
def has_workflow(d):
    w = os.path.join(d, "workflows")
    try: return any(f.endswith(".js") and re.search(r"export\s+const\s+meta\s*=", open(os.path.join(w, f)).read()) for f in os.listdir(w))
    except Exception: return False
workflows = set()
for d in (proj if trusted else []) + users:
    w = os.path.join(d, "workflows")
    if os.path.isdir(w):
        for f in os.listdir(w):
            try:
                if f.endswith(".js") and re.search(r"export\s+const\s+meta\s*=", open(os.path.join(w, f)).read()): workflows.add(f)
            except Exception: pass
def hooks(data):
    n = 0
    for groups in ((data or {}).get("hooks") or {}).values():
        for g in groups if isinstance(groups, list) else []:
            n += len([h for h in (g or {}).get("hooks") or [] if isinstance(h, dict) and h.get("type", "command") in ("command", "http")])
    return n
user = (rj(os.path.join(cdir, "settings.json")) or {}) if alls else {}
layers = [rj(os.path.join(cwd, ".claude", n)) or {} for n in ("settings.json", "settings.local.json")] if local else []
# auto: the adapter is needed where the project brings hooks or workflows
need = alls or any(hooks(l) for l in layers) or any(has_workflow(d) for d in proj)
nhooks = 0 if user.get("disableAllHooks") is True else hooks(user)
pending = 0
for l in layers:
    if trusted: nhooks += hooks(l)
    else: pending += hooks(l) + len(l.get("env") or {})
env = {}
for l in [user] + (layers if trusted else []):
    if isinstance(l.get("env"), dict): env.update({str(k): str(v) for k, v in l["env"].items()})
mcp = set((cj.get("mcpServers") or {}).keys() if alls else []) | set((((cj.get("projects") or {}).get(cwd) or {}).get("mcpServers") or {}).keys())
pm = (rj(os.path.join(cwd, ".mcp.json")) or {}).get("mcpServers") or {}
if pm and not trusted: pending += len(pm)
counts = [(len(commands), "command"), (len(skills), "skill"), (len(agents), "agent"), (nhooks, "hook"), (len(mcp), "MCP server"), (len(workflows), "workflow")]
parts = ["%d %s%s" % (n, w, "" if n == 1 else "s") for n, w in counts if n]
line = ("claude code: " + ", ".join(parts)) if parts else ""
if pending: line = (line or "claude code: nothing yet") + " (project hooks, MCP and env wait for trust)"
print(line)
print("need=%d" % (1 if need else 0))
for k, v in env.items():
    if re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k) and not k.startswith(("LETS_CODE_", "PI_")):
        print("export %s=%s" % (k, shlex.quote(v)))
print("export LETS_CODE_CLAUDE_ENV=%s" % ("all" if trusted else "user"))
' "${PWD}" 2>/dev/null)" || return 0
    CC_SUMMARY="$(printf '%s\n' "${out}" | sed -n '1p')"
    CC_NEED="$(printf '%s\n' "${out}" | sed -n 's/^need=//p')"
    [ "${CC_NEED}" = 1 ] || return 0
    eval "$(printf '%s\n' "${out}" | sed -n '3,$p')"
}

# Sandbox: bash confined with @anthropic-ai/sandbox-runtime. The runtime is
# an npm package installed next to the module (lets-code/sandbox/, a
# directory of its own inside the lets-code extension);
# lets-code installs or updates it when missing. Never fatal: without the
# runtime the extension warns and bash runs as before.
SANDBOX_RUNTIME_VERSION="0.0.79"
SB_NOTE=""
pi_write_sandbox_extension() {
    local dir f tmp have=""
    lc_ext_module sandbox; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.index.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (sandbox); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with the sandbox on
// (LETS_CODE_SANDBOX_ON=1). Runs the model's bash commands (and your own
// `!` commands) inside @anthropic-ai/sandbox-runtime: bubblewrap plus a
// filtering proxy on Linux, Seatbelt on macOS. Writes are confined to the
// project and a few scratch paths, secrets are unreadable, and the network
// is an allowlist of domains. The runtime lives next to this file
// (lets-code installs it into this directory); without it, bash runs as
// before and the launch line says so.
//
// Config, merged in this order: built-in defaults, ~/.pi/agent/extensions/
// sandbox.json, <project>/.pi/sandbox.json (the same files pi's own sandbox
// example reads), then the active mandate role (network on/off and its
// `sandbox` block). Keys: enabled, network.allowedDomains/deniedDomains,
// filesystem.denyRead/allowWrite/denyWrite, ignoreViolations,
// enableWeakerNestedSandbox.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const ACTIVE = process.env.LETS_CODE_SANDBOX_ON === "1";
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const HERE = dirname(fileURLToPath(import.meta.url));

export interface SandboxConfig {
	enabled?: boolean;
	network?: { allowedDomains?: string[]; deniedDomains?: string[] };
	filesystem?: { denyRead?: string[]; allowWrite?: string[]; denyWrite?: string[] };
	ignoreViolations?: Record<string, string[]>;
	enableWeakerNestedSandbox?: boolean;
}
export const DEFAULTS: SandboxConfig = {
	enabled: true,
	network: {
		allowedDomains: ["npmjs.org", "*.npmjs.org", "registry.yarnpkg.com", "pypi.org", "*.pypi.org", "files.pythonhosted.org", "github.com", "*.github.com", "raw.githubusercontent.com", "objects.githubusercontent.com", "crates.io", "*.crates.io", "proxy.golang.org", "deb.debian.org", "*.ubuntu.com"],
		deniedDomains: [],
	},
	filesystem: {
		denyRead: ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/lets-code", "~/.pi/agent/auth.json", "~/.pi/agent/mcp-auth.json", "~/.netrc", "~/.docker/config.json", "~/.kube"],
		allowWrite: [".", "/tmp", "~/.cache", "~/.npm", "~/.pi/agent/sessions"],
		denyWrite: [".env", ".env.*", "*.pem", "*.key", ".git/hooks"],
	},
};
function readJson(p: string, warn: (m: string) => void): Partial<SandboxConfig> {
	if (!existsSync(p)) return {};
	try { return JSON.parse(readFileSync(p, "utf8")); } catch (e) { warn(`sandbox: could not parse ${p}: ${(e as Error).message}`); return {}; }
}
export function merge(base: SandboxConfig, over: Partial<SandboxConfig>): SandboxConfig {
	const out: SandboxConfig = { ...base };
	if (over.enabled !== undefined) out.enabled = over.enabled;
	if (over.network) out.network = { ...base.network, ...over.network };
	if (over.filesystem) out.filesystem = { ...base.filesystem, ...over.filesystem };
	if (over.ignoreViolations) out.ignoreViolations = over.ignoreViolations;
	if (over.enableWeakerNestedSandbox !== undefined) out.enableWeakerNestedSandbox = over.enableWeakerNestedSandbox;
	return out;
}
export interface Mode { role?: string; network?: "on" | "off"; bypass?: boolean; sandbox?: Partial<SandboxConfig> & { allowWrite?: string[]; denyRead?: string[]; denyWrite?: string[]; allowedDomains?: string[] } }
export function loadConfig(cwd: string, mode: Mode | undefined, warn: (m: string) => void): SandboxConfig {
	let c = merge(DEFAULTS, readJson(join(AGENT_DIR, "extensions", "sandbox.json"), warn));
	c = merge(c, readJson(join(cwd, ".pi", "sandbox.json"), warn));
	if (mode) {
		if (mode.network === "off") c = merge(c, { network: { allowedDomains: [], deniedDomains: c.network?.deniedDomains } });
		const s = mode.sandbox ?? {};
		const flat: Partial<SandboxConfig> = {};
		if (s.allowWrite || s.denyRead || s.denyWrite) flat.filesystem = { ...(s.allowWrite ? { allowWrite: s.allowWrite } : {}), ...(s.denyRead ? { denyRead: s.denyRead } : {}), ...(s.denyWrite ? { denyWrite: s.denyWrite } : {}) };
		if (s.allowedDomains) flat.network = { allowedDomains: s.allowedDomains };
		c = merge(merge(c, s), flat);
		if (mode.bypass) c.enabled = false;
	}
	return c;
}

export default function (pi: ExtensionAPI) {
	if (!ACTIVE) return;
	let runtime: any = null;          // the @anthropic-ai/sandbox-runtime module, loaded lazily
	let piMod: any = null;            // @earendil-works/pi-coding-agent (createBashTool)
	let enabled = false;
	let mode: Mode | undefined;
	let cwd = process.cwd();
	let localBash: any = null;
	const warn = (ctx: ExtensionContext | undefined, m: string) => { if (ctx?.hasUI) ctx.ui.notify(m, "warning"); else console.error(`[lets-code] ${m}`); };

	// Sandboxed operations for createBashTool: wrap, then run through bash.
	function sandboxedOps() {
		return {
			async exec(command: string, dir: string, { onData, signal, timeout }: any) {
				if (!existsSync(dir)) throw new Error(`Working directory does not exist: ${dir}`);
				const wrapped: string = await runtime.SandboxManager.wrapWithSandbox(command);
				return new Promise<{ exitCode: number | null }>((resolve, reject) => {
					const child = spawn("bash", ["-c", wrapped], { cwd: dir, detached: true, stdio: ["ignore", "pipe", "pipe"] });
					let timedOut = false; let th: NodeJS.Timeout | undefined;
					const killGroup = () => { if (child.pid) { try { process.kill(-child.pid, "SIGKILL"); } catch { child.kill("SIGKILL"); } } };
					if (timeout && timeout > 0) th = setTimeout(() => { timedOut = true; killGroup(); }, timeout * 1000);
					child.stdout?.on("data", onData); child.stderr?.on("data", onData);
					child.on("error", (e) => { if (th) clearTimeout(th); reject(e); });
					signal?.addEventListener("abort", killGroup, { once: true });
					child.on("close", (code) => { if (th) clearTimeout(th); signal?.removeEventListener("abort", killGroup); if (signal?.aborted) reject(new Error("aborted")); else if (timedOut) reject(new Error(`timeout:${timeout}`)); else resolve({ exitCode: code }); });
				});
			},
		};
	}

	// Inits are serialised: a mode change can arrive while a previous init is
	// still awaiting the runtime, and two SandboxManager.initialize calls must
	// not interleave.
	let chain: Promise<void> = Promise.resolve();
	function init(ctx: ExtensionContext): Promise<void> { chain = chain.then(() => initNow(ctx)).catch(() => {}); return chain; }
	async function initNow(ctx: ExtensionContext) {
		const cfg = loadConfig(cwd, mode, (m) => warn(ctx, m));
		if (runtime) { try { await runtime.SandboxManager.reset(); } catch { /* ok */ } }
		if (!cfg.enabled) { enabled = false; if (ctx?.hasUI) ctx.ui.setStatus("sandbox", mode?.bypass ? "sandbox: off (yolo)" : "sandbox: off"); return; }
		if (process.platform !== "linux" && process.platform !== "darwin") { enabled = false; warn(ctx, `sandbox: not supported on ${process.platform}`); return; }
		try {
			if (!runtime) runtime = await import(join(HERE, "node_modules", "@anthropic-ai", "sandbox-runtime", "dist", "index.js"));
			if (!piMod) piMod = await import("@earendil-works/pi-coding-agent");
			// The runtime needs ripgrep; lets-code fetches pi's copy into <agent-dir>/bin, which is not on PATH
			const rg = join(AGENT_DIR, "bin", "rg");
			const ripgrep = existsSync(rg) ? { command: rg } : undefined;
			await runtime.SandboxManager.initialize({ network: cfg.network, filesystem: cfg.filesystem, ignoreViolations: cfg.ignoreViolations, enableWeakerNestedSandbox: cfg.enableWeakerNestedSandbox, ...(ripgrep ? { ripgrep } : {}) });
			enabled = true;
			if (ctx?.hasUI) ctx.ui.setStatus("sandbox", `sandbox: ${cfg.network?.allowedDomains?.length ? `${cfg.network.allowedDomains.length} domains` : "no network"}`);
		} catch (e) {
			enabled = false;
			warn(ctx, `sandbox: not active — ${(e as Error).message}. Install: cd ${HERE} && npm install; Linux also needs bubblewrap and socat.`);
		}
	}

	// The mandate announces its mode from its own session_start, which can run
	// before ours: before a session exists, only remember the mode, and let
	// session_start initialise with it.
	let lastCtx: ExtensionContext | undefined;
	// off: the mandate is dormant (mandate off, no mode entered): no role overrides
	pi.events.on("lets-code:mode", (data: unknown) => { mode = (data as any)?.off ? undefined : data as Mode; if (lastCtx) void init(lastCtx); });

	// The bash tool is replaced with one whose operations run sandboxed when
	// the sandbox is up, and plain otherwise. Registered at load so the tool
	// exists before the first turn; the wrapping decision is made per call.
	void (async () => {
		try { piMod = await import("@earendil-works/pi-coding-agent"); localBash = piMod.createBashTool(cwd); } catch { return; }
		pi.registerTool({
			...localBash,
			label: "bash",
			async execute(id: string, params: any, signal: AbortSignal, onUpdate: any) {
				if (!enabled) return localBash.execute(id, params, signal, onUpdate);
				return piMod.createBashTool(cwd, { operations: sandboxedOps() }).execute(id, params, signal, onUpdate);
			},
		});
	})();
	pi.on("user_bash", () => (enabled ? { operations: sandboxedOps() } : undefined));
	pi.on("session_start", async (_e, ctx) => { cwd = ctx.cwd; lastCtx = ctx; await init(ctx); });
	pi.on("session_shutdown", async () => { if (runtime) { try { await runtime.SandboxManager.reset(); } catch { /* ok */ } } });
	pi.registerCommand("sandbox", {
		description: "Show the sandbox configuration in effect",
		handler: async (_a, ctx) => {
			const c = loadConfig(ctx.cwd, mode, (m) => warn(ctx, m));
			ctx.ui.notify([`sandbox: ${enabled ? "on" : "off"}${mode?.role ? ` (mode ${mode.role})` : ""}`, `network: ${c.network?.allowedDomains?.join(", ") || "(none)"}`, `deny read: ${c.filesystem?.denyRead?.join(", ")}`, `allow write: ${c.filesystem?.allowWrite?.join(", ")}`, `deny write: ${c.filesystem?.denyWrite?.join(", ")}`].join("\n"), "info");
		},
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
    printf '{\n  "name": "lets-code-sandbox",\n  "private": true,\n  "type": "module",\n  "dependencies": { "@anthropic-ai/sandbox-runtime": "%s" }\n}\n' "${SANDBOX_RUNTIME_VERSION}" > "${dir}/package.json"
    [ -f "${dir}/node_modules/@anthropic-ai/sandbox-runtime/package.json" ] && \
        have="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "${dir}/node_modules/@anthropic-ai/sandbox-runtime/package.json" 2>/dev/null)"
    if [ "${have}" != "${SANDBOX_RUNTIME_VERSION}" ]; then
        if command -v npm >/dev/null 2>&1; then
            log "sandbox: installing @anthropic-ai/sandbox-runtime ${SANDBOX_RUNTIME_VERSION} into ${dir} (first run only) ..."
            if ! (cd "${dir}" && npm install --ignore-scripts --no-audit --no-fund --loglevel=error >/dev/null 2>&1); then
                SB_NOTE="runtime install failed; run: cd ${dir} && npm install"
            fi
        else
            SB_NOTE="npm not found; run: cd ${dir} && npm install"
        fi
    fi
    if [ "$(uname)" = "Linux" ]; then
        local miss=""
        command -v bwrap >/dev/null 2>&1 || miss="bubblewrap"
        command -v socat >/dev/null 2>&1 || miss="${miss:+${miss} }socat"
        [ -z "${miss}" ] || SB_NOTE="${SB_NOTE:+${SB_NOTE}; }needs ${miss} (apt install ${miss})"
    fi
}

# MCP: pi has MCP built in (~/.pi/agent/mcp.json, .pi/mcp.json, `pi mcp add`).
# Setup can import servers from the standard files other clients keep.
mcp_import() {  # mcp_import <ask: yes|no>
    local ask="$1" found
    found="$(python3 - "${PI_AGENT_DIR}" <<'PY'
import json, os, sys
home = os.path.expanduser("~")
cands = [os.path.join(os.getcwd(), ".mcp.json"), os.path.join(home, ".config", "mcp", "mcp.json"),
         os.path.join(home, ".claude.json"), os.path.join(home, ".cursor", "mcp.json"), os.path.join(home, ".codeium", "windsurf", "mcp_config.json")]
target = os.path.join(sys.argv[1], "mcp.json")
try:
    have = (json.load(open(target)).get("mcpServers") or {}) if os.path.exists(target) else {}
except Exception:
    have = {}
new = {}
for c in cands:
    if not os.path.isfile(c):
        continue
    try:
        d = json.load(open(c))
    except Exception:
        continue
    for name, cfg in (d.get("mcpServers") or {}).items():
        if name in have or name in new or not isinstance(cfg, dict):
            continue
        if not (cfg.get("command") or cfg.get("url")):
            continue
        new[name] = {k: v for k, v in cfg.items() if k in ("command", "args", "env", "cwd", "url", "headers", "type", "timeout")}
        new[name]["_from"] = c
for name, cfg in new.items():
    print("%s\t%s" % (name, cfg.pop("_from")))
json.dump(new, open(os.path.join(sys.argv[1], ".mcp-import.json"), "w"))
PY
)" || return 0
    if [ -z "${found}" ]; then
        log "mcp: no MCP servers found in .mcp.json, ~/.config/mcp/mcp.json, ~/.claude.json or ~/.cursor/mcp.json — add one later with: pi mcp add <name> -- <command>"
        rm -f "${PI_AGENT_DIR}/.mcp-import.json"; return 0
    fi
    echo ""
    echo "MCP servers found that pi does not have yet:"
    printf '%s\n' "${found}" | awk -F'\t' '{ printf "  %-24s from %s\n", $1, $2 }'
    local reply="y"
    if [ "${ask}" = "yes" ]; then printf "Import them into %s/mcp.json? [Y/n] " "${PI_AGENT_DIR}"; read -r reply; fi
    case "${reply}" in
        n|N) rm -f "${PI_AGENT_DIR}/.mcp-import.json"; log "mcp: skipped" ;;
        *)
            python3 - "${PI_AGENT_DIR}" <<'PY'
import json, os, sys
d = sys.argv[1]; target = os.path.join(d, "mcp.json")
doc = json.load(open(target)) if os.path.exists(target) else {}
if not isinstance(doc, dict): doc = {}
servers = doc.get("mcpServers") if isinstance(doc.get("mcpServers"), dict) else {}
servers.update(json.load(open(os.path.join(d, ".mcp-import.json"))))
doc["mcpServers"] = servers
tmp = target + ".tmp"
with open(tmp, "w") as f: json.dump(doc, f, indent=2); f.write("\n")
os.chmod(tmp, 0o600); os.replace(tmp, target)
os.unlink(os.path.join(d, ".mcp-import.json"))
PY
            log "mcp: imported into ${PI_AGENT_DIR}/mcp.json (manage with /mcp in pi, or pi mcp list)" ;;
    esac
}

# REA (https://github.com/morluto/rea): reverse engineering on demand. REA is
# one MCP server with ~170 tools (~65k tokens of input schemas even in its
# compact profile), so it is never registered in the main session: it is
# the expert reverse-engineer (agents/reverse-engineer.md, through the
# expert tool), whose child is a fresh pi with its own agent dir that
# registers REA, so its tools, its own skill and the raw evidence stay in
# that child and only the report comes back. The child agent dir links
# everything of ~/.pi/agent (models, auth, settings, extensions, so the
# same provider and guards apply) except mcp.json and skills. REA is pinned
# and installed by ${REA_DIR}/setup once the user enables the expert, and
# kept current by later launches.
REA_VERSION="6.4.0"
REA_DIR="${PI_AGENT_DIR}/rea"
# pi_write_rea <on|files>: writes the setup script, the child's standing
# instructions and the agent file; on also runs the setup (install when
# missing or another version, then the child's agent dir), files only
# refreshes the agent dir of an installed REA. Sets REA_NOTE (empty =
# ready) and REA_AGENT (1 = the agent file is ours).
pi_write_rea() {
    local invoke="$1" rc
    REA_NOTE=""; REA_AGENT=""
    mkdir -p "${REA_DIR}"
    # the runner and skill earlier versions wrote (REA without subagents, REA=manual)
    rm -rf "${REA_DIR}/skill" "${REA_DIR}/run"

    # 1. the setup: the pinned REA package (first run, or when REA_VERSION
    # changes), then the child's agent dir: links to the main one, minus MCP
    # and skills, and REA registered alone in its mcp.json
    {
        echo '#!/usr/bin/env bash'
        echo '# Written by lets-code (REA); regenerated on launch, edits are overwritten.'
        echo '# setup [--no-install]: installs the pinned REA into runtime/ when it is'
        echo '# missing or another version, then links the child agent dir (agent/) to'
        echo '# the main one and registers REA in its mcp.json. Progress goes to stderr;'
        echo '# on failure the last stdout line says why. --no-install: exit 3 when REA'
        echo '# is not installed, else only the agent dir.'
        printf 'version="%s"\n' "${REA_VERSION}"
        cat <<'SH'
set -u
here="$(cd "$(dirname "$0")" && pwd)"; main="$(dirname "${here}")"
rt="${here}/runtime"; agent="${here}/agent"; have=""
mkdir -p "${rt}"
printf '{\n  "name": "lets-code-rea",\n  "private": true,\n  "dependencies": { "rea-agents": "%s" }\n}\n' "${version}" > "${rt}/package.json"
[ -f "${rt}/node_modules/rea-agents/package.json" ] && \
    have="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "${rt}/node_modules/rea-agents/package.json" 2>/dev/null)"
if [ "${have}" != "${version}" ]; then
    [ "${1:-}" = --no-install ] && exit 3
    command -v npm >/dev/null 2>&1 || { echo "npm not found; run: cd ${rt} && npm install"; exit 2; }
    echo "${SETUP_LOG_PREFIX:+${SETUP_LOG_PREFIX} }rea: installing rea-agents ${version} into ${rt} (first run only, ~160 MB) ..." >&2
    (cd "${rt}" && npm install --omit=dev --ignore-scripts --no-audit --no-fund --loglevel=error >/dev/null 2>&1) || { echo "install failed; run: cd ${rt} && npm install --omit=dev --ignore-scripts"; exit 1; }
fi
mkdir -p "${agent}"
for e in "${main}"/* "${main}"/.[!.]*; do
    [ -e "${e}" ] || continue
    name="$(basename "${e}")"
    case "${name}" in mcp.json|mcp-auth.json|skills|sessions|rea) continue ;; esac
    if [ -e "${agent}/${name}" ] && [ ! -L "${agent}/${name}" ]; then rm -rf "${agent:?}/${name}"; fi
    ln -sfn "${e}" "${agent}/${name}"
done
for e in "${agent}"/* "${agent}"/.[!.]*; do   # links whose target is gone
    if [ -L "${e}" ] && [ ! -e "${e}" ]; then rm -f "${e}"; fi
done
# REA registered alone, compact schemas; env keys the user added to the
# entry (GHIDRA_INSTALL_DIR, REA_IDA_MCP_CONFIG, ...) and other servers
# added to this file are kept.
python3 - "${agent}/mcp.json" "${rt}/node_modules/rea-agents/scripts/rea.mjs" <<'PY' || { echo "could not write ${agent}/mcp.json"; exit 1; }
import json, os, sys
target, entry = sys.argv[1], sys.argv[2]
try:
    doc = json.load(open(target))
    if not isinstance(doc, dict): doc = {}
except Exception:
    doc = {}
servers = doc.get("mcpServers") if isinstance(doc.get("mcpServers"), dict) else {}
old = servers.get("rea") if isinstance(servers.get("rea"), dict) else {}
env = old.get("env") if isinstance(old.get("env"), dict) else {}
env.setdefault("REA_MCP_INPUT_SCHEMA_PROFILE", "compact")
servers["rea"] = {"type": "stdio", "command": "node", "args": [entry, "mcp"], "env": env,
                  "description": "REA: reverse engineering of binaries, apps, packages, firmware and websites"}
doc["mcpServers"] = servers
tmp = target + ".tmp"
with open(tmp, "w") as f: json.dump(doc, f, indent=2); f.write("\n")
os.chmod(tmp, 0o600); os.replace(tmp, target)
PY
SH
    } > "${REA_DIR}/setup"
    chmod 755 "${REA_DIR}/setup"

    # 2. the child's standing instructions
    cat > "${REA_DIR}/prompt.md" <<'MD'
You are the reverse-engineering agent of a lets-code session. Another agent
gave you one task and will see only your final message.

REA is connected as the MCP server `rea`. Its tools are reached through
codemode: `await describeNamespace("rea")` lists them and the server's
instructions, `await searchTools("<what>", { namespace: "rea" })` finds one,
and `tools.mcp__rea__<name>({...})` calls it. Read the
reverse-engineer-anything skill before the first REA call. REA is why you
were started: base findings on REA results, and use plain reads or runs only
to confirm them or where REA has no tool for the target. Reduce large
results inside the script; write bulky evidence to files and cite the paths.

Final message, for an agent that has not seen any of it:
## Answer
What the target does, in direct terms.
## Evidence
Files, functions, addresses, modules or requests that show it, with the
REA tool that produced each.
## Unknowns
What could not be established and why (missing engine, obfuscation, ...).
MD
    # 3. the expert; a user's own agent of that name is left alone
    # (REA_AGENT stays empty)
    rea_write_agent

    # 4. install (on) or refresh an installed one (files)
    if [ "${invoke}" = files ]; then
        bash "${REA_DIR}/setup" --no-install >/dev/null 2>&1 || true
        return 0
    fi
    rc=0; REA_NOTE="$(SETUP_LOG_PREFIX="${LOG_PREFIX}" bash "${REA_DIR}/setup")" || rc=$?
    if [ ${rc} -eq 0 ]; then REA_NOTE=""; else REA_NOTE="$(printf '%s\n' "${REA_NOTE}" | tail -n 1)"; REA_NOTE="${REA_NOTE:-setup failed (exit ${rc})}"; fi
    return 0
}
rea_write_agent() {
    local af="${PI_AGENT_DIR}/agents/reverse-engineer.md" tmp
    if [ -e "${af}" ] && ! grep -q '^# Written by lets-code' "${af}" 2>/dev/null; then return 0; fi
    mkdir -p "${PI_AGENT_DIR}/agents"
    tmp="$(mktemp "${af}.XXXXXX")" || return 0
    cat > "${tmp}" <<'MD'
---
# Written by lets-code (REA); regenerated on launch, edits are overwritten.
# To keep your own version, delete this line: lets-code then leaves it alone.
name: reverse-engineer
description: Reverse engineers binaries, apps, APKs, firmware, websites
agent_dir: rea/agent
skills: rea/runtime/node_modules/rea-agents/skills/reverse-engineer-anything
append_prompt: rea/prompt.md
timeout: 3600
requires: rea/runtime/node_modules/rea-agents/package.json
expert: true
use_for: reverse engineering: what a compiled binary, app, APK, firmware or minified script does
keywords: reverse engineering
job: Reverse engineers shipped software (binaries, Electron/JS apps, .NET, APKs, firmware, websites) with REA, when a question depends on a built artifact rather than source; up to an hour
setup: rea/setup
setup_note: installs REA with npm into ~/.pi/agent/rea (about 160 MB, a minute or two)
brief:
  - target (required): absolute path or URL of the artifact
  - question (required): what to find out
  - purpose: what the answer is for
---
MD
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${af}"; then rm -f "${tmp}"; else mv "${tmp}" "${af}"; fi
    REA_AGENT=1
}

# Tester expert: the test lead. Software testing of any kind with QA
# discipline (risk-based planning, test design techniques, oracles,
# evidence), done by itself (unit, integration, CLI and terminal UIs,
# libraries, a quick API smoke) or by its team of specialists, started with
# the expert tool: ui-tester (browser and mobile UI, the achilles method over
# Playwright and Appium) and api-tester (HTTP and GraphQL APIs). The team is
# the agent file's `team:` key: the subagents module gives this child one
# level more, and its experts module lists and runs only those experts.
# The QA discipline here is distilled from the tester's achilles method
# (journeys, coverage, bug discovery, failure diagnosis, evidence),
# generalized beyond the browser, and the standard test design techniques
# (ISTQB foundation: partitions, boundaries, decision tables, state
# transitions, pairwise, error guessing; exploratory charters; HICCUPPS
# oracles). Runs under the `tester` role: the developer's rights (tests and
# fixtures in its working folder and the temp dir, no git writes or
# installs) and the dispatch of its team. No setup and no platform: on the
# phone it tests by itself, and a specialist that cannot run there is
# reported as a gap.
# tester expert: Software testing with QA discipline: a risk-based test plan, then unit, integration, CLI and terminal UI, API and UI tests, by itself or by its team (ui-tester: browser and mobile, api-tester: HTTP APIs); verifies changes, writes tests, hunts bugs, diagnoses failing tests; up to an hour
# Written on every launch with experts on; dormant until the user enables it.
pi_write_tester() {
    local d="${PI_AGENT_DIR}/tester" af="${PI_AGENT_DIR}/agents/tester.md" tmp f
    mkdir -p "${d}/ref" "${PI_AGENT_DIR}/agents"
    # what the browser half left here before it became ui-tester
    rm -rf "${d}/bin" "${d}/setup" "${d}/prompt.md"
    for f in api-web.md api-mobile.md bugs.md composition.md method.md; do rm -f "${d}/ref/${f}"; done
    cat > "${d}/ref/strategy.md.tmp" <<'LC_EOF'
<!-- Written by lets-code (tester); regenerated on launch, edits are overwritten. -->
# Test strategy: basis, risk, levels, types, the plan

## 1. The test basis
- What the software must do: acceptance criteria, requirements, the ticket,
  the docs, the API spec, the diff and its commit message. Quote them.
- What it must keep doing: existing behaviour around the change (ask, or
  read the tests and docs). A change that breaks a neighbour is a failure.
- Implied requirements: the product's own conventions, platform norms,
  sensible error handling, no data loss, no secret in output. Label a
  criterion you inferred "inferred" and test it, but never let it decide
  the verdict alone.
- Read the basis critically first (static testing): contradictions,
  ambiguity ("fast", "correctly"), missing error cases, untestable wording.
  Report them as findings of their own (severity by what they put at risk).

## 2. Risk
Rate each feature, criterion or area:
- Likelihood of failure: complexity, size of the change, new code or new
  technology, churn (`git log --oneline -- <path> | head`), past bugs,
  concurrency, time and dates, money, parsing, external services.
- Impact: data loss or corruption, security or privacy, money, the core
  flow blocked, how many users, how visible, how hard to undo.
- High x high = High: test deep, at several levels. Low x low: smoke only.
Risk orders the work and sets depth; it never removes a criterion.

## 3. Levels (where a test lives)
- Unit: one function or class, its logic and edges; fast, many. Default
  home for boundaries, partitions and error paths of logic.
- Integration (component): modules together, the database, the file
  system, a real or faked service; the contracts between parts.
- System (end to end): through the real interface a user has: the CLI,
  the TUI, the HTTP API, the web or mobile UI. Fewer and slower; for the
  journeys and criteria as users observe them.
- Acceptance: each criterion shown at the level a user observes it.
The pyramid: most checks low, a few journeys high. Test each thing at the
lowest level that can show it, plus one end-to-end proof per criterion.

## 4. Types
- Functional: does it do what the basis says, including its errors.
- Confirmation: a fixed bug is fixed (its reproduction now passes).
- Regression: what worked still works (the suite, plus the neighbours of
  the change).
- Smoke: it builds, starts and its main path works; first, before depth.
- Exploratory: time-boxed, learning while testing (workflows.md, W4).
- Non-functional: performance, security, reliability, accessibility,
  compatibility, usability (nonfunctional.md); smoke level unless asked.

## 5. The test plan (write it before testing; a temp file is enough)
```
# Test plan: <target> - <goal>
Basis: <criteria, docs, diff>          Scope: in <...> / out <...>
Depth: smoke | standard | deep          Environment: <how it runs, what differs>
Baseline: <suite command> -> <counts, what already failed>
## Risks
R1 | <area> | likelihood H/M/L | impact H/M/L | why
## Matrix
ID | item (C<n>/R<n>) | level | type | technique | by (me/ui-tester/api-tester) | data | status
P1 | C1 | unit | functional | boundaries | me | generated | todo
## Entry / exit
Entry: builds, starts, baseline known.  Exit: see section 6.
```
Statuses: todo, passed, failed (-> finding), blocked (why), not done (why).

## 6. Depth and exit criteria
- Smoke: each criterion's happy path; the suite runs.
- Standard (the default): smoke, plus each criterion's errors, boundaries
  and partitions, the regression of the change's neighbours, one
  exploratory charter on the riskiest area.
- Deep: standard, plus states and combinations (pairwise), every High risk
  at two levels, non-functional smoke, a second charter.
Done when: every matrix row has a final status; every criterion has a
passing test or a finding; every High risk is covered at its level; new
tests pass 3 runs in a row; no unexplained skip; the full suite was run at
the end; what was not covered is listed as residual risk.

## 7. Regression selection
From the diff: the files changed, then their callers and the tests that
touch them (`grep -rn <symbol>`). Run those first, then the whole suite.
When the suite is slow, say what you ran instead and what that leaves out.

## 8. Test data and environment
- Each test makes its own data and cleans it up; no order between tests.
- Never production data or real accounts; logins and tokens by env var
  name, never the value.
- Note every way the test environment differs from where the software
  really runs (OS, versions, data size, network, permissions).
