}
// the acceptance criteria of a ticket: the list under a heading or line that says so
export function parseCriteria(ticket: string): string[] {
	const lines = (ticket || "").split(/\r?\n/); const out: string[] = []; let on = false;
	for (const raw of lines) {
		const l = raw.trim();
		if (/^(#+\s*)?(acceptance criteria|criteria|definition of done)\b.*:?$/i.test(l.replace(/\*\*/g, ""))) { on = true; continue; }
		if (!on) continue;
		if (/^#+\s/.test(l)) { if (out.length) break; continue; }
