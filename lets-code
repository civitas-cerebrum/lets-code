case "${o}" in
    *"Error type 3"*|*"does not exist"*) t0=1; echo "tier 0 intents: yes (am reaches the system)" ;;
    *) t0=0; echo "tier 0 intents: no (am did not answer the control check: $(printf '%s' "${o}" | tail -n 1))" ;;
