// ------------------------------------------------------------------ the engine
const next = (s: Stage): Stage => PIPELINE[Math.min(PIPELINE.indexOf(s) + 1, PIPELINE.length - 1)];
export function summary(L: Ledger): string {
	const lines = L.entries.map((e) => `- ${e.stage}${e.round ? ` (fix round ${e.round})` : ""}: ${e.verdict}${e.summary ? `, ${e.summary}` : ""}${e.seconds ? ` [${Math.round(e.seconds)} s${e.input ? `, ↑${e.input} ↓${e.output_tokens}` : ""}]` : ""}`);
	const state = L.status === "waiting" || (L.waiting && L.status === "running") ? `waiting for the user: ${L.waiting}${L.note ? ` (${L.note})` : ""}` : L.status === "done" ? `done${L.commit ? `, committed ${L.commit.slice(0, 10)} on ${L.branch}` : `, left uncommitted on ${L.branch}`}` : L.status === "stopped" ? `stopped${L.note ? `: ${L.note}` : ""}` : `running: ${L.stage}`;
	return [`factory run ${L.id}: ${state}`, `work tree: ${L.work}`, ...lines].join("\n");
