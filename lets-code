}
// where an expert can run: termux (Termux on Android), or Node platform
// names (linux, darwin, ...); none = everywhere
export function platformOk(p?: string): boolean {
	if (!p) return true;
	if (p === "termux") return /\/com\.termux\//.test(process.env.PREFIX ?? "") || existsSync("/data/data/com.termux/files/usr");
	return p.split(/[,\s]+/).includes(process.platform);
