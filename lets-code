/** Failing-test count reported by a test-like tool output: 0 = all passed, null = not a test run.
 * Several summaries can appear in one output ("130 pass, 1 fail" then "error tests: 0 failures");
 * the largest failure count wins, so one green sub-summary never hides a failure. */
export function testStatus(txt: string): number | null {
	const counts: number[] = [];
	for (const m of txt.matchAll(/(\d+)[ \t]+(?:tests?[ \t]+)?(?:failed|failures?|fail|errors?)\b(?![ \t]*[=:])/gi)) counts.push(Number(m[1]));
	for (const m of txt.matchAll(/\b(?:fail(?:ures|ed|s)?|errors?)\s*[=:]\s*(\d+)/gi)) counts.push(Number(m[1]));
	const base = baseStatus(txt);
	if (base === null && !counts.length) return null;
	if (base === null && !/\bpass(?:ed|es)?\b|\bOK\b|\bok\b/.test(txt)) return null;
	return Math.max(base ?? 0, ...counts);
}

function baseStatus(txt: string): number | null {
	if (/Ran \d+ tests?/.test(txt)) {
		const f = /FAILED \((?:failures=(\d+))?(?:, )?(?:errors=(\d+))?/.exec(txt);
		if (f) return Number(f[1] ?? 0) + Number(f[2] ?? 0);
		if (/(^|\n)OK\b/.test(txt)) return 0;
	}
	let m = /(\d+) passed(?:, | and )(\d+) failed/.exec(txt);
	if (m) return Number(m[2]);
	m = /(\d+) failed, (\d+) passed/.exec(txt); // pytest summary
	if (m) return Number(m[1]);
	if (/=+ (\d+) passed\b[^\n]*=+/.test(txt) && !/failed|error/i.test(txt.slice(-300))) return 0;
	m = /\bfail(?:ures|ed|s)?\s*[=:]\s*(\d+)/i.exec(txt); // checked=20000 failures=51
	if (m) return Number(m[1]);
	m = /(\d+)\/\d+ cases failed|(\d+) differential failures|(\d+) failures?\b(?!\s*[=:])/.exec(txt);
	if (m) return Number(m[1] ?? m[2] ?? m[3]);
	const nfail = (txt.match(/(^|\n)(FAIL|MISMATCH)[:\s]/g) ?? []).length;
	if (nfail) return nfail;
	if (/ALL (TESTS )?PASS|all tests passed|ALL OK|all checks passed/i.test(txt)) return 0;
	// "all inline tests passed", "All 189 test assertions pass", "all 30 checks passed"
	if (/\ball\b[\w ,-]{0,40}?\b(tests?|checks?|assertions?|cases?)\b[\w ]{0,15}?\bpass(ed|es)?\b/i.test(txt) && !/\bfail(ed|ures?)?\b(?![ \t]*[=:][ \t]*0)/i.test(txt)) return 0;
	return null;
}

/** Total test count reported by a test-like output, or null when it cannot be read. */
export function testTotal(txt: string): number | null {
	let m = /Ran (\d+) tests?/.exec(txt);
	if (m) return Number(m[1]);
	m = /(\d+) passed(?:, | and )(\d+) failed/.exec(txt) ?? /(\d+)[ \t]+pass(?:ed)?,[ \t]*(\d+)[ \t]+fail/i.exec(txt);
	if (m) return Number(m[1]) + Number(m[2]);
	m = /(\d+) failed, (\d+) passed/.exec(txt);
	if (m) return Number(m[1]) + Number(m[2]);
	m = /(\d+)\/(\d+) (?:cases|tests|checks)? ?(?:passed|ok)/i.exec(txt);
	if (m) return Number(m[2]);
	return null;
}

/** A struggle signal: why thinking was raised, and the condition that ends the burst. */
export interface Trigger {
	why: string;
	goal: string;
	resolved: (d: Detector) => boolean;
}

/** Struggle signals, fed from tool calls, tool results and turn ends. */
export class Detector {
	turns = 0;
	editStreak = 0;
	errStreak = 0;
	syntax = 0;
	repeats = 0;
	best: number | null = null;
	noImprove = 0;
	regression = false;
	lastFailing: number | null = null;
	passing = false;
	passTurn: number | null = null;
	passAt: number | null = null;
	totalTurns = 0;
	mutations = 0;
	editsSinceTest = 0;
	seq = 0;
	lastSourceEdit = 0;
	lastExec = 0;
	lastExecFailed = false;
	lastOkEdit = 0;
	lastCleanExec = 0;
	lastOkResult = 0;
	lastTestEdit = 0;
	testRuns = 0;
	draftWrong = false;
	draftChecked = false;
	lastTotal: number | null = null;
	pendingExec = false;
	lastCommand = "";
