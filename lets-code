		try { manifest = loadManifest(cwd, typeof (ctx as any)?.isProjectTrusted === "function" ? ctx!.isProjectTrusted() : !!(ctx as any)?.isProjectTrusted, (m) => warn(ctx, m)); }
		catch (e) { // a broken manifest fails closed: built-in roles only, and the strictest mode that still works
			warn(ctx, `mandate: ${(e as Error).message} — using built-in roles`); manifest = BUILTIN;
		}
		if (!ACTIVE) { if (on) apply(ctx, roleName, false); return; }
