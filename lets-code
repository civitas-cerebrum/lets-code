pi_write_experts_extension() {
    local dir f tmp
    lc_ext_module experts; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.experts.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (experts); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with subagents and experts
// on (LETS_CODE_EXPERTS_ON=1, LETS_CODE_SUBAGENTS_ON=1). An expert is
// a subagent with its own knowledge: an agent file in ~/.pi/agent/agents
// (never a project's) with `expert: true` and
//   job         one line on what it does (default: its description)
//   use_for     a few words on the tasks it takes, in the always-on line
//   keywords    two or three words that stand in for use_for once there are
//               many experts (default: its first words)
//   dispatch_rule  one imperative line in the system prompt while it is usable
//               here, for tasks the model keeps doing by hand next to the line
//               (termux-device's: phone actions); costs tokens in every request
//   platform    where it can run: termux, or Node platform names; else hidden
//   route       false: left out of the always-on line, so the model does not
//               route tasks to it; it is run by name (a pipeline stage) and
//               shown by list
//   runner      factory: run in this session by the factory module
//               (runExpert), not as a child: it starts children of its own
//   setup       a script (path under ~/.pi/agent) run once it is enabled,
//               when what the file names (agent_dir, requires, ...) is missing
//   setup_note  what that setup does, shown in the enable dialog
//   brief       the template its caller fills in, one block-list item per
//               field: "name (required): hint" or "name: hint"
// One tool, `expert`, costs a line in context: the names usable here, each
// with its use_for, and the three actions (names alone were not enough: a
// model did a phone task by hand next to a tool listing termux-device).
// list gives each one's job, state and template; enable asks the USER (a
// dialog; the model never enables one by itself, and without a UI it is
// refused with a note); run checks the brief against the template, asks to
// enable first when needed, and dispatches through the subagents module's
// runner (same progress, abort, timeout, depth and concurrency). Every
// expert is dormant until the user says yes (the dialog, /experts enable);
// that is remembered (lets-code-state.json, key experts), and
// /experts disable makes it dormant again. A dormant one costs its entry in
// the line and nothing else: its setup runs on enable.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import { mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { Type } from "typebox";

const ACTIVE = process.env.LETS_CODE_EXPERTS_ON === "1" && process.env.LETS_CODE_SUBAGENTS_ON === "1";
const DEPTH = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
const MAX_DEPTH = Number(process.env.LETS_CODE_SUBAGENT_MAX_DEPTH ?? "1") || 1;
const HERE = dirname(fileURLToPath(import.meta.url));
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const SETUP_TIMEOUT = 15 * 60 * 1000;

interface Field { name: string; required: boolean; hint: string }
interface Spec { name: string; description: string; file: string; expert: { job: string; useFor?: string; keywords?: string; dispatchRule?: string; brief: Field[]; setup?: string; setupNote?: string; ready: boolean; routed?: boolean; runner?: string } }

// ------------------------------------------------------------------ state
export const statePath = () => join(AGENT_DIR, "lets-code-state.json");
function readState(): any { try { const s = JSON.parse(readFileSync(statePath(), "utf8")); return s && typeof s === "object" ? s : {}; } catch { return {}; } }
export function remembered(): Record<string, boolean> {
	const s = readState().experts; const out: Record<string, boolean> = {};
	if (s && typeof s === "object") for (const [k, v] of Object.entries(s)) if (typeof v === "boolean") out[k] = v;
	return out;
}
export function remember(name: string, on: boolean): void {
	try {   // merge-safe: other keys of the file stay
		const p = statePath(); const s = readState();
		s.experts = { ...(s.experts && typeof s.experts === "object" ? s.experts : {}), [name]: on };
		mkdirSync(dirname(p), { recursive: true });
		const tmp = `${p}.${process.pid}.tmp`; writeFileSync(tmp, JSON.stringify(s, null, 2) + "\n", { mode: 0o600 }); renameSync(tmp, p);
	} catch { /* never fatal */ }
}

// ------------------------------------------------------------------ brief
// the brief as the model sent it: an object, or JSON of one
export function asBrief(b: unknown): Record<string, unknown> | null {
	if (typeof b === "string") { try { b = JSON.parse(b); } catch { return null; } }
	return b && typeof b === "object" && !Array.isArray(b) ? b as Record<string, unknown> : null;
}
const value = (v: unknown) => (typeof v === "string" ? v : v === undefined || v === null ? "" : JSON.stringify(v)).trim();
export function missingFields(fields: Field[], brief: Record<string, unknown> | null): string[] {
	return fields.filter((f) => f.required && !value(brief?.[f.name])).map((f) => f.name);
}
// the child's task: a heading per field, in template order, then any extra
// field the caller added
export function renderBrief(s: Spec, brief: Record<string, unknown>): string {
	const head = (n: string) => n.replace(/[_-]+/g, " ").replace(/^./, (c) => c.toUpperCase());
	const names = [...s.expert.brief.map((f) => f.name), ...Object.keys(brief).filter((k) => !s.expert.brief.some((f) => f.name === k))];
	const parts = names.map((n) => [n, value(brief[n])]).filter(([, v]) => v).map(([n, v]) => `## ${head(n)}\n${v}`);
	return `Brief for the ${s.name} expert.\n\n${parts.join("\n\n")}`;
}
export function template(s: Spec, full = false): string {
	if (!full) return s.expert.brief.map((f) => `${f.name}${f.required ? "*" : ""} (${f.hint || "no hint"})`).join("; ");
	const example = `{${s.expert.brief.map((f) => `${f.name}: "..."`).join(", ")}}`;
	return [...s.expert.brief.map((f) => `- ${f.name}${f.required ? " (required)" : ""}: ${f.hint || "no hint"}`),
		`Call: expert({action: "run", name: "${s.name}", brief: ${example}})`].join("\n");
}

// ------------------------------------------------------------------ setup
// runs the expert's setup script with bash; progress lines (stderr) go
// to onLine, the last stdout line is the note: why it failed, or what the
// user should know once it succeeded (e.g. an app to install by hand)
export function runSetup(script: string, onLine: (l: string) => void, signal?: AbortSignal): Promise<{ ok: boolean; note: string }> {
	return new Promise((resolve) => {
		let out = ""; let err = ""; let done = false;
		const child = spawn("bash", [script], { cwd: dirname(script), stdio: ["ignore", "pipe", "pipe"] });
		const finish = (ok: boolean, note: string) => { if (done) return; done = true; clearTimeout(timer); signal?.removeEventListener("abort", stop); resolve({ ok, note }); };
		const stop = () => { try { child.kill("SIGTERM"); } catch { /* gone */ } };
		const timer = setTimeout(stop, SETUP_TIMEOUT); timer.unref?.();
		signal?.addEventListener("abort", stop, { once: true });
		child.stdout.on("data", (d) => { out += d.toString(); });
		child.stderr.on("data", (d) => { err += d.toString(); const lines = err.split("\n"); err = lines.pop() ?? ""; lines.filter((l) => l.trim()).forEach((l) => onLine(l.trim())); });
		child.on("error", (e) => finish(false, e.message));
		child.on("close", (code) => { const last = out.trim().split("\n").pop() ?? ""; finish(code === 0, code === 0 ? last.trim() : last || err.trim() || `setup exited ${code}`); });
	});
}

// The always-on line: who takes which tasks, and the actions. Each entry is
// the name and its use_for; past LINE_BUDGET characters (about a dozen
// experts) the entries shrink to their keywords, or the first
// USE_FOR_SHORT words of use_for, so twenty stay under 400 tokens with the
// schema; list has the rest.
export const LINE_BUDGET = 1000;
export const USE_FOR_SHORT = 4;
export function snippet(all: Spec[]): string {
	const specs = all.filter((s) => s.expert.routed !== false);
	if (!specs.length) return "expert: experts run by name; list shows them. Actions: list | enable | run";
	const line = (short: boolean) => {
		const who = specs.map((s) => {
			let u = s.expert.useFor ?? "";
			if (short && s.expert.keywords) u = s.expert.keywords;
			else if (short) { const w = u.split(/\s+/); if (w.length > USE_FOR_SHORT) u = `${w.slice(0, USE_FOR_SHORT).join(" ").replace(/[,;:]$/, "")}…`; }
			return u ? `${s.name} (${u})` : s.name;
		}).join("; ");
		return `expert: these tasks go to the expert named, not done by hand, even quick ones: ${who}. Actions: list | enable | run`;
	};
	const full = line(false);
	return full.length <= LINE_BUDGET ? full : line(true);
}

// The experts' dispatch rules, one line each, as a system-prompt section
// (none: no section). The expert line alone did not stop a phone session
// from launching an app by hand; a rule in the prompt names the trigger.
export function rulesSection(specs: Spec[]): string {
	const rules = specs.filter((s) => s.expert.routed !== false).map((s) => s.expert.dispatchRule).filter((r): r is string => !!r);
	return rules.length ? ["Experts (lets-code):", ...rules.map((r) => `- ${r}`)].join("\n") : "";
}

export default async function (pi: ExtensionAPI) {
	if (!ACTIVE || DEPTH >= MAX_DEPTH) return;   // a child gets no tool (it cannot start children)
	// a child with a team (LETS_CODE_EXPERT_TEAM): its team's experts only, each
	// in its line (a specialist the main session does not route to is still its own)
	const TEAM = DEPTH > 0 ? (process.env.LETS_CODE_EXPERT_TEAM ?? "").split(",").map((t) => t.trim()).filter(Boolean) : [];
	const sub = await import(pathToFileURL(join(HERE, "subagents.ts")).href);
	const discover = (): Spec[] => TEAM.length ? sub.discoverExperts().filter((s: Spec) => TEAM.includes(s.name)).map((s: Spec) => ({ ...s, expert: { ...s.expert, routed: true } })) : sub.discoverExperts();
	const known = discover();
	if (!known.length) return;   // none usable here: no tool, no tokens
	const RULES = rulesSection(known);
	if (RULES) pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (sections && typeof sections === "object") sections.lets_code_experts = RULES;
		return undefined;
	});
	const session = new Map<string, boolean>();   // decided in this session (dialog, /experts)
	const declined = new Set<string>();            // said no in this session: not asked again
	const setupNotes = new Map<string, string>();  // a setup's note on success, for the result of the call that ran it
	const enabled = (n: string) => session.has(n) ? session.get(n)! : remembered()[n] === true;
	const find = (n: string) => discover().find((s) => s.name === n);
	const unknown = (n: string) => `Unknown expert "${n}". Experts: ${discover().map((s) => s.name).join(", ") || "none"}.`;
	const howTo = (n: string) => `/experts enable ${n}`;
	function stateOf(s: Spec): string {
		const on = enabled(s.name); const ready = s.expert.ready;
		if (on) return ready ? "enabled" : "enabled, not set up (run sets it up)";
		// worded so the model runs it (the dialog is the question) instead of asking in chat
		if (declined.has(s.name)) return `dormant: the user declined it in this session (they can: ${howTo(s.name)})`;
		const ask = "just run it: the user gets a yes/no dialog to enable it";
		return ready || !s.expert.setup ? `dormant, ${ask}` : `dormant, ${ask}, then it ${s.expert.setupNote || "runs its setup"}`;
	}
	function listText(name?: string): string {
		const specs = discover();
		if (name) {
			const s = specs.find((x) => x.name === name); if (!s) return unknown(name);
			return `${s.name}: ${s.expert.job}\nState: ${stateOf(s)}\nBrief:\n${template(s, true)}`;
		}
		return [`Experts (brief: * = required; run: {action: "run", name, brief: {field: value}}):`,
			...specs.map((s) => `- ${s.name}: ${s.expert.job} [${stateOf(s)}]\n  brief: ${template(s)}`)].join("\n");
	}
	// /experts for the user: one aligned line per expert with a state mark, the
	// details (brief fields, setup) only for one named expert. listText above
	// is the model's view, worded for the tool; this one is for reading.
	function menuText(name?: string, cols = process.stdout.columns || 80): string {
		const specs = discover();
		const W = Math.max(30, cols - 3);   // pi indents a notification by a column or two
		const mark = (s: Spec) => (enabled(s.name) ? "●" : "○");
		const state = (s: Spec) => {
			if (enabled(s.name)) return s.expert.ready ? "enabled" : "enabled, sets up on its first run";
			if (declined.has(s.name)) return "dormant, declined in this session";
			return s.expert.setup && !s.expert.ready ? `dormant, on enable: ${s.expert.setupNote || "runs its setup"}` : "dormant";
		};
		const cut = (t: string, n: number) => (t.length > n ? `${t.slice(0, n - 1).replace(/[\s,;:(]+\S*$/, "")}…` : t);
		// words onto lines of at most n characters, each after the indent
		const wrap = (t: string, indent: string, n: number) => {
			const out: string[] = []; let line = "";
			for (const w of t.split(/\s+/).filter(Boolean)) {
				if (line && line.length + 1 + w.length > n) { out.push(indent + line); line = w; } else line = line ? `${line} ${w}` : w;
			}
			if (line) out.push(indent + line);
			return out;
		};
		if (name) {
			const s = specs.find((x) => x.name === name); if (!s) return unknown(name);
			const fw = Math.max(...s.expert.brief.map((f) => f.name.length), 4);
			const fields = s.expert.brief.flatMap((f) => {
				const head = `  ${f.name.padEnd(fw)}  ${f.required ? "required" : "optional"}`;
				return [head, ...wrap(f.hint || "", "    ", W - 4)];
			});
			return [`${mark(s)} ${s.name}`, ...wrap(state(s), "  ", W - 2), "", ...wrap(s.expert.job, "  ", W - 2), "", "Brief", ...fields,
				"", `/experts ${enabled(s.name) ? "disable" : "enable"} ${s.name}`].join("\n");
		}
		if (!specs.length) return "No experts are usable here.";
		const nw = Math.max(...specs.map((x) => x.name.length));
		const side = W - (nw + 4) >= 36;   // room for the job next to the name, else under it
		const rows = specs.flatMap((s) => {
			const st = state(s); const extra = st === "enabled" || st === "dormant" ? [] : [st];
			if (side) {
				const pad = " ".repeat(nw + 4);
				return [`${mark(s)} ${s.name.padEnd(nw)}  ${cut(s.expert.job, W - nw - 4)}`, ...extra.map((x) => pad + cut(x, W - nw - 4))];
			}
			return [`${mark(s)} ${s.name}`, `  ${cut(s.expert.job, W - 2)}`, ...extra.map((x) => `  ${cut(x, W - 2)}`)];
		});
		return ["Experts  ● enabled  ○ dormant", "", ...rows, "", cut("/experts <name> for details", W), cut("/experts enable|disable <name>", W)].join("\n");
	}
	// enabled and set up -> null; else why not. consent: the user asked for it
	// (/experts enable), so no dialog. The user's yes is remembered.
	async function ensure(name: string, ctx: ExtensionContext, progress: (l: string) => void, consent: boolean, signal?: AbortSignal): Promise<string | null> {
		let s = find(name); if (!s) return unknown(name);
		const yesNow = consent || !enabled(name);
		if (!enabled(name) && !consent) {
			if (declined.has(name)) return `The user declined the ${name} expert in this session; they can enable it with ${howTo(name)}.`;
			if (!ctx.hasUI) return `The ${name} expert is not enabled, and only the user can enable it: ${howTo(name)}.`;
			const setup = !s.expert.ready && s.expert.setup ? `\nSetup: ${s.expert.setupNote || "runs its setup script"}.` : "";
			const yes = await ctx.ui.confirm(`Enable the ${name} expert?`, `${s.expert.job}${setup}\nlets-code remembers the answer yes; /experts disable ${name} undoes it.`);
			if (!yes) { declined.add(name); return `The user declined to enable the ${name} expert.`; }
		}
		if (!s.expert.ready) {
			if (!s.expert.setup) return `The ${name} expert is not set up: a path ${s.file} names is missing.`;
			progress(`${name}: setting up (${s.expert.setupNote || "its setup script"}) ...`);
			if (ctx.hasUI) ctx.ui.notify(`Setting up the ${name} expert: ${s.expert.setupNote || "running its setup"} ...`, "info");
			const r = await runSetup(s.expert.setup, (l) => progress(`${name} setup: ${l}`), signal);
			s = find(name);
			if (!r.ok || !s?.expert.ready) return `Setting up the ${name} expert failed: ${r.note || "it is still not ready"}.`;
			if (r.note) setupNotes.set(name, r.note);
			if (ctx.hasUI) ctx.ui.notify(`The ${name} expert is set up.${r.note ? ` ${r.note}` : ""}`, "info");
		}
		if (yesNow) { declined.delete(name); session.set(name, true); remember(name, true); }
		return null;
	}
	const text = (t: string, isError = false) => ({ content: [{ type: "text" as const, text: t }], isError });
	const noteOf = (n: string) => { const v = setupNotes.get(n); setupNotes.delete(n); return v ? ` Setup: ${v}` : ""; };
	const Brief = (o = {}) => Type.Object({}, { additionalProperties: true, ...o });
	pi.registerTool({
		name: "expert",
		label: "expert",
		// always in context: names in the snippet, actions here; jobs, states and templates come from list
		description: "Subagents with their own knowledge. list: jobs, states, brief templates. run: {name, brief}, or runs:[..] in parallel; brief fully; the first run of one asks the user (a dialog) to enable it. enable: the dialog alone.",
		promptSnippet: snippet(known),
		parameters: Type.Object({
			action: Type.String({ description: "list | enable | run" }),
			name: Type.Optional(Type.String()),
			brief: Type.Optional(Brief({ description: "the template's fields" })),
			runs: Type.Optional(Type.Array(Brief())),   // [{name, brief}], checked below (a nested schema costs ~25 tokens more)
		}),
		// a brief sent as a JSON string is taken as the object
		prepareArguments: (args: any) => {
			if (args && typeof args === "object") {
				if (typeof args.brief === "string") args.brief = asBrief(args.brief) ?? args.brief;
				if (Array.isArray(args.runs)) for (const r of args.runs) if (r && typeof r.brief === "string") r.brief = asBrief(r.brief) ?? r.brief;
			}
			return args;
		},
		async execute(_id, params: any, signal, onUpdate, ctx: ExtensionContext) {
			const progress = (line: string) => onUpdate?.({ content: [{ type: "text", text: line }] });
			const action = String(params.action ?? "").trim().toLowerCase();
			if (action === "list") return text(listText(params.name || undefined), !!params.name && !find(params.name));
			if (action === "enable") {
				if (!params.name) return text(`Give the name. ${listText()}`, true);
				const why = await ensure(params.name, ctx, progress, false, signal);
				return why ? text(why, true) : text(`The ${params.name} expert is enabled.${noteOf(params.name)}`);
			}
			if (action !== "run") return text(`action is list, enable or run. ${listText()}`, true);
			const runs: { name: string; brief: unknown }[] = Array.isArray(params.runs) && params.runs.length ? params.runs : params.name ? [{ name: params.name, brief: params.brief }] : [];
			if (runs.some((r) => !r || typeof r.name !== "string")) return text("Each of runs is {name, brief}.", true);
			if (!runs.length) return text(`Give {name, brief} or runs:[{name, brief}]. ${listText()}`, true);
			if (runs.length > sub.MAX_PARALLEL) return text(`Too many parallel runs (${runs.length}); max ${sub.MAX_PARALLEL}.`, true);
			// the brief first, so the user is not asked for a run that cannot start
			for (const r of runs) {
				const s = find(r.name); if (!s) return text(unknown(r.name), true);
				const b = asBrief(r.brief); const miss = missingFields(s.expert.brief, b);
				if (!b || miss.length) return text(`Nothing ran: the brief for ${s.name} ${b ? `lacks ${miss.join(", ")}` : "must be an object of the template's fields"}. Template:\n${template(s, true)}`, true);
			}
			// an expert with a runner (software-factory) runs in this session, alone
			const engine = runs.map((r) => find(r.name)!).find((s) => s.expert.runner);
			if (engine && runs.length > 1) return text(`${engine.name} runs alone, not in runs:[..]. Nothing ran.`, true);
			for (const n of [...new Set(runs.map((r) => r.name))]) {   // one dialog at a time
				const why = await ensure(n, ctx, progress, false, signal);
				if (why) return text(runs.length > 1 ? `${why} Nothing ran.` : why, true);
			}
			if (engine) {
				const mod = await import(pathToFileURL(join(HERE, `${engine.expert.runner}.ts`)).href);
				const out = await sub.detachable(signal, _id, (sig: AbortSignal, j: { detached: boolean }) => mod.runExpert(asBrief(runs[0].brief)!, ctx, sig, (l: string) => { if (!j.detached) progress(l); }, _id), sub.backgroundAfter(ctx), 1);
				return text(out.text, out.isError);
			}
			// the call goes on when the user switches sessions mid-call (the subagents module's detachable)
			let job = { detached: false };
			const cwd = ctx.cwd;   // read now: a ctx goes stale once the session switches, and queued runs start later
			const quiet = (line: string) => { if (!job.detached) progress(line); };
			const out = await sub.detachable(signal, _id, async (sig: AbortSignal, j: { detached: boolean }) => {
				job = j;
				const all = await sub.mapLimit(runs, sub.CONCURRENCY, (r: any, i: number) => sub.runAgent(find(r.name)!, renderBrief(find(r.name)!, asBrief(r.brief)!), cwd, sig, quiet, { tool: "expert", callId: _id, mode: runs.length > 1 ? "parallel" : "single", index: i, of: runs.length }), sig);
				const results = all.filter(Boolean), skipped = all.length - results.length;
				return { text: results.map(sub.render).join("\n\n") + (skipped ? `\n\n(${skipped} queued run${skipped === 1 ? " was" : "s were"} stopped before starting.)` : ""), isError: !results.length || results.every((r: any) => r.exitCode !== 0) };
			}, sub.backgroundAfter(ctx), runs.length);
			const notes = [...new Set(runs.map((r) => r.name))].map((n) => noteOf(n).trim()).filter(Boolean);
			return text(notes.length ? `${notes.join("\n")}\n\n${out.text}` : out.text, out.isError);
		},
	});
	pi.registerCommand("experts", {
		description: "Experts: /experts [list] | <name> | enable <name> | disable <name>",
		getArgumentCompletions: (prefix: string) => {
			const words = prefix.split(/\s+/);
			// a word typed out in full offers nothing, so Enter runs the command
			if (words.length <= 1) return ["list", "enable", "disable", ...discover().map((s) => s.name)].filter((v) => v.startsWith(words[0] ?? "") && v !== words[0]).map((v) => ({ value: v, label: v }));
			return discover().map((s) => s.name).filter((n) => n.startsWith(words[1] ?? "") && n !== words[1]).map((n) => ({ value: `${words[0]} ${n}`, label: n }));
		},
		handler: async (args: string, ctx: any) => {
			const [verb = "list", name] = (args ?? "").trim().split(/\s+/).filter(Boolean);
			const say = (m: string, type: "info" | "warning" | "error" = "info") => (ctx.hasUI ? ctx.ui.notify(m, type) : console.log(m));
			if (verb === "list") return say(menuText(name));
			if (find(verb) && !name) return say(menuText(verb));
			if ((verb !== "enable" && verb !== "disable") || !name) return say("Usage: /experts [list] | <name> | enable <name> | disable <name>", "warning");
			if (!find(name)) return say(unknown(name), "warning");
			if (verb === "disable") { session.set(name, false); remember(name, false); return say(`The ${name} expert is dormant again (remembered).`); }
			const why = await ensure(name, ctx, (l) => ctx.ui?.setStatus?.("expert", l), true);
			ctx.ui?.setStatus?.("expert", undefined);
			setupNotes.delete(name);   // the setup's notification already showed it
			say(why ?? `The ${name} expert is enabled (remembered).`, why ? "error" : "info");
		},
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

