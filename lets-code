	"network-exec": [/^(curl|wget|fetch)\b.*\|\s*(sh|bash|zsh|python3?|node|perl)(\s|$)/, /^(sh|bash|zsh)\s+<\(\s*(curl|wget)/, /^(nc|ncat|netcat|telnet|nmap|masscan|socat)(\s|$)/, /^ssh\s/, /^scp\s/, /^rsync\s.*:/],
};
// readonly commands with an option or script that writes or runs something:
// not read-only, so a deny-by-default role (plan, orchestrator) denies them
const READONLY_WRITES: RegExp[] = [
	/^(sed|perl)\s+(.*\s)?(-[a-zA-Z]*i|--in-place)/, /^(find|fd)\s.*\s(-exec|-execdir|-ok|-okdir|-delete|-fprint\S*|-fls|-x|--exec|--exec-batch)(\s|$)/,
	/^awk\s.*(system\s*\(|\|\s*["']|-i\s*inplace)/, /^sort\s(.*\s)?(-o|--output)/, /^git\s.*--output/, /^(xxd\s.*\s-r|tree\s.*\s-o|uniq\s+(-\S+\s+)*[^-\s]\S*\s+[^-\s])/,
];
const ORDER: Decision[] = ["allow", "ask", "deny"];
const stricter = (a: Decision, b: Decision) => (ORDER.indexOf(a) >= ORDER.indexOf(b) ? a : b);

const BUILTIN: Manifest = {
	default: "auto",
	cycle: ["auto", "ask", "plan", "orchestrator", "yolo"],
	roles: {
		auto: { label: "auto", external: "allow", bash: { "*": "allow" }, mcp: "allow", dispatch: ["*"], network: "on" },
		ask: {
			label: "ask", external: "ask", mcp: "allow", dispatch: ["*"], network: "on",
			bash: { "*": "allow", privileged: "ask", destructive: "ask", "package-install": "ask", "network-exec": "ask" },
		},
		plan: {
			label: "plan", tools: ["read", "grep", "find", "ls", "bash", "tool_search", "codemode", "subagent", "expert", "list_mcp_resources", "read_mcp_resource"],
			write: [], external: "deny", bash: { "*": "deny", readonly: "allow" }, mcp: "deny", dispatch: ["*"], network: "off",
			prompt: "Plan mode: explore the code and run read-only commands only; edits, writes and installs are refused. Finish with a numbered list under the heading \"Plan:\" that another agent could follow, then stop. The user decides when to execute it.",
		},
		// the software factory's main session: it plans with the user and
		// hands every change to experts; it reads and dispatches, never writes.
		// The main session's only: a child that would inherit it gets the default
		orchestrator: {
