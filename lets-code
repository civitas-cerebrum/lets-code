            echo "# MANDATE=true: modes plan/auto/ask/orchestrator/yolo and roles for subagents (MODE sets"
            echo "# the start mode, empty = auto)."
            echo "# SANDBOX=true: bash confined with sandbox-runtime."
            echo "MANDATE=\"${feat_mandate}\""
            echo "MODE=\"${feat_mode}\""
            echo "SANDBOX=\"${feat_sandbox}\""
            echo ""
            echo "# Experts: subagents with their own knowledge (tester, reviewers, judge,"
            echo "# researcher, software factory, ...) behind one 'expert' tool. Each is dormant"
            echo "# until you enable it in a session (a dialog, or /experts enable;"
            echo "# remembered). On by default (with subagents); EXPERTS=false turns"
            echo "# the tool off."
            echo "EXPERTS=\"true\""
            echo ""
            echo "# Core memory: a long-term memory per project (and a global one) the"
            echo "# agent searches on demand and adds to; lets-code adds pointers to"
