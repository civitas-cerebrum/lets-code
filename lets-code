	if (/\ball\b[\w ,-]{0,40}?\b(tests?|checks?|assertions?|cases?)\b[\w ]{0,15}?\bpass(ed|es)?\b/i.test(txt) && !/\bfail(ed|ures?)?\b(?![ \t]*[=:][ \t]*0)/i.test(txt)) return 0;
