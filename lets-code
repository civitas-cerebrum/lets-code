#!/usr/bin/env bash
#
# lets-code — run an agentic coding CLI against your own self-hosted LLM server
# (vLLM, SGLang, Ollama, LM Studio, OpenRouter, or any OpenAI-compatible
# server exposing /v1/models).
#
#   lets-code setup              interactive onboarding (start here)
#   lets-code [args...]          launch pi (args pass to `pi`, e.g.
#                                `lets-code -p "hello"` for one-shot print mode)
#   lets-code --url <base> ...   one-off endpoint override
#   lets-code --model <id> ...   one-off model override
#   lets-code --context <tok>    context window (default: auto-discovered)
#   lets-code --output-cap <tok> max output tokens (default 32768)
#   lets-code --api <dialect>    openai-completions (default) | openai-responses |
#                                anthropic-messages | google-generative-ai
#   lets-code --vision ...       model accepts images (default: off)
#   lets-code --no-vision ...    force image input off (config has VISION=true)
#   lets-code --thinking-level <l> startup thinking level, default: medium
#                                (auto-detected when the resident model thinks)
#   lets-code --harness <name>   pi (default; only v1 harness) |
#                                deepseek | claude | codex (roadmap)
#   lets-code --insecure ...     skip TLS verification (self-signed certs)
#   lets-code --no-mem-guard     launch without the memory guard
#   lets-code --no-git-guard     launch without the git guard
#   lets-code --verbose ...      show endpoint probing
#
# What it does at launch:
#   1. probes your configured endpoints in order, first reachable wins
#   2. discovers the resident model, its context window, and whether it
#      thinks (a minimal test request with thinking forced on)
#   3. registers the endpoint with pi (~/.pi/agent/models.json) and reserves
#      the output budget in pi's compaction settings (settings.json), so
#      compaction fires before a response can overflow the server's window
#   4. exports LETS_CODE_TOKEN (pi resolves it via $ENV interpolation) and
#      execs:  pi --provider lets-code --model <id>
#   5. memory guard (Linux): when the machine runs low on RAM, stops the
#      largest process this session started (never anything else) instead
#      of letting it freeze the machine; pi is warned first and told why
#   6. git guard: in a git repo, work happens on a pi/* branch. lets-code
#      creates pi/<timestamp> at launch if needed (uncommitted changes come
#      along); a pi hook parses each bash command like a shell and blocks
#      edits/writes/commands aimed at a repo whose HEAD is on any other
#      branch, refuses irreversible commands (force push, branch -D, reset
#      --hard, checkout <path>, clean -f, stash drop, rm .git) on every
#      branch, and refuses writes into .git. After each successful tool
#      call it snapshots uncommitted work under refs/pi-checkpoints/ (own
#      index file; HEAD, index and branches untouched). Zero tokens unless
#      a call is blocked.
#
# Harness: pi is the default (and only v1) harness; --harness deepseek|claude|codex
# are roadmap items, not yet available.
#
# Config: ~/.config/lets-code/config   (created by `lets-code setup`)
# Env overrides: LETS_CODE_ENDPOINTS (space-separated), LETS_CODE_TOKEN,
#                LETS_CODE_CA, LETS_CODE_MODEL, LETS_CODE_CONTEXT,
#                LETS_CODE_OUTPUT_CAP, LETS_CODE_API, LETS_CODE_VISION,
#                LETS_CODE_THINKING, LETS_CODE_REASONING,
#                LETS_CODE_MEM_GUARD (true|false), LETS_CODE_GIT_GUARD (true|false),
#                LETS_CODE_GIT_CHECKPOINTS (1|0)
# Needs: bash >= 3.2 (stock macOS is fine), curl, python3, pi CLI
# (auto-installed on request).

set -eu
(set -o pipefail) 2>/dev/null && set -o pipefail   # pipefail is bash 4+; keep 3.2 alive

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lets-code"
CONFIG_FILE="${CONFIG_DIR}/config"
PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"   # pi's config home (overridable)
PROVIDER_ID="lets-code"          # fixed provider id we upsert into pi's files
DEFAULT_CONTEXT=128000
DEFAULT_OUTPUT_CAP=32768
DEFAULT_API="openai-completions"
DEFAULT_THINKING="medium"

VERBOSE=false
LOG_PREFIX="[lets-code]"
log()         { echo "${LOG_PREFIX} ${1}"; }
log_verbose() { if [ "${VERBOSE}" = "true" ]; then echo "${LOG_PREFIX} ${1}"; fi; }
log_error()   { echo "${LOG_PREFIX} ERROR: ${1}" >&2; }

# ------------------------------------------------------------------ probing
# The probe is PERMISSIVE over TLS on purpose: it runs against every
# configured endpoint (first reachable wins), so a strict check here would
# wrongly kill LAN/VPN fallbacks. Certificate trust is enforced separately,
# before launch, for the endpoint that won (see the https block in main).

tls_args_for() {
    case "$1" in
        https://*)
            if   [ -n "${CA_FOUND:-}" ];        then echo "--cacert|${CA_FOUND}"
            elif [ "${INSECURE:-false}" = true ]; then echo "-k"
            else echo "-k"   # permissive probe; trust is enforced before launch
            fi ;;
        *) echo "" ;;
    esac
}

# Endpoint normalization. Accepts "192.168.0.114/vllm", "llm.example.com",
# "http://host:8000/v1", ... A missing scheme is filled in: IP addresses,
# localhost, bare hostnames and *.local (mDNS) get http:// (no public cert
# can exist for them); other domain names get https://. A trailing / or /v1
# is dropped — the probe always hits <base>/v1/models.
normalize_endpoint() {  # normalize_endpoint <url> -> prints the normalized base URL
    local u="${1%/}" host
    u="${u%/v1}"
    case "${u}" in
        *://*) ;;
        *)
            host="${u%%/*}"
            case "${host}" in
                \[*) ;;                               # [::1]:8000 — IPv6 literal
                *) host="${host%%:*}" ;;              # strip :port
            esac
            case "${host}" in
                \[*|localhost|*.local) u="http://${u}" ;;
                *[!0-9.]*)                            # not an IPv4 address
                    case "${host}" in
                        *.*) u="https://${u}" ;;      # domain name
                        *)   u="http://${u}" ;;       # bare hostname (no dots)
                    esac ;;
                *) u="http://${u}" ;;                 # IPv4 address
            esac ;;
    esac
    printf '%s\n' "${u}"
}

normalize_endpoints() {  # normalize_endpoints "<url> <url> ..." -> space-separated
    local out="" e
    for e in $1; do out="${out:+${out} }$(normalize_endpoint "${e}")"; done
    printf '%s\n' "${out}"
}

PROBE_ERR=""
PROBE_OUT="${TMPDIR:-/tmp}/.lets-code-probe.$$"
trap 'rm -f "${PROBE_OUT}"' EXIT
probe() {  # probe <base-url> -> prints /v1/models JSON on success; PROBE_ERR explains failure
    local base="$1" tls rc; tls="$(tls_args_for "$base")"
    local IFS='|'; # shellcheck disable=SC2086
    if curl -sf --max-time 4 ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" "${base}/v1/models" 2>/dev/null; then
        PROBE_ERR=""; return 0
    else
        rc=$?
    fi
    case "${rc}" in
        6)  PROBE_ERR="DNS: cannot resolve host" ;;
        7)  PROBE_ERR="connection refused (host up, port closed?)" ;;
        28) PROBE_ERR="timed out (host unreachable / wrong IP?)" ;;
        35) PROBE_ERR="TLS handshake failed" ;;
        60) PROBE_ERR="TLS certificate not trusted" ;;
        22) local code; code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 ${tls:+$tls} \
                -H "Authorization: Bearer ${TOKEN:-dummy-key}" "${base}/v1/models" 2>/dev/null)"
            case "${code}" in
                401)         PROBE_ERR="HTTP 401: token rejected" ;;
                403)         PROBE_ERR="HTTP 403: forbidden (proxy doesn't allow this network, or bad token)" ;;
                404)         PROBE_ERR="HTTP 404: no /v1/models here (wrong base URL/path?)" ;;
                502|503|504) PROBE_ERR="HTTP ${code}: proxy is up but the model server behind it is down" ;;
                *)           PROBE_ERR="HTTP error ${code:-4xx/5xx} from server" ;;
            esac ;;
        *)  PROBE_ERR="curl exit ${rc}" ;;
    esac
    return "${rc}"
}

# Thinking probe: one minimal chat completion with thinking forced on.
# A server that reports reasoning tokens (or streams reasoning content)
# has a thinking model resident. Cost: one tiny request per launch.
# Sets THINKING_DETECTED: true | false | unknown (inconclusive).
probe_thinking() {  # probe_thinking <base-url-without-/v1> <model>
    local base="$1" model="$2" payload tls out
    payload="$(python3 -c '
import json, sys
print(json.dumps({
    "model": sys.argv[1],
    "max_tokens": 16,
    "temperature": 0,
    "chat_template_kwargs": {"enable_thinking": True},
    "messages": [{"role": "user", "content": "Reply with exactly: OK"}],
}))' "${model}" 2>/dev/null)" || { THINKING_DETECTED="unknown"; return 0; }
    tls="$(tls_args_for "${base}")"
    local IFS='|'; # shellcheck disable=SC2086
    if out="$(curl -sf --max-time 30 ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" \
        -H "Content-Type: application/json" -d "${payload}" \
        "${base}/v1/chat/completions" 2>/dev/null)"; then
        THINKING_DETECTED="$(printf '%s' "${out}" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("unknown"); sys.exit()
ch = (d.get("choices") or [{}])[0]
m = ch.get("message") or {}
usage = d.get("usage") or {}
details = usage.get("completion_tokens_details") or {}
rt = details.get("reasoning_tokens") or 0
rc = m.get("reasoning_content") or m.get("reasoning") or ""
content = m.get("content") or ""
if isinstance(rt, (int, float)) and rt > 0:
    print("true")
elif isinstance(rc, str) and rc.strip():
    print("true")
elif "think" in content.lower():
    print("true")
else:
    print("false")' 2>/dev/null)"
    else
        THINKING_DETECTED="unknown"
    fi
    case "${THINKING_DETECTED}" in
        true|false) ;;
        *) THINKING_DETECTED="unknown" ;;
    esac
}

# Suggested thinking level from context window + output cap. Level costs
# are pi's published budgets (minimal ~1k / low ~2k / medium ~8k /
# high ~16k). A level is suggested only when 4x its cost fits the window
# (pi's own model catalog follows this: 64k deployments top out at high,
# 131k just misses xhigh's 32k, 256k gets xhigh) and half the output cap
# (thinking must not eat the response budget). xhigh/max are never
# suggested: on the chat-template path pi clamps their budget to high's
# 16k, so they behave identically to high.
suggested_thinking_level() {  # suggested_thinking_level <context> <output-cap>
    local ctx="$1" cap="$2" room
    room=$(( ctx / 4 ))
    if [ $(( cap / 2 )) -lt "${room}" ]; then room=$(( cap / 2 )); fi
    if   [ "${room}" -ge 16384 ]; then echo "high"
    elif [ "${room}" -ge 8192  ]; then echo "medium"
    elif [ "${room}" -ge 2048  ]; then echo "low"
    elif [ "${room}" -ge 1024  ]; then echo "minimal"
    else echo "off"; fi
}

# ---------------------------------------------------------- pi config writes
# pi keeps its state under ~/.pi/agent (override: $PI_CODING_AGENT_DIR).
# lets-code owns exactly two slices, both keyed by the fixed provider id
# 'lets-code', so it never clobbers the user's own providers or defaults:
#   models.json   -> providers["lets-code"]
#                    (endpoint, api dialect, model, contextWindow, maxTokens,
#                     input types: ["text","image"] when vision is enabled,
#                     reasoning + chat-template thinking kwargs when thinking,
#                     + hard thinking_token_budget ceiling when thinking)
#   settings.json -> compaction.enabled = true +
#                    compaction.modelOverrides["lets-code/<model>"]
#                    .reserveTokens = output cap
#                    + modelThinkingLevels["lets-code/<model>"] = startup
#                    thinking level (when thinking is registered)
# The token is never written to disk: apiKey points at $LETS_CODE_TOKEN (pi's
# $ENV interpolation), exported at launch — the secret stays in
# ~/.config/lets-code/config (mode 600). Writes are atomic (tmp + rename),
# every other key in the files is preserved, and a corrupt file fails loudly.
pi_write_configs() {  # pi_write_configs <base> <api> <model> <context> <output-cap> <vision> <reasoning> <thinking>
    PI_AGENT_DIR="${PI_AGENT_DIR}" python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" <<'PY'
import json, os, sys, tempfile

base, api, model, context, cap, vision, reasoning, thinking = sys.argv[1:9]
agent_dir = os.environ["PI_AGENT_DIR"]
ctx = int(context)
cap = int(cap)

def upsert(path, mutate):
    doc = {}
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                doc = json.load(f)
        except Exception as exc:
            sys.exit("[lets-code] cannot parse %s: %s\n"
                     "  fix or move the file aside, then re-run lets-code." % (path, exc))
    if not isinstance(doc, dict):
        sys.exit("[lets-code] %s must contain a JSON object." % path)
    mutate(doc)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    existed = os.path.exists(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".lets-code-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, indent=2)
            f.write("\n")
        os.chmod(tmp, os.stat(path).st_mode & 0o777 if existed else 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

def to_models(doc):
    providers = doc.get("providers")
    if not isinstance(providers, dict):
        providers = {}
    compat = {"supportsDeveloperRole": False, "supportsReasoningEffort": False}
    model_doc = {
        "id": model,
        "contextWindow": ctx,
        "maxTokens": cap,
        # pi defaults a model's input to ["text"] unless declared otherwise,
        # so image support must be declared explicitly for images to pass
        "input": ["text", "image"] if vision == "true" else ["text"],
    }
    if reasoning == "true":
        # pi only offers thinking levels for models that declare reasoning.
        # The chat-template kwargs map pi's level onto the server's chat
        # template variables (vLLM/SGLang pass chat_template_kwargs through;
        # Qwen3 & friends take enable_thinking + thinking_budget).
        model_doc["reasoning"] = True
        compat["thinkingFormat"] = "chat-template"
        compat["chatTemplateKwargs"] = {
            "enable_thinking": {"$var": "thinking.enabled"},
            "thinking_budget": {"$var": "thinking.budget", "omitWhenOff": True},
        }
        # Hard ceiling on thinking tokens. The template budget above is a
        # SOFT hint the model can overthink past (observed: a 16K hint
        # spiralled to the server's 32K output cap, starving the answer).
        # thinking_token_budget is enforced engine-side by vLLM (with a
        # reasoning parser): the thinking section is force-terminated at the
        # budget and the response continues. Servers that don't know the
        # field ignore it (OpenAI-compatible servers allow extra fields),
        # and with thinking off the budget is inert (no thinking section).
        # Half the output cap, so a runaway thinker can never starve the
        # answer; with the default 32K cap this equals pi's default high
        # thinking budget, so well-behaved models see no change.
        model_doc["samplingParams"] = {
            "thinking_token_budget": max(1024, cap // 2),
        }
    providers["lets-code"] = {
        "baseUrl": base,
        "api": api,
        "apiKey": "$LETS_CODE_TOKEN",
        "compat": compat,
        "models": [model_doc],
    }
    doc["providers"] = providers

def to_settings(doc):
    compaction = doc.get("compaction")
    if not isinstance(compaction, dict):
        compaction = {}
    overrides = compaction.get("modelOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    overrides["lets-code/" + model] = {"reserveTokens": cap}
    compaction["modelOverrides"] = overrides
    compaction["enabled"] = True  # auto-compaction explicit, not pi's implicit default
    doc["compaction"] = compaction
    if reasoning == "true":
        # pi's per-model startup thinking level (global default is "medium")
        levels = doc.get("modelThinkingLevels")
        if not isinstance(levels, dict):
            levels = {}
        levels["lets-code/" + model] = thinking
        doc["modelThinkingLevels"] = levels
    elif "lets-code/" + model in (doc.get("modelThinkingLevels") or {}):
        # thinking unregistered — drop our stale level so it cannot surprise
        # a later /model rebind; other providers' entries are untouched
        levels = dict(doc["modelThinkingLevels"])
        del levels["lets-code/" + model]
        if levels:
            doc["modelThinkingLevels"] = levels
        else:
            doc.pop("modelThinkingLevels", None)

upsert(os.path.join(agent_dir, "models.json"), to_models)
upsert(os.path.join(agent_dir, "settings.json"), to_settings)
PY
}

# ------------------------------------------------------------- memory guard
# A runaway command the agent runs (an unbounded search in a test, a leaking
# build) can eat the whole machine. When that machine also hosts the model
# server, the result is minutes of swap thrash and then a global OOM kill that
# can hit the server or the desktop (2026-09-25: a pi-run unittest reached
# 26 GB twice on the box serving the model).
#
# The guard watches the machine's REMAINING RAM (MemAvailable) and acts only on
# processes this lets-code session started -- never on anything else:
#   < 20 % free   pi is warned after each tool call
#   < 10 % free   pi's new non-cleanup bash commands are blocked
#   <  5 % free   (3 s) the largest session process is stopped gracefully:
#                 other big session processes paused, SIGINT -> SIGTERM -> SIGKILL
#   < 2.5 % free  the largest session process is SIGKILLed immediately
# No memory caps: nothing is limited until the machine as a whole runs low.
# It lives in a pi extension (lets-code-memguard.ts) that runs inside pi, so
# "this session" = descendants of that pi, plus anything in the session's
# systemd user scope (orphans re-parented to PID 1 keep their scope). The scope
# (lets-code-<pid>.scope, no root needed) also sets OOMPolicy=continue: if the
# kernel OOM-kills one process, systemd's default would stop the whole session.
# A machine-wide memguard daemon (github.com/civitas-cerebrum/memguard,
# /run/memguard present) already covers lets-code sessions: the extension then
# stays out of the way. Linux only; elsewhere the guard is off.
mem_limited_ancestor() {  # prints the nearest ancestor cgroup with a finite memory.max, if any
    local rel d
    rel="$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)" || return 0
    d="/sys/fs/cgroup${rel}"
    while [ "${d}" != "/sys/fs/cgroup" ] && [ -n "${d}" ]; do
        if [ -r "${d}/memory.max" ] && [ "$(cat "${d}/memory.max")" != "max" ]; then
            echo "${d#/sys/fs/cgroup}"; return 0
        fi
        d="${d%/*}"
    done
}

mem_guard_plan() {  # sets MG_MODE (scope|process|off) and MG_NOTE
    MG_MODE=off; MG_NOTE=""
    case "${MEM_GUARD}" in false|no|0|off) MG_NOTE="disabled"; return 0 ;; esac
    if [ "$(uname -s)" != Linux ]; then MG_NOTE="not available on $(uname -s)"; return 0; fi
    MG_MODE=process   # the extension alone: this pi's descendants
    local limited
    limited="$(mem_limited_ancestor)"
    if [ -n "${limited}" ]; then
        # a user scope would move pi OUT of a cgroup that has its own memory limits
        MG_NOTE="inside memory-limited cgroup ${limited}; no session scope"; return 0
    fi
    if ! command -v systemd-run >/dev/null 2>&1; then
        MG_NOTE="systemd-run not found; no session scope"; return 0
    fi
    # one cheap probe: user manager reachable and OOMPolicy accepted on scopes (systemd >= 253)
    if ! systemd-run --user --scope --quiet --collect -p OOMPolicy=continue true >/dev/null 2>&1; then
        MG_NOTE="systemd user scopes unavailable; no session scope"; return 0
    fi
    MG_MODE=scope
}

mem_guard_exec() {  # mem_guard_exec <cmd> [args...] -- replaces this process
    if [ "${MG_MODE}" != off ]; then export LETS_CODE_SESSION=1; fi
    if [ "${MG_MODE}" = scope ]; then
        exec systemd-run --user --scope --quiet --collect --unit="lets-code-$$" \
            -p OOMPolicy=continue -- "$@"
    fi
    exec "$@"
}

# The pi extension that IS the guard. Inert unless LETS_CODE_SESSION=1 (set by
# lets-code at launch) and silent while the machine has RAM to spare.
# Rewritten when its content changes.
pi_write_memguard_extension() {
    local dir="${PI_AGENT_DIR}/extensions" f tmp
    f="${dir}/lets-code-memguard.ts"
    mkdir -p "${dir}"
    tmp="$(mktemp "${dir}/.lets-code-memguard.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (memory guard); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code (LETS_CODE_SESSION=1). Watches the
// machine's free RAM and acts only on processes this session started.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { existsSync, readFileSync, readdirSync } from "node:fs";

const ACTIVE = process.env.LETS_CODE_SESSION === "1";
// A machine-wide memguard daemon already covers lets-code sessions: defer to it.
const DEFER = existsSync("/run/memguard") && process.env.LETS_CODE_MEM_IGNORE_SYSTEM_GUARD !== "1";
const GRACE_MS = 10_000, NEED = 3, PAUSE_MIN = 512 * 2 ** 20;
const CLEANUP_OK = /^\s*(sudo\s+)?(kill|pkill|killall|ps|pgrep|top|htop|free|vmstat|cat\s+\/proc|cat\s+\/sys\/fs\/cgroup|systemctl\s+(--user\s+)?(status|show)|docker\s+(ps|stop|rm|kill)|tmux\s+kill|echo|true|sleep\s+\d)\b/;

const read = (p: string): string | null => { try { return readFileSync(p, "utf8"); } catch { return null; } };
const gib = (b: number) => `${(b / 2 ** 30).toFixed(1)} GiB`;

function meminfo(): { total: number; avail: number } {
	const t = read("/proc/meminfo") ?? "";
	const kb = (k: string) => Number(new RegExp(`^${k}:\\s+(\\d+)`, "m").exec(t)?.[1] ?? 0) * 1024;
	return { total: kb("MemTotal"), avail: kb("MemAvailable") || kb("MemFree") };
}

// Levels: % of MemTotal or sizes like 3G; env overrides are for tests.
function level(spec: string, total: number): number {
	const m = /^\s*(\d+(?:\.\d+)?)\s*([%KMGT]?)/i.exec(spec);
	if (!m) return 0;
	const n = Number(m[1]), u = m[2].toUpperCase();
	return u === "%" ? (total * n) / 100 : n * 1024 ** "BKMGT".indexOf(u || "B");
}
function levels(total: number) {
	const e = process.env;
	return {
		warn: level(e.LETS_CODE_MEM_WARN ?? "20%", total),
		critical: level(e.LETS_CODE_MEM_CRITICAL ?? "10%", total),
		stop: level(e.LETS_CODE_MEM_STOP ?? "5%", total),
		emergency: level(e.LETS_CODE_MEM_EMERGENCY ?? "2.5%", total),
	};
}
type Level = "ok" | "warn" | "critical" | "stop" | "emergency";
function levelOf(avail: number, th: ReturnType<typeof levels>): Level {
	return avail < th.emergency ? "emergency" : avail < th.stop ? "stop" : avail < th.critical ? "critical" : avail < th.warn ? "warn" : "ok";
}

type Proc = { pid: number; ppid: number; bytes: number; start: number; cmd: string; argv: string[]; cgroup: string };
function procTable(): Map<number, Proc> {
	const out = new Map<number, Proc>();
	for (const d of readdirSync("/proc")) {
		if (!/^\d+$/.test(d)) continue;
		const stat = read(`/proc/${d}/stat`), st = read(`/proc/${d}/status`), cl = read(`/proc/${d}/cmdline`);
		if (!stat || !st || !cl) continue;
		const rest = stat.slice(stat.lastIndexOf(")") + 2).split(" ");
		const kb = (k: string) => Number(new RegExp(`${k}:\\s+(\\d+)`).exec(st)?.[1] ?? 0);
		const argv = cl.split("\0").filter(Boolean);
		if (!argv.length) continue;
		out.set(Number(d), {
			pid: Number(d), ppid: Number(rest[1]), start: Number(rest[19]),
			bytes: (kb("VmRSS") + kb("VmSwap")) * 1024, argv, cmd: argv.join(" ").slice(0, 60),
			cgroup: (read(`/proc/${d}/cgroup`) ?? "").trim().split("::").pop() ?? "",
		});
	}
	return out;
}

// The agents themselves (pi, its node entry, claude, tmux) are never stopped.
function isAgent(argv: string[]): boolean {
	const base = (argv[0] ?? "").split("/").pop() ?? "";
	if (/^(pi|claude|tmux)$/.test(base)) return true;
	return /^(node|nodejs)$/.test(base) && /pi-coding-agent\//.test(argv[1] ?? "");
}

const SCOPE = /\/(lets-code-\d+\.scope)(\/|$)/.exec(read("/proc/self/cgroup") ?? "")?.[1] ?? null;

// Processes this session started: descendants of this pi, or in this session's scope.
function sessionProcs(t: Map<number, Proc>): Proc[] {
