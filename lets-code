// The experts usable here: files in ~/.pi/agent/agents (never a
// project's) that say `expert: true` and fit this platform, parsed
// ungated, so one whose setup has not run is listed as not set up.
export function discoverExperts(): AgentDef[] {
	const dir = join(AGENT_DIR, "agents"); const out: AgentDef[] = [];
	if (!existsSync(dir)) return out;
	for (const f of readdirSync(dir).sort()) {
		if (!f.endsWith(".md")) continue;
		try { const a = parseAgentFile(readFileSync(join(dir, f), "utf8"), join(dir, f), "user", undefined, false, true); if (a?.expert && platformOk(a.expert.platform) && !out.some((x) => x.name === a.name)) out.push(a); } catch { /* skip bad file */ }
	}
