# The drawing side of the subagent sessions (the picker, the footer list,
# the live part of a running child's session), next to subagents.ts, which
# loads it; the index never loads it on its own.
pi_write_subagent_view_extension() {  # pi_write_subagent_view_extension <dir>
    local dir="$1" f tmp
    f="${dir}/subagent-view.ts"
    tmp="$(mktemp "${dir}/.subagent-view.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (subagents: the session view's parts); regenerated on launch, edits are overwritten.
// The drawing side of the subagent sessions, loaded by subagents.ts (the
// index never loads it on its own): the formatting of a run, the footer
// list, which is also the navigator (alt+s, /subagents) that switches the
// TUI into a run's own pi session and back, and the live part of a running
// child's session (the message on its way, which its session file does not
// have yet), drawn with pi's own message and tool components
// (UserMessageComponent, AssistantMessageComponent, ToolExecutionComponent
// with the built-in tools' renderers) when they load, else with the plain
// renderer below (same content, simpler look). Nothing here reaches the
// model. No runtime imports: pi's parts come in through piDeps(), so the
// module also loads where pi is not installed (tests).

type Run = any;
type Ev = any;
export interface Theme { fg(color: string, text: string): string; bold?(text: string): string; italic?(text: string): string }
export interface PiParts { UserMessageComponent: any; AssistantMessageComponent: any; ToolExecutionComponent: any; getMarkdownTheme?(): any; tools: Record<string, ((cwd: string) => any) | undefined> }
export interface Deps {
	matchesKey(data: string, key: string): boolean;
	visibleWidth(s: string): number;
	truncateToWidth(s: string, w: number): string;
	wrap(s: string, w: number): string[];
	pi?: PiParts;
}

// ------------------------------------------------------------------ plain helpers (no pi)
const ANSI = /\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[PX^_][^\x1b]*\x1b\\/g;
export function plainWidth(s: string): number { return [...s.replace(ANSI, "")].length; }
export function plainTruncate(s: string, w: number): string {
	if (plainWidth(s) <= w) return s;
	let out = "", seen = 0, i = 0;
	const limit = Math.max(0, w - 1);
	while (i < s.length) {
		ANSI.lastIndex = i;
		const m = ANSI.exec(s);
		if (m && m.index === i) { out += m[0]; i += m[0].length; continue; }
		const ch = String.fromCodePoint(s.codePointAt(i)!);
		if (seen >= limit) break;
		out += ch; seen++; i += ch.length;
	}
	return `${out}${w > 0 ? "…" : ""}\x1b[0m`;
}
// plain text (no ANSI) onto lines of at most w columns, words kept whole when they fit
export function plainWrap(s: string, w: number): string[] {
	const out: string[] = [];
	const width = Math.max(1, w);
	for (const raw of String(s).replace(/\t/g, "    ").split("\n")) {
		if (!raw.trim()) { out.push(""); continue; }
		let line = "";
		for (const word of raw.split(/(\s+)/)) {
			if (!word) continue;
			if ([...line].length + [...word].length <= width) { line += word; continue; }
			if (line.trim()) out.push(line.replace(/\s+$/, ""));
			line = /^\s+$/.test(word) ? "" : word;
			while ([...line].length > width) { const cs = [...line]; out.push(cs.slice(0, width).join("")); line = cs.slice(width).join(""); }
		}
		if (line.trim()) out.push(line.replace(/\s+$/, ""));
	}
	return out;
}
const SEQ: Record<string, string[]> = {
	escape: ["\x1b"], enter: ["\r", "\n"], tab: ["\t"], "shift+tab": ["\x1b[Z"], space: [" "],
	up: ["\x1b[A", "\x1bOA"], down: ["\x1b[B", "\x1bOB"], right: ["\x1b[C", "\x1bOC"], left: ["\x1b[D", "\x1bOD"],
	home: ["\x1b[H", "\x1b[1~", "\x1bOH"], end: ["\x1b[F", "\x1b[4~", "\x1bOF"],
	"alt+enter": ["\x1b\r"], "alt+up": ["\x1b[1;3A", "\x1b\x1b[A"],
};
// the raw sequences of the keys the picker uses (pi's matchesKey replaces it inside pi)
export function plainMatchesKey(data: string, key: string): boolean {
	if (SEQ[key]) return SEQ[key].includes(data);
	const alt = /^alt\+(.)$/.exec(key); if (alt) return data === `\x1b${alt[1]}`;
	const ctrl = /^ctrl\+([a-z])$/.exec(key); if (ctrl) return data === String.fromCharCode(ctrl[1].charCodeAt(0) - 96);
	return key.length === 1 && data === key;
}
export function plainDeps(): Deps { return { matchesKey: plainMatchesKey, visibleWidth: plainWidth, truncateToWidth: plainTruncate, wrap: plainWrap }; }
// pi's key parser (Kitty protocol included), width helpers and components, each
// piece falling back on its own when it does not load
export async function piDeps(): Promise<Deps> {
	const d = plainDeps();
	try {
		const t: any = await import("@earendil-works/pi-tui");
		if (typeof t.matchesKey === "function") d.matchesKey = (data, key) => t.matchesKey(data, key);
		if (typeof t.visibleWidth === "function") d.visibleWidth = (s) => t.visibleWidth(s);
		if (typeof t.truncateToWidth === "function") d.truncateToWidth = (s, w) => t.truncateToWidth(s, w);
		if (typeof t.wrapTextWithAnsi === "function") d.wrap = (s, w) => t.wrapTextWithAnsi(s, w);
	} catch { /* plain helpers */ }
	try {
		const p: any = await import("@earendil-works/pi-coding-agent");
		if (p.UserMessageComponent && p.AssistantMessageComponent && p.ToolExecutionComponent)
			d.pi = { UserMessageComponent: p.UserMessageComponent, AssistantMessageComponent: p.AssistantMessageComponent, ToolExecutionComponent: p.ToolExecutionComponent, getMarkdownTheme: p.getMarkdownTheme,
				tools: { read: p.createReadToolDefinition, bash: p.createBashToolDefinition, edit: p.createEditToolDefinition, write: p.createWriteToolDefinition, grep: p.createGrepToolDefinition, find: p.createFindToolDefinition, ls: p.createLsToolDefinition } };
	} catch { /* plain renderer */ }
	return d;
}

// ------------------------------------------------------------------ formatting
export function compact(n: number): string {
	if (n < 1000) return String(n);
	if (n < 10_000) return `${(n / 1000).toFixed(1)}k`;
	if (n < 1_000_000) return `${Math.round(n / 1000)}k`;
	return `${(n / 1_000_000).toFixed(1)}M`;
}
export function elapsed(ms: number): string {
	const t = Math.max(0, Math.floor(ms / 1000));
	if (t < 60) return `${t}s`;
	if (t < 3600) return `${Math.floor(t / 60)}m ${String(t % 60).padStart(2, "0")}s`;
	return `${Math.floor(t / 3600)}h ${String(Math.floor((t % 3600) / 60)).padStart(2, "0")}m`;
}
export const runMs = (r: Run, now: number) => (r.ended ?? (r.status === "running" ? now : r.started)) - r.started;
export const MARK: Record<string, string> = { running: "●", done: "✓", failed: "✗", aborted: "■", timeout: "✗" };
export const COLOR: Record<string, string> = { running: "accent", done: "success", failed: "error", aborted: "warning", timeout: "error" };
export function statusLabel(r: Run): string {
	if (r.status === "failed") return r.exitCode ? `failed (exit ${r.exitCode})` : "failed";
	return ({ running: "running", done: "done", aborted: "stopped", timeout: "timed out" } as Record<string, string>)[r.status] ?? String(r.status);
}
export const tokens = (r: Run) => (r.input || 0) + (r.output || 0) + (r.live || 0);
const io = (r: Run) => `↑${compact(r.input || 0)} ↓${compact((r.output || 0) + (r.live || 0))}`;
// running first (in the order they started), then the finished ones, newest first
export function order(runs: Run[]): Run[] {
	const live = runs.filter((r) => r.status === "running").sort((a, b) => a.started - b.started);
	const rest = runs.filter((r) => r.status !== "running").sort((a, b) => (b.ended ?? b.started) - (a.ended ?? a.started));
	return [...live, ...rest];
}
// one line of the task: an expert's brief loses its preamble and headings
export function summary(task: string): string {
	return String(task ?? "").replace(/^Brief for the [\w.-]+ expert\.\s*/, "").replace(/^#+\s*[^\n]*\n/gm, "").replace(/\s+/g, " ").trim();
}
const ident: Theme = { fg: (_c, s) => s };
const pad = (s: string, w: number, deps: Deps) => s + " ".repeat(Math.max(0, w - deps.visibleWidth(s)));
const cutTo = (s: string, w: number, deps: Deps) => (w <= 0 ? "" : deps.visibleWidth(s) <= w ? s : deps.truncateToWidth(s, w));

// ------------------------------------------------------------------ the footer list (and navigator)
// The session's runs in the footer, the main session first: one line each
// (mark, name, task on wide terminals, elapsed time, tokens; under
// TASK_MIN_WIDTH the task goes, under NARROW_WIDTH one total for the
// tokens), then one line of keys. The open session is marked ▸. With
// `selected` the list is navigating: ❯ marks the selected row and the last
// line has the keys. With more than SHORT_RUNS runs the short list has the
// first SHORT_RUNS - 1 of them and a "N more" row, which (enter) opens the
// whole list (expanded) as a menu; esc goes back to the short one. The whole
// list has at most FOOTER_ROWS rows; with more, a window around the
// selection (or the first rows), and the last line says how many more.
export const SHORT_RUNS = 3;
export const FOOTER_ROWS = 6;
export const TASK_MIN_WIDTH = 100;
export const NARROW_WIDTH = 72;
export interface NavRow { kind: "main" | "run" | "more"; id?: string }
// an expert's name without "expert-": the list says which agent, not what kind
export const shownName = (agent: string) => String(agent ?? "").replace(/^expert-/, "");
const isShort = (runs: Run[], expanded?: boolean) => !expanded && runs.length > SHORT_RUNS;
export function navRows(runs: Run[], expanded = false): NavRow[] {
	const rs = order(runs).map((r) => ({ kind: "run" as const, id: r.id }));
	return [{ kind: "main" }, ...(isShort(runs, expanded) ? [...rs.slice(0, SHORT_RUNS - 1), { kind: "more" as const }] : rs)];
}
export function footerLines(runs: Run[], o: { width: number; now: number; current?: string; selected?: number; confirm?: boolean; key?: string; theme?: Theme; deps?: Deps; expanded?: boolean }): string[] {
	const all = order(runs);
	if (!all.length) return [];
	const shortList = isShort(runs, o.expanded), hidden = shortList ? all.length - (SHORT_RUNS - 1) : 0;
	const rs = shortList ? all.slice(0, SHORT_RUNS - 1) : all;
	const th = o.theme ?? ident, deps = o.deps ?? plainDeps(), W = Math.max(20, o.width);
	const nav = o.selected !== undefined, total = rs.length + 1 + (shortList ? 1 : 0), cur = o.current ?? "main";
	const sel = nav ? Math.max(0, Math.min(o.selected!, total - 1)) : -1;
	const start = total <= FOOTER_ROWS ? 0 : nav ? Math.max(0, Math.min(sel - Math.floor(FOOTER_ROWS / 2), total - FOOTER_ROWS)) : 0;
	const end = Math.min(total, start + FOOTER_ROWS);
	const nw = Math.min(W < NARROW_WIDTH ? 12 : 16, Math.max(4, ...rs.map((r) => shownName(r.agent).length)));
	const lines: string[] = [];
	for (let i = start; i < end; i++) {
		if (shortList && i === total - 1) {   // the "N more" row: enter opens the whole list
			const selRow = i === sel, t = selRow ? ident : th;
			const row = ` ${t.fg("muted", "…")} ${pad(`${hidden} more`, nw, deps)}${W < NARROW_WIDTH ? "" : `  ${t.fg("dim", nav ? "enter: all runs" : `${all.filter((r) => r.status === "running").length} running`)}`}`;
			const line = cutTo(row, W, deps); lines.push(selRow ? th.fg("accent", line) : line);
			continue;
		}
		const r = i === 0 ? undefined : rs[i - 1];
		const here = r ? r.id === cur : cur === "main";
		// the selected row: the whole line in the theme's accent (pi's SelectList colour,
		// no background, no marker of its own); every row keeps its glyphs, the others their colours
		const selRow = i === sel, t = selRow ? ident : th;
		const lead = here ? t.fg("accent", "▸") : " ";
		const mark = r ? t.fg(COLOR[r.status] ?? "dim", MARK[r.status] ?? "?") : t.fg("muted", "◂");
		const nameS = pad(cutTo(r ? shownName(r.agent) : "main", nw, deps), nw, deps);
		// not focused: names dim, nothing looks selectable
		const name = !nav ? th.fg("muted", nameS) : nameS;
		const push = (row: string) => { const line = cutTo(row, W, deps); lines.push(selRow ? th.fg("accent", line) : line); };
		if (!r) {
			const what = W < TASK_MIN_WIDTH ? "" : `  ${t.fg("muted", "the main session")}`;
			push(`${lead}${mark} ${name}${what}`);
			continue;
		}
		const time = elapsed(runMs(r, o.now));
		if (W < NARROW_WIDTH) { push(`${lead}${mark} ${name} ${t.fg("dim", `${time} · ${compact(tokens(r))}`)}`); continue; }
		const tail = `${t.fg("dim", time.padStart(7))}  ${t.fg("dim", io(r).padStart(13))}`;
		if (W < TASK_MIN_WIDTH) { push(`${lead}${mark} ${name}  ${tail}`); continue; }
		const tw = W - (2 + 1 + nw + 2 + 2 + 7 + 2 + 13);
		push(`${lead}${mark} ${name}  ${t.fg("muted", pad(cutTo(summary(r.task) || "(no task)", tw, deps), tw, deps))}  ${tail}`);
	}
	const above = start, below = total - end;
	const more = above || below ? `${above ? `↑${above} ` : ""}${below ? `↓${below} ` : ""}more · ` : "";
	const selRun = sel > 0 && sel <= rs.length ? rs[sel - 1] : undefined;
	let keys: string;
	if (nav && o.confirm && selRun) keys = th.fg("warning", `Stop ${shownName(selRun.agent)}? x again stops it`);
	else if (nav) keys = th.fg("accent", `${more}↑↓ select · enter ${shortList && sel === total - 1 ? "all runs" : "switch"}${selRun?.status === "running" ? " · x stop" : ""} · esc ${o.expanded && all.length > SHORT_RUNS ? "short list" : "back"}`);
	else keys = th.fg("dim", `${more}↓ or ${o.key ?? "alt+s"}: switch session`);
	lines.push(cutTo(keys, W, deps));
	return lines;
}

// ------------------------------------------------------------------ the part on its way
// What of a run its session file does not hold yet, given what the open
// session loaded: the task when the file had no user message, assistant
// messages past the ones loaded, tool calls whose result is not in the
// file (one whose call is, pi already draws as pending: shown here only
// once its output streams); a note when nothing after it is in the file.
export interface Loaded { users: number; assistants: number; results: Set<string>; calls: Set<string> }
export function loadedOf(entries: any[]): Loaded {
	const l: Loaded = { users: 0, assistants: 0, results: new Set(), calls: new Set() };
	for (const e of entries ?? []) {
		if (e?.type !== "message") continue;
		const m = e.message ?? {};
		if (m.role === "user") l.users++;
		else if (m.role === "assistant") { l.assistants++; for (const c of Array.isArray(m.content) ? m.content : []) if (c?.type === "toolCall" && c.id) l.calls.add(String(c.id)); }
		else if (m.role === "toolResult" && m.toolCallId) l.results.add(String(m.toolCallId));
	}
	return l;
}
export function tailEvents(r: Run, loaded: Loaded): Ev[] {
	const evs: Ev[] = r?.events ?? [];
	let users = 0, assistants = 0;
	const skip = evs.map((ev) => {
		if (ev.t === "user") return ++users <= loaded.users;
		if (ev.t === "assistant") return ev.done && ++assistants <= loaded.assistants;
		if (ev.t === "tool") return loaded.results.has(String(ev.id)) || (!ev.done && !ev.output && loaded.calls.has(String(ev.id)));
		return undefined;   // a note: decided below
	});
	// a note shows when nothing after it is in the file already
	for (let i = evs.length - 1, later = false; i >= 0; i--) {
		if (skip[i] === undefined) skip[i] = later;
		else if (skip[i] && (evs[i].t !== "tool" || loaded.results.has(String(evs[i].id)))) later = true;
	}
	return evs.filter((_e, i) => !skip[i]);
}

// ------------------------------------------------------------------ transcript
export interface Flags { expanded: boolean; thinking: boolean }
function argSummary(name: string, a: any): string {
	if (!a || typeof a !== "object") return "";
	const s = (v: unknown) => String(v ?? "").replace(/\s+/g, " ").trim();
	if (name === "bash") return s(a.command);
	if (name === "grep" || name === "find") return [s(a.pattern), s(a.path)].filter(Boolean).join(" in ");
	if (a.path !== undefined) return s(a.path) + (name === "read" && (a.offset || a.limit) ? `:${a.offset ?? 1}${a.limit ? `+${a.limit}` : ""}` : "");
	try { return s(JSON.stringify(a)); } catch { return ""; }
}
export const TOOL_PREVIEW = 6;
// one event as plain lines (no pi components): the fallback, and the tests' view
export function plainEvent(ev: Ev, width: number, flags: Flags, th: Theme = ident, deps: Deps = plainDeps()): string[] {
	const W = Math.max(10, width), out: string[] = [];
	const it = (s: string) => (th.italic ? th.italic(s) : s);
	const bold = (s: string) => (th.bold ? th.bold(s) : s);
	if (ev.t === "user") {
		plainWrap(ev.text, W - 2).forEach((l, i) => out.push(`${th.fg("accent", i ? " " : "›")} ${l}`));
	} else if (ev.t === "assistant") {
		for (const b of ev.blocks ?? []) {
			if (b.type === "thinking" && b.text?.trim()) {
				if (flags.thinking) plainWrap(b.text.trim(), W - 2).forEach((l) => out.push(`  ${th.fg("dim", it(l))}`));
				else out.push(`  ${th.fg("dim", it("Thinking…"))}`);
			} else if (b.type === "text" && b.text?.trim()) {
				for (const l of plainWrap(b.text.trim(), W - 2)) out.push(`  ${l}`);
			}
		}
		if (ev.error) for (const l of plainWrap(`Error: ${ev.error}`, W - 2)) out.push(`  ${th.fg("error", l)}`);
		if (!ev.done && !out.length) out.push(`  ${th.fg("dim", "…")}`);
	} else if (ev.t === "tool") {
		const color = !ev.done ? "accent" : ev.isError ? "error" : "success";
		out.push(cutTo(`${th.fg(color, "●")} ${bold(ev.name)} ${th.fg("muted", argSummary(ev.name, ev.args))}`, W, deps));
		const lines = String(ev.output ?? "").replace(/\s+$/, "").split("\n").filter((l, i, a) => a.length > 1 || l);
		if (!lines.length || (lines.length === 1 && !lines[0])) { if (!ev.done) out.push(`  ${th.fg("dim", "running…")}`); }
		else {
			const shown = (flags.expanded && ev.done) || lines.length <= TOOL_PREVIEW ? lines : ev.name === "bash" ? lines.slice(-TOOL_PREVIEW) : lines.slice(0, TOOL_PREVIEW);
			const more = lines.length - shown.length;
			if (more && ev.name === "bash") out.push(`  ${th.fg("dim", `… ${more} earlier line${more === 1 ? "" : "s"}`)}`);
			for (const l of shown) out.push(cutTo(`  ${th.fg(ev.isError ? "error" : "dim", l.replace(/\t/g, "    "))}`, W, deps));
			if (more && ev.name !== "bash") out.push(`  ${th.fg("dim", `… ${more} more line${more === 1 ? "" : "s"}`)}`);
		}
	} else if (ev.t === "note") {
		for (const l of plainWrap(ev.text, W - 2)) out.push(`  ${th.fg(ev.error ? "error" : "dim", l)}`);
	}
	return out;
}

// Each event drawn once per (version, width, flags): with pi's components when
// they are there (as the main view draws the same messages), else plainEvent.
export class Transcript {
	deps: Deps; theme: Theme; tui: any;
	cache = new Map<object, { key: string; lines: string[] }>();
	piFailed = false;
	constructor(deps: Deps, theme: Theme, tui: any) { this.deps = deps; this.theme = theme; this.tui = tui; }
	clear() { this.cache.clear(); }
	lines(evs: Ev[], r: Run, width: number, flags: Flags): string[] {
		const out: string[] = [];
		const pi = this.deps.pi && !this.piFailed;
		for (const ev of evs) {
			const ls = this.event(ev, r, width, flags);
			if (!ls.length) continue;
			if (!pi && out.length) out.push("");
			out.push(...ls);
		}
		return out;
	}
	event(ev: Ev, r: Run, width: number, flags: Flags): string[] {
		// a running tool's clock moves: drawn again once a second
		const key = `${ev.v ?? 0}|${width}|${flags.expanded ? 1 : 0}|${flags.thinking ? 1 : 0}|${this.piFailed ? 0 : 1}|${ev.t === "tool" && !ev.done ? Math.floor(Date.now() / 1000) : ""}`;
		const hit = this.cache.get(ev);
		if (hit && hit.key === key) return hit.lines;
		let lines: string[] | undefined;
		if (this.deps.pi && !this.piFailed) {
			try { lines = this.piEvent(ev, r, width, flags); } catch { this.piFailed = true; this.cache.clear(); }
		}
		lines ??= plainEvent(ev, width, flags, this.theme, this.deps);
		this.cache.set(ev, { key, lines });
		return lines;
	}
	piEvent(ev: Ev, r: Run, width: number, flags: Flags): string[] {
		const p = this.deps.pi!;
		const md = p.getMarkdownTheme?.();
		if (ev.t === "user") return new p.UserMessageComponent(ev.text, md).render(width);
		if (ev.t === "assistant") {
			const content = (ev.blocks ?? []).map((b: any) => b.type === "thinking" ? { type: "thinking", thinking: b.text ?? "" }
				: b.type === "toolCall" ? { type: "toolCall", id: b.id ?? "", name: b.name ?? "", arguments: b.args ?? {} } : { type: "text", text: b.text ?? "" });
			const msg = { role: "assistant", content, stopReason: ev.stop ?? (ev.done ? "stop" : undefined), errorMessage: ev.error, timestamp: ev.at };
			const c = new p.AssistantMessageComponent(undefined, !flags.thinking, md);
			c.updateContent(msg, !ev.done);
			return c.render(width);
		}
		if (ev.t === "tool") {
			const def = p.tools[ev.name]?.(r.cwd || process.cwd());
			const c = new p.ToolExecutionComponent(ev.name, ev.id || `call-${ev.at}`, ev.args ?? {}, { showImages: false }, def, this.tui, r.cwd || process.cwd());
			// the tool's own clock (bash shows Elapsed / Took), not this component's
			const st = c.rendererState;
			if (st && typeof st === "object") { st.startedAt = ev.at; if (ev.done) st.endedAt = ev.end ?? ev.at; }
			c.markExecutionStarted?.(); c.setArgsComplete?.();
			if (ev.done || ev.output) c.updateResult({ content: [{ type: "text", text: ev.output ?? "" }], details: ev.details, isError: !!ev.isError }, !ev.done);
			c.setExpanded?.(flags.expanded && ev.done);
			const lines = c.render(width);   // it brings its own spacer, as in the main view
			// a running tool's renderer starts a timer to redraw itself; this component is thrown away
			if (st?.interval) { clearInterval(st.interval); st.interval = undefined; }
			return lines;
		}
		return ["", ...plainEvent(ev, width, flags, this.theme, this.deps)];
	}
}

// The live widget of a run's session: the part on its way, then one line
// while the run works (its clock and tokens: the session file has neither).
export function liveLines(r: Run, loaded: Loaded, o: { width: number; now: number; transcript?: Transcript; theme?: Theme; deps?: Deps; flags?: Flags; queued?: { text: string; kind: string }[]; added?: { has(e: object): boolean } }): string[] {
	if (!r) return [];
	const th = o.theme ?? ident, deps = o.deps ?? plainDeps(), W = Math.max(20, o.width);
	const flags = o.flags ?? { expanded: false, thinking: false };   // thinking collapsed, as pi shows it
	// what is already in the chat (added there as it completed) is not drawn again
