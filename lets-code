	toolResult(name: string, isError: boolean, text: string, path = ""): number | null {
		let failing = name === "bash" ? testStatus(text) : null;
		// a run of a test file with no recognisable summary: its exit status and output decide
		// (seen in benchmark wave 10: "all inline tests passed", or a bare AssertionError traceback)
		if (failing === null && name === "bash" && TEST_RUN_RE.test(this.lastCommand)) {
			if (!isError && /\bpass(ed|es)?\b|\bOK\b/i.test(text) && !/\bFAIL|\bError\b/.test(text)) failing = 0;
