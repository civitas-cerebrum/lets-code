		const c = g[i];
		if (c === "*" && g[i + 1] === "*") { if (g[i + 2] === "/") { s += "(?:.*/)?"; i += 2; } else { s += ".*"; i++; } }
		else if (c === "*") s += "[^/]*";
		else if (c === "?") s += "[^/]";
		else s += c.replace(/[.+^${}()|[\]\\]/g, "\\$&");
