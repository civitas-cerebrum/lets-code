    return 0


def browser_pss():
    """MB of proportional memory of the session's processes (Chromium and the CLI's daemon)."""
    kb = 0
    for p in os.listdir("/proc") if os.path.isdir("/proc") else []:
        if not p.isdigit():
            continue
        try:
            cmd = open(f"/proc/{p}/cmdline", "rb").read().replace(b"\0", b" ").decode("utf-8", "replace")
            if PROFILE in cmd or ("cliDaemon" in cmd and RT in cmd):
                for line in open(f"/proc/{p}/smaps_rollup"):
                    if line.startswith("Pss:"):
                        kb += int(line.split()[1])
        except OSError:
            pass
    return kb // 1024


