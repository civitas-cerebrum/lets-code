			const f = join(root2, d, `${run[1]}.json`); if (!existsSync(f)) continue;
			try { const rec = JSON.parse(readFileSync(f, "utf8")); return short([`${rec.kind ?? "subagent"} ${rec.agent} (${rec.status}), ${day(rec.started)}, ${rec.turns ?? 0} turns`, `task: ${short(oneLine(rec.task ?? ""), 400)}`, `record: ${f}`, rec.sessionFile ? `session: ${rec.sessionFile}` : "", rec.final ? `reply:\n${rec.final}` : ""].filter(Boolean).join("\n"), OPEN_CAP); } catch { return `Run record ${f} is unreadable.`; }
