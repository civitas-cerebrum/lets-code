	const backFrom = (from: string, mode: string) => (from && from !== mode && manifest.roles[from] ? from
		: ACTIVE ? (manifest.default && manifest.default !== mode ? manifest.default : "auto") : "");
	// into the orchestrator (a factory run, /orchestrator, /mode), and back out
	function orchestrate(ctx: ExtensionContext | undefined, reason = ""): boolean {
		if (on && roleName === "orchestrator") return false;
		// back to an orchestrator plan was entered from: no pointer back to plan (no loop)
		if (on && roleName === "plan" && planFrom === "orchestrator") planFrom = "";
		else before = on ? roleName : "";
		goTo(ctx, "orchestrator");
		log("orchestrate", { reason, from: before || "off" });
		if (reason && ctx?.hasUI) ctx.ui.notify(`mode: orchestrator (${reason}): experts make the changes; /orchestrator leaves it`, "info");
		return true;
	}
	function leave(ctx: ExtensionContext | undefined): void {
		const back = backFrom(before, "orchestrator"); before = ""; goTo(ctx, back);
	}
	// into plan mode, and back to the mode it was entered from
	function enterPlan(ctx: ExtensionContext | undefined): void {
		if (on && roleName === "plan") return;
		// back to a plan the orchestrator was entered from: likewise
		if (on && roleName === "orchestrator" && before === "plan") before = "";
		else planFrom = on ? roleName : "";
		goTo(ctx, "plan");
	}
	function leavePlan(ctx: ExtensionContext | undefined): void {
		const back = backFrom(planFrom, "plan"); planFrom = ""; goTo(ctx, back);
	}
	const why = () => (roleName === "orchestrator" ? " The orchestrator delegates: hand it to an expert." : " Switch with /mode, or ask the user.");

	// ok: the Claude Code adapter already allowed this call (an allow rule, a
	// hook, or the user's answer to its ask): no second question; deny stays deny
	async function decide(ctx: ExtensionContext, d: Decision, key: string, what: string, ok = false): Promise<{ block: true; reason: string } | undefined> {
		if (d === "allow") return undefined;
		if (d === "deny") { log("deny", { key, what }); return { block: true, reason: short(`mandate(${roleName}): ${what} is not allowed in this mode.${why()}`) }; }
		if (ok || allowedForSession.has(key)) return undefined;
		// a subagent does not ask the user (its dialogs would reach the user
		// past the orchestrator): what needs approval is refused, for its report
		if (subagentDepth > 0) { log("deny", { key, what, why: "subagent" }); return { block: true, reason: short(`mandate(${roleName}): ${what} needs the user's approval, and a subagent does not ask the user: do without it, or name it in your report.`) }; }
		if (!ctx.hasUI) { log("deny", { key, what, why: "no-ui" }); return { block: true, reason: short(`mandate(${roleName}): ${what} needs approval and no one can be asked in this mode.`) }; }
		const choice = await ctx.ui.select(`mandate (${roleName}): ${what}\n\nAllow?`, ["Allow once", "Allow for this session", "Deny"]);
		if (choice === "Allow for this session") allowedForSession.add(key);
		if (choice === "Allow once" || choice === "Allow for this session") { log("allow", { key, what, choice }); return undefined; }
		log("deny", { key, what, why: "user" });
		return { block: true, reason: short(`mandate(${roleName}): the user did not approve: ${what}`) };
	}

	pi.on("session_start", async (_e, ctx) => { cwd = ctx.cwd; allowedForSession = new Set(); askedPlan = ""; reload(ctx); });
	pi.on("project_trust", async (_e, ctx) => reload(ctx));

	pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (sections && typeof sections === "object") { if (on && role.prompt && !role.bypass) sections.lets_code_mandate = role.prompt; else delete sections.lets_code_mandate; }
		return undefined;
	});

	pi.on("tool_call", async (event, ctx) => {
		if (!on || role.bypass) return undefined;
		const name = event.toolName; const input: any = event.input ?? {};
		const ok = (globalThis as any).__letsCodeClaudeApproved?.has?.(event.toolCallId) === true;
		if (role.tools && !role.tools.includes(name) && !name.startsWith("mcp__")) return { block: true, reason: short(`mandate(${roleName}): tool '${name}' is not available in this mode${roleName === "orchestrator" ? `.${why()}` : ` (${role.tools.join(", ")}).`}`) };
		if (name.startsWith("mcp__")) return decide(ctx, mcpDecision(role, name), `mcp:${name.split("__")[1]}`, `MCP call ${name}`, ok);
		if (name === "edit" || name === "write") {
			const p = String(input.path ?? "");
			if (isProtected(p, role, ctx.cwd)) { log("deny", { key: "protected", what: p }); return { block: true, reason: short(`mandate(${roleName}): '${p}' is a protected path and is never written.`) }; }
			if (!inScope(p, role.write ?? ["."], ctx.cwd)) return decide(ctx, role.external ?? "ask", "external", `write outside the project: ${p}`, ok);
			return undefined;
		}
		if (name === "read" || name === "ls" || name === "grep" || name === "find") {
			const p = String(input.path ?? input.dir ?? ".");
			if (role.read && !inScope(p, role.read, ctx.cwd)) return decide(ctx, role.external ?? "ask", "external", `read outside the allowed paths: ${p}`, ok);
			return undefined;
		}
		if (name === "bash") {
			const cmd = String(input.command ?? "");
			const c = classify(cmd, role);
			if (c.decision !== "allow") { const r = await decide(ctx, c.decision, `bash:${c.group}`, `${c.group} command: ${short(c.command, 80)}`, ok); if (r) return r; }
			for (const t of redirectTargets(cmd)) {
				if (isProtected(t, role, ctx.cwd)) { log("deny", { key: "protected", what: t }); return { block: true, reason: short(`mandate(${roleName}): '${t}' is a protected path and is never written.`) }; }
				if (!inScope(t, role.write ?? ["."], ctx.cwd)) { const r = await decide(ctx, role.external ?? "ask", "external", `write outside the project: ${t}`, ok); if (r) return r; }
			}
			return undefined;
		}
		if (name === "subagent" || (name === "expert" && input.action === "run")) {
			const agents = (name === "expert" ? [input.name, ...(Array.isArray(input.runs) ? input.runs : []).map((r: any) => r?.name)]
				: [input.agent, ...(input.tasks ?? []).map((t: any) => t?.agent), ...(input.chain ?? []).map((t: any) => t?.agent)]).filter(Boolean) as string[];
			const bad = agents.find((a) => !mayDispatch(role, a));
			if (bad) { log("deny", { key: "dispatch", what: bad }); return { block: true, reason: short(roleName === "orchestrator" ? `mandate(orchestrator): not the '${bad}' agent: code goes through software-factory (a subagent only for setup and checks).` : `mandate(${roleName}): this role may not start the '${bad}' agent (allowed: ${(role.dispatch ?? ["*"]).join(", ")}).`) }; }
		}
		return undefined;
	});

	// --- commands and shortcuts (main session only; a subagent keeps its role)
	if (subagentDepth > 0 || process.env.LETS_CODE_ROLE) return;
	// the live mode for the subagent tool ("" unrestricted): a child started
	// in plan mode runs read-only
	(globalThis as any).__letsCodeMode = () => (on ? roleName : "");
	if (ACTIVE || ORCHESTRATOR) {
		// the factory module engages the orchestrator when a run starts or resumes
		(globalThis as any).__letsCodeOrchestrate = (ctx: ExtensionContext | undefined, reason?: string) => orchestrate(ctx, reason);
		pi.registerCommand("orchestrator", {
			description: "Toggle orchestrator mode: plan and dispatch experts, change no file yourself",
			handler: async (_args, ctx) => {
				if (on && roleName === "orchestrator") { leave(ctx); ctx.ui.notify(on ? `mode: ${roleName}` : "orchestrator mode off", "info"); return; }
				orchestrate(ctx); ctx.ui.notify("mode: orchestrator", "info");
			},
		});
	}
	// plan mode: read-only until the user approves the plan
	const EXECUTE = "Execute the plan you wrote above, step by step. Run the tests after each step and report what changed.";
	function runPlan(plan: string) {
		try { (pi as any).appendEntry?.("lets-code-plan", { plan, at: new Date().toISOString() }); } catch { /* never fatal */ }
		log("plan", { chars: plan.length });
		pi.sendUserMessage(EXECUTE, { deliverAs: "followUp" } as any);
	}
	async function togglePlan(ctx: ExtensionContext) {
		if (!(on && roleName === "plan")) { enterPlan(ctx); ctx.ui.notify("mode: plan", "info"); return; }
		const plan = await leavePlanIfNeeded(ctx, "");
		leavePlan(ctx); ctx.ui.notify(on ? `mode: ${roleName}` : "plan mode off", "info");
		if (plan) runPlan(plan);
	}
	if (ACTIVE || PLAN) {
		pi.registerCommand("plan", {
			description: "Toggle plan mode (read-only exploration that ends in a numbered plan)",
			handler: async (_args, ctx) => togglePlan(ctx),
		});
		pi.registerShortcut("ctrl+alt+p", { description: "Toggle plan mode", handler: async (ctx) => togglePlan(ctx) });
		// a finished plan: execute it, refine it, or stay (asked once per plan)
		pi.on("agent_end", async (event: any, ctx) => {
			if (!on || roleName !== "plan" || !ctx?.hasUI) return;
			const plan = planOf(lastAssistantText(ctx, event?.messages, true));
			if (!plan || plan === askedPlan) return;
			askedPlan = plan;
			const choice = await ctx.ui.select("Plan ready. What next?", ["Execute the plan", "Refine the plan", "Stay in plan mode"]);
			if (choice === "Execute the plan") { leavePlan(ctx); ctx.ui.notify(on ? `mode: ${roleName}` : "plan mode off", "info"); runPlan(plan); return; }
			if (choice !== "Refine the plan") return;
			const ui: any = ctx.ui;
			const r = typeof ui.editor === "function" ? await ui.editor("Refine the plan (edit it or add notes):", plan) : await ui.input?.("How should the plan change?");
			const text = String(r ?? "").trim();
			if (text && text !== plan) pi.sendUserMessage(`Revise the plan:\n\n${text}`, { deliverAs: "followUp" } as any);
		});
	}
	if (!ACTIVE) return;
	const names = () => Object.keys(manifest.roles);
	// to a mode by name: plan remembers where it came from
	async function switchTo(ctx: ExtensionContext, next: string) {
		const plan = await leavePlanIfNeeded(ctx, next);
		if (next === "plan") enterPlan(ctx); else { planFrom = ""; apply(ctx, next); }
		ctx.ui.notify(`mode: ${next}`, "info");
		if (plan) runPlan(plan);
	}
	pi.registerCommand("mode", {
		description: "Show or switch the mandate mode: /mode [plan|auto|ask|orchestrator|yolo|<role>]",
		handler: async (args, ctx) => {
			const want = (args ?? "").trim();
			if (!want) { ctx.ui.notify(`mode: ${roleName}  (available: ${names().join(", ")})\nlog: ${LOG}`, "info"); return; }
			if (!manifest.roles[want]) { ctx.ui.notify(`unknown mode '${want}' — one of ${names().join(", ")}`, "warning"); return; }
			await switchTo(ctx, want);
		},
	});
	pi.registerShortcut("alt+m", {
		description: "Cycle the mandate mode",
		handler: async (ctx) => { const cyc = (manifest.cycle ?? []).filter((n) => manifest.roles[n]); const i = cyc.indexOf(roleName); await switchTo(ctx, cyc[(i + 1) % cyc.length] ?? "auto"); },
	});

	// leaving plan with a plan on the table: the plan to execute, or ""
	async function leavePlanIfNeeded(ctx: ExtensionContext, next: string): Promise<string> {
		if (!on || roleName !== "plan" || next === "plan" || !ctx.hasUI) return "";
		const plan = planOf(lastAssistantText(ctx, undefined, true));
		if (!plan) return "";
		const choice = await ctx.ui.select("A plan is on the table. Execute it now?", ["Execute the plan", "Switch mode only"]);
		return choice === "Execute the plan" ? plan : "";
	}
	// "Plan:", "**Plan**:", "**Plan:**", "## Plan:", or a heading "## Plan" / "**Plan**" alone
	function planOf(text: string): string {
		const at = [/(^|\n)[ \t]*(#{1,6}[ \t]*)?(\*\*|__)?Plan(\*\*|__)?[ \t]*:/i, /(^|\n)[ \t]*(#{1,6}[ \t]*(\*\*)?|\*\*)Plan(\*\*)?[ \t]*(?=\r?\n|$)/i]
			.map((r) => r.exec(text)?.index ?? -1).filter((i) => i >= 0);
		return at.length ? text.slice(Math.min(...at)).trim() : "";
	}
	function textOf(m: any): string {
		const c = m?.content;
		return typeof c === "string" ? c : Array.isArray(c) ? c.filter((x: any) => x?.type === "text").map((x: any) => x.text).join("\n") : "";
	}
	// finished: only a reply that ended normally (not aborted, cut off or failed)
	function lastAssistantText(ctx: ExtensionContext, messages?: any[], finished = false): string {
		try {
			const sm = ctx.sessionManager as any;
			const list: any[] = Array.isArray(messages) ? messages : ((sm.getBranch?.() ?? sm.getEntries?.() ?? []) as any[]).map((e: any) => e?.message);
			for (let i = list.length - 1; i >= 0; i--) if (list[i]?.role === "assistant") return finished && list[i].stopReason !== "stop" ? "" : textOf(list[i]);
		} catch { /* fall through */ }
		return "";
	}
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# Subagents: one tool, `subagent`, that runs a named agent file in its own
# pi process (same provider, same guards, the role its file names).
pi_write_subagent_extension() {
    local dir f tmp
    lc_ext_module subagents; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.subagents.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (subagents); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with subagents on
// (LETS_CODE_SUBAGENTS_ON=1). One tool, `subagent`, delegates a task to a
// named agent in its own pi process with a fresh context: single, parallel
// (concurrency LETS_CODE_SUBAGENT_CONCURRENCY, default 2: one GPU serves
// every agent) or chained ({previous} carries the prior output). Agents are
// Markdown files with YAML frontmatter (name, description, tools, thinking,
// role) in ~/.pi/agent/agents/, and in .pi/agents/ or .agents/agents/ when
// the project is trusted. Every child goes through lets-code's provider and
// the same guards; it runs under the mandate role the agent file names.
// A child cannot start children of its own (LETS_CODE_SUBAGENT_DEPTH).
//
// An agent type can bring its own environment (all optional; paths relative
// to ~/.pi/agent, or absolute under it, or under the project for a trusted
// project's agent; anything else rejects the file):
//   agent_dir      the child's PI_CODING_AGENT_DIR (own mcp.json, ...)
//   skills         paths passed as --skill
//   append_prompt  a file appended with --append-system-prompt
//   timeout        seconds before a task turn is stopped (default
//                  LETS_CODE_SUBAGENT_TIMEOUT, 1800; a large value is none)
//   requires       a path that must exist, else the agent is hidden
//   requires_env   an environment variable that must be set (not 0), else hidden
// A missing agent_dir, skill or append_prompt hides the agent too.
//
// A file in ~/.pi/agent/agents that says `expert: true` is an expert
// (its own fields: job, use_for, keywords, dispatch_rule, platform, setup, setup_note, brief; see the
// experts module). It is never listed here (its name stays taken); with
// experts on (LETS_CODE_EXPERTS_ON=1) a call to it is pointed at the expert
// tool, with them off it is simply unknown.
//
// With the Claude Code adapter on (LETS_CODE_CLAUDE_CODE_ON=1), Claude Code
// agent files count too: ~/.claude/agents, and .claude/agents from the
// project up to its git root when the adapter trusts the folder
// (LETS_CODE_CLAUDE_TRUST=1). They come after every pi agent dir, so a pi
// agent of the same name wins. Their fields map to pi's: tools and
// disallowedTools by tool name (Read -> read, Glob -> find, ...; tools pi
// lacks are dropped), effort -> thinking, permissionMode plan -> the
// readonly role; model, color and the rest are ignored (one model here).
//
// Subagent sessions: each child is a pi in RPC mode on a real session file of
// its own (--session, under lets-code-runs/; see "the child process"), and
// /subagents (or LETS_CODE_SUBAGENT_KEY, default alt+s; "none" turns the key
// off) switches the TUI into it, live while it works, and back; there you
// go on with the child as with the main session (see "subagent sessions"
// below; subagent-view.ts draws the picker, the footer list and the live
// part). While one runs, the footer says so, with the key. No tool text,
// prompt or context changes.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import { chmodSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, isAbsolute, join, resolve, sep } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { Type } from "typebox";

const ACTIVE = process.env.LETS_CODE_SUBAGENTS_ON === "1";
const DEPTH = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
const MAX_DEPTH = Number(process.env.LETS_CODE_SUBAGENT_MAX_DEPTH ?? "1") || 1;
export const CONCURRENCY = Math.max(1, Number(process.env.LETS_CODE_SUBAGENT_CONCURRENCY ?? "2") || 2);
// a task turn's budget when the agent file sets no timeout
export const SUBAGENT_TIMEOUT = Math.max(1, Number(process.env.LETS_CODE_SUBAGENT_TIMEOUT ?? "1800") || 1800);
export const MAX_PARALLEL = 8;
const OUTPUT_CAP = 50 * 1024;
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const MODEL = process.env.LETS_CODE_MODEL || "";
const CLAUDE = process.env.LETS_CODE_CLAUDE_CODE_ON === "1";
const EXPERTS = process.env.LETS_CODE_EXPERTS_ON === "1";
const claudeDir = () => process.env.CLAUDE_CONFIG_DIR || join(process.env.HOME || homedir(), ".claude");
// Claude Code's tool names -> pi's; Task/Agent go too (a child starts no children)
export const CLAUDE_TOOLS: Record<string, string> = { Bash: "bash", Read: "read", Write: "write", Edit: "edit", MultiEdit: "edit", NotebookEdit: "edit", Grep: "grep", Glob: "find", LS: "ls" };
const PI_TOOLS = ["read", "bash", "edit", "write", "grep", "find", "ls"];
export function claudeTools(names: string[]): string[] {
	const out: string[] = [];
	for (const raw of names) {
		const n = raw.replace(/\(.*$/, "").trim();   // Bash(git *) -> Bash
		const t = n.startsWith("mcp__") ? n.replace(/-/g, "_") : CLAUDE_TOOLS[n];
		if (t && !out.includes(t)) out.push(t);
	}
	return out;
}

export interface AgentDef {
	name: string; description: string; tools?: string[]; thinking?: string; role?: string; prompt: string; source: "user" | "project"; file: string;
	agentDir?: string; skills?: string[]; appendPrompt?: string; timeout?: number; expert?: ExpertMeta;
	team?: string[];   // experts this agent may start itself (one level below it, and no further)
}
// An expert's own fields. brief: the template its caller fills in, one
// field per block-list item, "name (required): hint" or "name: hint" (none
// given: one required field, task). ready: everything the file names exists
// (agent_dir, skills, append_prompt, requires), i.e. its setup has run.
export interface BriefField { name: string; required: boolean; hint: string }
export interface ExpertMeta { job: string; useFor?: string; keywords?: string; dispatchRule?: string; brief: BriefField[]; platform?: string; setup?: string; setupNote?: string; ready: boolean; routed: boolean; runner?: string }
export const MAX_TIMEOUT = 24 * 3600;

// A path named in an agent file, resolved and checked lexically: relative to
// the agent dir, or absolute under one of the roots. null = outside them.
export function agentPath(p: string, roots: string[]): string | null {
	if (!p || /[\0\r\n]/.test(p)) return null;
	const abs = isAbsolute(p) ? resolve(p) : resolve(AGENT_DIR, p);
	return roots.some((r) => { const root = resolve(r); return abs === root || abs.startsWith(root.endsWith(sep) ? root : root + sep); }) ? abs : null;
}

// null when the file is not a usable agent: bad name, a field that does not
// validate, or an environment it needs that is missing here (hidden).
// ungated: a missing path or requires_env does not hide the file (a
// expert is listed as not set up instead; see ExpertMeta.ready).
export function parseAgentFile(text: string, file: string, source: "user" | "project", projectRoot?: string, claude = false, ungated = false): AgentDef | null {
	const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/.exec(text);
	const fm: Record<string, string> = {}; const items: Record<string, string[]> = {}; let body = text;
	if (m) {
		body = m[2]; let last = ""; let block = "";
		for (const line of m[1].split(/\r?\n/)) {
			const kv = /^([A-Za-z_][\w-]*)\s*:\s*(.*)$/.exec(line);
			if (kv) { last = kv[1]; fm[last] = kv[2].trim().replace(/^["']|["']$/g, ""); block = /^[>|][+-]?$/.test(fm[last]) ? last : ""; if (block) fm[last] = ""; continue; }
			const item = /^\s+-\s+(.*)$/.exec(line);   // a block list under the last key
			if (item && last && !block) { (items[last] ??= []).push(item[1].trim()); fm[last] = [fm[last], item[1].trim().replace(/^["']|["']$/g, "")].filter(Boolean).join(","); continue; }
			if (block && /^\s+\S/.test(line)) fm[block] = [fm[block], line.trim()].filter(Boolean).join(" ");   // a folded (>) or literal (|) block
		}
	}
	const name = (fm.name || file.replace(/^.*\//, "").replace(/\.md$/, "")).trim();
	if (!/^[A-Za-z0-9][\w.-]*$/.test(name)) return null;
	const list = (v?: string) => v ? v.replace(/^\[|\]$/g, "").split(",").map((s) => s.trim().replace(/^["']|["']$/g, "")).filter(Boolean) : undefined;
	const roots = [AGENT_DIR, ...(source === "project" && projectRoot ? [projectRoot] : [])];
	if (claude) {   // a Claude Code agent: its own fields only, none of the environment keys below
		let tools = fm.tools ? claudeTools(list(fm.tools)!) : undefined;
		if (fm.disallowedTools) { const no = claudeTools(list(fm.disallowedTools)!); tools = (tools ?? PI_TOOLS).filter((t) => !no.includes(t)); }
		if (tools && !tools.length) tools = ["read"];
		const effort = (fm.effort ?? "").toLowerCase();
		const thinking = ["low", "medium", "high"].includes(effort) ? effort : effort === "xhigh" || effort === "max" ? "high" : undefined;
		return { name, description: fm.description ?? "", tools, thinking, role: fm.permissionMode === "plan" ? "readonly" : undefined, prompt: body.trim(), source, file };
	}
	const a: AgentDef = { name, description: fm.description ?? "", tools: list(fm.tools), thinking: fm.thinking, role: fm.role, prompt: body.trim(), source, file, team: list(fm.team) };
	const path = (key: string) => { const p = agentPath(fm[key], roots); if (!p) throw new Error(key); return p; };
	let ready = true;
	const missing = () => { ready = false; return ungated; };   // true: keep going (ungated), false: hide
	try {
		if (fm.agent_dir) { a.agentDir = path("agent_dir"); if (!statSync(a.agentDir, { throwIfNoEntry: false })?.isDirectory() && !missing()) return null; }
		if (fm.skills) { a.skills = list(fm.skills)!.map((s) => { const p = agentPath(s, roots); if (!p) throw new Error("skills"); return p; }); if (!a.skills.every((s) => existsSync(s)) && !missing()) return null; }
		if (fm.append_prompt) { a.appendPrompt = path("append_prompt"); if (!statSync(a.appendPrompt, { throwIfNoEntry: false })?.isFile() && !missing()) return null; }
		if (fm.timeout) { const s = Number(fm.timeout); if (!/^\d+$/.test(fm.timeout) || s < 1 || s > MAX_TIMEOUT) return null; a.timeout = s; }
		if (fm.requires && !existsSync(path("requires")) && !missing()) return null;
		if (fm.requires_env) { if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(fm.requires_env)) return null; const v = process.env[fm.requires_env]; if ((!v || v === "0") && !ungated) return null; }
		if (/^(true|yes|on)$/i.test(fm.expert ?? "")) {
			const brief: BriefField[] = [];
			for (const it of items.brief ?? []) {
				const b = /^([A-Za-z_][\w-]*)\s*(\(required\))?\s*:\s*(.*)$/.exec(it.replace(/^["']|["']$/g, ""));
				if (!b || brief.some((f) => f.name === b[1])) return null;
				brief.push({ name: b[1], required: !!b[2], hint: b[3].trim() });
			}
			if (!brief.length) brief.push({ name: "task", required: true, hint: "the whole task, standing alone" });
			a.expert = { job: (fm.job || a.description).replace(/\s+/g, " ").trim(), useFor: fm.use_for?.replace(/\s+/g, " ").trim().slice(0, 100) || undefined, keywords: fm.keywords?.replace(/\s+/g, " ").trim().slice(0, 40) || undefined, dispatchRule: fm.dispatch_rule?.replace(/\s+/g, " ").trim().slice(0, 300) || undefined, brief, platform: fm.platform || undefined, setup: fm.setup ? path("setup") : undefined, setupNote: fm.setup_note || undefined, ready, routed: !/^(false|no|off)$/i.test(fm.route ?? ""), runner: fm.runner || undefined };
