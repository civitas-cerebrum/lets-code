		const hooks = all.hooks.filter(project);
		if (hooks.length) what.push(`hooks:\n${[...new Set(hooks.map((h) => `  ${h.event}: ${short(String(h.command ?? h.url), 100)}`))].slice(0, 12).join("\n")}`);
