export interface Workflow { name: string; description: string; file: string; scope: "user" | "project"; source: string }
// export const meta = { ... } as its first statement: a plain literal, read without running the script
export function parseWorkflow(src: string): { meta: any; body: string } | null {
	const m = /export\s+const\s+meta\s*=\s*/.exec(src);
	if (!m) return null;
	let i = m.index + m[0].length; if (src[i] !== "{") return null;
	let depth = 0; let q = ""; let j = i;
	for (; j < src.length; j++) {
		const c = src[j];
		if (q) { if (c === "\\") j++; else if (c === q) q = ""; continue; }
		if (c === '"' || c === "'" || c === "`") q = c;
		else if (c === "/" && src[j + 1] === "/") { while (j < src.length && src[j] !== "\n") j++; }
		else if (c === "/" && src[j + 1] === "*") { j = src.indexOf("*/", j + 2); if (j < 0) return null; j++; }
		else if (c === "{") depth++;
		else if (c === "}" && --depth === 0) break;
	}
	if (depth !== 0) return null;
	let meta: any;
	try { meta = vm.runInNewContext(`(${src.slice(i, j + 1)})`, Object.create(null), { timeout: 200 }); } catch { return null; }
	if (!meta || typeof meta.name !== "string") return null;
	return { meta, body: src.slice(0, m.index) + src.slice(j + 1).replace(/^\s*;/, "") };
}
export function discoverWorkflows(cwd: string, trusted: boolean): Workflow[] {
	const out = new Map<string, Workflow>();
	const scan = (dir: string, scope: Workflow["scope"]) => {
		if (!isDir(dir)) return;
		for (const f of readdirSync(dir).sort()) {
			if (!f.endsWith(".js")) continue;
			const src = readText(join(dir, f)); const p = src === undefined ? null : parseWorkflow(src);
			if (!p || out.has(p.meta.name)) continue;
			out.set(p.meta.name, { name: p.meta.name, description: String(p.meta.description ?? ""), file: join(dir, f), scope, source: src! });
		}
	};
	if (trusted) for (const d of projectDirs(cwd)) scan(join(d, ".claude", "workflows"), "project");
	if (userScope()) scan(join(claudeDir(), "workflows"), "user");
	return [...out.values()];
}
// enough JSON Schema for an agent's answer: type, required, properties, items, enum
export function validate(v: any, s: any, at = "$"): string | null {
	if (!s || typeof s !== "object") return null;
	const types = Array.isArray(s.type) ? s.type : s.type ? [s.type] : [];
	const typeOf = (x: any) => (x === null ? "null" : Array.isArray(x) ? "array" : Number.isInteger(x) ? "integer" : typeof x);
	if (types.length && !types.some((t: string) => t === typeOf(v) || (t === "number" && typeof v === "number"))) return `${at} should be ${types.join("|")}`;
	if (Array.isArray(s.enum) && !s.enum.some((e: any) => JSON.stringify(e) === JSON.stringify(v))) return `${at} should be one of ${JSON.stringify(s.enum)}`;
	if (v && typeof v === "object" && !Array.isArray(v)) {
		for (const k of s.required ?? []) if (!(k in v)) return `${at}.${k} is missing`;
		for (const [k, sub] of Object.entries(s.properties ?? {})) if (k in v) { const e = validate(v[k], sub, `${at}.${k}`); if (e) return e; }
	}
	if (Array.isArray(v) && s.items) for (let i = 0; i < v.length; i++) { const e = validate(v[i], s.items, `${at}[${i}]`); if (e) return e; }
	return null;
}
export function parseJsonReply(text: string): unknown {
	const t = text.trim().replace(/^```(?:json)?\s*\n?/, "").replace(/\n?```\s*$/, "");
	try { return JSON.parse(t); } catch { /* look inside */ }
	const a = t.search(/[[{]/); const b = Math.max(t.lastIndexOf("}"), t.lastIndexOf("]"));
	if (a >= 0 && b > a) { try { return JSON.parse(t.slice(a, b + 1)); } catch { /* none */ } }
	return undefined;
}
export interface WorkflowRuntime {
	runAgent(prompt: string, label: string, signal?: AbortSignal): Promise<{ text: string; ok: boolean }>;
	concurrency: number; signal?: AbortSignal; onProgress?(line: string): void;
}
// The script runs in a vm context with agent / parallel / pipeline / phase /
// log / args as globals, its body wrapped in an async function so a top-level
// return is the result. Agents share one queue of `concurrency` slots.
export async function runWorkflow(wf: { source: string; file?: string }, args: unknown, rt: WorkflowRuntime): Promise<{ result: unknown; agents: number }> {
	const p = parseWorkflow(wf.source);
	if (!p) throw new Error("not a workflow script (no `export const meta = { name, ... }`)");
	let active = 0; let agents = 0; let phaseTitle = "";
	const queue: (() => void)[] = [];
	const acquire = () => new Promise<void>((r) => { if (active < rt.concurrency) { active++; r(); } else queue.push(() => { active++; r(); }); });
	const release = () => { active--; queue.shift()?.(); };
	const progress = (s: string) => rt.onProgress?.(s);
	const agent = async (prompt: string, opts: any = {}) => {
		if (rt.signal?.aborted) return null;
		await acquire();
		try {
			if (rt.signal?.aborted) return null;
			const label = String(opts?.label ?? `agent ${agents + 1}`);
			agents++; progress(`${opts?.phase ?? phaseTitle ? `${opts?.phase ?? phaseTitle}: ` : ""}${label}`);
			if (!opts?.schema) { const r = await rt.runAgent(String(prompt), label, rt.signal); return r.ok || r.text ? r.text : null; }
			const ask = `${prompt}\n\nReply with only a JSON value (no prose, no code fence) that matches this JSON Schema:\n${JSON.stringify(opts.schema)}`;
			let r = await rt.runAgent(ask, label, rt.signal);
			let v = parseJsonReply(r.text); let err = v === undefined ? "the reply was not JSON" : validate(v, opts.schema);
			if (err && !rt.signal?.aborted) {   // one retry, with the reason
				agents++;
				r = await rt.runAgent(`${ask}\n\nA previous answer was rejected (${err}):\n${r.text.slice(0, 2000)}\nReply again with only the JSON.`, label, rt.signal);
				v = parseJsonReply(r.text); err = v === undefined ? "the reply was not JSON" : validate(v, opts.schema);
			}
			return err ? null : v;
		} finally { release(); }
	};
	const settle = async (x: any) => { try { return await (typeof x === "function" ? x() : x); } catch { return null; } };
	const parallel = (items: any, ...rest: any[]) => Promise.all((Array.isArray(items) ? items : [items, ...rest]).map(settle));
	const pipeline = (items: any[], ...stages: any[]) => Promise.all((items ?? []).map((it: any, i: number) => settle(async () => { let v = it; for (const s of stages) v = await s(v, i); return v; })));
	const phase = (t: string) => { phaseTitle = String(t); progress(`phase: ${phaseTitle}`); };
	const log = (...m: unknown[]) => progress(m.map((x) => (typeof x === "string" ? x : JSON.stringify(x))).join(" "));
	const ctx = vm.createContext({ agent, parallel, pipeline, phase, log, args, console: { log, info: log, warn: log, error: log } });
	const result = await vm.runInContext(`(async () => {\n${p.body}\n})()`, ctx, { filename: wf.file ?? `${p.meta.name}.js` });
	return { result, agents };
}
// When a prompt asks for a workflow, judged on the user's words with code
// removed, deterministic and strict, since a hit adds a prompt section:
//   * its name with the word "workflow" ("run the review workflow"), as
//     /<name>, or a name with - _ : in it ("deep-research") on its own;
//   * or the request reads like its description: at least 3 shared content
//     words (4+ letters, crude stemming), 40 % of the description's and
//     20 % of the prompt's (so a long prompt does not match by chance).
const STOP = new Set("about above after again also always based because been before being both cannot could does doing done each every from have having here into just like make many more most much must need only other over same should some such than that their them then there these they this those through under until very what when where which while will with within without would your yours please using used uses into onto".split(" "));
const stem = (w: string) => w.replace(/(ies)$/, "y").replace(/(ing|ed|es|s)$/, "");
const words = (s: string) => new Set((s.toLowerCase().match(/[a-z][a-z0-9]{3,}/g) ?? []).filter((w) => !STOP.has(w)).map((w) => stem(stem(w))));
const strip = (p: string) => String(p ?? "").replace(/```[\s\S]*?(```|$)/g, " ").replace(/`[^`\n]*`/g, " ");
export function workflowMatches(prompt: string, list: Pick<Workflow, "name" | "description">[]): string[] {
	const p = strip(prompt); const lower = p.toLowerCase(); const pw = words(p);
	return list.filter((w) => {
		const n = w.name.toLowerCase(); const esc = n.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
		const named = new RegExp(`(^|[^\\w/-])${esc}($|[^\\w-])`).test(lower);
		if (new RegExp(`(^|\\s)/${esc}($|\\s)`).test(lower)) return true;
		if (named && (/[-_:]/.test(n) || (/\bworkflows?\b/.test(lower) && !/\b(github|gitlab|ci|actions?|ya?ml|n8n|zapier)\b/.test(lower)))) return true;
		const dw = words(`${w.name.replace(/[-_:]/g, " ")} ${w.description}`);
		let shared = 0; for (const x of dw) if (pw.has(x)) shared++;
		return shared >= 3 && shared >= Math.ceil(0.4 * dw.size) && shared >= 0.2 * pw.size;   // a long prompt shares words by chance
	}).map((w) => w.name);
}
// the section a match adds: one line per workflow and how to start it
export function workflowSection(list: Pick<Workflow, "name" | "description">[]): string {
	return [
		"Workflows (lets-code): the request matches a scripted workflow of this project; run it with the workflow tool instead of doing its steps by hand:",
		...list.map((w) => `- ${w.name}: ${short(w.description.replace(/\s+/g, " ").trim(), 120)} -> workflow({name: "${w.name}", args: "<input from the request>"})`),
	].join("\n");
}
