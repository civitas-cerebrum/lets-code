// ------------------------------------------------------------------ parsing
const clean = (l: string) => l.replace(/`/g, "").replace(/\*\*/g, "").replace(/^\s*(?:[>#]+\s*|[-*]\s+)?/, "").trim();
// the first STATUS: / VERDICT: line anywhere in the message, backticks and bold stripped
export function lineValue(text: string, key: string): string | null {
	const re = new RegExp(`^${key}:\\s*([A-Za-z_]+)`, "i");
	for (const raw of (text || "").split(/\r?\n/)) { const m = re.exec(clean(raw)); if (m) return m[1].toUpperCase(); }
	return null;
}
// finding lines `R1 | major | src/a.js:4 | confirmed | title` and the indented lines under them
export function parseFindings(text: string, prefix: string): Finding[] {
	const out: Finding[] = []; let cur: Finding | null = null;
	const head = new RegExp(`^(${prefix}\\d+)\\s*\\|\\s*(blocker|major|minor|nit)\\s*\\|\\s*([^|]*?)\\s*\\|\\s*(.*)$`, "i");
	for (const raw of (text || "").split(/\r?\n/)) {
		const l = clean(raw); const m = head.exec(l);
		if (m) {
			const rest = m[4].split("|").map((s) => s.trim()); const title = rest.length > 1 && /^(confirmed|suspected)$/i.test(rest[0]) ? rest.slice(1).join(" | ") : rest.join(" | ");
			cur = { id: m[1].toUpperCase(), severity: m[2].toLowerCase(), where: m[3], title, detail: "" }; out.push(cur); continue;
		}
		if (/^#{1,6}\s/.test(raw.trim()) || (!raw.trim() && cur?.detail)) { cur = null; continue; }
		if (cur && raw.trim()) cur.detail = cur.detail ? `${cur.detail}\n${raw.trim()}` : raw.trim();
	}
	return out;
}
// the acceptance judge: ACCEPT / REJECT, and every criterion that is not PASS as a finding C<n>
export function parseJudge(text: string): { verdict: string | null; failing: Finding[] } {
	const lines = (text || "").split(/\r?\n/); let verdict: string | null = null; const failing: Finding[] = []; let cur: Finding | null = null;
	for (let i = 0; i < lines.length; i++) {
		const l = clean(lines[i]);
		if (!verdict) { const v = /^(ACCEPT|REJECT)\b/i.exec(l) || /^verdict:\s*(ACCEPT|REJECT)\b/i.exec(l); if (v) { verdict = v[1].toUpperCase(); continue; } }
