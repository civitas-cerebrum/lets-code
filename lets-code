#!/usr/bin/env python3
# Written by lets-code (termux); regenerated on launch, edits are overwritten.
"""uitext: a uiautomator dump (XML) as short text lines, and node lookup.

  uitext.py dump <xml> [--all] [--full] [--max N] [--grep WORD]
  uitext.py find <xml> (--text S | --desc S | --id S | --any S) [--nth N]
  uitext.py at <xml> <x> <y>

dump prints a header and one line per node worth seeing (it has text or a
description, or it can be clicked, typed into or scrolled; --all: every
visible node):
  #<n> <Class> "<text>" desc="<d>" id=<id> @<x>,<y> [click,edit,scroll,...]
"~" before the text marks a label taken from the node's children.
find matches exact (case-insensitive) first, then substring, and prints
  <x> <y>            the center to tap: the node's, or its nearest clickable
                     ancestor's when the node itself is not clickable
  node: <line>
  target: <line>
at prints the same for the smallest clickable node under a point.
exit 1: no match; 2: several (listed; pick one with --nth N); 3: bad dump.
"""
import re
import sys
import xml.etree.ElementTree as ET

BOUNDS = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")
CUT = 60


def load(path):
    data = open(path, "rb").read()
    start = data.find(b"<hierarchy")
    end = data.rfind(b"</hierarchy>")
    if start < 0 or end < 0:
        print("no UI hierarchy in the dump (uiautomator failed: screen not idle or locked, or no shell rights)")
        sys.exit(3)
    try:
        root = ET.fromstring(data[start:end + len(b"</hierarchy>")])
    except ET.ParseError as e:
        print(f"unreadable dump: {e}")
        sys.exit(3)
    nodes = []

    def walk(e, parent):
        for c in e:
            if c.tag != "node":
                walk(c, parent)
                continue
            n = dict(c.attrib)
            m = BOUNDS.match(n.get("bounds", ""))
            n["_b"] = tuple(map(int, m.groups())) if m else (0, 0, 0, 0)
            n["_parent"], n["_kids"], n["_i"] = parent, [], len(nodes)
            nodes.append(n)
            if parent is not None:
                parent["_kids"].append(n)
            walk(c, n)

    walk(root, None)
    return nodes


def visible(n):
    x1, y1, x2, y2 = n["_b"]
    return x2 > x1 and y2 > y1


def true(n, k):
    return n.get(k) == "true"


def short(s, full):
    s = " ".join((s or "").split())
    return s if full or len(s) <= CUT else s[:CUT - 1] + "…"


def child_texts(n, out):
    for k in n["_kids"]:
        t = k.get("text") or k.get("content-desc")
        if t and visible(k):
            out.append(t)
        child_texts(k, out)
    return out


def editable(n):
    c = n.get("class", "")
    return c.endswith("EditText") or c.endswith("AutoCompleteTextView")


def flags(n):
    f = []
    if true(n, "clickable") or true(n, "long-clickable"):
        f.append("click")
    if editable(n):
        f.append("edit")
    if true(n, "scrollable"):
        f.append("scroll")
    if true(n, "checkable"):
        f.append("checked" if true(n, "checked") else "unchecked")
    if true(n, "selected"):
        f.append("selected")
    if true(n, "focused"):
        f.append("focus")
    if n.get("enabled") == "false":
        f.append("off")
    return f


def center(n):
    x1, y1, x2, y2 = n["_b"]
    return (x1 + x2) // 2, (y1 + y2) // 2


def line(n, full=False):
    cls = n.get("class", "").rsplit(".", 1)[-1] or "node"
    parts = [f"#{n['_i']}", cls]
    text = n.get("text") or ""
    if true(n, "password") and text:
        text = "•" * min(len(text), 8)
    if text:
        parts.append('"%s"' % short(text, full))
    desc = n.get("content-desc") or ""
    if desc and desc != text:
        parts.append('desc="%s"' % short(desc, full))
    if not text and not desc and (true(n, "clickable") or true(n, "long-clickable")):
        kids = child_texts(n, [])
        if kids:
            parts.append('~"%s"' % short(" / ".join(kids[:3]), full))
    rid = n.get("resource-id") or ""
    if rid:
        parts.append("id=" + rid.split(":id/", 1)[-1])
    x, y = center(n)
    parts.append(f"@{x},{y}")
    f = flags(n)
    if f:
        parts.append("[" + ",".join(f) + "]")
    return " ".join(parts)


def useful(n):
    return bool(n.get("text") or n.get("content-desc") or flags(n) and set(flags(n)) & {"click", "edit", "scroll"})


def arg(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def dump(nodes, args):
    full, every = "--full" in args, "--all" in args
    maxn = int(arg(args, "--max", "80"))
    grep = (arg(args, "--grep") or "").casefold()
    shown = [n for n in nodes if visible(n) and (every or useful(n))]
    lines = [line(n, full) for n in shown]
    if grep:
        lines = [s for s in lines if grep in s.casefold()]
    root = nodes[0] if nodes else None
    pkg = root.get("package", "?") if root else "?"
    size = "%dx%d" % (root["_b"][2], root["_b"][3]) if root else "?"
    print(f"screen: {pkg} {size}, {len(lines)} of {len(nodes)} nodes" + (f" matching {grep!r}" if grep else ""))
    for s in lines[:maxn]:
        print(s)
    if len(lines) > maxn:
        print(f"... {len(lines) - maxn} more (narrow it: ui dump <word>)")


def target(n):
    t = n
    while t is not None and not (true(t, "clickable") or true(t, "long-clickable")):
        t = t["_parent"]
    return t or n


def find(nodes, args):
    modes = [m for m in ("--text", "--desc", "--id", "--any") if m in args]
    if len(modes) != 1:
        print("find needs one of --text, --desc, --id, --any")
        sys.exit(3)
    mode, want = modes[0], (arg(args, modes[0]) or "").casefold()
    nth = arg(args, "--nth")

    def fields(n):
        rid = n.get("resource-id") or ""
        if mode == "--id":
            return [rid, rid.split(":id/", 1)[-1]]
        if mode == "--text":
            return [n.get("text") or ""]
        if mode == "--desc":
            return [n.get("content-desc") or ""]
        return [n.get("text") or "", n.get("content-desc") or ""]

    cand = [n for n in nodes if visible(n)]
    hits = [n for n in cand if want in [f.casefold().strip() for f in fields(n)]]
    if not hits and mode != "--id":
        hits = [n for n in cand if any(want in f.casefold() for f in fields(n) if f)]
    # one entry per tap target
    seen, uniq = set(), []
    for n in hits:
        t = target(n)
        if t["_i"] not in seen:
            seen.add(t["_i"])
            uniq.append(n)
    if not uniq:
        print(f"no match for {mode[2:]} {want!r}")
        sys.exit(1)
    if nth is not None:
        k = int(nth)
        if not 1 <= k <= len(uniq):
            print(f"--nth {k}: only {len(uniq)} matches")
            sys.exit(1)
        uniq = [uniq[k - 1]]
    if len(uniq) > 1:
        print(f"{len(uniq)} matches for {mode[2:]} {want!r}; pick one with --nth N:")
        for k, n in enumerate(uniq, 1):
            print(f"  {k}: {line(target(n))}")
        sys.exit(2)
    n = uniq[0]
    t = target(n)
    x, y = center(t)
    print(f"{x} {y}")
    print("node: " + line(n))
    print("target: " + line(t))


def at(nodes, args):
    x, y = int(args[0]), int(args[1])
    under = [n for n in nodes if visible(n) and n["_b"][0] <= x < n["_b"][2] and n["_b"][1] <= y < n["_b"][3]]
    if not under:
        print(f"{x} {y}")
        print("node: nothing at this point")
        return
    area = lambda n: (n["_b"][2] - n["_b"][0]) * (n["_b"][3] - n["_b"][1])
    n = min(under, key=area)
    t = target(n)
    print(f"{x} {y}")
    print("node: " + line(n))
    print("target: " + line(t))


def main(argv):
    if len(argv) < 2 or argv[0] not in ("dump", "find", "at"):
        print(__doc__.strip())
        return 3
    nodes = load(argv[1])
    {"dump": dump, "find": find, "at": at}[argv[0]](nodes, argv[2:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
