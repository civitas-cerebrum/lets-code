		const scriptSlip = name === "bash" && /File "<(stdin|string)>"/.test(text) && /\b(SyntaxError|IndentationError)\b/.test(text);
		const testFileEdit = (name === "edit" || name === "write") && TEST_PATH_RE.test(path);
		const realError = isError && failing === null && !scriptSlip && !testFileEdit && !text.trim().startsWith("(no output)") && !(name === "bash" && /\bAssertionError\b/.test(text));
		this.errStreak = realError ? this.errStreak + 1 : 0;
		if (!realError) this.lastOkResult = this.seq;
		if (name === "edit" && !TEST_PATH_RE.test(path)) this.editStreak = isError ? this.editStreak + 1 : 0;
		const hasSyntax = /\b(SyntaxError|IndentationError)\b/.test(text);
		// a broken throwaway script (heredoc or -c: File "<stdin>" / "<string>") is a quoting slip, not a
		// struggle with the code; only syntax errors in real files count toward the signal
		const syntaxFile = /File "([^"]+)", line \d+[^\n]*\n(?:[^\n]*\n){0,3}?\s*(?:SyntaxError|IndentationError)/.exec(text)?.[1] ?? "";
		if (hasSyntax && !/^<(stdin|string)>$/.test(syntaxFile) && !/File "<(stdin|string)>"/.test(text) && !TEST_PATH_RE.test(syntaxFile)) this.syntax++;
		const editedSource = (name === "edit" || name === "write") && !isError;
		if (editedSource) {
			this.mutations++;
			this.lastOkEdit = this.seq;
			if (TEST_PATH_RE.test(path)) {
				this.lastTestEdit = this.seq;
			} else {
				this.editsSinceTest++;
				this.lastSourceEdit = this.seq;
			}
		}
		const executed = name === "bash" && this.pendingExec;
		if (executed) {
			this.lastExecFailed = failing !== 0 && (failing !== null || FAILURE_RE.test(text));
			if (!hasSyntax) this.lastCleanExec = this.seq;
			this.pendingExec = false;
		}
		if (failing !== null) {
			this.testRuns++;
			const total = testTotal(text);
			this.lastTotal = total;
			// the first test runs decide whether the draft is broadly right: half or more failing means a design
			// problem, which patching one failure at a time (thinking off) fixes slowly
			if (!this.draftChecked && this.testRuns <= 2 && total !== null && failing >= 5 && failing * 2 >= total) {
				this.draftWrong = true;
				this.draftChecked = true;
			} else if (this.testRuns >= 2) {
				this.draftChecked = true;
			}
			// more failures than the previous run after a source change, with the tests themselves untouched: a regression
			// (a test-file edit in between means the suite grew; new failures are then expected, not a signal)
			this.regression = this.lastFailing !== null && failing > this.lastFailing && this.lastSourceEdit > this.lastExec && this.lastTestEdit < this.lastExec;
			if (this.best === null || failing < this.best) {
				this.best = failing;
				this.noImprove = 0;
			} else if (failing > 0) {
				this.noImprove++;
			}
			this.lastFailing = failing;
			if (failing === 0 && !this.passing) {
				this.passTurn = this.totalTurns;
				this.passAt = this.now();
			}
			if (failing > 0) this.passTurn = this.passAt = null;
			this.passing = failing === 0;
			this.editsSinceTest = 0;
		}
		if (executed) this.lastExec = this.seq;
		return failing;
	}
	turnEnd(): void {
		this.turns++;
		this.totalTurns++;
	}
	/** The first strong struggle signal present, with its resolution condition, or null. */
	trigger(): Trigger | null {
		if (this.passing) return null;
		const seq = this.seq;
		const mutations = this.mutations;
		if (this.draftWrong) {
			this.draftWrong = false;
			const failing = this.lastFailing ?? 0, total = this.lastTotal ?? 0;
			return {
				why: `${failing} of ${total} tests fail on the first draft`,
				goal: "That many failures points at the design, not a detail. Re-read the task statement, find what the draft gets wrong at the root, and rewrite that part instead of patching failures one at a time.",
				resolved: (d) => d.lastFailing !== null && d.lastTotal !== null && d.lastFailing * 4 <= d.lastTotal,
			};
		}
		if (this.editStreak >= 2) {
			return { why: "2 failed edits in a row", goal: "Read the exact current text of the region before the next edit, then make one edit that matches it.", resolved: (d) => d.lastOkEdit > seq };
		}
		if (this.syntax >= 2) {
			return { why: "2 syntax errors", goal: "Re-read the broken region and fix the syntax in one edit, then run the file.", resolved: (d) => d.lastCleanExec > seq };
		}
		if (this.repeats >= 2) {
			return { why: "the same tool call repeated with no file change in between", goal: "Repeating that command gives the same result. Change the code or run a different check.", resolved: (d) => d.mutations > mutations };
		}
		if (this.regression) {
			const before = this.best ?? 0;
			return { why: "more tests fail after the last edit", goal: "Your last edit made more tests fail. Compare with the previous state and fix the regression first.", resolved: (d) => d.lastFailing !== null && d.lastFailing <= before };
		}
		if (this.noImprove >= 3) {
			// the count that keeps recurring is the latest one; best may be 0 from an earlier green run,
			// which would make "fewer than best" unreachable and pin the burst to its turn cap
			const stuck = this.lastFailing ?? this.best ?? 0;
			return { why: `${stuck} test(s) still failing after 3 runs`, goal: `Diagnose why ${stuck} test(s) keep failing before editing again; verify the diagnosis by running code.`, resolved: (d) => d.lastFailing !== null && d.lastFailing < stuck };
		}
		if (this.errStreak >= 3) {
			return { why: "3 tool errors in a row", goal: "Read the error text of the last three calls and change approach.", resolved: (d) => d.lastOkResult > seq };
		}
		if (this.turns >= 40 && this.testRuns > 0) {
			return { why: "40 turns without passing tests", goal: "Step back: list what is still failing and the simplest change that fixes it.", resolved: (d) => d.passing };
		}
		return null;
	}
	/** True once the model's own tests have passed for `turns` turns and `minMs`, or for `ms` on their own. */
	passedFor(turns: number, ms = Infinity, minMs = 0): boolean {
		if (!this.passing || this.passTurn === null || this.passAt === null) return false;
		const age = this.now() - this.passAt;
		return (this.totalTurns - this.passTurn >= turns && age >= minMs) || age >= ms;
	}
	/** Why finishing now would rest on speculation rather than execution, or null. */
	unverified(): "no-run" | "failed" | null {
		if (this.lastSourceEdit > this.lastExec) return "no-run";
		if (this.lastExec > 0 && this.lastExecFailed) return "failed";
		return null;
	}
}

/** Drops thinking from all but the last `keep` assistant messages. Returns null when nothing changes. */
export function stripOldThinking(messages: any[], keep: number): any[] | null {
	if (!Number.isFinite(keep)) return null;
	const idx = messages.map((m, i) => (m && m.role === "assistant" ? i : -1)).filter((i) => i >= 0);
	const kept = new Set(keep > 0 ? idx.slice(-keep) : []);
	let changed = false;
	const out = messages.map((m, i) => {
		if (!m || m.role !== "assistant" || kept.has(i) || !Array.isArray(m.content)) return m;
		const content = m.content.filter((c: any) => !(c && c.type === "thinking"));
		if (content.length === m.content.length) return m;
		changed = true;
		return { ...m, content };
	});
	return changed ? out : null;
}

function content0(event: any): any[] {
	const c = event?.message?.content;
	return Array.isArray(c) ? c : [];
}

function textOf(content: unknown): string {
	if (!Array.isArray(content)) return typeof content === "string" ? content : "";
	return content.map((c: any) => (c && c.type === "text" ? String(c.text ?? "") : "")).join("");
}

export default function (pi: ExtensionAPI) {
	if (!ACTIVE) return;
	const d = new Detector();
	let wrapNudged = false;
	let wrapTurn = -1;
	let wrapAt = 0;
	let wrapSourceEdit = 0;
	let stopNudged = false;
	let lengthNudges = 0;
	let testReminders = 0;
	let verifyNudges = 0;
	let burst: { trigger: Trigger; turns: number; actNudges: number; goalPending: boolean } | null = null;
	let bursts = 0;
	let reviewed = false;
	let reviewing = false;
	let reviewSeq = -1;
	let afterReviewNudged = false;
	let planning = false;
	let planTurns = 0;
	const msg = (content: string) => ({ type: "custom_message" as const, customType: "lets-code-agent-guard", content, display: true });
	const log = (event: string, detail: Record<string, unknown> = {}) => {
		if (!LOG) return;
		try {
			appendFileSync(LOG, JSON.stringify({ t: Date.now(), turn: d.totalTurns, level: pi.getThinkingLevel(), event, ...detail }) + "\n");
		} catch {}
	};
	// the level outside bursts, plans and reviews: down once the model's own tests pass and a later turn
	// made no source edit (the work has settled), base otherwise. Dialing down on the first green run was
	// too early: hidden fixes often came after it, and at off the model missed a wrong order its own check printed.
	let greenSettled = false;
	let greenEdit = -1;
	const restLevel = () => (d.passing && greenSettled ? DOWN : BASE);
	const endBurst = (why: string) => {
		pi.setThinkingLevel(restLevel() as any);
		log("deescalate", { why, burstTurns: burst?.turns ?? 0 });
		burst = null;
		d.reset();
	};

	pi.on("session_start", async () => {
		if (AUTO && pi.getThinkingLevel() !== BASE) pi.setThinkingLevel(BASE as any);
		if (AUTO && PLAN) {
			planning = true;
			pi.setThinkingLevel(PLAN_LEVEL as any);
		}
		log("start", { auto: AUTO || null, base: BASE, down: DOWN, bashTimeout: BASH_TIMEOUT, wrapTurns: WRAP_TURNS, wrapMinutes: WRAP_MS / 60_000, burstTurns: BURST_TURNS, maxBursts: MAX_BURSTS, replay: Number.isFinite(REPLAY) ? REPLAY : "all" });
	});

	pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (sections && typeof sections === "object") {
			sections.lets_code_verification = PROMPT_SECTION;
			if (PLAN) sections.lets_code_plan = PLAN_SECTION;
		}
		return undefined;
	});

	pi.on("context", async (event: any) => {
		const out = stripOldThinking(event?.messages ?? [], REPLAY);
		return out ? { messages: out } : undefined;
	});

	pi.on("agent_before_settle", async () => {
		const why = d.unverified();
		if (!why && !REVIEW_OFF && ((AUTO && bursts > 0) || REVIEW_ALWAYS) && !reviewed && d.passing) {
			// one review turn: the misses that remain are task rules the model never tested. In dynamic mode
			// it runs at the ceiling; at a fixed level it runs at that level.
			reviewed = true;
			reviewSeq = d.seq;
			if (AUTO) {
				reviewing = true;
				if (burst) endBurst("final review");
				pi.setThinkingLevel(AUTO as any);
			}
			log("review-burst", { to: AUTO || pi.getThinkingLevel() });
			return { entries: [msg(REVIEW_TEXT)], continue: true };
		}
		if (!why && reviewed && !afterReviewNudged && !(d.lastExec > reviewSeq && d.passing)) {
			// the review may have added tests; finishing needs a green run after it
			afterReviewNudged = true;
			log("after-review-nudge");
			return { entries: [msg(AFTER_REVIEW_TEXT)], continue: true };
		}
		if (!why || verifyNudges >= MAX_VERIFY_NUDGES) return undefined;
		verifyNudges++;
		log("verify-nudge", { why, n: verifyNudges });
		return { entries: [msg(why === "no-run" ? VERIFY_TEXT : FAILED_CHECK_TEXT)], continue: true };
	});

	pi.on("before_provider_request", async (event: any) => {
		if (!LOG) return undefined;
		const p = event?.payload ?? {};
		const msgs = Array.isArray(p?.messages) ? p.messages : [];
		const replayed = msgs.filter((m: any) => m && m.role === "assistant" && typeof (m.reasoning ?? m.reasoning_content) === "string" && (m.reasoning ?? m.reasoning_content).length > 0).length;
		log("request", { enable_thinking: p?.chat_template_kwargs?.enable_thinking ?? null, reasoning_effort: p?.chat_template_kwargs?.reasoning_effort ?? null, thinking_token_budget: p?.thinking_token_budget ?? null, max_tokens: p?.max_tokens ?? null, replayed_thinking: replayed, messages: msgs.length });
		return undefined;
	});

	pi.on("tool_call", async (event: any) => {
		if (event.parentToolCallId) return undefined;
		d.toolCall(event.toolName, event.input);
		if (event.toolName === "bash" && event.input && event.input.timeout == null) {
			event.input.timeout = BASH_TIMEOUT;
		}
		return undefined;
	});

	pi.on("tool_result", async (event: any) => {
		if (event.parentToolCallId) return undefined;
		const text = textOf(event.content);
		if (event.toolName === "bash" && /timed out/i.test(text)) log("bash-timeout");
		const failing = d.toolResult(event.toolName, !!event.isError, text, String(event.input?.path ?? ""));
		if (failing !== null) log("tests", { failing });
		// adaptive mode: a green run arms the dial-down (applied after a settled turn, see turn_end);
		// a red run cancels it and returns to base
		if (AUTO && failing !== null && BASE !== DOWN) {
			if (failing === 0) {
				if (greenEdit < 0) greenEdit = d.lastSourceEdit;
			} else {
				greenSettled = false;
				greenEdit = -1;
				if (!burst && !planning && !reviewing && pi.getThinkingLevel() !== BASE) {
					pi.setThinkingLevel(BASE as any);
					log("dial", { to: BASE, why: `${failing} failing` });
				}
			}
		}
		// no bursts once the review has started: failures in tests the review adds are verification, not struggle
		if (AUTO && !burst && !planning && !reviewed && bursts < MAX_BURSTS) {
			const trigger = d.trigger();
			if (trigger) {
				pi.setThinkingLevel(AUTO as any);
				burst = { trigger, turns: 0, actNudges: 0, goalPending: true };
				bursts++;
				log("escalate", { why: trigger.why, to: AUTO, burst: bursts });
			}
		}
		return undefined;
	});

	pi.on("turn_end", async (event: any) => {
		d.turnEnd();
		if (planning) {
			planTurns++;
			const wroteSource = content0(event).some((c: any) => c && c.type === "toolCall" && (c.name === "write" || c.name === "edit") && !TEST_PATH_RE.test(String(c.arguments?.path ?? "")));
			if (wroteSource || planTurns >= PLAN_MAX_TURNS) {
				planning = false;
				if (!burst) pi.setThinkingLevel(restLevel() as any);
				log("plan-done", { planTurns });
			}
		}
		// adaptive dial-down: tests green and this turn changed no source since the green run
		if (AUTO && BASE !== DOWN && d.passing && greenEdit >= 0 && !greenSettled) {
			if (d.lastSourceEdit === greenEdit) {
				greenSettled = true;
				if (!burst && !planning && !reviewing && pi.getThinkingLevel() !== DOWN) {
					pi.setThinkingLevel(DOWN as any);
					log("dial", { to: DOWN, why: "tests pass, work settled" });
				}
			} else {
				greenEdit = d.lastSourceEdit; // still editing after green: wait for a turn without edits
			}
		}
		if (reviewing) {
			// the review turn has been taken; back to rest for whatever testing it triggers
			reviewing = false;
			pi.setThinkingLevel(restLevel() as any);
			log("review-done");
		}
		const m = event.message ?? {};
		const content = Array.isArray(m.content) ? m.content : [];
		const madeToolCall = content.some((c: any) => c && c.type === "toolCall");
		const entries: any[] = [];
		let cont: boolean | undefined;
		if (burst) {
			if (burst.goalPending) {
				burst.goalPending = false;
				entries.push(msg(`[lets-code] Thinking raised to ${AUTO} because: ${burst.trigger.why}. ${burst.trigger.goal} ` +
					"Use this thinking turn to reason it through: state your best hypothesis for the cause and what would confirm it, " +
					"then confirm it by running code before you edit. Act with a tool call."));
			} else {
				burst.turns++;
				if (d.passing) endBurst("tests pass");
				else if (burst.trigger.resolved(d)) endBurst("resolved: " + burst.trigger.why);
				else if (burst.turns >= BURST_TURNS) endBurst(`${BURST_TURNS} turns`);
				else if (!madeToolCall && m.role === "assistant" && m.stopReason === "stop" && burst.actNudges < MAX_ACT_NUDGES_PER_BURST) {
					burst.actNudges++;
					log("act-nudge");
					entries.push(msg(`[lets-code] You were given thinking time for: ${burst.trigger.why}. Act on your conclusion now with a tool call.`));
					cont = true;
				}
			}
		}
		if (wrapNudged && !stopNudged && madeToolCall && d.lastSourceEdit === wrapSourceEdit &&
			(d.totalTurns - wrapTurn >= STOP_AFTER_TURNS || Date.now() - wrapAt >= STOP_AFTER_MS)) {
			// the wrap-up was ignored and nothing has changed in the source since: the rest is re-checking
			stopNudged = true;
			log("stop-nudge", { turnsSinceWrap: d.totalTurns - wrapTurn });
			entries.push(msg(STOP_TEXT));
		}
		if (m.role === "assistant" && m.stopReason === "length" && !madeToolCall && lengthNudges < MAX_LENGTH_NUDGES) {
			lengthNudges++;
			log("length-nudge", { n: lengthNudges });
			entries.push(msg(LENGTH_TEXT));
			cont = true;
		} else if (madeToolCall && d.editsSinceTest >= TEST_REMIND_EDITS && testReminders < MAX_TEST_REMINDERS) {
			testReminders++;
			d.editsSinceTest = 0;
			log("test-nudge", { n: testReminders });
			entries.push(msg(TEST_TEXT));
		} else if (!wrapNudged && madeToolCall && d.passedFor(WRAP_TURNS, WRAP_MS, WRAP_MIN_MS)) {
			wrapNudged = true;
			wrapTurn = d.totalTurns;
			wrapAt = Date.now();
			wrapSourceEdit = d.lastSourceEdit;
			log("wrap-nudge");
			entries.push(msg(WRAP_TEXT));
		}
		if (!entries.length) return undefined;
		return cont ? { entries, continue: true } : { entries };
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# ------------------------------------------------------------ harness gating
# v1 implements exactly one harness (pi). The others are roadmap items and
# must fail loudly rather than silently fall back or misconfigure.
harness_gate() {  # harness_gate <name>
    case "$1" in
        pi) return 0 ;;
        *)
            log_error "harness '$1' is a roadmap item — not yet available in v1."
            log_error "pi is the default (and only implemented) harness: run 'lets-code' without --harness, or with --harness pi."
            exit 1
            ;;
    esac
}

# ------------------------------------------------------ pi presence + install
# Detects a missing pi and offers to install it (confirm, then install).
# Never blocks a non-interactive session: it prints the command and returns 1
# so the caller can abort with a pointer.
ensure_pi() {
    command -v pi >/dev/null 2>&1 && return 0
    log "pi (the agentic coding CLI) is not installed."
    log "install command: npm install -g --ignore-scripts @earendil-works/pi-coding-agent"
    if [ ! -t 0 ]; then
        log_error "non-interactive session — refusing to auto-install."
        log_error "run the command above yourself, then re-run lets-code."
        return 1
    fi
    printf "Install now? [Y/n] "
    local answer; read -r answer
    case "$answer" in
        [Nn]*)
            log "skipped — install pi manually (command above) and re-run lets-code."
            return 1
            ;;
    esac
    if ! command -v npm >/dev/null 2>&1; then
        log_error "npm not found — cannot auto-install pi."
        log_error "install Node.js (>= 22.19.0) + npm, then re-run lets-code."
        return 1
    fi
    local nv major minor=""
    nv="$(node -v 2>/dev/null | sed 's/^v//')" || nv=""
    major="${nv%%.*}"
    case "${nv}" in *.*) minor="${nv#*.}"; minor="${minor%%.*}" ;; esac
    [ -n "${minor}" ] || minor=0
    if [ -z "${nv}" ] || [ "${major}" -lt 22 ] || { [ "${major}" -eq 22 ] && [ "${minor}" -lt 19 ]; }; then
        log_error "Node.js >= 22.19.0 required (found: ${nv:-none}) — pi 0.85+ needs it."
        log_error "upgrade Node, then re-run lets-code."
        return 1
    fi
    log "installing pi via npm (this may take a minute) ..."
    if ! npm install -g --ignore-scripts @earendil-works/pi-coding-agent; then
        log_error "npm install failed — check the npm output above and retry."
        return 1
    fi
    if ! command -v pi >/dev/null 2>&1; then
        log_error "npm reported success but 'pi' is not on PATH — check your npm global prefix, then re-run."
        return 1
    fi
    log "installed pi: $(pi --version 2>/dev/null | head -n1)"
    return 0
}

# pi's file-search helpers. pi looks for fd (or Debian's fdfind) and rg on
# PATH, else under <agent-dir>/bin, and downloads what is missing from
# GitHub the first time the TUI starts — printing "fd not found.
# Downloading..." / "ripgrep not found. Downloading..." into the session.
# Fetch them up front instead, through pi's own downloader (same releases,
# same bin dir), so the first session starts clean. No-op once present,
# skipped under PI_OFFLINE, and never fatal: pi still fetches on its own.
ensure_pi_tools() {
    [ -z "${PI_OFFLINE:-}" ] || return 0
    local missing="" bin="${PI_AGENT_DIR}/bin"
    { [ -x "${bin}/fd" ] || command -v fd >/dev/null 2>&1 || command -v fdfind >/dev/null 2>&1; } || missing="fd"
    { [ -x "${bin}/rg" ] || command -v rg >/dev/null 2>&1; } || missing="${missing:+${missing} }rg"
    [ -n "${missing}" ] || return 0
    command -v node >/dev/null 2>&1 || return 0
    local pi_bin pkg mod
    pi_bin="$(node -p 'require("fs").realpathSync(process.argv[1])' "$(command -v pi)" 2>/dev/null)" || pi_bin=""
    pkg="${pi_bin%/dist/*}"
    mod="${pkg}/dist/utils/tools-manager.js"
    if [ -z "${pi_bin}" ] || [ ! -f "${mod}" ]; then
        log "note: pi will download its file-search helpers (${missing}) on first start."
        return 0
    fi
    log "fetching pi's file-search helpers (${missing}) into ${bin} — first run only ..."
    # shellcheck disable=SC2016
    PI_CODING_AGENT_DIR="${PI_AGENT_DIR}" node --input-type=module -e '
        const [mod, ...tools] = process.argv.slice(1);
        const { ensureTool } = await import(mod);
        let ok = true;
        for (const t of tools) {
            const p = await ensureTool(t, (s) => { if (s.type === "warning") { console.log("[lets-code] " + s.message); ok = false; } });
            if (p) console.log("[lets-code] " + (t === "rg" ? "ripgrep" : t) + ": " + p); else ok = false;
        }
        process.exit(ok ? 0 : 1);' "${mod}" ${missing} \
        || log "note: could not fetch ${missing} now — pi retries on its next start (or install them with your package manager)."
    return 0
}

# ---------------------------------------------------------------- onboarding
run_setup() {
    echo ""
    echo "lets-code setup — point the pi harness at your own LLM server."
    echo "Answers are saved to ${CONFIG_FILE} (edit it any time, or re-run setup)."
    echo ""

    # 1. prerequisites
    local missing=""
    command -v curl    >/dev/null || missing="${missing} curl"
    command -v python3 >/dev/null || missing="${missing} python3"
    if [ -n "${missing}" ]; then
        log_error "missing prerequisites:${missing} — install them and re-run setup."
        exit 1
    fi

    # 2. pi harness (confirm, then install), plus its file-search helpers
    ensure_pi || exit 1
    ensure_pi_tools

    # 3. endpoints
    echo ""
    echo "Enter your server base URL(s), most-preferred first (no /v1 suffix)."
    echo "No scheme? IPs, localhost and *.local get http://, domains get https://."
    echo "Examples:  http://localhost:8000    https://llm.my-lan.example"
    echo "You can list several separated by spaces — the first reachable one wins"
    echo "(useful if the same server has a localhost, LAN, and VPN address)."
    printf "Endpoints [http://localhost:8000]: "
    local endpoints
    read -r endpoints
    endpoints="$(normalize_endpoints "${endpoints:-http://localhost:8000}")"
    echo "Using: ${endpoints}"

    # 4. token
    echo ""
    echo "API token. vLLM without --api-key accepts anything; a placeholder is fine."
    printf "Token [dummy-key]: "
    local token
    read -r token
    token="${token:-dummy-key}"

    # 5. CA for private TLS
    local ca=""
    case " ${endpoints}" in *" https://"*|" https://"*)
        echo ""
        echo "You listed an https endpoint. If it uses a private CA (e.g. mkcert),"
        echo "pi (Node) needs the root CA file — Node ignores the OS trust store."
        printf "Path to root CA .pem (empty to skip): "
        read -r ca
        if [ -n "${ca}" ] && [ ! -f "${ca}" ]; then
            log_error "no file at ${ca} — saving anyway; fix it in ${CONFIG_FILE} later."
        fi ;;
    esac

    # 6. save config (re-emitted after the live probe with the thinking level)
    setup_emit_config() {  # setup_emit_config <thinking-level> [vision-pin]
        {
            echo "# lets-code configuration (shell syntax). Re-run 'lets-code setup' to regenerate."
            echo "ENDPOINTS=\"${endpoints}\""
            echo "TOKEN=\"${token}\""
            echo "CA_PATH=\"${ca}\""
            echo ""
            echo "# Optional pins (empty = auto-discovered at launch):"
            echo "MODEL=\"\""
            echo "CONTEXT=\"\""
            echo "OUTPUT_CAP=\"\""
            echo "API=\"\""
            echo ""
            echo "# Image input pin (empty = auto-detected at launch with a tiny test"
            echo "# image; setup asks when that probe is inconclusive): true|false"
            echo "VISION=\"${2:-}\""
            echo ""
            echo "# Thinking support pin (empty = auto-detected at launch): true|false"
            echo "REASONING=\"\""
            echo "# Thinking level for new sessions (default: medium; setup"
            echo "# suggests one based on the detected context window):"
            echo "THINKING=\"${1}\""
            echo ""
            echo "# Memory guard (Linux): when the machine runs low on RAM, stop the"
            echo "# largest process this session started. MEM_GUARD=false disables it."
            echo "MEM_GUARD=\"true\""
            echo ""
            echo "# Git guard: in a git repo, work on a pi/* branch (created at launch);"
            echo "# edits off such a branch are blocked. GIT_GUARD=false disables it."
            echo "GIT_GUARD=\"true\""
            echo ""
            echo "# Agent guard: bash timeouts, cut-off reply recovery, a wrap-up hint"
            echo "# once tests pass, and the auto thinking level. AGENT_GUARD=false disables it."
            echo "AGENT_GUARD=\"true\""
        } > "${CONFIG_FILE}"
        chmod 600 "${CONFIG_FILE}"
    }
    mkdir -p "${CONFIG_DIR}"
    setup_emit_config ""
    echo ""
    log "saved ${CONFIG_FILE}"

    # 7. register as a command: install + make executable + ensure PATH
    local self target
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    echo ""
    echo "Where should the 'lets-code' command be installed?"
    echo "  1) ${HOME}/.local/bin   (this user only — default)"
    echo "  2) /usr/local/bin       (system-wide, needs sudo)"
    printf "Choice [1]: "
    local reply
    read -r reply
    if [ "${reply:-1}" = "2" ]; then
        target="/usr/local/bin/lets-code"
        sudo cp "${self}" "${target}" && sudo chmod 755 "${target}"
        log "installed ${target}"
    else
        target="${HOME}/.local/bin/lets-code"
        mkdir -p "${HOME}/.local/bin"
        [ "${self}" = "${target}" ] || cp "${self}" "${target}"
        chmod +x "${target}"
        log "installed ${target}"
        # ensure ~/.local/bin is on PATH — offer to persist it in the shell profile
        case ":${PATH}:" in
            *":${HOME}/.local/bin:"*) ;;
            *)
                local profile
                case "$(basename "${SHELL:-/bin/sh}")" in
                    zsh)  profile="${HOME}/.zshrc" ;;
                    bash) if [ "$(uname)" = "Darwin" ]; then profile="${HOME}/.bash_profile"; else profile="${HOME}/.bashrc"; fi ;;
                    *)    profile="" ;;
                esac
                echo ""
                echo "~/.local/bin is not on your PATH, so 'lets-code' won't be found yet."
                if [ -n "${profile}" ]; then
                    printf "Add 'export PATH=\"\$HOME/.local/bin:\$PATH\"' to %s? [Y/n] " "${profile}"
                    read -r reply
                    case "${reply}" in n|N)
                        echo "Add it manually, then restart your shell." ;;
                    *)
                        printf '\n# added by lets-code setup\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "${profile}"
                        log "PATH line appended to ${profile} — restart your shell (or: source ${profile})" ;;
                    esac
                else
                    echo "Add this line to your shell profile, then restart your shell:"
                    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
                fi ;;
        esac
    fi
    # verify registration
    if command -v lets-code >/dev/null 2>&1; then
        log "command registered: $(command -v lets-code)"
    else
        log "command will be available in a fresh shell."
    fi

    # 8. live test
    echo ""
    printf "Probe the server now? [Y/n] "
    read -r reply
    case "${reply}" in
        n|N)
            echo "Setup done. Run: lets-code"
            offer_fresh_shell
            exit 0
            ;;
    esac
    TOKEN="${token}"; CA_FOUND=""; [ -f "${ca}" ] && CA_FOUND="${ca}"
    local found=""
    for cand in ${endpoints}; do
        if probe "${cand%/}" > "${PROBE_OUT}"; then found="${cand%/}"; MODELS_JSON="$(cat "${PROBE_OUT}")"; break; fi
        echo "  ${cand}: ${PROBE_ERR}"
    done
    if [ -z "${found}" ]; then
        log_error "no endpoint reachable right now — config saved; check the server and try 'lets-code --verbose'."
        offer_fresh_shell
        exit 1
    fi
    local info
    info="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print(d.get("id","?"), "| context:", d.get("max_model_len","?"))' 2>/dev/null || echo "?")"
    log "reachable: ${found}"
    log "resident model: ${info}"

    # 9. register the resident model with pi (so it is selectable in the fresh shell)
    local reg reg_id reg_len
    reg="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print("%s|%s" % (d.get("id", ""), d.get("max_model_len", "")))' 2>/dev/null || true)"
    reg_id="${reg%%|*}"
    reg_len="${reg##*|}"
    if [ -z "${reg_id}" ]; then
        log "could not parse a model id from /v1/models — skipping pi registration (launch re-registers anyway)."
    else
        case "${reg_len}" in
            *[!0-9]*|"") reg_len="${DEFAULT_CONTEXT}" ;;
        esac
        # probe thinking support (launch re-detects; this informs onboarding)
        probe_thinking "${found}" "${reg_id}"
        local suggested thinking_level reasoning_reg
        reasoning_reg="false"
        suggested="$(suggested_thinking_level "${reg_len}" "${DEFAULT_OUTPUT_CAP}")"
        case "${THINKING_DETECTED}" in
            true)
                reasoning_reg="true"
                echo ""
                log "thinking: detected on ${reg_id} (probe: minimal request with thinking forced on)"
                echo "Thinking level for new sessions: off|minimal|low|medium|high (xhigh|max),"
                echo "or auto[:<ceiling>]: dynamic, off except short bursts up to <ceiling> (default high)."
                echo "Suggested for ${reg_len} context / ${DEFAULT_OUTPUT_CAP} output cap: ${suggested}"
                printf "Thinking level [%s]: " "${suggested}"
                read -r thinking_level
                thinking_level="${thinking_level:-${suggested}}"
                case "${thinking_level}" in
                    off|minimal|low|medium|high|xhigh|max|adaptive|adaptive:low|adaptive:medium|adaptive:high|adaptive:xhigh|adaptive:max|auto|auto:minimal|auto:low|auto:medium|auto:high|auto:xhigh|auto:max) ;;
                    *) log_error "thinking level must be one of off|minimal|low|medium|high|xhigh|max|auto[:<level>] (got: ${thinking_level})"; exit 1 ;;
                esac ;;
            *)
                thinking_level="${suggested}"
                case "${THINKING_DETECTED}" in
                    false) log "thinking: not detected on ${reg_id} — registering without thinking" ;;
                    *)     log "thinking: probe inconclusive for ${reg_id} — registering without thinking (pin REASONING=true in ${CONFIG_FILE} if it supports it)" ;;
                esac
                log "startup thinking level saved as ${thinking_level} in case the resident model changes" ;;
        esac
        # probe image support (launch re-detects unless pinned); ask when inconclusive
        local vision_reg vision_pin
        vision_reg="false"; vision_pin=""
        if [ -n "${LETS_CODE_VISION:-}" ]; then
            vision_pin="${LETS_CODE_VISION}"; vision_reg="${LETS_CODE_VISION}"
            log "vision: pinned to ${vision_pin} by LETS_CODE_VISION"
        else
            probe_vision "${found}" "${reg_id}"
            case "${VISION_DETECTED}" in
                true)  vision_reg="true"
                       log "vision: detected on ${reg_id} (probe: a tiny red image, asked for its color) — images will be sent to it" ;;
                false) log "vision: not detected on ${reg_id} (the server rejected image input or the model could not see it) — registering as text-only" ;;
                *)
                    echo ""
                    log "vision: probe inconclusive for ${reg_id} (no usable answer about a test image)."
                    echo "Does ${reg_id} accept images (screenshots, diagrams)? If unsure, say n —"
                    echo "pi only sends images to models declared with image input."
                    printf "Model accepts images? [y/N] "
                    read -r reply
                    case "${reply}" in
                        y|Y|yes|YES) vision_pin="true"; vision_reg="true" ;;
                        *)           vision_pin="false" ;;
                    esac
                    log "vision pinned as VISION=${vision_pin} in ${CONFIG_FILE} (clear it to re-probe at launch)" ;;
            esac
        fi
        setup_emit_config "${thinking_level}" "${vision_pin}"
        log "updated ${CONFIG_FILE} (thinking level: ${thinking_level}, vision: ${vision_pin:-auto})"
        EFFORT_MAP=""
        if [ "${reasoning_reg}" = true ]; then
            probe_template_effort "${found}" "${reg_id}"
            log "${EFFORT_NOTE}"
        fi
        # auto[:<level>] starts off (the agent guard raises it). Computed
        # outside the call: bash 3.2 (macOS) cannot parse a case pattern's
        # ')' inside "$(...)" and prints a syntax error for it.
        local startup_level
        case "${thinking_level}" in auto*) startup_level="off" ;; adaptive*) startup_level="medium" ;; *) startup_level="${thinking_level}" ;; esac
        pi_write_configs "${found}" "${DEFAULT_API}" "${reg_id}" "${reg_len}" "${DEFAULT_OUTPUT_CAP}" "${vision_reg}" "${reasoning_reg}" "${startup_level}" "${EFFORT_MAP}"
        log "registered with pi: ${reg_id} (context ${reg_len}, output cap ${DEFAULT_OUTPUT_CAP}, vision: ${vision_reg}, thinking: ${reasoning_reg}, level: ${thinking_level})"
    fi

    echo ""
    echo "All set. Run:  lets-code          (interactive session)"
    echo "          or:  lets-code -p \"hi\"  (one-shot print mode)"
    offer_fresh_shell
    exit 0
}

# The parent shell caches its command/completion tables at startup, so a
# just-installed command isn't tab-completable there. A child process cannot
# refresh the parent — but we can hand the user a fresh login shell instead.
offer_fresh_shell() {
    if [ -t 0 ]; then
        printf "Open a refreshed shell now so 'lets-code' + tab-completion work immediately? [Y/n] "
        read -r reply
        case "${reply}" in
            n|N) echo "OK — run 'rehash' (zsh) / 'hash -r' (bash), or open a new terminal." ;;
            *)   exec "${SHELL:-/bin/sh}" -l ;;
        esac
    else
        echo "Note: run 'rehash' (zsh) / 'hash -r' (bash) or open a new terminal for tab-completion."
    fi
}

# --------------------------------------------------------------------- main
# setup is a terminal path: it exits on every branch
[ "${1:-}" = "setup" ] && { CA_FOUND=""; TOKEN="dummy-key"; run_setup; }

# load config (defaults, then file, then env overrides)
ENDPOINTS=""
TOKEN="dummy-key"
CA_PATH=""
MODEL=""
CONTEXT=""
OUTPUT_CAP=""
API=""
VISION=""
REASONING=""
THINKING=""
MEM_GUARD="true"
GIT_GUARD="true"
AGENT_GUARD="true"
TEMPLATE_EFFORT="auto"
# shellcheck disable=SC1090
[ -f "${CONFIG_FILE}" ] && . "${CONFIG_FILE}"
ENDPOINTS="${LETS_CODE_ENDPOINTS:-${ENDPOINTS}}"
TOKEN="${LETS_CODE_TOKEN:-${TOKEN}}"
CA_PATH="${LETS_CODE_CA:-${CA_PATH}}"
MODEL="${LETS_CODE_MODEL:-${MODEL}}"
CONTEXT="${LETS_CODE_CONTEXT:-${CONTEXT}}"
OUTPUT_CAP="${LETS_CODE_OUTPUT_CAP:-${OUTPUT_CAP}}"
API="${LETS_CODE_API:-${API}}"
VISION="${LETS_CODE_VISION:-${VISION}}"
REASONING="${LETS_CODE_REASONING:-${REASONING}}"
THINKING="${LETS_CODE_THINKING:-${THINKING}}"
MEM_GUARD="${LETS_CODE_MEM_GUARD:-${MEM_GUARD}}"
GIT_GUARD="${LETS_CODE_GIT_GUARD:-${GIT_GUARD}}"
AGENT_GUARD="${LETS_CODE_AGENT_GUARD:-${AGENT_GUARD}}"
TEMPLATE_EFFORT="${LETS_CODE_TEMPLATE_EFFORT:-${TEMPLATE_EFFORT}}"

HARNESS="pi"
URL_OVERRIDE=""
MODEL_OVERRIDE=""
CONTEXT_OVERRIDE=""
OUTPUT_CAP_OVERRIDE=""
API_OVERRIDE=""
VISION_OVERRIDE=""
THINKING_OVERRIDE=""
INSECURE=false
PASSTHROUGH=()
while [ $# -gt 0 ]; do
    case $1 in
        --harness)  [ -n "${2:-}" ] || { log_error "--harness requires an argument."; exit 1; }
                    HARNESS="$2"; shift 2 ;;
        --url)      [ -n "${2:-}" ] || { log_error "--url requires an argument."; exit 1; }
                    URL_OVERRIDE="${2%/}"; shift 2 ;;
        --model)    [ -n "${2:-}" ] || { log_error "--model requires an argument."; exit 1; }
                    MODEL_OVERRIDE="$2"; shift 2 ;;
        --context)  [ -n "${2:-}" ] || { log_error "--context requires an argument."; exit 1; }
                    case "$2" in *[!0-9]*|0|"") log_error "--context expects a positive integer (tokens), got: $2"; exit 1 ;; esac
                    CONTEXT_OVERRIDE="$2"; shift 2 ;;
        --output-cap) [ -n "${2:-}" ] || { log_error "--output-cap requires an argument."; exit 1; }
                    case "$2" in *[!0-9]*|0|"") log_error "--output-cap expects a positive integer (tokens), got: $2"; exit 1 ;; esac
                    OUTPUT_CAP_OVERRIDE="$2"; shift 2 ;;
        --api)      [ -n "${2:-}" ] || { log_error "--api requires an argument."; exit 1; }
                    API_OVERRIDE="$2"; shift 2 ;;
        --vision)   VISION_OVERRIDE=true; shift ;;
        --no-vision) VISION_OVERRIDE=false; shift ;;
        --thinking-level) [ -n "${2:-}" ] || { log_error "--thinking-level requires an argument."; exit 1; }
                          THINKING_OVERRIDE="$2"; shift 2 ;;
        --insecure) INSECURE=true; shift ;;
        --no-mem-guard) MEM_GUARD=false; shift ;;
        --no-git-guard) GIT_GUARD=false; shift ;;
        --no-agent-guard) AGENT_GUARD=false; shift ;;
        --verbose|--debug) VERBOSE=true; shift ;;
        -h|--help)  sed -n "3,$(grep -n '^# (auto-installed on request)\.$' "$0" | cut -d: -f1)p" "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)          PASSTHROUGH+=("$1"); shift ;;
    esac
done

case "${API_OVERRIDE}" in
    ""|openai-completions|openai-responses|anthropic-messages|google-generative-ai) ;;
    *) log_error "unsupported --api dialect: ${API_OVERRIDE} (openai-completions | openai-responses | anthropic-messages | google-generative-ai)"; exit 1 ;;
esac

harness_gate "${HARNESS}"

if [ -z "${ENDPOINTS}" ] && [ -z "${URL_OVERRIDE}" ]; then
    log_error "no configuration found. Run:  lets-code setup"
    exit 1
fi

ensure_pi || exit 1
command -v curl    >/dev/null || { log_error "curl not found."; exit 1; }
command -v python3 >/dev/null || { log_error "python3 not found."; exit 1; }
ensure_pi_tools

CA_FOUND=""
if [ -n "${CA_PATH}" ] && [ -f "${CA_PATH}" ]; then CA_FOUND="${CA_PATH}"; fi

BASE_URL=""
MODELS_JSON=""
# Normalize (see normalize_endpoint): a missing scheme is filled in and a
# trailing /v1 dropped — the probe always hits <base>/v1/models, and /v1 is
# re-added for pi below.
if [ -n "${URL_OVERRIDE}" ]; then
    BASE_URL="$(normalize_endpoint "${URL_OVERRIDE}")"
    probe "${BASE_URL}" > "${PROBE_OUT}" || { log_error "server not reachable at ${BASE_URL} (${PROBE_ERR})"; exit 1; }
    MODELS_JSON="$(cat "${PROBE_OUT}")"
else
    FAILS=""
    for cand in ${ENDPOINTS}; do
        cbase="$(normalize_endpoint "${cand}")"; cand="${cbase}"
        log_verbose "probing ${cbase} ..."
        if probe "${cbase}" > "${PROBE_OUT}"; then BASE_URL="${cbase}"; MODELS_JSON="$(cat "${PROBE_OUT}")"; break; fi
        FAILS="${FAILS}
  ${cand}  ->  ${PROBE_ERR}"
        log_verbose "  ${cand}: ${PROBE_ERR}"
    done
    if [ -z "${BASE_URL}" ]; then
        log_error "no endpoint reachable:${FAILS}"
        log_error "hints: 'DNS' = this machine isn't using your LAN's DNS server; 'timed out' = name resolves to the wrong IP (public instead of LAN?); 'refused' = server/port down; 'HTTP 502' = start the model server."
        exit 1
    fi
fi

case "${BASE_URL}" in
    https://*)
        if [ -z "${CA_FOUND}" ] && [ "${INSECURE}" != true ]; then
            # only refuse if the cert actually fails system trust
            if ! curl -sf --max-time 4 -H "Authorization: Bearer ${TOKEN}" "${BASE_URL}/v1/models" >/dev/null 2>&1; then
                log_error "${BASE_URL} uses a certificate this machine doesn't trust."
                log_error "Set the CA in ${CONFIG_FILE} (CA_PATH=...) or run with --insecure."
                exit 1
            fi
        fi ;;
esac

DISCOVERED="$(printf '%s' "${MODELS_JSON}" | python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or [{}])[0]
print("%s|%s" % (d.get("id", ""), d.get("max_model_len", "")))' 2>/dev/null)" || DISCOVERED=""
DISCOVERED_ID="${DISCOVERED%%|*}"
DISCOVERED_LEN="${DISCOVERED##*|}"

MODEL="${MODEL_OVERRIDE:-${MODEL}}"
[ -n "${MODEL}" ] || MODEL="${DISCOVERED_ID}"
[ -n "${MODEL}" ] || { log_error "could not discover a model from ${BASE_URL}/v1/models and no --model given."; exit 1; }

CONTEXT="${CONTEXT_OVERRIDE:-${CONTEXT}}"
[ -n "${CONTEXT}" ] || CONTEXT="${DISCOVERED_LEN}"
[ -n "${CONTEXT}" ] || CONTEXT="${DEFAULT_CONTEXT}"
OUTPUT_CAP="${OUTPUT_CAP_OVERRIDE:-${OUTPUT_CAP}}"
[ -n "${OUTPUT_CAP}" ] || OUTPUT_CAP="${DEFAULT_OUTPUT_CAP}"
API="${API_OVERRIDE:-${API}}"
[ -n "${API}" ] || API="${DEFAULT_API}"
VISION="${VISION_OVERRIDE:-${VISION}}"
case "${VISION}" in
    ""|true|false) ;;
    *) log_error "vision must be empty (auto-detect), true, or false (got: ${VISION}) — set it via --vision / --no-vision, LETS_CODE_VISION, or VISION= in ${CONFIG_FILE} (if present)."; exit 1 ;;
esac
case "${REASONING}" in
    ""|true|false) ;;
    *) log_error "REASONING must be empty (auto-detect), true, or false (got: ${REASONING}) — pin it in ${CONFIG_FILE} (if present) or via LETS_CODE_REASONING."; exit 1 ;;
esac
THINKING="${THINKING_OVERRIDE:-${THINKING}}"
[ -n "${THINKING}" ] || THINKING="${DEFAULT_THINKING}"
# auto[:<ceiling>]: dynamic thinking. Start with thinking off; the agent
# guard raises it to <ceiling> (default high) for a short burst when a
# struggle signal fires, and drops it back as soon as the signal is resolved.
# adaptive[:<ceiling>] (the default): medium while the task is unsolved, off once
# pi's own tests pass, bursts to <ceiling> (default high) on struggle signals.
THINKING_AUTO=""; THINKING_BASE=""
case "${THINKING}" in
    adaptive)   THINKING_AUTO="high"; THINKING_BASE="medium"; THINKING="medium" ;;
    adaptive:*) THINKING_AUTO="${THINKING#adaptive:}"; THINKING_BASE="medium"; THINKING="medium"
                case "${THINKING_AUTO}" in
                    low|medium|high|xhigh|max) ;;
                    *) log_error "adaptive thinking needs a ceiling: adaptive:low|medium|high|xhigh|max (got: adaptive:${THINKING_AUTO})"; exit 1 ;;
                esac ;;
    auto)   THINKING_AUTO="high"; THINKING="off" ;;
    auto:*) THINKING_AUTO="${THINKING#auto:}"; THINKING="off"
            case "${THINKING_AUTO}" in
                minimal|low|medium|high|xhigh|max) ;;
                *) log_error "auto thinking needs a level to raise to: auto:minimal|low|medium|high|xhigh|max (got: auto:${THINKING_AUTO})"; exit 1 ;;
            esac ;;
esac
case "${THINKING}" in
    off|minimal|low|medium|high|xhigh|max) ;;
    *) log_error "thinking level must be one of off|minimal|low|medium|high|xhigh|max|adaptive[:<ceiling>]|auto[:<level>] (got: ${THINKING}) — set it via --thinking-level, LETS_CODE_THINKING, or THINKING= in ${CONFIG_FILE} (if present)."; exit 1 ;;
esac

case "${CONTEXT}" in
    *[!0-9]*|0) log_error "context length must be a positive integer (tokens); got: ${CONTEXT} (from --context or config/env)."; exit 1 ;;
esac
case "${OUTPUT_CAP}" in
    *[!0-9]*|0) log_error "output cap must be a positive integer (tokens); got: ${OUTPUT_CAP} (from --output-cap or config/env)."; exit 1 ;;
esac
if [ "${CONTEXT}" -le "${OUTPUT_CAP}" ]; then
    log_error "context (${CONTEXT}) must exceed the output cap (${OUTPUT_CAP}) — no room left for input."
    exit 1
fi

# pi's OpenAI SDK builds request paths relative to baseUrl and never appends
# /v1 itself, so OpenAI-family dialects get the /v1 suffix written into pi;
# anthropic-messages/google-generative-ai gateways take the bare base.
PROVIDER_BASE="${BASE_URL}"
case "${API}" in
    openai-completions|openai-responses) PROVIDER_BASE="${BASE_URL}/v1" ;;
esac
# thinking support: the REASONING pin (config/env) wins; otherwise one
# minimal test request auto-detects a resident thinking model
# (OpenAI-dialect endpoints only).
REASONING_SUPPORTED="false"
if [ -n "${REASONING}" ]; then
    REASONING_SUPPORTED="${REASONING}"
else
    case "${API}" in
        openai-completions|openai-responses)
            log_verbose "probing thinking support for ${MODEL} ..."
            probe_thinking "${BASE_URL}" "${MODEL}"
            case "${THINKING_DETECTED}" in
                true)  REASONING_SUPPORTED="true" ;;
                false) ;;
                *)     log "thinking probe inconclusive — registering without thinking; pin REASONING=true in ${CONFIG_FILE} (if present) if ${MODEL} supports it." ;;
            esac ;;
        *)
            log "thinking auto-detection needs an OpenAI-dialect endpoint — registering without thinking (pin REASONING=true if ${MODEL} supports it)." ;;
    esac
fi
log "thinking support: ${REASONING_SUPPORTED} (startup level: ${THINKING})"
# image input: the VISION pin (--vision/--no-vision, config/env) wins;
# otherwise one tiny image request auto-detects a vision model
# (OpenAI-dialect endpoints only). Inconclusive -> text-only, with a hint.
if [ -z "${VISION}" ]; then
    VISION="false"
    case "${API}" in
        openai-completions|openai-responses)
            log_verbose "probing image support for ${MODEL} ..."
            probe_vision "${BASE_URL}" "${MODEL}"
            case "${VISION_DETECTED}" in
                true)  VISION="true" ;;
                false) ;;
                *)     log "vision probe inconclusive — registering as text-only; pin VISION=true in ${CONFIG_FILE} (if present) or run 'lets-code setup' if ${MODEL} accepts images." ;;
            esac ;;
        *)
            log "vision auto-detection needs an OpenAI-dialect endpoint — registering as text-only (pin VISION=true if ${MODEL} accepts images)." ;;
    esac
fi
log "image input: ${VISION}"
if [ "${REASONING_SUPPORTED}" = false ] && [ "${THINKING}" != off ]; then
    log "note: thinking level ${THINKING} not applied — model not registered as a thinking model."
fi
EFFORT_MAP=""
if [ "${REASONING_SUPPORTED}" = true ] && [ "${API}" = openai-completions ]; then
    case "$(printf '%s' "${TEMPLATE_EFFORT}" | tr '[:upper:]' '[:lower:]')" in
        off|false|no|0) log_verbose "template effort: off (TEMPLATE_EFFORT=off)" ;;
        neutral) probe_template_effort "${BASE_URL}" "${MODEL}" 1
                 log "${EFFORT_NOTE} (neutral)" ;;
        *) probe_template_effort "${BASE_URL}" "${MODEL}"
           log "${EFFORT_NOTE}" ;;
    esac
fi
pi_write_configs "${PROVIDER_BASE}" "${API}" "${MODEL}" "${CONTEXT}" "${OUTPUT_CAP}" "${VISION}" "${REASONING_SUPPORTED}" "${THINKING}" "${EFFORT_MAP}"

export LETS_CODE_TOKEN="${TOKEN}"
export PI_SKIP_VERSION_CHECK=1
case "${BASE_URL}" in
    https://*)
        if [ -n "${CA_FOUND}" ]; then
            export NODE_EXTRA_CA_CERTS="${CA_FOUND}"
        elif [ "${INSECURE}" = true ]; then
            export NODE_TLS_REJECT_UNAUTHORIZED=0
        fi ;;
esac

mem_guard_plan
case "${MG_MODE}" in
    off) MG_DESC="memory guard is off (${MG_NOTE})" ;;
    *)   pi_write_memguard_extension
         MG_DESC="memory guard is on" ;;
esac

GG_BRANCH=""
git_guard_plan
case "${GG_MODE}" in
    off) GG_DESC="git guard is off (${GG_NOTE})" ;;
    *)   pi_write_gitguard_extension
         GG_DESC="git guard: ${GG_BRANCH:-no pi/* branch yet}" ;;
esac

unset LETS_CODE_AGENT_GUARD_ON LETS_CODE_THINKING_AUTO LETS_CODE_THINKING_BASE LETS_CODE_THINKING_DOWN
THINKING_DESC="${THINKING}"
case "$(printf '%s' "${AGENT_GUARD}" | tr '[:upper:]' '[:lower:]')" in
    false|no|0|off)
        AG_DESC="agent guard is off (disabled)"
        if [ -n "${THINKING_AUTO}" ]; then
            log "note: ${THINKING_BASE:+adaptive}${THINKING_BASE:-auto} thinking needs the agent guard; thinking stays at ${THINKING}."
            THINKING_AUTO=""
        fi ;;
    *)
        export LETS_CODE_AGENT_GUARD_ON=1
        pi_write_agentguard_extension
        AG_DESC="agent guard is on" ;;
esac
if [ -n "${THINKING_AUTO}" ]; then
    if [ "${REASONING_SUPPORTED}" = true ]; then
        export LETS_CODE_THINKING_AUTO="${THINKING_AUTO}"
        if [ -n "${THINKING_BASE}" ]; then
            export LETS_CODE_THINKING_BASE="${THINKING_BASE}" LETS_CODE_THINKING_DOWN="low"
            THINKING_DESC="adaptive (${THINKING_BASE}; low once tests pass and work settles; bursts to ${THINKING_AUTO} on struggle)"
        else
            THINKING_DESC="auto (off; bursts to ${THINKING_AUTO} on struggle)"
        fi
    else
        log "note: ${THINKING_BASE:+adaptive}${THINKING_BASE:-auto} thinking not applied — model not registered as a thinking model."
    fi
fi

log "connecting: ${BASE_URL}  harness: ${HARNESS}  model: ${MODEL}  context: ${CONTEXT}  output cap: ${OUTPUT_CAP}  vision: ${VISION}  thinking: ${THINKING_DESC}  api: ${API}  ${MG_DESC}  ${GG_DESC}  ${AG_DESC}"
if [ ${#PASSTHROUGH[@]} -eq 0 ]; then
    mem_guard_exec pi --provider "${PROVIDER_ID}" --model "${MODEL}"
else
    mem_guard_exec pi --provider "${PROVIDER_ID}" --model "${MODEL}" "${PASSTHROUGH[@]}"
fi
