    else
        log_verbose "backend: a Claude model is saved as pi's default, but Claude Code is not installed here and CLAUDE_URL is not set; using the configured server"
    fi
fi
if [ "${BACKEND}" = claude ]; then
    [ -z "${URL_OVERRIDE}" ] || { log_error "--url picks a server and does not combine with the Claude backend."; exit 1; }
    if [ -n "${CLAUDE_TOKEN}" ] && ! is_claude_token "${CLAUDE_TOKEN}"; then
        log_error "CLAUDE_TOKEN is not a whole Claude Code token (${#CLAUDE_TOKEN} characters; 'claude setup-token' prints one, sk-ant-oat01-..., and a narrow terminal can wrap it over lines)."
        exit 1
    fi
    if [ -n "${CLAUDE_URL}" ]; then
        # another machine's proxy: checked now, so a problem is one clear line
        # instead of a failed first request
        case "$(claude_proxy_status "${CLAUDE_URL}" "${CLAUDE_TOKEN}")" in
            200) ;;
