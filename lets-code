function scheduleCheckpoint(dir: string): void {
	const repo = repoOf(dir);
	if (!repo || !repo.branch.startsWith(PREFIX)) return;
	const top = repo.top;
	const t = cpTimers.get(top); if (t) clearTimeout(t);
	const timer = setTimeout(() => {
		cpTimers.delete(top);
		if (cpRunning.has(top)) { cpAgain.add(top); return; }
		cpRunning.add(top);
		const p = checkpoint(top).catch(() => { /* never break pi */ }).finally(() => {
			cpRunning.delete(top); cpInFlight = cpInFlight.filter((x) => x !== p);
			if (cpAgain.delete(top)) scheduleCheckpoint(top);
