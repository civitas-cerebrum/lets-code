export function pathPatternMatches(spec: string, base: string, cwd: string, path: string): boolean {
	let p = spec.trim(); let root: string;
	if (p.startsWith("//")) { root = "/"; p = p.slice(2); }
	else if (p.startsWith("~/")) { root = home(); p = p.slice(2); }
	else if (p.startsWith("/")) { root = base; p = p.slice(1); }
	else { root = cwd; p = p.replace(/^\.\//, ""); if (!p.replace(/\/$/, "").includes("/")) p = `**/${p}`; }
