# Claude Code adapter: a project or user set up for Claude Code works in pi
# as it is, read at each start (CLAUDE.md and imports, skills, commands,
# hooks, permissions, MCP, workflows; agents through the subagents module,
# settings env through claude_code_scan). On by default, inert where there
# is no .claude/ folder, CLAUDE.md or ~/.claude.
pi_write_claudecode_extension() {
    local dir f tmp
    lc_ext_module claude-code; dir="${LC_MOD_DIR}"; f="${LC_MOD_FILE}"
    tmp="$(mktemp "${dir}/.claude-code.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (claude-code); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with the Claude Code adapter on
// (LETS_CODE_CLAUDE_CODE_ON=1). A project or user set up for Claude Code
// works here as it is: everything is read live at each start, nothing is
// copied or converted.
//   memory       ~/.claude/CLAUDE.md, .claude/CLAUDE.md, CLAUDE.local.md,
//                .claude/rules/*.md without paths:, a CLAUDE.md pi passes over
//                for an AGENTS.md, and @path imports (4 hops), as context files
//   skills       .claude/skills up to the git root and ~/.claude/skills, as pi
//                skills (name + description in the prompt), also /<name>
//   commands     .claude/commands/**/*.md and ~/.claude/commands: /<dir>:<name>
//                with $ARGUMENTS, $N, $name, !`cmd` and @file
//   hooks        the settings files' hooks on pi's events, with Claude's
//                stdin JSON, exit codes and JSON output
//   permissions  allow / ask / deny rules; lets-code's guards stay authoritative
//   MCP          .mcp.json and ~/.claude.json (user and local scope), with
//                Claude's approvals
//   workflows    .claude/workflows/*.js: the `workflow` tool, /workflow and
//                /<name>, each agent() a child pi (needs subagents on)
// Agent files (.claude/agents) are read by the subagents module; settings
// `env` is exported by the launcher.
//
// Trust, as Claude Code does it: user-level files always count. Project
// hooks, MCP servers, env, allow rules, agents, workflows and the !`cmd` of
// project commands need the folder trusted: in Claude Code (~/.claude.json
// projects[<dir or a parent>].hasTrustDialogAccepted), in pi (trust.json),
// or by the answer to the one question asked here with a UI (remembered in
// lets-code-state.json, key claudeCodeTrust). Without a UI an untrusted
// folder's project parts are skipped with a one-line note. deny and ask
// rules always apply: they only tighten. Hooks are a snapshot taken at
// session start; edits apply to the next session.
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import { existsSync, mkdirSync, readdirSync, readFileSync, realpathSync, renameSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import vm from "node:vm";
import { Type } from "typebox";

const ACTIVE = process.env.LETS_CODE_CLAUDE_CODE_ON === "1";
const DEPTH = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
const MAX_DEPTH = Number(process.env.LETS_CODE_SUBAGENT_MAX_DEPTH ?? "1") || 1;
const CONCURRENCY = Math.max(1, Number(process.env.LETS_CODE_SUBAGENT_CONCURRENCY ?? "2") || 2);
const agentDir = () => process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const home = () => process.env.HOME || homedir();
// Claude Code's own override moves both ~/.claude and ~/.claude.json
export const claudeDir = () => process.env.CLAUDE_CONFIG_DIR || join(home(), ".claude");
export const claudeJsonPath = () => (process.env.CLAUDE_CONFIG_DIR ? join(process.env.CLAUDE_CONFIG_DIR, ".claude.json") : join(home(), ".claude.json"));
// CLAUDE_CODE=all also brings the user's own ~/.claude (hooks, skills,
// commands, agents, workflows, CLAUDE.md, MCP, env); the default (auto) only
// the project's .claude, and only where it has hooks or workflows
export const userScope = () => process.env.LETS_CODE_CLAUDE_SCOPE === "all";
// a folder whose .claude is the user's own (the home folder) is not a project
export const isUserClaude = (d: string) => resolve(d, ".claude") === resolve(claudeDir());
const MAX_FILE = 256 * 1024;
const CAP = 10_000;          // Claude's cap on one hook's context or message
const short = (s: string, n = 190) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);

// ------------------------------------------------------------------ files
function readJson(p: string): any {
	try { return JSON.parse(readFileSync(p, "utf8")); } catch { return undefined; }
}
function readText(p: string): string | undefined {
	try { const s = statSync(p); if (!s.isFile() || s.size > MAX_FILE) return undefined; return readFileSync(p, "utf8"); } catch { return undefined; }
}
function real(p: string): string { try { return realpathSync(p); } catch { return resolve(p); } }
function isDir(p: string): boolean { try { return statSync(p).isDirectory(); } catch { return false; } }
function under(p: string, root: string): boolean { const r = relative(root, p); return r === "" || (!r.startsWith("..") && !isAbsolute(r)); }
// the directory and its parents, nearest first
function ancestors(dir: string, stop?: string): string[] {
	const out: string[] = []; let d = resolve(dir);
	while (true) { out.push(d); if (stop && d === stop) break; const p = dirname(d); if (p === d) break; d = p; }
	return out;
}
export function gitRoot(cwd: string): string | undefined { return ancestors(cwd).find((d) => existsSync(join(d, ".git"))); }
// project .claude dirs are looked up from cwd to the git root (cwd alone outside git)
const projectDirs = (cwd: string) => ancestors(cwd, gitRoot(cwd) ?? resolve(cwd)).filter((d) => !isUserClaude(d));
const expandHome = (p: string) => (p === "~" ? home() : p.startsWith("~/") ? join(home(), p.slice(2)) : p);

// A small YAML subset for frontmatter: key: value, quoted strings, inline
// [a, b] and block (- a) lists, folded (>) and literal (|) blocks, booleans.
export function parseFrontmatter(text: string): { fm: Record<string, any>; body: string } {
	const m = /^---\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)([\s\S]*)$/.exec(text);
	if (!m) return { fm: {}, body: text };
	const fm: Record<string, any> = {}; const lines = m[1].split(/\r?\n/);
	const scalar = (v: string): any => {
		v = v.trim();
		if (/^".*"$/.test(v)) { try { return JSON.parse(v); } catch { return v.slice(1, -1); } }
		if (/^'.*'$/.test(v)) return v.slice(1, -1).replace(/''/g, "'");
		if (/^\[.*\]$/.test(v)) return v.slice(1, -1).split(",").map((x) => scalar(x)).filter((x) => x !== "");
		if (/^(true|yes|on)$/i.test(v)) return true;
		if (/^(false|no|off)$/i.test(v)) return false;
		return v;
	};
	for (let i = 0; i < lines.length; i++) {
		const kv = /^([A-Za-z_][\w-]*)\s*:\s*(.*)$/.exec(lines[i]);
		if (!kv) continue;
		const key = kv[1]; const v = kv[2].trim();
		if (/^[>|][+-]?$/.test(v)) {        // block scalar: the indented lines that follow
			const block: string[] = [];
			while (i + 1 < lines.length && (/^\s+\S/.test(lines[i + 1]) || lines[i + 1].trim() === "")) block.push(lines[++i].trim());
			fm[key] = v.startsWith(">") ? block.join(" ").replace(/\s+/g, " ").trim() : block.join("\n").trim();
		} else if (v === "") {               // a block list, or nothing
			const items: any[] = [];
			while (i + 1 < lines.length && /^\s*-\s+/.test(lines[i + 1])) items.push(scalar(lines[++i].replace(/^\s*-\s+/, "")));
			fm[key] = items.length ? items : "";
		} else fm[key] = scalar(v);
	}
	return { fm, body: m[2] };
}
export function asList(v: unknown): string[] {
	if (Array.isArray(v)) return v.map(String).map((s) => s.trim()).filter(Boolean);
	if (typeof v === "string") return v.split(/[,\s]+(?![^(]*\))/).map((s) => s.trim()).filter(Boolean);
	return [];
}

// ------------------------------------------------------------------ trust
function nearestEntry<T>(map: Record<string, T> | undefined, cwd: string, value: (v: T) => boolean | null | undefined): boolean | null {
	if (!map || typeof map !== "object") return null;
	for (const d of [...new Set([...ancestors(real(cwd)), ...ancestors(resolve(cwd))])]) {
		const v = map[d] === undefined ? undefined : value(map[d]);
		if (v === true || v === false) return v;
	}
	return null;
}
// Claude Code: a folder whose trust dialog was accepted, or a parent of it
export function claudeTrusted(cwd: string): boolean {
	return nearestEntry<any>(readJson(claudeJsonPath())?.projects, cwd, (p) => (p?.hasTrustDialogAccepted === true ? true : null)) === true;
}
// pi: an explicit entry in trust.json (pi calls a folder without .pi resources trusted, which says nothing here)
export function piTrusted(cwd: string): boolean | null { return nearestEntry<any>(readJson(join(agentDir(), "trust.json")), cwd, (v) => v); }
const statePath = () => join(agentDir(), "lets-code-state.json");
export function rememberedTrust(cwd: string): boolean | null { return nearestEntry<any>(readJson(statePath())?.claudeCodeTrust, cwd, (v) => v); }
export function rememberTrust(cwd: string, decision: boolean): void {
	try {   // merge-safe: other keys of the file stay
		const p = statePath(); const s = readJson(p) ?? {};
		s.claudeCodeTrust = { ...(s.claudeCodeTrust ?? {}), [real(cwd)]: decision };
		mkdirSync(dirname(p), { recursive: true });
		const tmp = `${p}.${process.pid}.tmp`; writeFileSync(tmp, JSON.stringify(s, null, 2) + "\n"); renameSync(tmp, p);
	} catch { /* never fatal */ }
}
export function trustDecision(cwd: string): { trusted: boolean; source: string } {
	const inherited = process.env.LETS_CODE_CLAUDE_TRUST;   // a subagent gets its parent's decision
	if (DEPTH > 0 && (inherited === "1" || inherited === "0")) return { trusted: inherited === "1", source: "parent" };
	if (claudeTrusted(cwd)) return { trusted: true, source: "claude" };
	if (piTrusted(cwd) === true) return { trusted: true, source: "pi" };
	const r = rememberedTrust(cwd);
	return r === null ? { trusted: false, source: "undecided" } : { trusted: r, source: "lets-code" };
}

// --------------------------------------------------------------- settings
export interface HookDef { event: string; matcher: string; type: string; command?: string; url?: string; headers?: Record<string, string>; allowedEnvVars?: string[]; timeout?: number; scope: string }
export interface Rule { raw: string; tool: string; spec?: string; base: string }
export interface Settings {
	hooks: HookDef[]; allow: Rule[]; ask: Rule[]; deny: Rule[]; env: Record<string, string>; disableAllHooks: boolean;
	enableAllProjectMcpServers: boolean; enabledMcpjsonServers: string[]; disabledMcpjsonServers: string[];
	untrustedHooks: HookDef[]; untrustedEnv: string[];
}
export function parseRule(raw: string, base: string): Rule | null {
	const m = /^\s*([^()\s]+)\s*(?:\(([\s\S]*)\))?\s*$/.exec(String(raw));
	return m ? { raw: String(raw).trim(), tool: m[1], spec: m[2] === undefined || m[2] === "*" ? undefined : m[2], base } : null;
}
export function settingsLayers(cwd: string): { scope: "user" | "project" | "local"; file: string; data: any }[] {
	const out: { scope: "user" | "project" | "local"; file: string; data: any }[] = [];
	const add = (scope: "user" | "project" | "local", file: string) => { const d = readJson(file); if (d && typeof d === "object") out.push({ scope, file, data: d }); };
	if (userScope()) add("user", join(claudeDir(), "settings.json"));
	if (!isUserClaude(cwd)) {
		add("project", join(cwd, ".claude", "settings.json"));
		add("local", join(cwd, ".claude", "settings.local.json"));
	}
	return out;
}
export function loadSettings(cwd: string, trusted: boolean): Settings {
	const s: Settings = { hooks: [], allow: [], ask: [], deny: [], env: {}, disableAllHooks: false, enableAllProjectMcpServers: false, enabledMcpjsonServers: [], disabledMcpjsonServers: [], untrustedHooks: [], untrustedEnv: [] };
	let disable: boolean | undefined;
	for (const l of settingsLayers(cwd)) {
		const ok = l.scope === "user" || trusted;
		const base = dirname(dirname(l.file));
		const p = l.data.permissions ?? {};
		for (const k of ["deny", "ask", "allow"] as const) {
			if (k === "allow" && !ok) continue;     // deny and ask only tighten: they apply untrusted too
			for (const r of Array.isArray(p[k]) ? p[k] : []) { const rule = parseRule(r, base); if (rule) s[k].push(rule); }
		}
		const hooks: HookDef[] = [];
		for (const [event, groups] of Object.entries(l.data.hooks ?? {})) {
			for (const g of Array.isArray(groups) ? groups : []) {
				for (const h of Array.isArray((g as any)?.hooks) ? (g as any).hooks : []) {
					if (!h || typeof h !== "object") continue;
					hooks.push({ event, matcher: typeof (g as any).matcher === "string" ? (g as any).matcher : "", type: h.type ?? "command", command: h.command, url: h.url, headers: h.headers, allowedEnvVars: h.allowedEnvVars, timeout: typeof h.timeout === "number" ? h.timeout : undefined, scope: l.scope });
				}
			}
		}
		if (ok) s.hooks.push(...hooks); else s.untrustedHooks.push(...hooks);
		if (l.data.env && typeof l.data.env === "object") {
			if (ok) Object.assign(s.env, Object.fromEntries(Object.entries(l.data.env).map(([k, v]) => [k, String(v)])));
			else s.untrustedEnv.push(...Object.keys(l.data.env));
		}
		if (ok && typeof l.data.disableAllHooks === "boolean") disable = l.data.disableAllHooks;
		// MCP approvals from a committed project file count only in a trusted folder
		if (ok || l.scope === "local") {
			if (l.data.enableAllProjectMcpServers === true) s.enableAllProjectMcpServers = true;
			s.enabledMcpjsonServers.push(...asList(l.data.enabledMcpjsonServers));
		}
		s.disabledMcpjsonServers.push(...asList(l.data.disabledMcpjsonServers));
	}
	s.disableAllHooks = disable === true;
	if (s.disableAllHooks) s.hooks = [];
	return s;
}

// ------------------------------------------------------------------ tools
// pi's tools under their Claude Code names (subagent is Claude's Agent, once Task)
const TO_CLAUDE: Record<string, string> = { bash: "Bash", read: "Read", write: "Write", edit: "Edit", grep: "Grep", find: "Glob", ls: "LS", subagent: "Agent", workflow: "Workflow" };
export const claudeToolName = (pi: string) => TO_CLAUDE[pi] ?? pi;
const ALIASES: Record<string, string[]> = { Agent: ["Agent", "Task"] };
const abs = (p: unknown, cwd: string) => { const s = String(p ?? "."); return isAbsolute(expandHome(s)) ? expandHome(s) : resolve(cwd, s); };
const drop = (o: Record<string, unknown>) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));

export function toClaudeInput(tool: string, input: any, cwd: string): Record<string, unknown> {
	const i = input ?? {};
	switch (tool) {
		case "bash": return drop({ command: i.command, timeout: typeof i.timeout === "number" ? i.timeout * 1000 : undefined, description: "" });
		case "read": return drop({ file_path: abs(i.path, cwd), offset: i.offset, limit: i.limit });
		case "write": return { file_path: abs(i.path, cwd), content: i.content };
		case "edit": {
			const edits: any[] = Array.isArray(i.edits) ? i.edits : i.oldText !== undefined ? [{ oldText: i.oldText, newText: i.newText }] : [];
			return drop({ file_path: abs(i.path, cwd), old_string: edits[0]?.oldText, new_string: edits[0]?.newText, replace_all: false,
				edits: edits.length > 1 ? edits.map((e) => ({ old_string: e.oldText, new_string: e.newText })) : undefined });
		}
		case "grep": return drop({ pattern: i.pattern, path: i.path === undefined ? undefined : abs(i.path, cwd), glob: i.glob, "-i": i.ignoreCase, "-C": i.context, head_limit: i.limit, output_mode: "content" });
		case "find": return drop({ pattern: i.pattern, path: i.path === undefined ? undefined : abs(i.path, cwd) });
		case "ls": return { path: abs(i.path, cwd) };
		case "subagent": return drop({ subagent_type: i.agent ?? i.tasks?.[0]?.agent ?? i.chain?.[0]?.agent, prompt: i.task ?? i.tasks?.[0]?.task ?? i.chain?.[0]?.task, description: "", tasks: i.tasks, chain: i.chain });
		default: return { ...i };
	}
}
// A hook's updatedInput, in Claude's names, back into pi's schema for the tool
export function fromClaudeInput(tool: string, upd: any, orig: any): Record<string, unknown> {
	const u = upd ?? {}; const o = orig ?? {};
	const pick = (k: string, fallback: unknown) => (u[k] !== undefined ? u[k] : fallback);
	switch (tool) {
		case "bash": return drop({ command: pick("command", o.command), timeout: typeof u.timeout === "number" ? u.timeout / 1000 : o.timeout });
		case "read": return drop({ path: pick("file_path", o.path), offset: pick("offset", o.offset), limit: pick("limit", o.limit) });
		case "write": return { path: pick("file_path", o.path), content: pick("content", o.content) };
		case "edit": {
			let edits = o.edits;
			if (Array.isArray(u.edits)) edits = u.edits.map((e: any) => ({ oldText: e.old_string, newText: e.new_string }));
			else if (u.old_string !== undefined || u.new_string !== undefined) {
				const first = { oldText: pick("old_string", o.edits?.[0]?.oldText ?? o.oldText), newText: pick("new_string", o.edits?.[0]?.newText ?? o.newText) };
				edits = [first, ...(Array.isArray(o.edits) ? o.edits.slice(1) : [])];
			}
			return drop({ path: pick("file_path", o.path), edits });
		}
		case "grep": return drop({ pattern: pick("pattern", o.pattern), path: pick("path", o.path), glob: pick("glob", o.glob), ignoreCase: pick("-i", o.ignoreCase), literal: o.literal, context: pick("-C", o.context), limit: pick("head_limit", o.limit) });
		case "find": return drop({ pattern: pick("pattern", o.pattern), path: pick("path", o.path), limit: o.limit });
		case "ls": return drop({ path: pick("path", o.path), limit: o.limit });
		case "subagent": return drop({ ...o, agent: u.subagent_type ?? o.agent, task: u.prompt ?? o.task });
		default: return { ...o, ...u };
	}
}
// tool_response in roughly Claude's shape for the tool
export function toolResponse(tool: string, input: any, content: any[], isError: boolean): unknown {
	const text = (content ?? []).filter((c: any) => c?.type === "text").map((c: any) => c.text).join("\n");
	const i = input ?? {};
	switch (tool) {
		case "bash": return { stdout: text, stderr: "", interrupted: false, isImage: false };
		case "read": return { type: "text", file: { filePath: i.path, content: text } };
		case "write": return { type: "create", filePath: i.path, content: i.content, success: !isError };
		case "edit": return { filePath: i.path, oldString: i.edits?.[0]?.oldText, newString: i.edits?.[0]?.newText, replaceAll: false, success: !isError };
		case "find": { const f = text.split("\n").filter(Boolean); return { filenames: f, numFiles: f.length }; }
		default: return { content: text };
	}
}

// --------------------------------------------------------------- matchers
// Claude's rule: "", "*" or none = all; only letters, digits, _, -, spaces,
// "," and "|" = an exact name or a list of them; anything else an unanchored regex
export function matcherMatches(matcher: string | undefined, value: string | string[]): boolean {
	const m = (matcher ?? "").trim(); const values = Array.isArray(value) ? value : [value];
	if (m === "" || m === "*") return true;
	if (/^[\w\s,|-]+$/.test(m)) { const names = m.split(/[|,]/).map((s) => s.trim()).filter(Boolean); return values.some((v) => names.includes(v)); }
	try { const re = new RegExp(m); return values.some((v) => re.test(v)); } catch { return false; }
}
const toolNames = (claude: string) => ALIASES[claude] ?? [claude];
const MATCHED: Record<string, boolean> = { PreToolUse: true, PostToolUse: true, PostToolUseFailure: true, SessionStart: true, SessionEnd: true, PreCompact: true, Notification: true, SubagentStart: true, SubagentStop: true };
export function selectHooks(hooks: HookDef[], event: string, value?: string | string[]): HookDef[] {
	const seen = new Set<string>(); const out: HookDef[] = [];
	for (const h of hooks) {
		if (h.event !== event) continue;
		if (h.type !== "command" && h.type !== "http") continue;
		if (MATCHED[event] && value !== undefined && !matcherMatches(h.matcher, value)) continue;
		const key = `${h.type}\0${h.command ?? h.url}`;    // identical handlers run once
		if (seen.has(key)) continue;
		seen.add(key); out.push(h);
	}
	return out;
}

// ------------------------------------------------------------------ hooks
export interface HookRun { hook: HookDef; code: number | null; stdout: string; stderr: string; timedOut?: boolean; error?: string }
const DEFAULT_TIMEOUT: Record<string, number> = { UserPromptSubmit: 30 };
export function runHook(hook: HookDef, input: Record<string, unknown>, opts: { cwd: string; signal?: AbortSignal; timeoutMs?: number }): Promise<HookRun> {
	const ms = opts.timeoutMs ?? (hook.timeout ?? DEFAULT_TIMEOUT[hook.event] ?? 600) * 1000;
	const body = JSON.stringify(input);
	if (hook.type === "http") {
		const headers: Record<string, string> = { "content-type": "application/json" };
		for (const [k, v] of Object.entries(hook.headers ?? {})) headers[k] = String(v).replace(/\$\{?([A-Za-z_]\w*)\}?/g, (all, n) => ((hook.allowedEnvVars ?? []).includes(n) ? process.env[n] ?? "" : all));
		const signals = [AbortSignal.timeout(ms), ...(opts.signal ? [opts.signal] : [])];
		return fetch(String(hook.url), { method: "POST", headers, body, signal: AbortSignal.any(signals) })
			.then(async (r) => ({ hook, code: r.ok ? 0 : 1, stdout: await r.text(), stderr: r.ok ? "" : `HTTP ${r.status}` }))
			.catch((e) => ({ hook, code: null, stdout: "", stderr: "", error: e instanceof Error ? e.message : String(e), timedOut: /timeout/i.test(String(e)) }));
	}
	return new Promise((done) => {
		const r: HookRun = { hook, code: null, stdout: "", stderr: "" };
		let child: ReturnType<typeof spawn>;
		try { child = spawn("sh", ["-c", String(hook.command ?? "")], { cwd: opts.cwd, env: { ...process.env, CLAUDE_PROJECT_DIR: opts.cwd }, stdio: ["pipe", "pipe", "pipe"] }); }
		catch (e) { r.error = (e as Error).message; done(r); return; }
		const kill = () => { try { child.kill("SIGTERM"); } catch { /* gone */ } setTimeout(() => { try { child.kill("SIGKILL"); } catch { /* gone */ } }, 2000).unref(); };
		const timer = setTimeout(() => { r.timedOut = true; kill(); }, ms);
		const onAbort = () => kill();
		opts.signal?.addEventListener("abort", onAbort, { once: true });
		child.stdout!.on("data", (d) => { if (r.stdout.length < 1_000_000) r.stdout += d.toString(); });
		child.stderr!.on("data", (d) => { if (r.stderr.length < 100_000) r.stderr += d.toString(); });
		child.stdin!.on("error", () => { /* the hook did not read its input */ });
		child.stdin!.end(body);
		child.on("error", (e) => { r.error = e.message; });
		child.on("close", (code) => { clearTimeout(timer); opts.signal?.removeEventListener("abort", onAbort); r.code = r.timedOut ? null : code; done(r); });
	});
}

export interface Outcome {
	decision?: "allow" | "deny" | "ask"; reason?: string; block?: string; updatedInput?: Record<string, unknown>;
	updatedOutput?: unknown; context: string[]; stop?: string; notices: string[];
}
// exit 2 blocks these (stderr to the model, or to the user for a prompt)
const BLOCKING = new Set(["PreToolUse", "UserPromptSubmit", "Stop", "SubagentStop", "PreCompact"]);
// plain stdout on exit 0 becomes context for these
const STDOUT_CONTEXT = new Set(["UserPromptSubmit", "SessionStart"]);
const RANK: Record<string, number> = { allow: 1, ask: 2, deny: 3 };
export function interpret(event: string, runs: HookRun[]): Outcome {
	const o: Outcome = { context: [], notices: [] };
	const cmd = (r: HookRun) => short(String(r.hook.command ?? r.hook.url ?? ""), 60);
	const decide = (d: string | undefined, reason: string | undefined) => {
		if (!d || !RANK[d]) return;     // "defer" and unknown values leave the normal flow
		if (!o.decision || RANK[d] > RANK[o.decision]) { o.decision = d as Outcome["decision"]; o.reason = reason; }
	};
	const block = (reason: string) => { if (o.block === undefined) o.block = reason; };
	for (const r of runs) {
		if (r.error || r.timedOut) { o.notices.push(`${event} hook ${r.timedOut ? "timed out" : `failed (${r.error})`}: ${cmd(r)}`); continue; }
		const err = r.stderr.trim();
		const out = r.stdout.trim();
		let j: any;
		if ((r.code === 0 || r.code === 2) && out.startsWith("{")) { try { j = JSON.parse(out); } catch { j = undefined; } }
		if (r.code === 2) {
			const why = err || "blocked by a hook";
			if (event === "PreToolUse") decide("deny", why);
			else if (BLOCKING.has(event)) block(why);
			else if (event === "PostToolUse" || event === "PostToolUseFailure") o.context.push(why.slice(0, CAP));
			else o.notices.push(`${event} hook: ${short(why)}`);
		} else if (r.code !== 0) {
			o.notices.push(`${event} hook failed with non-blocking status code ${r.code}: ${short(err.split("\n")[0] || cmd(r))}`);
			continue;
		}
		if (j && typeof j === "object") {
			if (j.continue === false) o.stop = String(j.stopReason ?? "stopped by a hook");
			if (typeof j.systemMessage === "string" && j.systemMessage) o.notices.push(j.systemMessage.slice(0, CAP));
			if (j.decision === "block") { if (event === "PreToolUse") decide("deny", j.reason); else block(String(j.reason ?? "blocked by a hook")); }
			if (j.decision === "approve" && event === "PreToolUse") decide("allow", j.reason);
			const h = j.hookSpecificOutput;
			if (h && typeof h === "object") {
				if (event === "PreToolUse") decide(h.permissionDecision, h.permissionDecisionReason);
				if (h.updatedInput && typeof h.updatedInput === "object" && o.updatedInput === undefined && h.permissionDecision !== "deny") o.updatedInput = h.updatedInput;
				if (h.updatedToolOutput !== undefined) o.updatedOutput = h.updatedToolOutput;
				if (typeof h.additionalContext === "string" && h.additionalContext) o.context.push(h.additionalContext.slice(0, CAP));
			}
		} else if (r.code === 0 && out && STDOUT_CONTEXT.has(event)) o.context.push(out.slice(0, CAP));
	}
	if (o.decision === "deny") o.updatedInput = undefined;
	return o;
}

