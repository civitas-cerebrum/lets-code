	try {
		const r = await fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(1500) });
		return r.ok ? ((await r.json()) as Health) : { name: "?" };
	} catch {
		return null;   // nothing listening (or not answering)
	}
}

// Starts the daemon unless the current one answers; resolves to an error
// message, or "" when the proxy is up.
export async function ensureProxy(env: Record<string, string | undefined> = process.env, file = SERVER): Promise<string> {
	const port = proxyPort(env);
	const want = proxyVersion(file);
	let h = await health(port);
	if (h?.version === want) return "";
	if (h && h.name !== "lets-code-claude") return `port ${port} is taken by another server; set LETS_CODE_CLAUDE_PORT to a free port`;
	if (h?.pid) {
		// an older proxy (lets-code was updated): its live conversations are
		// replayed by the new one
		try { process.kill(h.pid, "SIGTERM"); } catch { /* gone already */ }
		for (let i = 0; i < 50 && (await health(port)); i++) await sleep(100);
	}
	const state = env.LETS_CODE_CLAUDE_STATE || join(env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent"), "lets-code-claude");
	mkdirSync(state, { recursive: true });
	const logFd = openSync(join(state, "proxy.log"), "a");
	spawn(process.execPath, [file], {
		detached: true,   // the sidecar outlives this session
		cwd: state,       // not pi's project directory
		stdio: ["ignore", logFd, logFd],
		env: { ...env, PORT: String(port), HOST: "127.0.0.1", STATE_DIR: state },
	}).unref();
	closeSync(logFd);   // the sidecar has its own copy
	// a second pi starting at the same moment loses the port and exits; either
	// daemon answering with this version is fine
	for (let i = 0; i < 100; i++) {
		await sleep(100);
		h = await health(port);
		if (h?.version === want) return "";
	}
	return `the Claude proxy did not start; see ${join(state, "proxy.log")}`;
}

// The remote proxy answers with this key: resolves to an error message, or ""
export async function checkRemote(env: Record<string, string | undefined> = process.env): Promise<string> {
	const url = (env.LETS_CODE_CLAUDE_URL ?? "").replace(/\/+$/, "");
	try {
		const r = await fetch(`${url}/health`, { headers: { Authorization: `Bearer ${env.LETS_CODE_CLAUDE_TOKEN ?? ""}` }, signal: AbortSignal.timeout(8000) });
		if (r.ok) return "";
		const msg = ((await r.json().catch(() => ({}))) as any)?.error?.message;
		return `the Claude proxy at ${url} answered ${r.status}${msg ? `: ${msg}` : ""}`;
	} catch (e) {
		return `the Claude proxy at ${url} is not reachable (${e instanceof Error ? e.message : String(e)})`;
	}
}

export default function (pi: ExtensionAPI) {
	const provider = process.env.LETS_CODE_CLAUDE_PROVIDER ?? "";
	if (!provider) return;
	const onClaude = (ctx: any) => ctx?.model?.provider === provider;
	let pending: Promise<string> | null = null;
	// a remote proxy that just answered is trusted for a minute (each check is
	// a round trip); the local one is checked before every request, so a
	// stopped sidecar is back before the request that finds it gone
	const remote = !!process.env.LETS_CODE_CLAUDE_URL;
	let okUntil = 0;
	const ensure = async (ctx: any) => {
		if (remote && Date.now() < okUntil) return;
		pending ??= (remote ? checkRemote() : ensureProxy()).finally(() => { pending = null; });
		const err = await pending;
		if (err) ctx?.ui?.notify?.(`Claude: ${err}`, "error");
		else okUntil = Date.now() + 60_000;
	};
	pi.on("session_start", async (_event: any, ctx: any) => { if (onClaude(ctx)) await ensure(ctx); });
	pi.on("model_select", async (event: any, ctx: any) => { if (event?.model?.provider === provider) await ensure(ctx); });
	pi.on("before_provider_request", async (_event: any, ctx: any) => { if (onClaude(ctx)) await ensure(ctx); return undefined; });
}
