// with a signal, items not started by the time it is aborted are left out (undefined)
export async function mapLimit<T, R>(items: T[], limit: number, fn: (x: T, i: number) => Promise<R>, signal?: AbortSignal): Promise<R[]> {
	const out: R[] = new Array(items.length); let next = 0;
	const worker = async () => { while (next < items.length && !signal?.aborted) { const i = next++; out[i] = await fn(items[i], i); } };
	await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
	return out;
}

// The tool description, always in context, under 160 characters: the agent
// names and the three call shapes. Their jobs are in orchestration().
// the tool description: each agent with its job (so the model knows what is
// there when it needs it), then the three call shapes
export function agentsBlurb(agents: AgentDef[]): string {
	const jobs = agentJobs(agents) || "none yet";
	return `Agents: ${jobs}. Fresh contexts: brief fully. {agent,task} | {tasks:[..]} parallel | {chain:[..]}, {previous}=prior output`;
}
// "name (job)" with the job cut to about 60 characters
export function agentJobs(agents: AgentDef[]): string {
	return agents.map((a) => {
		const d = (a.description || "").replace(/\s+/g, " ").trim();
		return `${a.name} (${d.length > 60 ? d.slice(0, 57).replace(/[\s,;:]+\S*$/, "") + "…" : d || "no description"})`;
	}).join("; ");
}

// When a session gets the orchestration method. Judged on the user's own
// words: code (fenced or inline) is dropped first, so "parallel" or
// "workflow" in a snippet never counts. Strong intent only; "workflow"
// only as something to design or plan, and not about CI pipelines.
export const ORCH_CONTEXT_PCT = 50;
export function wantsOrchestration(prompt: string): boolean {
	const p = String(prompt ?? "").replace(/```[\s\S]*?(```|$)/g, " ").replace(/`[^`\n]*`/g, " ");
	if (/\bsub-?agents?\b|\bdelegat(e|ing|ion)\b|\borchestrat\w*|\bfan[- ]?out\b|\bin parallel\b|\bparalleli[sz](e|ing)\b|\bsplit (the|this) work\b/i.test(p)) return true;
	return /\b(design|plan|build|set up|sketch)\b[^.?!\n]{0,40}\bworkflows?\b/i.test(p) && !/\b(github|gitlab|ci|actions?|yaml|pipeline|n8n|zapier)\b/i.test(p);
}

// The method, about 190 tokens.
export function orchestration(agents: AgentDef[]): string {
	const has = (n: string) => agents.some((a) => a.name === n);
	const work = has("scout") && has("worker") && has("reviewer")
		? "scouts in parallel map the code (one per area) -> you decide -> workers in parallel on disjoint files -> reviewer -> you run the tests"
		: "gather in parallel -> you decide -> act in parallel on disjoint parts -> check -> you run the tests";
	const flow = has("general") ? `a question -> general (it answers); a change -> ${work}` : work;
	return [
		"Orchestration (lets-code): you are the orchestrator; subagents read and work in fresh contexts, you keep the plan and the decisions.",
		...(agents.length ? [`- Agents: ${agentJobs(agents)}.`] : []),
		"- Delegate now: do not explore yourself what a subagent can explore. Independent parts go in ONE call with tasks:[...]; chain:[...] only when a step needs the previous output.",
		"- Brief each task fully (goal, paths or names, constraints, answer shape): they see nothing of this conversation.",
		`- Usual flow: ${flow}.`,
		"- Trust their reports; re-read code only to settle a conflict or verify a change.",
		"- A cut or failed task is not retried by re-sending it: narrow the next task to the obstacle its report names.",
	].join("\n");
}

// ------------------------------------------------------------ subagent sessions
// UI only: a command, a shortcut, a status, a widget and footer lines; no
// tool, prompt or context change (the exceptions, a note in a call that
// detaches and the reply of a turn the user started in a child, are below).
// Every child runs on its own pi session file, <run id>.pi.jsonl next to its
// transcript, outside pi's session store, so it is not in /resume's list.
// /subagents (or LETS_CODE_SUBAGENT_KEY, default alt+s; "none" turns the key
// off) opens a picker in place of the editor: the main session, then the
// runs, running first. Enter switches the TUI into that run's session with
// pi's own switchSession, the way /resume does: pi draws it as it draws any
// session. The status says whose session it is; alt+s or /subagents back
// returns to the main session; /subagents <n | name> switches straight to
// a run; /subagents toggle shows the runs in the footer (remembered).
//
// The child's session works as the main one does, through the child's own
// process (its RPC, see "the child process"): a prompt while it works is a
// steer, one while it rests a new turn (its process starts again when it
// has gone), Esc aborts its turn, ! and !! run in its process and land in
// its session, /model and the thinking level are passed on to it, /compact
// compacts its session. The TUI itself never writes to a child's file: the
// child is that file's one writer, so the TUI opens a copy of it
// (<run id>.view.jsonl, made when the session is opened), and whatever pi
// appends to the copy (a model or thinking change, a ! command's record,
// the messages below) stays in the copy.
//
// How live, and without reloading: pi reads a session file when it opens
// it. The copy holds what the child had completed then (cut before an
// assistant message whose tool calls have no results yet). From then on,
// each message the child completes (its replies, tool results, the user's
// own prompts and steers) is added to the chat in-process, as a custom
// message drawn with pi's own message and tool components
// (registerMessageRenderer), the way pi adds a message in the main session;
// the session is never reopened while you look at it, so nothing jumps.
// The message on its way (thinking, text and tool calls token by token, a
// tool's output as it streams, steers not yet taken) is drawn below the
// chat in a widget above the editor, as pi draws a streaming message.
//
// switchSession exists on a command's ctx only: the shortcut sends the
// command (/subagents, /subagents back) with pi.sendUserMessage, which pi
// runs as a command; an input hook drops the text should it ever get
// further.
//
// Detaching: pi aborts the turn in flight before it replaces the session.
// A subagent or expert call in that turn would stop its children, so when
// the abort comes from one of these switches (reg.switching) the call
// detaches instead: its children go on, the tool returns at once with a
// short note, and once they are done their report goes to the session the
// call came from, as a message that continues it (held while another
// session is open).
export const VIEW_KEY = (process.env.LETS_CODE_SUBAGENT_KEY ?? "alt+s").trim().toLowerCase();
const keyOn = (key = VIEW_KEY) => !!key && key !== "none";
const HERE = dirname(fileURLToPath(import.meta.url));
export const CUSTOM_TYPE = "lets-code-subagents";
export const VIEW_MSG = "lets-code-subagent-message";   // a child's message added to its session's chat
// the footer line while something runs
export function hintText(n: number, key = VIEW_KEY): string {
	if (!n) return "";
	return `${n} subagent${n === 1 ? "" : "s"} running · ${keyOn(key) ? `${key} or ` : ""}/subagents to switch`;
}
// the status in a subagent's session
export function markerText(r: { agent: string; status: string; exitCode?: number } | undefined): string {
	if (!r) return "subagent session";
	const st = r.status === "failed" ? (r.exitCode ? `failed (exit ${r.exitCode})` : "failed") : ({ running: "running", done: "done", aborted: "stopped", timeout: "timed out" } as Record<string, string>)[r.status] ?? r.status;
	return `subagent ${r.agent} · ${st}`;
}
// pi's keybindings this view follows: <agent dir>/keybindings.json over pi's defaults
export const KEY_DEFAULTS: Record<string, string[]> = {
	"app.interrupt": ["escape"], "app.thinking.toggle": ["ctrl+t"], "app.tools.expand": ["ctrl+o"], "app.message.copy": ["ctrl+x"],
	"app.message.followUp": process.platform === "win32" ? ["ctrl+q"] : ["alt+enter"], "app.message.dequeue": process.platform === "win32" ? ["alt+q"] : ["alt+up"], "app.session.resume": [], "tui.editor.cursorDown": ["down"],
	"app.thinking.cycle": ["shift+tab"], "app.model.cycleForward": ["ctrl+p"], "app.model.cycleBackward": process.platform === "win32" ? ["alt+p"] : ["shift+ctrl+p"], "app.model.select": ["ctrl+l"],
