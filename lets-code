#!/usr/bin/env bash
#
# lets-code — run an agentic coding CLI against your own self-hosted LLM server
# (vLLM, SGLang, Ollama, LM Studio, OpenRouter, or any OpenAI-compatible
# server exposing /v1/models).
#
#   lets-code setup              interactive onboarding (start here)
#   lets-code setup full         onboarding with every optional feature on
#                                (mandate modes, sandbox, MCP import, full footer)
#   lets-code setup granular     onboarding that asks about each feature
#   lets-code setup preset [<name>]  onboarding for another backend (server,
#                                token, model) saved as a named preset (asks
#                                the name when not given); launch it with
#                                `lets-code --<name>` or `--preset <name>`
#   lets-code presets            list saved presets
#   lets-code --claude ...       Claude (Haiku by default; --model claude-sonnet,
#                                claude-opus, claude-fable) through Claude Code
#                                on your Claude subscription, instead of a server;
#                                the Claude models are in /model on every launch
#                                where Claude Code is installed, and Ctrl+S on one
#                                there makes later launches start on it
#   lets-code claude-remote      let other machines (a phone) use this machine's
#                                Claude proxy: starts it and says what to set
#                                there (CLAUDE_URL, and CLAUDE_TOKEN: your Claude
#                                Code token from `claude setup-token`)
#   lets-code update             replace this lets-code with the latest
#                                release published to npm
#   lets-code update --snapshot  ... with the latest commit on main instead
#   lets-code --version          print the version
#   lets-code mandate init       write a starter .pi/mandate.json (--global:
#                                ~/.pi/agent/mandate.json)
#   lets-code sessions           list the live lets-code sessions on this machine
#   lets-code message <to> [--wait <s>] -- <text>   send a message to a session
#                                (a pid, session id, name, or "repo": every
#                                session in this repository) and wait for it
#                                to be seen (default 10 s)
#   lets-code [args...]          launch pi (args pass to `pi`, e.g.
#                                `lets-code -p "hello"` for one-shot print mode)
#   lets-code --url <base> ...   one-off endpoint override
#   lets-code --model <id> ...   one-off model override
#   lets-code --context <tok>    context window (default: auto-discovered)
#   lets-code --output-cap <tok> max output tokens (default 32768)
#   lets-code --api <dialect>    openai-completions (default) | openai-responses |
#                                anthropic-messages | google-generative-ai
#   lets-code --vision ...       model accepts images (default: auto-detected)
#   lets-code --no-vision ...    force image input off (skips the probe)
#   lets-code --thinking-level <l> thinking level, default: medium (measured best
#                                default for Qwen3.8-27B); adaptive[:<l>] dials
#                                medium -> low once tests pass, high on struggle
#                                (auto-detected when the resident model thinks);
#                                auto[:<l>] is dynamic thinking: off, raised to
#                                the ceiling <l> (default high) in short bursts
#                                when the output shows pi struggling
#   lets-code --insecure ...     skip TLS verification (self-signed certs)
#   lets-code --no-mem-guard     launch without the memory guard
#   lets-code --no-git-guard     launch without the git guard
#   lets-code --no-agent-guard   launch without the agent guard
#   lets-code --no-grounding     launch without the grounding guard (look up
#                                facts instead of guessing; read before overwrite)
#   lets-code --no-session-tag   send no session tag with model requests
#   lets-code --metrics | --no-metrics   start with the full footer (directory,
#                                model, cache, first token, output) instead of
#                                the minimal one (/metrics switches inside pi)
#   lets-code --metrics-log <file>   append per-request and per-prompt metrics
#                                to <file> as JSON lines (also without a UI)
#   lets-code --mandate [<m>]    mandate on, optionally in mode plan | auto |
#                                ask | orchestrator | yolo | <role> (pi's own
#                                --mode is untouched)
#   lets-code --orchestrator     start in orchestrator mode (--mandate
#                                orchestrator): the session plans and dispatches
#                                experts and changes no file itself; a software
#                                factory run switches into it on its own
#   lets-code --no-mandate       launch without the mandate (modes) extension,
#                                and without the orchestrator or /plan
#   lets-code --subagents | --no-subagents   the subagent tool on/off (default on)
#   lets-code --experts | --no-experts   the expert tool on/off (default on, needs subagents);
#                                each expert is enabled in a session (/experts)
#   lets-code --claude-code | --no-claude-code   Claude Code adapter with your
#                                ~/.claude too / off (default: on by itself where
#                                a project's .claude has hooks or workflows):
#                                commands, skills, agents, hooks, permissions,
#                                MCP, workflows, CLAUDE.md
#   lets-code --sandbox | --no-sandbox       the OS sandbox on/off
#   lets-code --core-memory | --no-core-memory   core memory on/off (default on): a
#                                memory per project and a global one that the
#                                agent searches on demand and adds to (/memories)
#   lets-code --sessions | --no-sessions   sessions on/off (default on): the
#                                message tool and /sessions, a local channel
#                                between the sessions on this machine
#   lets-code --verbose ...      show endpoint probing
#
# What it does at launch:
#   1. probes your configured endpoints in order, first reachable wins
#   2. discovers the resident model, its context window, whether it
#      thinks (a minimal test request with thinking forced on) and whether
#      it sees images (a tiny solid-red PNG and "what color is this?"); for a
#      thinking model on vLLM, also whether its chat template has its own
#      effort control (rendered via /tokenize, no generation), which then
#      follows pi's thinking level
#   3. registers the endpoint with pi (~/.pi/agent/models.json) and reserves
#      the output budget in pi's compaction settings (settings.json), so
#      compaction fires before a response can overflow the server's window;
#      pi's install telemetry is off unless you turned it on yourself, and
#      pi's file-search helpers (fd, ripgrep) are fetched before the first
#      start instead of by the TUI mid-session
#   4. exports LETS_CODE_TOKEN (pi resolves it via $ENV interpolation) and
#      execs:  pi --provider lets-code --model <id>
#   5. memory guard (Linux): when the machine runs low on RAM, stops the
#      largest process this session started (never anything else) instead
#      of letting it freeze the machine; pi is warned first and told why
#   6. git guard: in a git repo, work happens on a pi/* branch. lets-code
#      creates pi/<timestamp> at launch if needed (uncommitted changes come
#      along); a pi hook parses each bash command like a shell and blocks
#      edits/writes/commands aimed at a repo whose HEAD is on any other
#      branch, refuses irreversible commands (force push, branch -D, reset
#      --hard, checkout <path>, clean -f, stash drop, rm .git) on every
#      branch, and refuses writes into .git. After each successful tool
#      call it snapshots uncommitted work under refs/pi-checkpoints/ (own
#      index file; HEAD, index and branches untouched). Zero tokens unless
#      a call is blocked.
#   7. agent guard: gives bash calls a default timeout, continues a reply
#      the output limit cut off before any tool call, reminds pi to run its
#      tests after several untested edits, requires executed checks (not
#      reasoning) as verification, tells pi once to finish after its own
#      tests have passed for a while, and runs the auto thinking level. Zero tokens unless a rule acts.
#   8. optional features: mandate (off unless setup full/granular or
#      MANDATE=true) — a role per session or subagent that says which tools,
#      paths, command kinds, MCP servers and agents are allowed, asked about
#      or denied (modes plan/auto/ask/orchestrator/yolo, zero tokens on
#      allowed calls); subagents (on by default) — a `subagent` tool that
#      delegates to agent files in ~/.pi/agent/agents (single / parallel /
#      chain, each child a pi process through the same provider and guards);
#      experts (on by default, with subagents) — an `expert` tool for
#      subagents with their own knowledge (a tester and its team, two
#      reviewers, an acceptance judge, a developer, the software factory, a
#      researcher, a reverse engineer, an expert builder, a phone expert on
#      Termux), each dormant until the user enables it (a dialog or /experts
#      enable, remembered); sandbox (off unless setup full/granular or
#      SANDBOX=true) — bash confined with @anthropic-ai/sandbox-runtime
#      (bubblewrap on Linux, Seatbelt on macOS); MCP — setup full/granular
#      imports an existing .mcp.json or another client's config into pi's
#      built-in MCP support.
#   9. session tag: every model request carries X-Lets-Code-Session:
#      <host>:<project>:<random> (subagents add /sub<depth>.<pid>), also
#      appended to the User-Agent, so a proxy's access log can tell
#      sessions apart without reading any request content.
#  10. Claude Code adapter (automatic: on where a project's .claude has
#      hooks or workflows; CLAUDE_CODE=all adds your ~/.claude): a project set
#      up for Claude Code works as it is, read at each start: CLAUDE.md files and
#      their @imports, .claude/skills, .claude/commands (/name), agents
#      (as subagents), hooks (Claude's events, stdin JSON and exit codes on
#      pi's), permission rules, MCP servers, workflow scripts and settings
#      env. Project hooks, MCP, env and agents need the folder trusted
#      (in Claude Code, in pi, or once here).
#  11. Claude backend (needs Claude Code installed and signed in): pi's
#      requests go to a local proxy that runs each conversation in one
#      `claude -p` process with Claude Code's own tools off and pi's tools
#      handed over through MCP, so Claude calls them natively. pi's thinking
#      level maps to Claude Code's effort (off -> thinking off, low..max), and
#      /model and /thinking switch the running conversation in place, the way
#      /model and /effort do in Claude Code. Your claude.ai connectors,
#      skills, hooks and CLAUDE.md stay out of it. CLAUDE_MODELS picks the
#      models listed; LETS_CODE_CLAUDE_PORT (8795) the proxy's port. The
#      first session on Claude starts the proxy as a sidecar on its own
#      machine, which outlives that session and serves every later one; CLAUDE_URL (+ CLAUDE_TOKEN, your Claude
#      Code token from `claude setup-token`) points a machine at another
#      one's proxy instead (see claude-remote), so it needs no Claude Code of
#      its own and starts nothing; its requests run on that token.
#
# Config: ~/.config/lets-code/config   (created by `lets-code setup`)
# Presets: ~/.config/lets-code/presets/<name>   (`lets-code setup preset <name>`)
#          same keys as the config, applied on top of it; `--<name>` picks one
# Env overrides: LETS_CODE_CLAUDE_MODELS, LETS_CODE_CLAUDE_PORT, LETS_CODE_CLAUDE_URL,
#                LETS_CODE_CLAUDE_TOKEN, LETS_CODE_CLAUDE_STATE (the proxy's state dir),
#                LETS_CODE_ENDPOINTS (space-separated), LETS_CODE_TOKEN,
#                LETS_CODE_CA, LETS_CODE_MODEL, LETS_CODE_CONTEXT,
#                LETS_CODE_OUTPUT_CAP, LETS_CODE_API, LETS_CODE_VISION,
#                LETS_CODE_THINKING, LETS_CODE_REASONING,
#                LETS_CODE_MEM_GUARD (true|false), LETS_CODE_GIT_GUARD (true|false),
#                LETS_CODE_GIT_CHECKPOINTS (1|0),
#                LETS_CODE_MANDATE (true|false), LETS_CODE_MODE, LETS_CODE_SUBAGENTS,
#                LETS_CODE_SANDBOX (true|false), LETS_CODE_SUBAGENT_CONCURRENCY (2),
#                LETS_CODE_SUBAGENT_TIMEOUT (s per subagent task, default 1800)
#                LETS_CODE_CLAUDE_CODE (auto|all|false)
#                LETS_CODE_EXPERTS (true|false)
#                LETS_CODE_CORE_MEMORY (true|false), LETS_CODE_CORE_MEMORY_HEADLINES (0..5, default 3)
#                LETS_CODE_SESSIONS (true|false), LETS_CODE_SESSIONS_DIR (the registry and inboxes),
#                LETS_CODE_SESSIONS_AUTOTURN (1: an idle session starts a turn on a message)
#                LETS_CODE_SESSION_TAG (true|false), LETS_CODE_METRICS (true|false), LETS_CODE_METRICS_LOG (<file>), LETS_CODE_AGENT_GUARD (true|false), LETS_CODE_GROUNDING (true|false), LETS_CODE_BASH_TIMEOUT (s, default 300, 0 = none),
#                LETS_CODE_WRAP_TURNS (6, 0 = off), LETS_CODE_WRAP_MINUTES (5), LETS_CODE_FIRM_STOP (0|1), LETS_CODE_TEMPLATE_EFFORT (auto|neutral|off),
#                LETS_CODE_BURST_TURNS (3), LETS_CODE_MAX_BURSTS (8), LETS_CODE_THINKING_REPLAY (all|<n>)
#                LETS_CODE_FINAL_REVIEW (auto|on|0), LETS_CODE_PLAN_BURST (0|1), LETS_CODE_PLAN_LEVEL (low)
#                LETS_CODE_OPENROUTER_PROVIDER (pin upstream providers, comma-separated, no fallbacks)
# Needs: bash >= 3.2 (stock macOS is fine), curl, python3, pi CLI
# (auto-installed on request).

set -eu
(set -o pipefail) 2>/dev/null && set -o pipefail   # pipefail is bash 4+; keep 3.2 alive

# Stamped by the publish workflow (the release tag) and by `update --snapshot`
# (main-<commit>); "dev" in a checkout.
LETS_CODE_VERSION="dev"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lets-code"
CONFIG_FILE="${CONFIG_DIR}/config"
SETUP_FILE="${CONFIG_FILE}"          # where setup saves (a preset file under setup --preset)
PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"   # pi's config home (overridable)
PRESET_DIR="${CONFIG_DIR}/presets"
PROVIDER_ID="lets-code"          # provider id we upsert into pi's files (lets-code-<preset> for a preset)
DEFAULT_CONTEXT=128000
DEFAULT_OUTPUT_CAP=32768
# The default output cap never takes more than a quarter of the context
# window, so a 32k (or smaller) server still leaves room for input. A
# pinned OUTPUT_CAP / --output-cap is used as given.
default_output_cap() {  # default_output_cap <context>
    local ctx="$1" q
    case "${ctx}" in *[!0-9]*|"") echo "${DEFAULT_OUTPUT_CAP}"; return ;; esac
    q=$(( ctx / 4 ))
    if [ "${q}" -lt "${DEFAULT_OUTPUT_CAP}" ]; then echo "${q}"; else echo "${DEFAULT_OUTPUT_CAP}"; fi
}
# xhigh thinking (opt-in): pi itself clamps xhigh to high (same 16k budget),
# so lets-code gives xhigh its own engine-enforced budget, sent through
# samplingParamsByThinkingLevel. It is enabled only when the output cap holds
# that budget plus XHIGH_ANSWER_ROOM tokens of answer; otherwise xhigh stays
# clamped to high as before. A startup level of xhigh with no pinned output
# cap raises the default cap to XHIGH_OUTPUT_CAP, never above a quarter of
# the context window.
XHIGH_THINKING_BUDGET=32768
XHIGH_ANSWER_ROOM=8192
XHIGH_OUTPUT_CAP=49152
xhigh_output_cap() {  # xhigh_output_cap <context> -> the default cap for xhigh, or "" if the window is too small
    local ctx="$1" q c
    case "${ctx}" in *[!0-9]*|"") return 0 ;; esac
    q=$(( ctx / 4 )); c="${XHIGH_OUTPUT_CAP}"
    if [ "${q}" -lt "${c}" ]; then c="${q}"; fi
    if [ "${c}" -ge $(( XHIGH_THINKING_BUDGET + XHIGH_ANSWER_ROOM )) ]; then echo "${c}"; fi
}
DEFAULT_API="openai-completions"
DEFAULT_THINKING="medium"

VERBOSE=false
LOG_PREFIX="[lets-code]"
log()         { echo "${LOG_PREFIX} ${1}"; }
log_verbose() { if [ "${VERBOSE}" = "true" ]; then echo "${LOG_PREFIX} ${1}"; fi; }
log_error()   { echo "${LOG_PREFIX} ERROR: ${1}" >&2; }

# ------------------------------------------------------------------ probing
# The probe is PERMISSIVE over TLS on purpose: it runs against every
# configured endpoint (first reachable wins), so a strict check here would
# wrongly kill LAN/VPN fallbacks. Certificate trust is enforced separately,
# before launch, for the endpoint that won (see the https block in main).

tls_args_for() {
    case "$1" in
        https://*)
            if   [ -n "${CA_FOUND:-}" ];        then echo "--cacert|${CA_FOUND}"
            elif [ "${INSECURE:-false}" = true ]; then echo "-k"
            else echo "-k"   # permissive probe; trust is enforced before launch
            fi ;;
        *) echo "" ;;
    esac
}

# Endpoint normalization. Accepts "10.0.0.5/vllm", "llm.example.com",
# "http://host:8000/v1", ... A missing scheme is filled in: IP addresses,
# localhost, bare hostnames and *.local (mDNS) get http:// (no public cert
# can exist for them); other domain names get https://. A trailing / or /v1
# is dropped — the probe always hits <base>/v1/models.
normalize_endpoint() {  # normalize_endpoint <url> -> prints the normalized base URL
    local u="${1%/}" host
    u="${u%/v1}"
    case "${u}" in
        *://*) ;;
        *)
            host="${u%%/*}"
            case "${host}" in
                \[*) ;;                               # [::1]:8000 — IPv6 literal
                *) host="${host%%:*}" ;;              # strip :port
            esac
            case "${host}" in
                \[*|localhost|*.local) u="http://${u}" ;;
                *[!0-9.]*)                            # not an IPv4 address
                    case "${host}" in
                        *.*) u="https://${u}" ;;      # domain name
                        *)   u="http://${u}" ;;       # bare hostname (no dots)
                    esac ;;
                *) u="http://${u}" ;;                 # IPv4 address
            esac ;;
    esac
    printf '%s\n' "${u}"
}

normalize_endpoints() {  # normalize_endpoints "<url> <url> ..." -> space-separated
    local out="" e
    for e in $1; do out="${out:+${out} }$(normalize_endpoint "${e}")"; done
    printf '%s\n' "${out}"
}

PROBE_ERR=""
PROBE_OUT="${TMPDIR:-/tmp}/.lets-code-probe.$$"
trap 'rm -f "${PROBE_OUT}"' EXIT
probe() {  # probe <base-url> -> prints /v1/models JSON on success; PROBE_ERR explains failure
    local base="$1" tls rc; tls="$(tls_args_for "$base")"
    local IFS='|'; # shellcheck disable=SC2086
    if curl -sf --max-time 4 ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" "${base}/v1/models" 2>/dev/null; then
        PROBE_ERR=""; return 0
    else
        rc=$?
    fi
    case "${rc}" in
        6)  PROBE_ERR="DNS: cannot resolve host" ;;
        7)  PROBE_ERR="connection refused (host up, port closed?)" ;;
        28) PROBE_ERR="timed out (host unreachable / wrong IP?)" ;;
        35) PROBE_ERR="TLS handshake failed" ;;
        60) PROBE_ERR="TLS certificate not trusted" ;;
        22) local code; code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 ${tls:+$tls} \
                -H "Authorization: Bearer ${TOKEN:-dummy-key}" "${base}/v1/models" 2>/dev/null)"
            case "${code}" in
                401)         PROBE_ERR="HTTP 401: token rejected" ;;
                403)         PROBE_ERR="HTTP 403: forbidden (proxy doesn't allow this network, or bad token)" ;;
                404)         PROBE_ERR="HTTP 404: no /v1/models here (wrong base URL/path?)" ;;
                502|503|504) PROBE_ERR="HTTP ${code}: proxy is up but the model server behind it is down" ;;
                *)           PROBE_ERR="HTTP error ${code:-4xx/5xx} from server" ;;
            esac ;;
        *)  PROBE_ERR="curl exit ${rc}" ;;
    esac
    return "${rc}"
}

# Thinking probe: one minimal chat completion with thinking forced on.
# A server that reports reasoning tokens (or streams reasoning content)
# has a thinking model resident. Cost: one tiny request per launch.
# Sets THINKING_DETECTED: true | false | unknown (inconclusive).
probe_thinking() {  # probe_thinking <base-url-without-/v1> <model>
    local base="$1" model="$2" payload tls out
    payload="$(python3 -c '
import json, sys
print(json.dumps({
    "model": sys.argv[1],
    "max_tokens": 16,
    "temperature": 0,
    "chat_template_kwargs": {"enable_thinking": True},
    "messages": [{"role": "user", "content": "Reply with exactly: OK"}],
}))' "${model}" 2>/dev/null)" || { THINKING_DETECTED="unknown"; return 0; }
    tls="$(tls_args_for "${base}")"
    local IFS='|'; # shellcheck disable=SC2086
    if out="$(curl -sf --max-time 30 ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" \
        -H "Content-Type: application/json" -d "${payload}" \
        "${base}/v1/chat/completions" 2>/dev/null)"; then
        THINKING_DETECTED="$(printf '%s' "${out}" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("unknown"); sys.exit()
ch = (d.get("choices") or [{}])[0]
m = ch.get("message") or {}
usage = d.get("usage") or {}
details = usage.get("completion_tokens_details") or {}
rt = details.get("reasoning_tokens") or 0
rc = m.get("reasoning_content") or m.get("reasoning") or ""
content = m.get("content") or ""
if isinstance(rt, (int, float)) and rt > 0:
    print("true")
elif isinstance(rc, str) and rc.strip():
    print("true")
elif "think" in content.lower():
    print("true")
else:
    print("false")' 2>/dev/null)"
    else
        THINKING_DETECTED="unknown"
    fi
    case "${THINKING_DETECTED}" in
        true|false) ;;
        *) THINKING_DETECTED="unknown" ;;
    esac
}

# Vision probe: one minimal chat completion carrying a 64x64 solid-red PNG
# (built inline; no PIL) and the question "what color is this?". A model
# that answers "red" saw the image. An error whose message talks about
# images / multimodal input (vLLM 400, llama.cpp 500 without an mmproj) is
# a text-only model. A 200 whose answer says it cannot see images (servers
# like Ollama silently drop images for text-only models) is text-only too.
# Anything else is inconclusive: onboarding then asks, launch defaults to
# text-only. Cost: one tiny request per launch (only when VISION is unset).
# Sets VISION_DETECTED: true | false | unknown (inconclusive).
probe_vision() {  # probe_vision <base-url-without-/v1> <model>
    local base="$1" model="$2" payload tls out code body
    payload="$(python3 -c '
import base64, json, struct, sys, zlib
w = h = 64
raw = b"".join(b"\x00" + b"\xff\x00\x00" * w for _ in range(h))
def chunk(t, d):
    return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
       + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
print(json.dumps({
    "model": sys.argv[1],
    "max_tokens": 200,
    "temperature": 0,
    "chat_template_kwargs": {"enable_thinking": False},
    "messages": [{"role": "user", "content": [
        {"type": "text", "text": "What color is this image? Reply with one word."},
        {"type": "image_url", "image_url": {"url": "data:image/png;base64," + base64.b64encode(png).decode()}},
    ]}],
}))' "${model}" 2>/dev/null)" || { VISION_DETECTED="unknown"; return 0; }
    tls="$(tls_args_for "${base}")"
    local IFS='|'; # shellcheck disable=SC2086
    if out="$(curl -s --max-time 60 -w '
%{http_code}' ${tls:+$tls} -H "Authorization: Bearer ${TOKEN:-dummy-key}" \
        -H "Content-Type: application/json" -d "${payload}" \
        "${base}/v1/chat/completions" 2>/dev/null)"; then
        code="${out##*
}"; body="${out%
*}"
        VISION_DETECTED="$(printf '%s' "${body}" | python3 -c '
import json, re, sys
code = sys.argv[1]
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    d = {}
if code == "200" and isinstance(d, dict) and d.get("choices"):
    m = (d["choices"] or [{}])[0].get("message") or {}
    content = m.get("content") or ""
    if not isinstance(content, str):  # list-of-parts replies
        content = " ".join(p.get("text", "") for p in content if isinstance(p, dict))
    seen = (content + " " + (m.get("reasoning_content") or m.get("reasoning") or "")).lower()
    if re.search(r"\bred\b", seen):
        print("true")
    elif re.search(r"(can.?t|cannot|unable to|not able to|don.?t have the ability to) (see|view|process|interpret|analy[sz]e|access)|no image|text-only|text-based|only (process|handle|understand) text", seen):
        print("false")
    else:
        print("unknown")
elif code[:1] in ("4", "5"):
    # a JSON error that names images/multimodal input: the server refused
    # the image for this model (vLLM 400, llama.cpp 500 without mmproj)
    err = d.get("error") if isinstance(d, dict) else None
    msg = err.get("message", "") if isinstance(err, dict) else (err if isinstance(err, str) else "")
    if re.search(r"image|vision|multi-?modal|mm_|mmproj", str(msg), re.I):
        print("false")
    else:
        print("unknown")
else:
    print("unknown")' "${code}" 2>/dev/null)"
    else
        VISION_DETECTED="unknown"
    fi
    case "${VISION_DETECTED}" in
        true|false) ;;
        *) VISION_DETECTED="unknown" ;;
    esac
}

# Template effort probe. Some chat templates carry their own effort control
# besides enable_thinking: Qwen3.8's takes reasoning_effort low|medium|xhigh,
# defaults to xhigh, and puts an instruction in the system prompt ("think
# carefully, validate key assumptions, consider plausible alternatives"),
# rejecting any other value with HTTP 400. pi never sets it unless told to, so
# every thinking level ran under the xhigh instruction and the levels differed
# only in where the token budget cut the thinking off (2026-10-08).
# Renders the prompt through vLLM's /tokenize (no generation, milliseconds)
# without the kwarg and with each candidate value. If some accepted value
# changes the rendered prompt, the template uses it: each pi level from minimal
# to high gets the accepted value nearest to it. xhigh gets its nearest value
# too, but pi_write_configs keeps it only when xhigh's larger budget fits the
# output cap, its own or the model's (see XHIGH_THINKING_BUDGET); otherwise
# xhigh, like max, stays unmapped and pi clamps it to high. Servers without /tokenize: nothing is sent.
# Sets EFFORT_MAP ("" or JSON like {"low": "low", ...}) and EFFORT_NOTE.
probe_template_effort() {  # probe_template_effort <base-url-without-/v1> <model> [1 = neutral: map every level to the least-instruction value]
    EFFORT_MAP=""; EFFORT_NOTE=""
    local out
    out="$(LC_BASE="$1" LC_MODEL="$2" LC_TOKEN="${TOKEN:-}" LC_CA="${CA_FOUND:-}" LC_NEUTRAL="${3:-0}" python3 -c '
import json, os, ssl, urllib.request, urllib.error
base, model, token, ca = (os.environ[k] for k in ("LC_BASE", "LC_MODEL", "LC_TOKEN", "LC_CA"))
ctx = None
if base.startswith("https://"):
    ctx = ssl.create_default_context(cafile=ca) if ca else ssl._create_unverified_context()
RANK = {"minimal": 0, "low": 1, "medium": 2, "high": 3, "xhigh": 4, "max": 5}
class NoTokenize(Exception):
    pass
def render(extra):
    kwargs = {"enable_thinking": True}
    kwargs.update(extra)
    body = {"model": model, "add_generation_prompt": True, "chat_template_kwargs": kwargs,
            "messages": [{"role": "system", "content": "s"}, {"role": "user", "content": "u"}]}
    req = urllib.request.Request(base + "/tokenize", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json", "Authorization": "Bearer " + token})
    try:
        with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
            return json.load(r).get("tokens")
    except urllib.error.HTTPError as e:
        if e.code == 400:
            return None
        raise NoTokenize("HTTP %d" % e.code)
    except Exception as e:
        raise NoTokenize(type(e).__name__)
try:
    baseline = render({})
    if baseline is None:
        raise NoTokenize("baseline rejected")
    accepted = {}
    for v in RANK:
        t = render({"reasoning_effort": v})
        if t is not None:
            accepted[v] = t
except NoTokenize as e:
    print("|no /tokenize endpoint (%s): template effort not probed" % e)
    raise SystemExit
renders = {json.dumps(t) for t in accepted.values()} | {json.dumps(baseline)}
if not accepted or len(renders) < 2:
    print("|template has no effort control")
    raise SystemExit
mapping = {}
neutral = min(accepted, key=lambda v: (len(accepted[v]), RANK[v]))  # the value whose instruction is shortest
for level in ("minimal", "low", "medium", "high", "xhigh"):
    mapping[level] = neutral if os.environ.get("LC_NEUTRAL") == "1" else min(accepted, key=lambda v: (abs(RANK[v] - RANK[level]), RANK[v]))
default = [v for v, t in accepted.items() if t == baseline]
note = "template effort control: accepts %s%s; pi levels map %s" % (
    "|".join(accepted), " (default %s)" % "|".join(default) if default else "",
    ", ".join("%s->%s" % kv for kv in mapping.items()))
print(json.dumps(mapping) + "|" + note)
' 2>/dev/null)" || out="|template effort probe failed"
    EFFORT_MAP="${out%%|*}"
    EFFORT_NOTE="${out#*|}"
}

# Suggested thinking level from context window + output cap. Level costs
# are pi's published budgets (minimal ~1k / low ~2k / medium ~8k /
# high ~16k). A level is suggested only when 4x its cost fits the window
# (pi's own model catalog follows this: 64k deployments top out at high,
# 131k just misses xhigh's 32k, 256k gets xhigh) and half the output cap
# (thinking must not eat the response budget). The suggestion stops at
# medium, the default: on the benchmark's hard tasks fixed high timed out
# where medium finished (see README, "Choosing a thinking level"), so a
# large window alone is no reason to pick it. xhigh/max are never suggested
# either: xhigh (32k budget, larger output cap) is opt-in only, and max is
# clamped by pi (to xhigh when xhigh is on, else to high).
suggested_thinking_level() {  # suggested_thinking_level <context> <output-cap>
    local ctx="$1" cap="$2" room
    room=$(( ctx / 4 ))
    if [ $(( cap / 2 )) -lt "${room}" ]; then room=$(( cap / 2 )); fi
    if   [ "${room}" -ge 8192  ]; then echo "medium"
    elif [ "${room}" -ge 2048  ]; then echo "low"
    elif [ "${room}" -ge 1024  ]; then echo "minimal"
    else echo "off"; fi
}

# ---------------------------------------------------------- pi config writes
# pi keeps its state under ~/.pi/agent (override: $PI_CODING_AGENT_DIR).
# lets-code owns exactly two slices, both keyed by its provider id ('lets-code',
# or 'lets-code-<name>' for a preset, so sessions on different presets never
# rewrite each other's backend), and never clobbers the user's own providers:
#   models.json   -> providers["lets-code"]
#                    (endpoint, api dialect, model, contextWindow, maxTokens,
#                     input types: ["text","image"] when vision is enabled,
#                     reasoning + chat-template thinking kwargs when thinking,
#                     + hard thinking_token_budget ceiling when thinking)
#   settings.json -> compaction.enabled = true +
#                    compaction.modelOverrides["lets-code/<model>"]
#                    .reserveTokens = output cap
#                    + modelThinkingLevels["lets-code/<model>"] = startup
#                    thinking level (when thinking is registered)
#                    + enableInstallTelemetry = false when the key is absent
#                    (pi defaults it to true and pings pi.dev on first start;
#                    an explicit true/false already in the file is kept)
#                    + theme = "lets-code" in place of the retired
#                    lets-code-soft/-pastel/-chalk (any other theme is
#                    kept; with none set pi uses "system", and the first
#                    interactive launch asks, see pick_theme_once)
#   themes/lets-code.json -> see pi_write_themes
# The token is never written to disk: apiKey points at $LETS_CODE_TOKEN (pi's
# $ENV interpolation), exported at launch — the secret stays in
# ~/.config/lets-code/config (mode 600). Writes are atomic (tmp + rename),
# every other key in the files is preserved, and a corrupt file fails loudly.
pi_write_configs() {  # pi_write_configs <base> <api> <model> <context> <output-cap> <vision> <reasoning> <thinking> [<effort-map-json>]
    # Claude models go in too wherever Claude Code is installed (see
    # pi_write_claude_extension); the inline defaults are CLAUDE_DEFAULT_* for
    # when this function runs on its own (setup's preset path, the tests)
    local claude_base="" claude_key="claude"
    if [ -n "${CLAUDE_URL:-}" ]; then
        claude_base="${CLAUDE_URL%/}/v1"
    elif command -v claude >/dev/null 2>&1; then
        claude_base="http://127.0.0.1:${LETS_CODE_CLAUDE_PORT:-${CLAUDE_DEFAULT_PORT:-8795}}/v1"
    fi
    # CLAUDE_TOKEN (claude setup-token) goes with every request and the
    # proxy runs the conversation on it; without it a local proxy uses this
    # machine's Claude Code sign-in. pi resolves it from the environment.
    [ -z "${CLAUDE_TOKEN:-}" ] || claude_key='$LETS_CODE_CLAUDE_TOKEN'
    LC_CLAUDE_BASE="${claude_base}" LC_CLAUDE_KEY="${claude_key}" LC_CLAUDE_MODELS="${CLAUDE_MODELS:-${CLAUDE_DEFAULT_MODELS:-haiku sonnet opus fable}}" LC_CLAUDE_CONTEXT="${CLAUDE_CONTEXT:-1000000}" LC_CLAUDE_CAP="${CLAUDE_OUTPUT_CAP:-32000}" \
    PI_AGENT_DIR="${PI_AGENT_DIR}" LC_PROVIDER="${PROVIDER_ID:-lets-code}" LC_XHIGH_BUDGET="${XHIGH_THINKING_BUDGET:-}" LC_XHIGH_ROOM="${XHIGH_ANSWER_ROOM:-}" LC_XHIGH_CAP="${XHIGH_LEVEL_CAP:-}" python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "${9:-}" <<'PY'
import json, os, sys, tempfile

base, api, model, context, cap, vision, reasoning, thinking, effort_map = sys.argv[1:10]
provider = os.environ.get("LC_PROVIDER") or "lets-code"
agent_dir = os.environ["PI_AGENT_DIR"]
ctx = int(context)
cap = int(cap)
xhigh_budget = int(os.environ.get("LC_XHIGH_BUDGET") or 32768)
xhigh_room = int(os.environ.get("LC_XHIGH_ROOM") or 8192)
# output cap for xhigh requests alone when the model's cap is too small (unpinned caps only)
xhigh_cap = int(os.environ.get("LC_XHIGH_CAP") or 0)

def upsert(path, mutate):
    doc = {}
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                doc = json.load(f)
        except Exception as exc:
            sys.exit("[lets-code] cannot parse %s: %s\n"
                     "  fix or move the file aside, then re-run lets-code." % (path, exc))
    if not isinstance(doc, dict):
        sys.exit("[lets-code] %s must contain a JSON object." % path)
    mutate(doc)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    existed = os.path.exists(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".lets-code-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, indent=2)
            f.write("\n")
        os.chmod(tmp, os.stat(path).st_mode & 0o777 if existed else 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

# shown as the badge in /model: claude-haiku [Anthropic]. pi matches provider
# names case-insensitively, so pi's own "anthropic" (an API key or /login
# anthropic) would shadow it; lets-code does not set that one up.
CLAUDE_PROVIDER = "Anthropic"
CLAUDE_PROVIDER_LEGACY = "lets-code-claude"   # its name before; renamed in saved settings

def claude_doc():
    # Claude through Claude Code (see pi_write_claude_extension), one entry
    # per CLAUDE_MODELS entry. pi's thinking level goes out as
    # reasoning_effort and the proxy runs it the way Claude Code does:
    # low..max are its effort levels, off is its thinking off, and it has no
    # minimal (hidden here, so a saved minimal clamps up to low).
    import re
    levels = {"off": "none", "minimal": None, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}
    entries = [m for m in re.split(r"[\s,]+", os.environ["LC_CLAUDE_MODELS"]) if m]
    ids = [m if m.startswith("claude-") else "claude-" + m for m in entries]
    if provider == CLAUDE_PROVIDER and model not in ids:
        ids.append(model)
    own = provider == CLAUDE_PROVIDER   # this launch's pins (context, cap) apply
    # API rates per million tokens, for pi's cost figures: on a subscription
    # nothing is paid per token, so they read as what the same use would cost
    # on the API. cacheWrite is the 1-hour rate (2x input), the TTL Claude
    # Code writes with. Haiku 5.5 costs more above 100K tokens of input (a pi
    # cost tier). Rates as of 2026-10; a model not listed here gets no cost
    # (pi shows none).
    rates = {   # per family: (input, output, cache read, 1-hour cache write)
        "haiku": (0.10, 0.50, 0.01, 0.20),
        "sonnet": (2.0, 10.0, 0.20, 4.0),
        "opus": (4.0, 20.0, 0.20, 8.0),
        "fable": (10.0, 50.0, 0.25, 20.0),
    }
    # the alias the CLI resolves to them, and their full names
    family = {**{f: f for f in rates}, "claude-haiku-5-5": "haiku", "claude-sonnet-5-5": "sonnet",
              "claude-opus-5-5": "opus", "claude-fable-5-1": "fable"}
    fields = ("input", "output", "cacheRead", "cacheWrite")
    def cost(i):
        f = family.get(i) or family.get(i[len("claude-"):])
        if not f:
            return {}
        c = dict(zip(fields, rates[f]))
        if f == "haiku":
            c["tiers"] = [{"inputTokensAbove": 100000, **dict(zip(fields, (0.50, 2.50, 0.05, 1.00)))}]
        return {"cost": c}
    def name(i):
        alias = i[len("claude-"):]
        return "(Anthropic) " + ("Claude " + alias.capitalize() if re.fullmatch(r"[a-z]+", alias) else i)
    return {
        "baseUrl": os.environ["LC_CLAUDE_BASE"],
        "api": "openai-completions",
        # the Claude Code token, or a placeholder (pi wants a key) for a local
        # proxy on this machine's sign-in
        "apiKey": os.environ["LC_CLAUDE_KEY"],
        "compat": {"supportsDeveloperRole": False, "supportsReasoningEffort": True},
        "models": [{
            "id": i, "name": name(i),
            "contextWindow": ctx if own else int(os.environ["LC_CLAUDE_CONTEXT"]),
            "maxTokens": cap if own else int(os.environ["LC_CLAUDE_CAP"]),
            "input": ["text", "image"] if vision == "true" or not own else ["text"],
            "reasoning": True, "thinkingLevelMap": levels, **cost(i),
        } for i in ids],
    }

def to_models(doc):
    providers = doc.get("providers")
    if not isinstance(providers, dict):
        providers = {}
    providers.pop(CLAUDE_PROVIDER_LEGACY, None)
    if os.environ.get("LC_CLAUDE_BASE"):
        providers[CLAUDE_PROVIDER] = claude_doc()
    else:
        providers.pop(CLAUDE_PROVIDER, None)   # Claude Code gone and no CLAUDE_URL
    if provider == CLAUDE_PROVIDER:
        doc["providers"] = providers
        return
    compat = {"supportsDeveloperRole": False, "supportsReasoningEffort": False}
    model_doc = {
        "id": model,
        "contextWindow": ctx,
        "maxTokens": cap,
        # pi defaults a model's input to ["text"] unless declared otherwise,
        # so image support must be declared explicitly for images to pass
        "input": ["text", "image"] if vision == "true" else ["text"],
    }
    openrouter = "openrouter.ai" in base
    if reasoning == "true" and openrouter:
        # OpenRouter normalises thinking across providers with its own request
        # field, reasoning: {effort}; pi sends it per request (effort "none" when
        # thinking is off) in its openrouter mode. Chat-template kwargs and
        # thinking_token_budget are vLLM/SGLang features and are not set here.
        model_doc["reasoning"] = True
        compat["thinkingFormat"] = "openrouter"
    elif reasoning == "true":
        # pi only offers thinking levels for models that declare reasoning.
        # The chat-template kwargs map pi's level onto the server's chat
        # template variables (vLLM/SGLang pass chat_template_kwargs through;
        # Qwen3 & friends take enable_thinking + thinking_budget).
        model_doc["reasoning"] = True
        compat["thinkingFormat"] = "chat-template"
        compat["chatTemplateKwargs"] = {
            "enable_thinking": {"$var": "thinking.enabled"},
            "thinking_budget": {"$var": "thinking.budget", "omitWhenOff": True},
        }
        # Hard per-level ceiling on thinking tokens. The template budget above
        # is only a hint, and Qwen3's template ignores it entirely (checked
        # 2026-10-06: identical prompt with and without it). vLLM enforces
        # thinking_token_budget engine-side (with a reasoning parser): the
        # thinking section is force-terminated at the budget. pi sends its
        # budget for the current level in that field when the compat flag is
        # set (defaults: minimal 1024, low 2048, medium 8192, high 16384;
        # override with thinkingBudgets in settings.json), clamped to leave
        # 1024 tokens of answer room. A fixed samplingParams ceiling used to
        # be here; it gave every level the same 16K budget, so low, medium
        # and high behaved alike. Servers that don't know the field ignore it.
        compat["supportsThinkingTokenBudget"] = True
        # The template's own effort control (see probe_template_effort): pi
        # substitutes its current level through thinkingLevelMap, so the
        # model gets the matching instruction instead of the template's
        # default. Omitted when thinking is off (no thinking section at all).
        level_map = json.loads(effort_map) if effort_map else {}
        xhigh_value = level_map.pop("xhigh", None)
        # xhigh (opt-in, see XHIGH_THINKING_BUDGET): pi treats xhigh as a
        # supported level only when thinkingLevelMap has an entry for it, and
        # otherwise clamps it to high; even when supported, pi's own budget
        # for xhigh is high's. samplingParamsByThinkingLevel is merged into
        # the request after pi's thinking_token_budget, so its value wins.
        # Enabled when the output cap leaves answer room after the budget,
        # or else (unpinned cap) with a larger output cap for xhigh requests
        # alone, so xhigh is offered in-session at every startup level while
        # the other levels keep theirs. max stays unmapped and so clamps to
        # xhigh when it is on.
        xhigh_params = {"thinking_token_budget": xhigh_budget}
        if cap - xhigh_budget < xhigh_room and xhigh_cap - xhigh_budget >= xhigh_room:
            # pi sends one of the two fields (detected per server); both
            # carry the same value, so whichever the server reads agrees
            xhigh_params.update({"max_tokens": xhigh_cap, "max_completion_tokens": xhigh_cap})
        if cap - xhigh_budget >= xhigh_room or len(xhigh_params) > 1:
            # without a template effort control the value is never sent;
            # the entry only makes xhigh a supported level
            level_map["xhigh"] = xhigh_value or "xhigh"
            model_doc["samplingParamsByThinkingLevel"] = {"xhigh": xhigh_params}
        if effort_map:
            compat["chatTemplateKwargs"]["reasoning_effort"] = {"$var": "thinking.effort", "omitWhenOff": True}
        if level_map:
            model_doc["thinkingLevelMap"] = level_map
    if openrouter and os.environ.get("LETS_CODE_OPENROUTER_PROVIDER"):
        # Pin one upstream provider (no fallbacks): providers serving the same
        # model differ in quantization and in how they honour reasoning effort
        # (2026-10-09: for qwen3.8-27b, effort "none" was clean on one provider
        # and still reasoned at length in the answer on another).
        compat["openRouterRouting"] = {"order": [p.strip() for p in os.environ["LETS_CODE_OPENROUTER_PROVIDER"].split(",") if p.strip()], "allow_fallbacks": False}
    providers[provider] = {
        "baseUrl": base,
        "api": api,
        "apiKey": "$LETS_CODE_TOKEN",
        "compat": compat,
        "models": [model_doc],
    }
    doc["providers"] = providers

def to_settings(doc):
    # the Claude provider's old name in what pi saved: the startup default,
    # scoped models and per-model keys follow the rename
    old = CLAUDE_PROVIDER_LEGACY + "/"
    if doc.get("defaultProvider") == CLAUDE_PROVIDER_LEGACY:
        doc["defaultProvider"] = CLAUDE_PROVIDER
    if isinstance(doc.get("enabledModels"), list):
        doc["enabledModels"] = [CLAUDE_PROVIDER + "/" + m[len(old):] if isinstance(m, str) and m.startswith(old) else m for m in doc["enabledModels"]]
    for keyed in (doc.get("modelThinkingLevels"), (doc.get("compaction") or {}).get("modelOverrides") if isinstance(doc.get("compaction"), dict) else None):
        if isinstance(keyed, dict):
            for k in [k for k in keyed if k.startswith(old)]:
                keyed.setdefault(CLAUDE_PROVIDER + "/" + k[len(old):], keyed.pop(k))
    compaction = doc.get("compaction")
    if not isinstance(compaction, dict):
        compaction = {}
    overrides = compaction.get("modelOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    overrides[provider + "/" + model] = {"reserveTokens": cap}
    compaction["modelOverrides"] = overrides
    compaction["enabled"] = True  # auto-compaction explicit, not pi's implicit default
    doc["compaction"] = compaction
    # install telemetry off by default; a value the user set stays as is
    doc.setdefault("enableInstallTelemetry", False)
    # the three earlier lets-code themes are one now (also inside a "light/dark" pair)
    if isinstance(doc.get("theme"), str):
        doc["theme"] = "/".join("lets-code" if t in ("lets-code-soft", "lets-code-pastel", "lets-code-chalk") else t
                                for t in doc["theme"].split("/"))
    if reasoning == "true":
        # pi's per-model startup thinking level (global default is "medium")
        levels = doc.get("modelThinkingLevels")
        if not isinstance(levels, dict):
            levels = {}
        levels[provider + "/" + model] = thinking
        doc["modelThinkingLevels"] = levels
    elif provider + "/" + model in (doc.get("modelThinkingLevels") or {}):
        # thinking unregistered — drop our stale level so it cannot surprise
        # a later /model rebind; other providers' entries are untouched
        levels = dict(doc["modelThinkingLevels"])
        del levels[provider + "/" + model]
        if levels:
            doc["modelThinkingLevels"] = levels
        else:
            doc.pop("modelThinkingLevels", None)

upsert(os.path.join(agent_dir, "models.json"), to_models)
upsert(os.path.join(agent_dir, "settings.json"), to_settings)

# the per-model level just written, so the next launch can tell a level the
# user set in pi's settings menu from its own (see lc_thinking_default)
def note_written(doc):
    seen = doc.get("thinkingSeen") if isinstance(doc.get("thinkingSeen"), dict) else {}
    models = seen.get("models") if isinstance(seen.get("models"), dict) else {}
    if reasoning == "true":
        models[provider + "/" + model] = thinking
    else:
        models.pop(provider + "/" + model, None)
    seen["models"] = models
    doc["thinkingSeen"] = seen
    # setup's answer is the new default: one adopted from pi before gives
    # way, and so does a global default set before setup
    if os.environ.get("LC_THINKING_RESET"):
        if isinstance(doc.get("thinkingDefaults"), dict):
            doc["thinkingDefaults"].pop(provider + "/" + model, None)
        try:
            with open(os.path.join(agent_dir, "settings.json"), encoding="utf-8") as f:
                pd = json.load(f).get("defaultThinkingLevel")
        except Exception:
            pd = None
        defaults_seen = seen.get("defaults") if isinstance(seen.get("defaults"), dict) else {}
        defaults_seen[provider + "/" + model] = pd if pd in ("off", "minimal", "low", "medium", "high", "xhigh", "max") else None
        seen["defaults"] = defaults_seen
try:
    upsert(os.path.join(agent_dir, "lets-code-state.json"), note_written)
except SystemExit:
    pass   # an unreadable state file: a settings-menu change is just not noticed
PY
}

# ------------------------------------------------------------ extension dirs
# Everything lets-code runs inside pi is ONE pi extension,
# ~/.pi/agent/extensions/lets-code/, so pi's startup [Extensions] list shows
# "lets-code" once instead of a name per feature. Its index.ts (see
# pi_write_lets_code_extension) loads each feature module that is present:
# <feature>.ts, or <feature>/index.ts for a feature with files of its own
# (the sandbox and its npm runtime). pi loads only index.ts from a directory
# (no recursion), so a module never loads on its own as well. A module is
# written when its feature is on; one written by an earlier launch with the
# feature off now stays inert, as each still checks its own switch. A
# "lets-code" directory the user made (an extension there not written by
# lets-code) is left alone and lets-code-ext is used instead.
LC_EXT_FEATURES="agent-guard backend claude-code core-memory footer git-guard grounding mandate memory-guard sandbox session-tag experts subagents thinking"
LC_EXT_ROOT=""
LC_ACTIVE=""    # the features whose module this launch wrote, i.e. the ones on
lc_written() {  # lc_written <file>: true when lets-code wrote <file>
    [ -f "$1" ] && head -n 1 "$1" 2>/dev/null | grep -q "Written by lets-code"
}
lc_ext_root() {  # sets LC_EXT_ROOT, the lets-code extension's directory (decided once)
    local base="${PI_AGENT_DIR}/extensions" d
    [ -z "${LC_EXT_ROOT}" ] || return 0
    d="${base}/lets-code"
    if ! lc_written "${d}/index.ts" && { [ -e "${d}/index.ts" ] || [ -e "${d}/index.js" ] || [ -e "${d}/package.json" ]; }; then
        d="${base}/lets-code-ext"
        log "note: ${base}/lets-code is your own extension; lets-code's features go in ${d}."
    fi
    LC_EXT_ROOT="${d}"
}
# lc_ext_module <feature>: sets LC_MOD_DIR (where the module's files go) and
# LC_MOD_FILE (its source), creates the directory, makes sure the index that
# loads it is there, and records the feature as on. Called directly, not in
# "$(...)", so the record survives.
lc_ext_module() {
    lc_ext_root
    case "$1" in
        sandbox|claude) LC_MOD_DIR="${LC_EXT_ROOT}/$1"; LC_MOD_FILE="${LC_MOD_DIR}/index.ts" ;;
        *)       LC_MOD_DIR="${LC_EXT_ROOT}"; LC_MOD_FILE="${LC_EXT_ROOT}/$1.ts" ;;
    esac
    mkdir -p "${LC_MOD_DIR}"
    lc_written "${LC_EXT_ROOT}/index.ts" || pi_write_lets_code_extension
    case " ${LC_ACTIVE} " in *" $1 "*) ;; *) LC_ACTIVE="${LC_ACTIVE:+${LC_ACTIVE} }$1" ;; esac
}

# Every launch moves what earlier versions wrote into the one extension,
# features that are off this time included (left in place, pi would still
# load them under their old names): the per-feature directories <feature>/
# (lets-code-<feature>/ where the user had a directory of that name, and
# lets-code-sandbox/ from before that) and the older single files
# lets-code-*.ts. Only what lets-code wrote is touched: a directory whose
# index.ts, or a file whose first line, says "Written by lets-code". A
# module moves to lets-code/<feature>.ts unless the new place already has
# one; the sandbox directory moves whole, npm runtime included, so nothing
# is reinstalled. A directory left holding files lets-code did not write
# stays (it is no longer an extension) and the launch says so.
lc_migrate_extensions() {
    local base="${PI_AGENT_DIR}/extensions" feat d f
    lc_ext_root
    mkdir -p "${LC_EXT_ROOT}"
    pi_write_lets_code_extension
    for feat in ${LC_EXT_FEATURES}; do
        for d in "${base}/${feat}" "${base}/lets-code-${feat}"; do
            [ "${d}" != "${LC_EXT_ROOT}" ] && lc_written "${d}/index.ts" || continue
            if [ "${feat}" = sandbox ] && [ ! -e "${LC_EXT_ROOT}/sandbox" ]; then
                mv "${d}" "${LC_EXT_ROOT}/sandbox"; continue
            fi
            if [ "${feat}" = sandbox ]; then
                rm -rf "${d}/node_modules"; rm -f "${d}/package.json" "${d}/package-lock.json"
            elif [ ! -e "${LC_EXT_ROOT}/${feat}.ts" ]; then
                mv "${d}/index.ts" "${LC_EXT_ROOT}/${feat}.ts"
            fi
            rm -f "${d}/index.ts" "${d}"/.index.*
            rmdir "${d}" 2>/dev/null || log "note: ${d} holds files lets-code did not write; left in place (no longer loaded)."
        done
    done
    for f in "${base}"/lets-code-*.ts; do
        if lc_written "${f}"; then rm -f "${f}"; fi
    done
}

# The one extension pi loads: imports each feature module present, in the
# order pi loaded them when they were separate (alphabetical), and isolates
# them, so one that fails to import or to set up is reported by name and the
# others still run. Rewritten when its content changes.
pi_write_lets_code_extension() {
    local f tmp
    lc_ext_root
    mkdir -p "${LC_EXT_ROOT}"
    f="${LC_EXT_ROOT}/index.ts"
    tmp="$(mktemp "${LC_EXT_ROOT}/.index.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (its pi features, as one extension); regenerated on launch, edits are overwritten.
// pi lists this directory once, as "lets-code". Each feature is a module
// next to this file, <feature>.ts or <feature>/index.ts (the sandbox, with
// its npm runtime), written by lets-code when the feature is on; each one
// checks its own switch (LETS_CODE_*), so a module left from a launch with
// the feature off stays inert. pi loads only this file from the directory.
// Modules load one at a time in a fixed order, each on its own: a module
// that is missing is skipped; one that fails to import, or whose setup
// throws, is reported by name (a notification with a UI, stderr without)
// and the others still load. Handlers a failing setup registered before it
// threw stay registered.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { existsSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
// pi's load order when they were separate extensions (alphabetical)
export const FEATURES = ["agent-guard", "backend", "claude", "claude-code", "core-memory", "footer", "git-guard", "grounding", "mandate", "memory-guard", "sandbox", "session-tag", "sessions", "experts", "factory", "subagents", "thinking"];

export function moduleFile(dir: string, name: string): string | undefined {
	return [join(dir, `${name}.ts`), join(dir, name, "index.ts")].find((f) => existsSync(f));
}

export default async function (pi: ExtensionAPI) {
	const failed: string[] = [];
	for (const name of FEATURES) {
		const file = moduleFile(HERE, name);
		if (!file) continue;
		try {
			const mod = await import(pathToFileURL(file).href);
			const setup = typeof mod.default === "function" ? mod.default : mod.default?.default;
			if (typeof setup !== "function") throw new Error("no default export function");
			await setup(pi);
		} catch (e) {
			failed.push(`${name} (${e instanceof Error ? e.message : String(e)})`);
		}
	}
	if (failed.length === 0) return;
	const msg = `lets-code: ${failed.length === 1 ? "feature" : "features"} not loaded: ${failed.join("; ")}. The others are running.`;
	pi.on("session_start", (_e: unknown, ctx: { hasUI?: boolean; ui?: { notify(m: string, t?: string): void } }) => {
		if (ctx?.hasUI && ctx.ui) ctx.ui.notify(msg, "error");
		else console.error(msg);
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

