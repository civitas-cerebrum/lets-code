#!/usr/bin/env bash
# Written by lets-code (termux); regenerated on launch, edits are overwritten.
# ui: the screen and input of this phone, through a shell-uid channel
# (Shizuku's rish, or adb connected to the phone itself over wireless
# debugging). Without one every command but `xml` exits 3 and says so.
#   ui channel                 the channel in use: "rish <path>", "adb <serial>" or "none"
#   ui dump [<word>] [--all] [--full] [--max N]
#                              the screen as text, one line per node (uitext.py)
#   ui tap <text> | --id <id> | --desc <d> | <x> <y>  [--nth N] [--confirmed]
#                              taps the match's center (its clickable parent);
#                              a final step (send, call, pay, post, ...) needs --confirmed
#   ui type <text>             types into the focused field (ASCII only)
#   ui key <back|home|enter|del|tab|search|paste|recent|<code>>
#   ui swipe <up|down|left|right>
#   ui top                     the resumed activity
#   ui shot <file.png>         a screenshot (heavy: last resort)
#   ui sh '<command>'          any command as the shell user
#   ui xml <file> [dump args]  parse a dump already on disk
set -u
to() { if command -v timeout >/dev/null 2>&1; then timeout "$@"; else shift; "$@"; fi; }   # no timeout on macOS
here="$(cd "$(dirname "$0")" && pwd)"
dumpf="${TMPDIR:-/tmp}/lets-code-ui.xml"
final_re='(^|[^a-z])(send|gönder|call|voice call|video call|pay|post|publish|tweet|reply all|place order|buy|order now|checkout|confirm payment|transfer|delete|submit)([^a-z]|$)'

find_rish() {
    local r
    for r in "$(command -v rish 2>/dev/null)" "${HOME}/rish" "${HOME}/bin/rish" "${PREFIX:-/nonexistent}/bin/rish"; do
        [ -n "${r}" ] && [ -f "${r}" ] && { echo "${r}"; return 0; }
    done
    return 1
}
channel() {   # prints the channel, or "none" (exit 3) with the reasons on stderr
    if [ -n "${TERMUX_UI_CHANNEL:-}" ]; then echo "${TERMUX_UI_CHANNEL}"; return 0; fi
    local r o why="" s devs bad
    if r="$(find_rish)"; then
        o="$(to 10 sh "${r}" -c 'id -u' </dev/null 2>&1 | tr -d '\r' | tail -n 1)"
        case "${o}" in 2000|0) echo "rish ${r}"; return 0 ;; esac
        why="rish (${r}) did not answer as shell: ${o:-no output} (is Shizuku started, and Termux allowed in it?)"
    else
        why="rish: not found"
    fi
    if command -v adb >/dev/null 2>&1; then
        devs="$(to 10 adb devices 2>/dev/null | tr -d '\r' | awk 'NR > 1 && $2 == "device" { print $1 }')"
        bad="$(to 10 adb devices 2>/dev/null | tr -d '\r' | awk 'NR > 1 && ($2 == "unauthorized" || $2 == "offline") { print $1 "=" $2 }' | tr '\n' ' ')"
        for s in $(printf '%s\n' ${devs} | grep -E '^(localhost|127\.0\.0\.1)' ; printf '%s\n' ${devs} | grep -vE '^(localhost|127\.0\.0\.1)'); do
            o="$(to 10 adb -s "${s}" shell 'id -u' </dev/null 2>/dev/null | tr -d '\r')"
            [ "${o}" = 2000 ] && { echo "adb ${s}"; return 0; }
        done
        why="${why}; adb: no connected device${bad:+ (${bad% })} (Wireless debugging on, then adb connect localhost:<port>)"
    else
        why="${why}; adb: not installed (pkg install android-tools)"
    fi
    echo none; echo "${why}" >&2; return 3
}
CH=""
need() {
    [ -n "${CH}" ] && return 0
    local e why; e="$(mktemp "${TMPDIR:-/tmp}/lc-ui.XXXXXX")"
    CH="$(channel 2>"${e}")"; why="$(cat "${e}")"; rm -f "${e}"
    [ "${CH}" != none ] && [ -n "${CH}" ] && return 0
    echo "no shell channel (screen, taps and typing need Shizuku's rish or adb to this phone; see ref/tiers.md): ${why}" >&2
    exit 3
}
run() {   # run '<command>' as the shell user
    need
    case "${CH}" in
        rish\ *) to "${UI_TIMEOUT:-30}" sh "${CH#rish }" -c "$1" </dev/null ;;
        adb\ *)  to "${UI_TIMEOUT:-30}" adb -s "${CH#adb }" shell "$1" </dev/null ;;
        *) echo "unknown channel: ${CH}" >&2; return 3 ;;
    esac
}
fetch() {   # the current screen into ${dumpf}; one retry (animations make uiautomator fail)
    local i
    need
    for i in 1 2; do
        run 'uiautomator dump /data/local/tmp/lc-ui.xml >/dev/null 2>&1; cat /data/local/tmp/lc-ui.xml 2>/dev/null; rm -f /data/local/tmp/lc-ui.xml' > "${dumpf}" 2>/dev/null
        grep -q '</hierarchy>' "${dumpf}" 2>/dev/null && return 0
        sleep 1
    done
    echo "uiautomator dump failed twice (screen locked, a video or animation playing, or a secure window)" >&2
    return 4
}
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }   # quote for the remote sh

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "${cmd}" in
    channel) channel ;;
    sh) [ $# -ge 1 ] || { echo "usage: ui sh '<command>'" >&2; exit 2; }; run "$*" ;;
    xml) [ $# -ge 1 ] || { echo "usage: ui xml <file> [dump args]" >&2; exit 2; }
        f="$1"; shift; python3 "${here}/uitext.py" dump "${f}" "$@" ;;
    dump)
        args=(); word=""
        while [ $# -gt 0 ]; do case "$1" in --max) args+=("$1" "${2:-80}"); shift 2 ;; --*) args+=("$1"); shift ;; *) word="$1"; shift ;; esac; done
        fetch || exit $?
        python3 "${here}/uitext.py" dump "${dumpf}" ${word:+--grep "${word}"} "${args[@]+"${args[@]}"}" ;;
    tap)
        confirmed=""; nth=""; mode=""; want=""; xy=()
        while [ $# -gt 0 ]; do
            case "$1" in
                --confirmed) confirmed=1; shift ;;
                --nth) nth="${2:-}"; shift 2 ;;
                --id|--desc|--text) mode="$1"; want="${2:-}"; shift 2 ;;
                *) if [[ "$1" =~ ^[0-9]+$ ]] && [ -z "${mode}" ]; then xy+=("$1"); else mode=--any; want="$1"; fi; shift ;;
            esac
        done
        if [ ${#xy[@]} -eq 2 ] && [ -z "${mode}" ]; then
            x="${xy[0]}"; y="${xy[1]}"; what="point ${x},${y}"
            if [ -z "${confirmed}" ] && fetch 2>/dev/null; then
                what="$(python3 "${here}/uitext.py" at "${dumpf}" "${x}" "${y}" | sed 1d)"
            fi
        else
            [ -n "${mode}" ] || { echo "usage: ui tap <text> | --id <id> | --desc <d> | <x> <y> [--nth N] [--confirmed]" >&2; exit 2; }
            fetch || exit $?
            out="$(python3 "${here}/uitext.py" find "${dumpf}" "${mode}" "${want}" ${nth:+--nth "${nth}"})"; rc=$?
            [ ${rc} -eq 0 ] || { echo "${out}"; exit ${rc}; }
            x="$(printf '%s\n' "${out}" | sed -n '1s/ .*//p')"; y="$(printf '%s\n' "${out}" | sed -n '1s/.* //p')"
            what="$(printf '%s\n' "${out}" | sed 1d)"
        fi
        # the final step of an outward action is the user's: only with --confirmed
        own="$(printf '%s\n' "${what}" | sed -E 's/~"[^"]*"//g' | tr 'A-Z' 'a-z')"
        if [ -z "${confirmed}" ] && printf '%s\n' "${own}" | grep -qE "${final_re}"; then
            printf '%s\n' "${what}"
            echo "not tapped: this looks like a final step (send, call, pay, post, delete, ...). Stop and report it as awaiting confirmation; tap it with --confirmed only once the user approved this exact step."
            exit 6
        fi
        run "input tap ${x} ${y}" || exit $?
        printf 'tapped %s,%s\n%s\n' "${x}" "${y}" "${what}" ;;
    type)
        [ $# -ge 1 ] || { echo "usage: ui type <text>" >&2; exit 2; }
        text="$*"
        if printf '%s' "${text}" | LC_ALL=C grep -q '[^ -~]'; then
            echo "not typed: input text takes ASCII only. Use a pre-fill intent (EXTRA_TEXT / ?text=), or termux-clipboard-set then ui key paste (needs Termux:API)." >&2
            exit 4
        fi
        enc="$(printf '%s' "${text}" | sed 's/ /%s/g')"
        run "input text $(q "${enc}")" && echo "typed ${#text} chars" ;;
    key)
        [ $# -ge 1 ] || { echo "usage: ui key <name|code>" >&2; exit 2; }
        case "$1" in
            back) k=4 ;; home) k=3 ;; enter) k=66 ;; del) k=67 ;; tab) k=61 ;; search) k=84 ;;
            paste) k=279 ;; recent) k=187 ;; up) k=19 ;; down) k=20 ;; left) k=21 ;; right) k=22 ;;
            *) [[ "$1" =~ ^[0-9]+$ ]] || [[ "$1" =~ ^KEYCODE_[A-Z0-9_]+$ ]] || { echo "unknown key: $1" >&2; exit 2; }; k="$1" ;;
        esac
        run "input keyevent ${k}" && echo "key ${1}" ;;
    swipe)
        size="$(run 'wm size' | tr -d '\r' | sed -n 's/.*: *\([0-9]*\)x\([0-9]*\).*/\1 \2/p' | tail -n 1)"
        w="${size% *}"; h="${size#* }"; [ -n "${w}" ] && [ -n "${h}" ] || { w=1080; h=2400; }
        cx=$((w / 2)); cy=$((h / 2)); dy=$((h / 3)); dx=$((w / 3))
        case "${1:-}" in   # "up" scrolls the content up: the finger moves up
            up)    c="${cx} $((cy + dy)) ${cx} $((cy - dy))" ;;
            down)  c="${cx} $((cy - dy)) ${cx} $((cy + dy))" ;;
            left)  c="$((cx + dx)) ${cy} $((cx - dx)) ${cy}" ;;
            right) c="$((cx - dx)) ${cy} $((cx + dx)) ${cy}" ;;
            *) echo "usage: ui swipe <up|down|left|right>" >&2; exit 2 ;;
        esac
        run "input swipe ${c} 300" && echo "swiped ${1}" ;;
    top) run 'dumpsys activity activities' | tr -d '\r' | grep -m 1 -E 'topResumedActivity|mResumedActivity|ResumedActivity' | sed 's/^ *//' ;;
    shot)
        [ $# -ge 1 ] || { echo "usage: ui shot <file.png>" >&2; exit 2; }
        need
        case "${CH}" in
            adb\ *) to 30 adb -s "${CH#adb }" exec-out screencap -p > "$1" ;;
            *) run 'screencap -p' > "$1" ;;
        esac
        [ -s "$1" ] && echo "screenshot: $1 ($(wc -c < "$1") bytes)" || { echo "screencap failed" >&2; exit 4; } ;;
    ""|-h|--help) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) echo "unknown: ${cmd} (ui --help)" >&2; exit 2 ;;
esac
