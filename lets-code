						// commands that read the session itself (/copy, /export, ...) see the
						// messages added since it opened only once the copy is made again: a
						// command is the user acting, so the copy is made again first and the
						// command then runs on it
						if (READS_SESSION.test(text) && (vs.addedCount ?? 0) > 0 && !vs.resubmit) {
							vs.resubmit = text;
							command("refresh");
							return { consume: true };
						}
						return undefined;
					});
				} catch { /* no key hook here */ }
			}
			// a command held for this session (the copy caught up, or the main session open) runs now, as typed
			runResubmit();
			vs.nav = false; vs.confirm = false;   // a switch ends the navigation
			// the clocks of running runs move once a second
			clock = setInterval(() => { if (reg.runs.some((x) => x.status === "running") && footerShown()) repaint(); }, 1000);
			(clock as any).unref?.();
			addDone();
		}
		status();
		if (!isChildSession(file)) setTimeout(flushPending, 50);
	});
	// /new in a child's session starts a new main session, as in the main
	// session; /fork and /clone (and /tree's branching) would fork the copy
	pi.on("session_before_switch", (event: any) => {
		if (vs.inplace) { exitInPlace(); return undefined; }   // /new or /resume from in place: the main session's own, as typed there
		if (!inChild() || event?.reason !== "new") return undefined;
		command("new");
		return { cancel: true };
	});
	pi.on("session_before_fork", () => {
		if (!inChild()) return undefined;
		notify("/fork and /clone work on the main session: alt+s or /subagents back first.", "warning");
		return { cancel: true };
	});
	pi.on("session_shutdown", (event: any) => {
		if (clock) { clearInterval(clock); clock = undefined; }
		// the main session ends (quit, /new, /resume elsewhere): its children go; our own switches and /reload keep them
		if (!reg.switching && event?.reason !== "reload") {
			// its background calls go too: queued tasks not started, no report for a session that has gone
			for (const c of bgCalls().values()) { c.drop = true; c.abort(); }
			killChildren();
		}
	});
	// a message for the viewed child: a steer or follow-up while it works, else its next turn
	const toChild = (r: RunRecord, text: string, kind: "steer" | "followUp", images?: unknown[]) => {
		const c = childOf(r);
		if (c.busy) void c.steer(text, kind, images).then((res) => { if (!res?.success) notify(`${r.agent}: ${res?.error ?? "the message was refused"}`, "error"); });
		else {
			if (!r.spawn) { notify("This run predates restartable subagents; it cannot go on.", "warning"); return; }
			void c.prompt(text, { images }).then((x) => { if (x.exitCode !== 0 && !x.stopped && x.exitCode !== 130) notify(`${r.agent}: ${(x.stderr || "the turn failed").trim().slice(-200)}`, "error"); });
		}
		repaint();
	};
	// In place the TUI's session is the main session, so its input hook also
	// sees the main session's own input: messages queued while it compacted
	// (pi submits them when compaction ends), other extensions' messages. A
	// message typed for the child goes to it from the key hook (it never
	// enters pi's submit, whose compaction queue is the main session's); a
	// slash text (a prompt template or skill) is marked there and taken here.
	const typedForChild = (text: string, kind: "steer" | "followUp"): boolean => {
		vs.typed = undefined;
		if (!text) return false;
		const ed = (reg as any).tui?.focusedComponent;
		try { if (ed?.isShowingAutocomplete?.()) return false; } catch { /* as typed */ }
		if (text.startsWith("/")) { vs.typed = text; return false; }   // pi's command, or a template the input hook takes
		const r = viewed();
		if (!r) return false;
		try { ed?.addToHistory?.(text); } catch { /* no history */ }
		try { reg.ui?.setEditorText?.(""); } catch { /* keep going */ }
		toChild(r, text, kind);
		return true;
	};
	// in a child's session, the editor talks to the child; this view's own command text never reaches the model
	pi.on("input", (event: any) => {
		const text = String(event?.text ?? "");
		if (/^\/subagents(\s|$)/.test(text.trim())) return { action: "handled" };
		if (!inChild()) return undefined;
		if (vs.inplace) {   // the main session's own input, not the child's (see typedForChild)
			if ((event?.source && event.source !== "interactive") || !vs.typed || text.trim() !== vs.typed) return undefined;
			vs.typed = undefined;
		}
		const r = viewed();
		if (!r) { notify("This subagent's run is not known here any more.", "warning"); return { action: "handled" }; }
		if (!text.trim()) return { action: "handled" };
		const images = Array.isArray(event?.images) && event.images.length ? event.images : undefined;
		const kind = vs.followUpNext ? "followUp" : "steer"; vs.followUpNext = false;
		toChild(r, text, kind, images);
		return { action: "handled" };
	});
	// ! and !! in a child's session run in the child (and land in its session);
	// pi draws the result as for any ! command and records it in its copy
	pi.on("user_bash", async (event: any) => {
		if (!inChild()) return undefined;
		if (vs.inplace) throw new Error("runs in the subagent's session: press enter on the ! line again");   // never recorded in the main session
		const r = viewed(), c = r && childOf(r);
		if (!r || !c || !(c.alive || c.start())) return { result: { output: `${r?.agent ?? "the subagent"} could not start: ${c?.stderr ?? ""}`, exitCode: 1, cancelled: false, truncated: false } };
		const res = await c.send({ type: "bash", command: String(event?.command ?? ""), excludeFromContext: !!event?.excludeFromContext });
		const d = res?.data ?? {};
		if (!res?.success) return { result: { output: String(res?.error ?? "failed"), exitCode: 1, cancelled: false, truncated: false } };
		return { result: { output: String(d.output ?? ""), exitCode: typeof d.exitCode === "number" ? d.exitCode : 0, cancelled: !!d.cancelled, truncated: !!d.truncated, fullOutputPath: d.fullOutputPath } };
	});
	// /model, the thinking level and /compact in a child's session act on the child
	const forward = async (cmd: Record<string, unknown>, what: string) => {
		const r = viewed(); if (!r) return;
		const c = childOf(r);
		if (!c.alive && !c.start()) { notify(`${r.agent} could not start: ${c.stderr}`, "error"); return; }
		const res = await c.send(cmd);
		// the level the child took (pi may clamp it to what its model has): asked back
		if (res?.success && cmd.type === "set_thinking_level") { noteLevel(r, cmd.level); void refreshStats(c); }
		if (res?.success && (cmd.type === "set_model" || cmd.type === "compact")) void refreshStats(c);
		notify(res?.success ? `${r.agent}: ${what}` : `${r.agent}: ${res?.error ?? `${what} failed`}`, res?.success ? "info" : "error");
	};
	const forwardTo = async (c: Child, r: RunRecord, cmd: Record<string, unknown>, what: string) => {
		if (!c.alive && !c.start()) { notify(`${r.agent} could not start: ${c.stderr}`, "error"); return; }
		const res = await c.send(cmd);
		const d = res?.data ?? {};
		const now = d.level ?? d.model?.id ?? d.id ?? "";
		if (res?.success) { if (cmd.type === "cycle_thinking_level") noteLevel(r, d.level); else if (cmd.type === "cycle_model") void refreshStats(c); }
		notify(res?.success ? `${r.agent}: ${what}${now ? ` ${now}` : ""}` : `${r.agent}: ${res?.error ?? `${what} failed`}`, res?.success ? "info" : "error");
	};
	pi.on("model_select", (event: any) => {
		if (!inChild() || !event?.model) return;
		void forward({ type: "set_model", provider: event.model.provider, modelId: event.model.id }, `model ${event.model.id}`);
	});
	pi.on("thinking_level_select", (event: any) => {
		// in place the event is the main session's (pi's or the agent guard's): not the child's
		if (!inChild() || vs.inplace || !event?.level) return;
		// the copy set to the child's level on opening: nothing to pass on
		const i = vs.echo?.indexOf(event.level) ?? -1;
		if (i >= 0) { vs.echo!.splice(i, 1); return; }
		void forward({ type: "set_thinking_level", level: event.level }, `thinking ${event.level}`);
	});
	pi.on("session_before_compact", (event: any) => {
		if (!inChild()) return undefined;
		// in place the session pi compacts on its own is the main one: it goes ahead
		if (vs.inplace && event?.reason !== "manual") return undefined;
		if (event?.reason === "manual") void forward({ type: "compact", ...(event.customInstructions ? { customInstructions: event.customInstructions } : {}) }, "session compacted");
		return { cancel: true };   // the copy (or, in place, the main session on /compact) is not compacted here
	});

	// switch the TUI to a session file; a call in flight detaches (see above)
	const switchTo = async (ctx: any, file: string, refresh = false, then?: (ctx: any) => unknown): Promise<boolean> => {
		if (!file) return false;
		if (file === vs.current && !refresh) return true;
		if (!existsSync(file)) { notify(isChildSession(file) ? "That run has not written its session yet; try again in a moment." : "The main session has no file yet.", "warning"); return false; }
		if (typeof ctx?.switchSession !== "function") { notify("Switching needs the /subagents command.", "warning"); return false; }
		reg.switching = true;
		try {
			const r = await ctx.switchSession(file, { withSession: async (n: any) => { reg.switching = false; await then?.(n); } });
			if (r?.cancelled) { notify("Switch cancelled.", "warning"); return false; }
			return true;
		} catch (e) {
			notify(`Switching sessions failed: ${e instanceof Error ? e.message : String(e)}`, "error");
			return false;
		} finally { reg.switching = false; }
	};
	// the main session's turn is running (or has queued messages): a switchSession now would abort it
	const mainWorking = (ctx: any) => !isChildSession(vs.current) && (vs.mainBusy || (typeof ctx?.isIdle === "function" && !ctx.isIdle()) || !!ctx?.hasPendingMessages?.());
	// a child's session is opened as a fresh copy of its file (the child writes the file);
	// while the main session works it is shown in place instead (see above)
	const switchToRun = async (ctx: any, r: RunRecord, refresh = false) => {
		if (vs.inplace && !refresh) { if (r.id !== vs.inplace.run) enterInPlace(r); return; }
		if (!refresh && mainWorking(ctx)) {
			if (enterInPlace(r)) return;
			notify("The main session is working, and switching now would stop it: switch again when its turn has ended.", "warning");   // pi's layout not as expected
			return;
		}
		if (!r.sessionFile || !existsSync(r.sessionFile)) { notify("That run has no session file (it predates this version).", "warning"); return; }
		const copy = viewFile(r.sessionFile);
		keepMainLevel();
		// not opened (the copy not written, the switch refused or cancelled): nothing kept aside
		const unkeep = () => { if (!inChild()) { vs.mainLevel = undefined; vs.mainHome = undefined; } };
		try { writeFileSync(copy, viewLines(readFileSync(r.sessionFile, "utf8")).join("\n") + "\n", { mode: 0o600 }); chmodSync(copy, 0o600); }
		catch (e) { unkeep(); notify(`Could not open that session: ${e instanceof Error ? e.message : String(e)}`, "error"); return; }
		if (!(await switchTo(ctx, copy, refresh))) unkeep();
	};
	const listText = () => {
		const rs = view ? view.order(reg.runs) : reg.runs;
		if (!rs.length) return "No subagent or expert runs in this session yet.";
		return rs.map((r: RunRecord, i: number) => `${i + 1}. ${view?.MARK?.[r.status] ?? r.status} ${r.agent} — ${view ? view.statusLabel(r) : r.status}, ${view ? view.elapsed(view.runMs(r, Date.now())) : ""}, ↑${r.input} ↓${r.output}: ${view ? view.summary(r.task).slice(0, 80) : r.task.slice(0, 80)}`).join("\n");
	};
	api.registerCommand?.("subagents", {
		description: "Subagent sessions: /subagents navigates the footer list (as alt+s); /subagents toggle: the list in the main session's footer; back; stop <n|agent>; <n|agent> switches",
		getArgumentCompletions: (prefix: string) => subcommandCompletions(prefix),
		handler: async (args: string, ctx: any) => {
			const a = String(args ?? "").trim();
			try { await loadDeps(); } catch { /* plain */ }
			const say = (m: string, t: "info" | "warning" | "error" = "info") => (ctx?.hasUI ? ctx.ui.notify(m, t) : console.log(m));
			if (a === "toggle") {
				vs.footer = !vs.footer;
				if (DEPTH === 0) { try { saveFooterOn(vs.footer); } catch { /* best effort */ } }
				applyFooter(); lastStatus = undefined; status(); repaint();
				return say(vs.footer ? "Subagents in the footer (remembered)." : "No subagents in the footer (remembered).");
			}
			if (a === "stop" || a.startsWith("stop ")) {
				const r = pickRun(reg.runs, a.slice(4), view?.order ?? ((x: RunRecord[]) => x));
				if (!r || r.status !== "running") return say(r ? `${r.agent} is not running.` : `No run "${a.slice(4).trim()}".`, "warning");
				reg.stops.get(r.id)?.();
				return say(`Stopping ${r.agent}.`);
			}
			if (!isTui(ctx)) return say(listText());
			reg.ui = ctx.ui;
			if (a === "back" || a === "main") {
				if (exitInPlace()) return;
				if (!inChild()) return say("This is the main session.");
				await switchTo(ctx, vs.home);
				return;
			}
			if (a.startsWith("id:")) {   // the navigator's switch
				const r = reg.runs.find((x) => x.id === a.slice(3));
				if (r) await switchToRun(ctx, r);
				return;
			}
			if (a === "refresh") {
				const r = viewed();
				if (vs.inplace && r) {   // a command held in place: in the child's own session, once the main session is idle
					if (mainWorking(ctx)) { vs.resubmit = undefined; vs.resubmitKey = undefined; notify(`The main session is working: this would act on it. It runs in ${r.agent}'s own session once the main session is idle.`, "warning"); return; }
					exitInPlace(false); await switchToRun(ctx, r, true); return;   // the held command runs there
				}
				if (inChild() && r) await switchToRun(ctx, r, true);
				return;
			}
			if (a === "new") {   // /new typed in a child's session: a new main session
				if (!inChild()) return;
				await switchTo(ctx, vs.home, false, async (n: any) => { await n?.newSession?.(); });
				return;
			}
			if (a) {
				const r = pickRun(reg.runs, a, view?.order ?? ((x: RunRecord[]) => x));
				if (!r) return say(`No run "${a}". /subagents lists them.`, "warning");
				return switchToRun(ctx, r);
			}
			if (vs.nav) closeNav(); else openNav();   // the footer navigator
		},
	});
	if (keyOn()) api.registerShortcut?.(VIEW_KEY, {
		description: "Subagent sessions: the footer list takes the keys (↑↓ enter switches, esc back to the editor)",
		handler: async () => { if (vs.nav) closeNav(); else openNav(); },   // where the key hook is missing
	});
}

export default function (pi: ExtensionAPI) {
	if (!ACTIVE || DEPTH >= MAX_DEPTH) return;   // a child at the depth limit gets no tool at all (and pays no tokens for it)
	if (DEPTH > 0 && process.env.LETS_CODE_EXPERT_TEAM) return;   // a child with a team starts its team's experts only (the expert tool)
	const Item = Type.Object({ agent: Type.String({ description: "agent name" }), task: Type.String({ description: "task; in a chain, {previous} is the prior step's output" }) });
	// Always in context, kept small: the snippet puts the tool in pi's
	// "Available tools" list, the guideline makes the model orchestrate
	// instead of building its own delegation, and the tool description names
	// each agent's job with the three call shapes so the first call needs no
	// discovery. The full method (orchestration()) joins the system prompt
	// only once a session asks for it (wantsOrchestration) or its context
	// passes ORCH_CONTEXT_PCT, and then stays: a section that comes and goes
	// costs a change note in the conversation each time it flips.
	const known = discoverAgents(process.cwd(), false).slice(0, 8);
	const names = known.map((a) => a.name).join(", ") || "none yet";
	let orchestrating = false;
	pi.registerTool({
		name: "subagent",
		label: "subagent",
		description: agentsBlurb(known),
		promptSnippet: `subagent: delegate to agents (${names}); parallel or chained`,
		promptGuidelines: ["Orchestrate independent parts or heavy reading via subagent (tasks:[...] = parallel); never build your own."],
		parameters: Type.Object({
			agent: Type.Optional(Type.String({ description: "agent name (single)" })),
			task: Type.Optional(Type.String({ description: "task (single)" })),
			tasks: Type.Optional(Type.Array(Item, { description: "run in parallel" })),
			chain: Type.Optional(Type.Array(Item, { description: "run in order" })),
			action: Type.Optional(Type.String({ description: "run (default) | status | stop" })),
			run: Type.Optional(Type.String({ description: "stop: the run id, agent name, workflow name, or all" })),
			wait: Type.Optional(Type.Number({ description: "seconds to wait for the report before it goes on in the background (default 0)" })),
		}),
		async execute(_id, params: any, signal, onUpdate, ctx: ExtensionContext) {
			const agents = discoverAgents(ctx.cwd, typeof (ctx as any).isProjectTrusted === "function" ? ctx.isProjectTrusted() : !!(ctx as any).isProjectTrusted);
			const list = agents.map((a) => `- ${a.name}: ${a.description || "(no description)"}`).join("\n") || "(none: add ~/.pi/agent/agents/<name>.md)";
			const find = (n: string) => agents.find((a) => a.name === n);
			const missing = (n: string) => EXPERTS && discoverExperts().some((s) => s.name === n)
				? { content: [{ type: "text" as const, text: `"${n}" is an expert: use expert({action: "run", name: "${n}", brief}) (action "list" shows its brief template).` }], isError: true }
				: { content: [{ type: "text" as const, text: `Unknown agent "${n}". Agents:\n${list}` }], isError: true };
			// a call goes on when the user switches sessions mid-call (see detachable)
			let job = { detached: false };
			const progress = (line: string) => { if (!job.detached) onUpdate?.({ content: [{ type: "text", text: line }] }); };
			const cwd = ctx.cwd;   // read now: a ctx goes stale once the session switches, and queued tasks start later
			const planned = params.tasks?.length || params.chain?.length || 1;
			const detach = (work: (s: AbortSignal) => Promise<{ text: string; isError: boolean }>) =>
				detachable(signal, _id, (s, j) => { job = j; return work(s); }, backgroundAfter(ctx, params.wait), planned).then((o) => ({ content: [{ type: "text" as const, text: o.text }], isError: o.isError }));
			const reply = (text: string, isError = false) => ({ content: [{ type: "text" as const, text }], isError });
			const action = String(params.action ?? "run").trim().toLowerCase() || "run";
			if (action === "status") return reply(statusText(registry().runs));
			if (action === "stop") {
				const want = String(params.run ?? "").trim();
				const live = registry().runs.filter((r) => r.status === "running");
				if (want === "all") {
					const n = bgCalls().size;
					for (const c of bgCalls().values()) c.abort();
					for (const r of live) registry().stops.get(r.id)?.();
					return reply(n || live.length ? `Stopping ${live.length} run${live.length === 1 ? "" : "s"} and ${n} background call${n === 1 ? "" : "s"} (their queued tasks are not started); the reports arrive as messages.` : "Nothing is running.");
				}
				const r = live.find((x) => x.id === want) ?? live.find((x) => x.agent === want);
				const wf = r ? undefined : [...bgCalls().values()].find((c) => c.name && (c.name === want || `workflow ${c.name}` === want));
				if (wf) { wf.abort(); return reply(`Stopping workflow ${wf.name} (its running agents too, and it starts no more); its report arrives as a message.`); }
				if (!r) return reply(want ? `No running run "${want}". subagent({action: "status"}) lists them.` : "Give run: the run id or agent name.", true);
				registry().stops.get(r.id)?.();
				return reply(`Stopping ${r.agent} (run ${r.id}); its report arrives as a message.`);
			}
			if (action !== "run") return reply("action is run, status or stop.", true);
			if (params.tasks?.length) {
				if (params.tasks.length > MAX_PARALLEL) return { content: [{ type: "text" as const, text: `Too many parallel tasks (${params.tasks.length}); max ${MAX_PARALLEL}.` }], isError: true };
				for (const t of params.tasks) if (!find(t.agent)) return missing(t.agent);
				return detach(async (sig) => {
					const all = await mapLimit(params.tasks, CONCURRENCY, (t: any, i: number) => runAgent(find(t.agent)!, t.task, cwd, sig, progress, { tool: "subagent", callId: _id, mode: "parallel", index: i, of: params.tasks.length }), sig);
					const results = all.filter(Boolean), skipped = all.length - results.length;
					return { text: results.map(render).join("\n\n") + (skipped ? `\n\n(${skipped} queued task${skipped === 1 ? " was" : "s were"} stopped before starting.)` : ""), isError: !results.length || results.every((r) => r.exitCode !== 0) };
				});
			}
			if (params.chain?.length) {
				for (const t of params.chain) if (!find(t.agent)) return missing(t.agent);
				return detach(async (sig) => {
					const results: RunResult[] = []; let previous = "";
					for (const [i, t] of (params.chain as any[]).entries()) {
						const r = await runAgent(find(t.agent)!, t.task.replace(/\{previous\}/g, previous), cwd, sig, progress, { tool: "subagent", callId: _id, mode: "chain", index: i, of: params.chain.length });
						r.step = i + 1; results.push(r); previous = r.text;
						if (r.exitCode !== 0 || sig.aborted) break;
					}
					return { text: results.map(render).join("\n\n"), isError: results[results.length - 1]?.exitCode !== 0 };
				});
			}
			if (!params.agent || !params.task) return { content: [{ type: "text" as const, text: `Give {agent, task}, {tasks:[...]} or {chain:[...]}. Agents:\n${list}` }], isError: !agents.length };
			const a = find(params.agent); if (!a) return missing(params.agent);
			return detach(async (sig) => {
				const r = await runAgent(a, params.task, cwd, sig, progress, { tool: "subagent", callId: _id, mode: "single" });
				return { text: render(r), isError: r.exitCode !== 0 };
			});
		},
	});
	if (DEPTH === 0) setupSessions(pi);
	// once on, it stays on for the session (see above); subagents never get it
	pi.on("before_agent_start", async (event: any, ctx: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (!sections || typeof sections !== "object") return undefined;
		if (!orchestrating && DEPTH === 0) {
			const pct = ctx?.getContextUsage?.()?.percent;
			orchestrating = wantsOrchestration(event.prompt) || (typeof pct === "number" && pct >= ORCH_CONTEXT_PCT);
		}
		if (orchestrating) sections.lets_code_orchestration = orchestration(known);
		// a trusted project's Claude Code agents are known only once the session has started
		const snippets = event?.systemPromptOptions?.toolSnippets;
		if (CLAUDE && snippets && typeof snippets === "object" && "subagent" in snippets) {
			const all = discoverAgents(ctx?.cwd ?? process.cwd(), false).slice(0, 12).map((a) => a.name).join(", ");
			if (all && all !== names) snippets.subagent = `subagent: delegate to agents (${all}); parallel or chained`;
		}
		return undefined;
	});
}
