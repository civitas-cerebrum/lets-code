};
const ORDER: Decision[] = ["allow", "ask", "deny"];
const stricter = (a: Decision, b: Decision) => (ORDER.indexOf(a) >= ORDER.indexOf(b) ? a : b);

const BUILTIN: Manifest = {
	default: "auto",
	cycle: ["auto", "ask", "plan", "yolo"],
	roles: {
		auto: { label: "auto", external: "allow", bash: { "*": "allow" }, mcp: "allow", dispatch: ["*"], network: "on" },
		ask: {
			label: "ask", external: "ask", mcp: "allow", dispatch: ["*"], network: "on",
			bash: { "*": "allow", privileged: "ask", destructive: "ask", "package-install": "ask", "network-exec": "ask" },
		},
		plan: {
			label: "plan", tools: ["read", "grep", "find", "ls", "bash", "tool_search", "codemode", "subagent", "list_mcp_resources", "read_mcp_resource"],
			write: [], external: "deny", bash: { "*": "deny", readonly: "allow" }, mcp: "deny", dispatch: ["*"], network: "off",
			prompt: "Plan mode: explore the code and run read-only commands only; edits, writes and installs are refused. Finish with a numbered list under the heading \"Plan:\" that another agent could follow, then stop. The user decides when to execute it.",
		},
		// read-only without the planning instructions: for scouts and reviewers
		readonly: { label: "readonly", tools: ["read", "grep", "find", "ls", "bash", "tool_search", "list_mcp_resources", "read_mcp_resource"], write: [], external: "deny", bash: { "*": "deny", readonly: "allow" }, mcp: "deny", dispatch: [], network: "off" },
		yolo: { label: "yolo", bypass: true, network: "on", dispatch: ["*"], mcp: "allow" },
	},
};

// ---------------------------------------------------------------- manifest
function readJson(p: string): any | undefined {
	if (!existsSync(p)) return undefined;
	try { return JSON.parse(readFileSync(p, "utf8")); } catch (e) { throw new Error(`${p}: ${(e as Error).message}`); }
}
function mergeRole(base: Role, over: Role): Role {
	const out: Role = { ...base, ...over };
	if (base.bash || over.bash) out.bash = { ...(base.bash ?? {}), ...(over.bash ?? {}) };
	if (base.groups || over.groups) out.groups = { ...(base.groups ?? {}), ...(over.groups ?? {}) };
	if (base.sandbox || over.sandbox) out.sandbox = { ...(base.sandbox ?? {}), ...(over.sandbox ?? {}) };
	return out;
}
// The project manifest may only tighten: decisions can move allow -> ask ->
// deny, lists can shrink, bypass cannot be set, roles cannot be added.
function tightenRole(global: Role, project: Role, warn: (m: string) => void, name: string): Role {
	const out: Role = { ...global };
	const inter = (a: string[] | undefined, b: string[] | undefined) => (a ? a.filter((x) => b!.includes(x) || b!.includes("*")) : b);
	if (project.tools) out.tools = inter(global.tools, project.tools);
	if (project.dispatch) out.dispatch = global.dispatch?.includes("*") ? project.dispatch : inter(global.dispatch, project.dispatch);
	if (project.write) out.write = project.write.filter((w) => !global.write || global.write.some((g) => w === g || w.startsWith(g.replace(/\/?$/, "/"))) );
	if (project.read) out.read = project.read;
	if (project.external) out.external = stricter(global.external ?? "allow", project.external);
	if (project.bash) { out.bash = { ...(global.bash ?? {}) }; for (const [g, d] of Object.entries(project.bash)) out.bash[g] = stricter(global.bash?.[g] ?? global.bash?.["*"] ?? "allow", d); }
	if (project.groups) out.groups = { ...(global.groups ?? {}), ...project.groups };
	if (project.mcp !== undefined) {
		if (typeof project.mcp === "string") out.mcp = typeof global.mcp === "string" ? stricter(global.mcp, project.mcp) : project.mcp === "allow" ? global.mcp : project.mcp;
		else out.mcp = Array.isArray(global.mcp) ? global.mcp.filter((s) => (project.mcp as string[]).includes(s)) : project.mcp;
	}
	if (project.network === "off") out.network = "off";
	if (project.protected) out.protected = [...(global.protected ?? []), ...project.protected];
	if (project.prompt) out.prompt = project.prompt;
	if (project.sandbox) out.sandbox = { ...(global.sandbox ?? {}), ...project.sandbox };
	if (project.bypass) warn(`mandate: .pi/mandate.json cannot set bypass on role '${name}' (ignored)`);
	return out;
}
export function loadManifest(cwd: string, trusted: boolean, warn: (m: string) => void): Manifest {
	const m: Manifest = { default: BUILTIN.default, cycle: [...(BUILTIN.cycle ?? [])], roles: {} };
	for (const [n, r] of Object.entries(BUILTIN.roles)) m.roles[n] = { ...r };
	const g = readJson(join(AGENT_DIR, "mandate.json"));
	if (g) {
		if (typeof g.default === "string") m.default = g.default;
		if (Array.isArray(g.cycle)) m.cycle = g.cycle.filter((x: unknown) => typeof x === "string");
		for (const [n, r] of Object.entries((g.roles ?? {}) as Record<string, Role>)) m.roles[n] = m.roles[n] ? mergeRole(m.roles[n], r) : { ...r };
	}
	const pPath = join(cwd, ".pi", "mandate.json");
	if (trusted && existsSync(pPath)) {
		const p = readJson(pPath);
		if (p?.default && typeof p.default === "string" && m.roles[p.default]) m.default = p.default;
		for (const [n, r] of Object.entries((p?.roles ?? {}) as Record<string, Role>)) {
			if (!m.roles[n]) { warn(`mandate: .pi/mandate.json cannot add role '${n}' (ignored)`); continue; }
			m.roles[n] = tightenRole(m.roles[n], r, warn, n);
		}
	} else if (!trusted && existsSync(pPath)) warn("mandate: .pi/mandate.json ignored (project not trusted)");
	return m;
}

// ------------------------------------------------------------------ paths
function expandHome(p: string): string { return p === "~" ? homedir() : p.startsWith("~/") ? join(homedir(), p.slice(2)) : p; }
function globToRe(g: string): RegExp {
	const esc = g.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*\*/g, "\u0000").replace(/\*/g, "[^/]*").replace(/\?/g, "[^/]").replace(/\u0000/g, ".*");
	return new RegExp(`^${esc}$`);
}
function canonical(p: string, cwd: string): string {
	let abs = isAbsolute(p) ? p : resolve(cwd, expandHome(p));
	abs = expandHome(abs);
	// resolve the deepest existing ancestor so symlinks cannot leave the scope
	let probe = abs; const rest: string[] = [];
	while (!existsSync(probe) && dirname(probe) !== probe) { rest.unshift(probe.slice(dirname(probe).length + 1)); probe = dirname(probe); }
	try { probe = realpathSync(probe); } catch { /* keep */ }
	return rest.length ? join(probe, ...rest) : probe;
}
function inScope(path: string, scopes: string[] | undefined, cwd: string): boolean {
	if (!scopes) return true;
	const c = canonical(path, cwd);
	for (const s of scopes) {
		if (s === "*" || s === "/") return true;
		if (/[*?]/.test(s)) { if (globToRe(canonical(s.replace(/[*?].*$/, "") , cwd) + s.slice(s.search(/[*?]/))).test(c) || globToRe(s).test(c)) return true; continue; }
		const base = canonical(s, cwd);
		if (c === base || c.startsWith(base.endsWith(sep) ? base : base + sep)) return true;
	}
	return false;
}
function isProtected(path: string, role: Role, cwd: string): boolean {
	const c = canonical(path, cwd); const name = c.split(sep).pop() ?? "";
	for (const p of [...PROTECTED, ...(role.protected ?? [])]) {
		if (p.endsWith("/")) { if (c.split(sep).includes(p.slice(0, -1))) return true; continue; }
		if (/[*?]/.test(p)) { if (globToRe(p).test(name)) return true; continue; }
		if (name === p) return true;
	}
	return false;
}

// ------------------------------------------------------------------- bash
// A small shell lexer: enough to split a command line into simple commands
// (respecting quotes, subshells and heredocs), strip env/wrapper prefixes
// and pull out redirection targets. Indirection it cannot see (a variable
// holding a command) is judged as what it shows; the sandbox is the backstop.
export function splitCommands(cmd: string): string[] {
	const out: string[] = []; let cur = ""; let q: string | null = null; let depth = 0; let i = 0;
	const heredocs: string[] = [];
	const push = () => { const t = cur.trim(); if (t) out.push(t); cur = ""; };
	while (i < cmd.length) {
		const ch = cmd[i], nx = cmd[i + 1];
		if (q) { cur += ch; if (ch === "\\" && q === '"' && nx !== undefined) { cur += nx; i += 2; continue; } if (ch === q) q = null; i++; continue; }
		if (ch === "\\" && nx !== undefined) { cur += ch + nx; i += 2; continue; }
		if (ch === "'" || ch === '"' || ch === "`") { q = ch === "`" ? "`" : ch; cur += ch; i++; continue; }
		if (ch === "#" && (cur === "" || /\s$/.test(cur))) { while (i < cmd.length && cmd[i] !== "\n") i++; continue; }
		if (ch === "<" && nx === "<") { const m = /^<<-?\s*(['"]?)([A-Za-z_][A-Za-z0-9_]*)\1/.exec(cmd.slice(i)); if (m) { heredocs.push(m[2]); cur += m[0]; i += m[0].length; continue; } }
		if (ch === "(" ) { depth++; cur += ch; i++; continue; }
		if (ch === ")") { depth = Math.max(0, depth - 1); cur += ch; i++; continue; }
		// "&" is an operator only when it is not part of a redirection: 2>&1, <&0, &>file
		const redirAmp = ch === "&" && (/[<>]$/.test(cur) || nx === ">");
		if (depth === 0 && !redirAmp && (ch === ";" || ch === "|" || ch === "&" || ch === "\n")) {
			if (ch === "\n" && heredocs.length) { // skip heredoc bodies
				let rest = cmd.slice(i + 1); let consumed = 0;
				for (const tag of heredocs) { const re = new RegExp(`(^|\\n)\\t*${tag}(\\n|$)`); const mm = re.exec(rest); if (mm) { consumed += mm.index + mm[0].length; rest = rest.slice(mm.index + mm[0].length); } }
				heredocs.length = 0; push(); i += 1 + consumed; continue;
			}
			push(); if ((ch === "|" || ch === "&") && nx === ch) i++; i++; continue;
		}
		cur += ch; i++;
	}
	push();
	// unwrap subshells / groups / shell -c and judge their contents too
	const expanded: string[] = [];
	for (const c of out) {
		const inner = /^\(\s*([\s\S]*)\)\s*$/.exec(c) ?? /^\{\s*([\s\S]*);?\s*\}\s*$/.exec(c);
		if (inner) { expanded.push(...splitCommands(inner[1])); continue; }
		const shc = /^(?:(?:env|sudo|doas|nice|nohup|timeout\s+\S+|xargs)\s+)*(?:sh|bash|zsh|dash)\s+(?:-[a-z]*c)\s+(['"])([\s\S]*)\1/.exec(c);
		if (shc) { expanded.push(c.replace(shc[2], "…"), ...splitCommands(shc[2])); continue; }
		const sub = [...c.matchAll(/\$\(([^()]*)\)/g)].map((m) => m[1]);
		expanded.push(c, ...sub.flatMap(splitCommands));
	}
	return expanded;
}
function stripPrefixes(c: string): string {
	let s = c.trim(); let changed = true;
	while (changed) {
		changed = false;
		const m = /^(?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+|env\s+(?:-[a-zA-Z]+\s+)?|nice\s+(?:-n\s*\d+\s+)?|nohup\s+|time\s+|command\s+|exec\s+|builtin\s+|timeout\s+(?:-[a-z]+\s+)*\S+\s+|xargs\s+(?:-[a-zA-Z0-9]+\s*)*)/.exec(s);
		if (m && m[0].length) { s = s.slice(m[0].length); changed = true; }
	}
	return s;
}
export function classify(cmd: string, role: Role): { decision: Decision; group: string; command: string } {
	const groups = { ...GROUPS, ...Object.fromEntries(Object.entries(role.groups ?? {}).map(([k, v]) => [k, v.map((r) => new RegExp(r))])) };
	const policy = role.bash ?? { "*": "allow" };
	const dflt: Decision = policy["*"] ?? "allow";
	let worst: { decision: Decision; group: string; command: string } = { decision: "allow", group: "", command: "" };
	for (const raw of splitCommands(cmd)) {
		const c = stripPrefixes(raw);
		if (!c) continue;
		const sudo = /^(sudo|doas)\s/.test(raw.trim());
		let d: Decision | null = null; let g = "";
		for (const [name, res] of Object.entries(groups)) {
			if (name === "readonly") continue;
			// patterns that mention a pipe are matched against the whole call, since pipelines are split
			if (res.some((r) => r.test(c) || (r.source.includes("\\|") && r.test(cmd))) || (name === "privileged" && sudo)) { const pd = policy[name] ?? dflt; if (d === null || stricter(pd, d) === pd) { d = pd; g = name; } }
		}
		if (d === null) { // no group matched: readonly commands are allowed under a deny-by-default role
			// a redirection makes a read-only command a write, except to /dev/null or into another descriptor (2>&1)
			const noWrite = !/[>]/.test(c.replace(/\d?>>?\s*\/dev\/null/g, "").replace(/\d?>&\d/g, ""));
			if (dflt === "deny" && groups.readonly.some((r) => r.test(c)) && noWrite) { d = policy.readonly ?? "allow"; g = "readonly"; }
			else { d = dflt; g = "*"; }
		}
		if (stricter(d, worst.decision) === d && d !== worst.decision) worst = { decision: d, group: g, command: c };
		if (worst.decision === "deny") break;
	}
	return worst;
}
export function redirectTargets(cmd: string): string[] {
	const out: string[] = [];
	for (const m of cmd.matchAll(/(?:^|[^<>])(?:\d?>>?|&>|>\|)\s*([^\s;&|)]+)/g)) if (!/^&\d/.test(m[1]) && m[1] !== "/dev/null") out.push(m[1].replace(/^['"]|['"]$/g, ""));
	for (const m of cmd.matchAll(/\b(?:tee|touch|mkdir|cp|mv|install|ln|rsync)\s+(?:-[a-zA-Z]+\s+)*(.*?)(?:$|[;&|])/g)) for (const a of m[1].split(/\s+/)) if (a && !a.startsWith("-")) out.push(a.replace(/^['"]|['"]$/g, ""));
	for (const m of cmd.matchAll(/\bsed\s+-i\S*\s+(?:-e\s+\S+\s+|'[^']*'\s+|"[^"]*"\s+)+(\S+)/g)) out.push(m[1]);
	return out.filter((p) => !/[$`]/.test(p));
}

// ------------------------------------------------------------------- state
export function roleFor(manifest: Manifest, name: string): Role { return manifest.roles[name] ?? manifest.roles[manifest.default ?? "auto"] ?? BUILTIN.roles.auto; }
export function mcpDecision(role: Role, tool: string): Decision {
	const server = tool.split("__")[1] ?? "";
	if (role.mcp === undefined) return "allow";
	if (typeof role.mcp === "string") return role.mcp;
	return role.mcp.includes(server) || role.mcp.includes("*") ? "allow" : "deny";
}
export function mayDispatch(role: Role, agent: string): boolean { return !role.dispatch || role.dispatch.includes("*") || role.dispatch.includes(agent); }
const short = (s: string, n = 190) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);

export default function (pi: ExtensionAPI) {
	if (!ACTIVE) return;
	const subagentDepth = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
	let manifest: Manifest = BUILTIN;
	let roleName = process.env.LETS_CODE_ROLE || process.env.LETS_CODE_MODE || "auto";
	let role: Role = BUILTIN.roles.auto;
	let allowedForSession = new Set<string>();   // "bash:<group>" | "external" | "mcp:<server>"
	let cwd = process.cwd();
	let savedTools: string[] | null = null;

	const log = (event: string, detail: Record<string, unknown>) => {
		try { mkdirSync(dirname(LOG), { recursive: true }); appendFileSync(LOG, JSON.stringify({ t: Date.now(), role: roleName, event, ...detail }) + "\n"); } catch { /* never fatal */ }
	};
	const warn = (ctx: ExtensionContext | undefined, m: string) => { if (ctx?.hasUI) ctx.ui.notify(m, "warning"); log("warn", { m }); };

	function apply(ctx: ExtensionContext | undefined, name: string, announce = true) {
		if (!manifest.roles[name]) { warn(ctx, `mandate: unknown role '${name}', using '${manifest.default}'`); name = manifest.default ?? "auto"; }
		const prev = roleName; roleName = name; role = roleFor(manifest, name);
		// plan-like roles: drop tools outside the allowlist from the active set; restore on exit
		if (role.tools) {
			if (!savedTools) savedTools = pi.getActiveTools();
			const allowed = new Set(role.tools);
			pi.setActiveTools(pi.getActiveTools().filter((t) => allowed.has(t)));
		} else if (savedTools) { pi.setActiveTools(savedTools); savedTools = null; }
		if (ctx?.hasUI) ctx.ui.setStatus("mandate", role.bypass ? "mode: yolo" : `mode: ${role.label ?? name}`);
		if (announce) { pi.events.emit("lets-code:mode", { role: name, network: role.network ?? "on", bypass: !!role.bypass, sandbox: role.sandbox ?? {} }); if (prev !== name) log("mode", { from: prev, to: name }); }
	}
	function reload(ctx: ExtensionContext | undefined) {
		try { manifest = loadManifest(cwd, ctx?.isProjectTrusted ?? false, (m) => warn(ctx, m)); }
		catch (e) { // a broken manifest fails closed: built-in roles only, and the strictest mode that still works
			warn(ctx, `mandate: ${(e as Error).message} — using built-in roles`); manifest = BUILTIN;
		}
		apply(ctx, process.env.LETS_CODE_ROLE || process.env.LETS_CODE_MODE || manifest.default || "auto");
	}

	async function decide(ctx: ExtensionContext, d: Decision, key: string, what: string): Promise<{ block: true; reason: string } | undefined> {
		if (d === "allow") return undefined;
		if (d === "deny") { log("deny", { key, what }); return { block: true, reason: short(`mandate(${roleName}): ${what} is not allowed in this mode. Switch with /mode, or ask the user.`) }; }
		if (allowedForSession.has(key)) return undefined;
		if (!ctx.hasUI) { log("deny", { key, what, why: "no-ui" }); return { block: true, reason: short(`mandate(${roleName}): ${what} needs approval and no one can be asked in this mode.`) }; }
		const choice = await ctx.ui.select(`mandate (${roleName}): ${what}\n\nAllow?`, ["Allow once", "Allow for this session", "Deny"]);
		if (choice === "Allow for this session") allowedForSession.add(key);
		if (choice === "Allow once" || choice === "Allow for this session") { log("allow", { key, what, choice }); return undefined; }
		log("deny", { key, what, why: "user" });
		return { block: true, reason: short(`mandate(${roleName}): the user did not approve: ${what}`) };
	}

	pi.on("session_start", async (_e, ctx) => { cwd = ctx.cwd; allowedForSession = new Set(); reload(ctx); });
	pi.on("project_trust", async (_e, ctx) => reload(ctx));

	pi.on("before_agent_start", async (event: any) => {
		const sections = event?.systemPromptOptions?.sections;
		if (sections && typeof sections === "object") { if (role.prompt && !role.bypass) sections.lets_code_mandate = role.prompt; else delete sections.lets_code_mandate; }
		return undefined;
	});

	pi.on("tool_call", async (event, ctx) => {
		if (role.bypass) return undefined;
		const name = event.toolName; const input: any = event.input ?? {};
		if (role.tools && !role.tools.includes(name) && !name.startsWith("mcp__")) return { block: true, reason: short(`mandate(${roleName}): tool '${name}' is not available in this mode (${role.tools.join(", ")}).`) };
		if (name.startsWith("mcp__")) return decide(ctx, mcpDecision(role, name), `mcp:${name.split("__")[1]}`, `MCP call ${name}`);
		if (name === "edit" || name === "write") {
			const p = String(input.path ?? "");
			if (isProtected(p, role, ctx.cwd)) { log("deny", { key: "protected", what: p }); return { block: true, reason: short(`mandate(${roleName}): '${p}' is a protected path and is never written.`) }; }
			if (!inScope(p, role.write ?? ["."], ctx.cwd)) return decide(ctx, role.external ?? "ask", "external", `write outside the project: ${p}`);
			return undefined;
		}
		if (name === "read" || name === "ls" || name === "grep" || name === "find") {
			const p = String(input.path ?? input.dir ?? ".");
			if (role.read && !inScope(p, role.read, ctx.cwd)) return decide(ctx, role.external ?? "ask", "external", `read outside the allowed paths: ${p}`);
			return undefined;
		}
		if (name === "bash") {
			const cmd = String(input.command ?? "");
			const c = classify(cmd, role);
			if (c.decision !== "allow") { const r = await decide(ctx, c.decision, `bash:${c.group}`, `${c.group} command: ${short(c.command, 80)}`); if (r) return r; }
			for (const t of redirectTargets(cmd)) {
				if (isProtected(t, role, ctx.cwd)) { log("deny", { key: "protected", what: t }); return { block: true, reason: short(`mandate(${roleName}): '${t}' is a protected path and is never written.`) }; }
				if (!inScope(t, role.write ?? ["."], ctx.cwd)) { const r = await decide(ctx, role.external ?? "ask", "external", `write outside the project: ${t}`); if (r) return r; }
			}
			return undefined;
		}
		if (name === "subagent") {
			const agents = [input.agent, ...(input.tasks ?? []).map((t: any) => t?.agent), ...(input.chain ?? []).map((t: any) => t?.agent)].filter(Boolean) as string[];
			const bad = agents.find((a) => !mayDispatch(role, a));
			if (bad) { log("deny", { key: "dispatch", what: bad }); return { block: true, reason: short(`mandate(${roleName}): this role may not start the '${bad}' agent (allowed: ${(role.dispatch ?? ["*"]).join(", ")}).`) }; }
		}
		return undefined;
	});

	// --- commands and shortcuts (main session only; a subagent keeps its role)
	if (subagentDepth > 0 || process.env.LETS_CODE_ROLE) return;
	const names = () => Object.keys(manifest.roles);
	pi.registerCommand("mode", {
		description: "Show or switch the mandate mode: /mode [plan|auto|ask|yolo|<role>]",
		handler: async (args, ctx) => {
			const want = (args ?? "").trim();
			if (!want) { ctx.ui.notify(`mode: ${roleName}  (available: ${names().join(", ")})\nlog: ${LOG}`, "info"); return; }
			if (!manifest.roles[want]) { ctx.ui.notify(`unknown mode '${want}' — one of ${names().join(", ")}`, "warning"); return; }
			await leavePlanIfNeeded(ctx, want); apply(ctx, want);
			ctx.ui.notify(`mode: ${want}`, "info");
		},
	});
	pi.registerCommand("plan", {
		description: "Toggle plan mode (read-only exploration that ends in a numbered plan)",
		handler: async (_args, ctx) => { const next = roleName === "plan" ? "auto" : "plan"; await leavePlanIfNeeded(ctx, next); apply(ctx, next); ctx.ui.notify(`mode: ${next}`, "info"); },
	});
	pi.registerShortcut("alt+m", {
		description: "Cycle the mandate mode",
		handler: async (ctx) => { const cyc = (manifest.cycle ?? []).filter((n) => manifest.roles[n]); const i = cyc.indexOf(roleName); const next = cyc[(i + 1) % cyc.length] ?? "auto"; await leavePlanIfNeeded(ctx, next); apply(ctx, next); ctx.ui.notify(`mode: ${next}`, "info"); },
	});
	pi.registerShortcut("ctrl+alt+p", { description: "Toggle plan mode", handler: async (ctx) => { const next = roleName === "plan" ? "auto" : "plan"; await leavePlanIfNeeded(ctx, next); apply(ctx, next); ctx.ui.notify(`mode: ${next}`, "info"); } });

	async function leavePlanIfNeeded(ctx: ExtensionContext, next: string) {
		if (roleName !== "plan" || next === "plan" || !ctx.hasUI) return;
		const last = lastAssistantText(ctx);
		if (!/(^|\n)\s*#*\s*Plan:/i.test(last)) return;
		const choice = await ctx.ui.select("A plan is on the table. Execute it now?", ["Execute the plan", "Switch mode only"]);
		if (choice === "Execute the plan") pi.sendUserMessage("Execute the plan you wrote above, step by step. Run the tests after each step and report what changed.", { deliverAs: "followUp" } as any);
	}
	function lastAssistantText(ctx: ExtensionContext): string {
		try {
			const entries: any[] = (ctx.sessionManager as any).getEntries?.() ?? (ctx.sessionManager as any).getBranch?.() ?? [];
			for (let i = entries.length - 1; i >= 0; i--) {
				const m = entries[i]?.message; if (!m || m.role !== "assistant") continue;
				const c = m.content; if (typeof c === "string") return c;
				if (Array.isArray(c)) return c.filter((x: any) => x?.type === "text").map((x: any) => x.text).join("\n");
			}
		} catch { /* fall through */ }
		return "";
	}
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

# Subagents: one tool, `subagent`, that runs a named agent file in its own
# pi process (same provider, same guards, the role its file names).
pi_write_subagent_extension() {
    local dir="${PI_AGENT_DIR}/extensions" f tmp
    f="${dir}/lets-code-subagent.ts"
    mkdir -p "${dir}"
    tmp="$(mktemp "${dir}/.lets-code-subagent.XXXXXX")"
    cat > "${tmp}" <<'TS'
// Written by lets-code (subagents); regenerated on launch, edits are overwritten.
// Active only in a pi launched by lets-code with subagents on
// (LETS_CODE_SUBAGENTS_ON=1). One tool, `subagent`, delegates a task to a
// named agent in its own pi process with a fresh context: single, parallel
// (concurrency LETS_CODE_SUBAGENT_CONCURRENCY, default 2: one GPU serves
// every agent) or chained ({previous} carries the prior output). Agents are
// Markdown files with YAML frontmatter (name, description, tools, thinking,
// role) in ~/.pi/agent/agents/, and in .pi/agents/ or .agents/agents/ when
// the project is trusted. Every child goes through lets-code's provider and
// the same guards; it runs under the mandate role the agent file names.
// A child cannot start children of its own (LETS_CODE_SUBAGENT_DEPTH).
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { join } from "node:path";
import { Type } from "typebox";

const ACTIVE = process.env.LETS_CODE_SUBAGENTS_ON === "1";
const DEPTH = Number(process.env.LETS_CODE_SUBAGENT_DEPTH ?? "0") || 0;
const MAX_DEPTH = Number(process.env.LETS_CODE_SUBAGENT_MAX_DEPTH ?? "1") || 1;
const CONCURRENCY = Math.max(1, Number(process.env.LETS_CODE_SUBAGENT_CONCURRENCY ?? "2") || 2);
const MAX_PARALLEL = 8;
const OUTPUT_CAP = 50 * 1024;
const AGENT_DIR = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const MODEL = process.env.LETS_CODE_MODEL || "";

export interface AgentDef { name: string; description: string; tools?: string[]; thinking?: string; role?: string; prompt: string; source: "user" | "project"; file: string }

export function parseAgentFile(text: string, file: string, source: "user" | "project"): AgentDef | null {
	const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/.exec(text);
	const fm: Record<string, string> = {}; let body = text;
	if (m) { body = m[2]; for (const line of m[1].split(/\r?\n/)) { const kv = /^([A-Za-z_][\w-]*)\s*:\s*(.*)$/.exec(line); if (kv) fm[kv[1]] = kv[2].trim().replace(/^["']|["']$/g, ""); } }
	const name = (fm.name || file.replace(/^.*\//, "").replace(/\.md$/, "")).trim();
	if (!/^[A-Za-z0-9][\w.-]*$/.test(name)) return null;
	const list = (v?: string) => v ? v.replace(/^\[|\]$/g, "").split(",").map((s) => s.trim()).filter(Boolean) : undefined;
	return { name, description: fm.description ?? "", tools: list(fm.tools), thinking: fm.thinking, role: fm.role, prompt: body.trim(), source, file };
}
export function discoverAgents(cwd: string, trusted: boolean): AgentDef[] {
	const out = new Map<string, AgentDef>();
	const scan = (dir: string, source: "user" | "project") => {
		if (!existsSync(dir)) return;
		for (const f of readdirSync(dir)) { if (!f.endsWith(".md")) continue; try { const a = parseAgentFile(readFileSync(join(dir, f), "utf8"), join(dir, f), source); if (a && !out.has(a.name)) out.set(a.name, a); } catch { /* skip bad file */ } }
	};
	if (trusted) { scan(join(cwd, ".pi", "agents"), "project"); scan(join(cwd, ".agents", "agents"), "project"); }
	scan(join(AGENT_DIR, "agents"), "user");
	return [...out.values()];
}

interface RunResult { agent: string; task: string; text: string; exitCode: number; stderr: string; turns: number; input: number; output: number; step?: number }

function runAgent(agent: AgentDef, task: string, cwd: string, signal: AbortSignal | undefined, onProgress?: (line: string) => void): Promise<RunResult> {
	const args = ["--mode", "json", "-p", "--no-session"];
	if (MODEL) args.push("--provider", "lets-code", "--model", MODEL);
	if (agent.thinking) args.push("--thinking", agent.thinking);
	if (agent.tools?.length) args.push("--tools", agent.tools.join(","));
	const tmp = mkdtempSync(join(tmpdir(), "lets-code-agent-"));
	const promptFile = join(tmp, "prompt.md");
	writeFileSync(promptFile, `You are the "${agent.name}" agent. ${agent.description}\n\n${agent.prompt}\n`);
	args.push("--append-system-prompt", promptFile, `Task: ${task}`);
	const env = { ...process.env, LETS_CODE_SUBAGENT_DEPTH: String(DEPTH + 1), LETS_CODE_ROLE: agent.role || process.env.LETS_CODE_ROLE || process.env.LETS_CODE_MODE || "" };
	if (!env.LETS_CODE_ROLE) delete (env as any).LETS_CODE_ROLE;
	const r: RunResult = { agent: agent.name, task, text: "", exitCode: 0, stderr: "", turns: 0, input: 0, output: 0 };
	return new Promise((resolve) => {
		const child = spawn("pi", args, { cwd, env, stdio: ["ignore", "pipe", "pipe"] });
		let buf = "";
		const handle = (line: string) => {
			if (!line.trim()) return;
			let ev: any; try { ev = JSON.parse(line); } catch { return; }
			if (ev.type === "message_end" && ev.message?.role === "assistant") {
				r.turns++; const u = ev.message.usage; if (u) { r.input += u.input || 0; r.output += u.output || 0; }
				const c = ev.message.content; const text = typeof c === "string" ? c : Array.isArray(c) ? c.filter((x: any) => x?.type === "text").map((x: any) => x.text).join("\n") : "";
				if (text.trim()) r.text = text;
			}
			if (ev.type === "tool_execution_start" && onProgress) onProgress(`${agent.name}: ${ev.toolName} ${ev.toolName === "bash" ? String(ev.args?.command ?? "").slice(0, 60) : String(ev.args?.path ?? "")}`);
		};
		child.stdout.on("data", (d) => { buf += d.toString(); const lines = buf.split("\n"); buf = lines.pop() ?? ""; lines.forEach(handle); });
		child.stderr.on("data", (d) => { r.stderr += d.toString().slice(0, 4000); });
		const onAbort = () => { try { child.kill("SIGTERM"); } catch { /* gone */ } };
		signal?.addEventListener("abort", onAbort, { once: true });
		child.on("error", (e) => { r.exitCode = 1; r.stderr += `\n${e.message}`; finish(); });
		child.on("close", (code) => { if (buf) handle(buf); r.exitCode = code ?? 1; finish(); });
		const finish = () => { signal?.removeEventListener("abort", onAbort); try { rmSync(tmp, { recursive: true, force: true }); } catch { /* ok */ } resolve(r); };
	});
}
function cap(s: string): string { if (Buffer.byteLength(s, "utf8") <= OUTPUT_CAP) return s; let t = s.slice(0, OUTPUT_CAP); while (Buffer.byteLength(t, "utf8") > OUTPUT_CAP) t = t.slice(0, -1); return `${t}\n\n[output truncated at 50 KB]`; }
function render(r: RunResult): string {
	const head = `## ${r.agent}${r.step ? ` (step ${r.step})` : ""} — ${r.exitCode === 0 ? "done" : `exit ${r.exitCode}`}, ${r.turns} turn${r.turns === 1 ? "" : "s"}, ↑${r.input} ↓${r.output}`;
	const body = r.text.trim() || (r.stderr.trim() ? `(no output; stderr: ${r.stderr.trim().slice(-800)})` : "(no output)");
	return `${head}\n${cap(body)}`;
}
async function mapLimit<T, R>(items: T[], limit: number, fn: (x: T, i: number) => Promise<R>): Promise<R[]> {
	const out: R[] = new Array(items.length); let next = 0;
	const worker = async () => { while (next < items.length) { const i = next++; out[i] = await fn(items[i], i); } };
	await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
	return out;
}

export default function (pi: ExtensionAPI) {
	if (!ACTIVE || DEPTH >= MAX_DEPTH) return;   // a child at the depth limit gets no tool at all (and pays no tokens for it)
	const Item = Type.Object({ agent: Type.String({ description: "agent name" }), task: Type.String({ description: "task; in a chain, {previous} is the prior step's output" }) });
	pi.registerTool({
		name: "subagent",
		label: "subagent",
		description: "Delegate to a named agent with a fresh context: {agent, task} for one; {tasks:[...]} for parallel; {chain:[...]} for sequential with {previous}. Names: see the agents list in the result of a call without arguments.",
		parameters: Type.Object({
			agent: Type.Optional(Type.String({ description: "agent name (single)" })),
			task: Type.Optional(Type.String({ description: "task (single)" })),
			tasks: Type.Optional(Type.Array(Item, { description: "run in parallel" })),
			chain: Type.Optional(Type.Array(Item, { description: "run in order" })),
		}),
		async execute(_id, params: any, signal, onUpdate, ctx: ExtensionContext) {
			const agents = discoverAgents(ctx.cwd, ctx.isProjectTrusted);
			const list = agents.map((a) => `- ${a.name}: ${a.description || "(no description)"}`).join("\n") || "(none: add ~/.pi/agent/agents/<name>.md)";
			const find = (n: string) => agents.find((a) => a.name === n);
			const missing = (n: string) => ({ content: [{ type: "text" as const, text: `Unknown agent "${n}". Agents:\n${list}` }], isError: true });
			const progress = (line: string) => onUpdate?.({ content: [{ type: "text", text: line }] });
			if (params.tasks?.length) {
				if (params.tasks.length > MAX_PARALLEL) return { content: [{ type: "text" as const, text: `Too many parallel tasks (${params.tasks.length}); max ${MAX_PARALLEL}.` }], isError: true };
				for (const t of params.tasks) if (!find(t.agent)) return missing(t.agent);
				const results = await mapLimit(params.tasks, CONCURRENCY, (t: any) => runAgent(find(t.agent)!, t.task, ctx.cwd, signal, progress));
				return { content: [{ type: "text" as const, text: results.map(render).join("\n\n") }], isError: results.every((r) => r.exitCode !== 0) };
			}
			if (params.chain?.length) {
				for (const t of params.chain) if (!find(t.agent)) return missing(t.agent);
				const results: RunResult[] = []; let previous = "";
				for (const [i, t] of (params.chain as any[]).entries()) {
					const r = await runAgent(find(t.agent)!, t.task.replace(/\{previous\}/g, previous), ctx.cwd, signal, progress);
					r.step = i + 1; results.push(r); previous = r.text;
					if (r.exitCode !== 0 || signal?.aborted) break;
				}
				return { content: [{ type: "text" as const, text: results.map(render).join("\n\n") }], isError: results[results.length - 1]?.exitCode !== 0 };
			}
			if (!params.agent || !params.task) return { content: [{ type: "text" as const, text: `Give {agent, task}, {tasks:[...]} or {chain:[...]}. Agents:\n${list}` }], isError: !agents.length };
			const a = find(params.agent); if (!a) return missing(params.agent);
			const r = await runAgent(a, params.task, ctx.cwd, signal, progress);
			return { content: [{ type: "text" as const, text: render(r) }], isError: r.exitCode !== 0 };
		},
	});
}
TS
    chmod 644 "${tmp}"
    if cmp -s "${tmp}" "${f}"; then rm -f "${tmp}"; else mv "${tmp}" "${f}"; fi
}

