	}, CP_DEBOUNCE);
	timer.unref?.();
	cpTimers.set(top, timer);
}

// Run every pending checkpoint now (session end).
async function flushCheckpoints(): Promise<void> {
	for (const [top, t] of cpTimers) { clearTimeout(t); cpTimers.delete(top); if (!cpRunning.has(top)) { cpRunning.add(top); cpInFlight.push(checkpoint(top).catch(() => {}).finally(() => cpRunning.delete(top))); } }
